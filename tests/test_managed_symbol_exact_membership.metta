; Names occur only inside strings so source parsing cannot pre-register them.
!(bind! &runtime-facts (new-space))
!(let $fact (parse "(runtime-msg fresh-runtime-membership)")
   (add-atom &runtime-facts $fact))
!(let $query (parse "(runtime-msg fresh-runtime-membership)")
   (assertEqualToResult (match &runtime-facts $query found) (found)))
!(let $fact (parse "(runtime-msg fresh-runtime-membership)")
   (add-atom-nodup &runtime-facts $fact))
!(assertEqualToResult
   (match &runtime-facts ($head $value) kept) (kept))
!(let $query (parse "(runtime-msg absent-runtime-membership)")
   (assertEqualToResult (match &runtime-facts $query found) ()))
!(let $fact (parse "(runtime-msg fresh-runtime-membership)")
   (add-atom &runtime-facts $fact))
!(let $query (parse "(runtime-msg fresh-runtime-membership)")
   (assertEqualToResult (match &runtime-facts $query found) (found found)))
!(let $fact (parse "(runtime-msg fresh-runtime-membership)")
   (remove-atom &runtime-facts $fact))
!(let $query (parse "(runtime-msg fresh-runtime-membership)")
   (assertEqualToResult (match &runtime-facts $query found) (found)))
