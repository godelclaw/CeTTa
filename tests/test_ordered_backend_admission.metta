!(bind! &fifo-admission (new-space queue))
!(add-atom &fifo-admission z)
!(add-atom &fifo-admission a)
!(assertEqualToResult (space-set-backend! &fifo-admission pathmap)
  ((Error (space-set-backend! &fifo-admission pathmap) UnsupportedSpaceKind)))
!(space-pop &fifo-admission)
!(space-pop &fifo-admission)

!(bind! &lifo-admission (new-space stack))
!(add-atom &lifo-admission z)
!(add-atom &lifo-admission a)
!(assertEqualToResult (space-set-match-backend! &lifo-admission pathmap)
  ((Error (space-set-match-backend! &lifo-admission pathmap) UnsupportedSpaceKind)))
!(space-pop &lifo-admission)
!(space-pop &lifo-admission)

!(bind! &native-candidates (new-space queue))
!(space-set-backend! &native-candidates native-candidate-exact)
!(add-atom &native-candidates z)
!(add-atom &native-candidates a)
!(space-pop &native-candidates)
!(space-pop &native-candidates)
