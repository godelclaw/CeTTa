; A runtime classifier extends the intrinsic answer; it grants no proof authority.
(= (get-type $x)
   (if (== (% $x 2) 0) EvenNumber (empty)))
(: even-add (-> EvenNumber EvenNumber EvenNumber))
(= (even-add $x $y) (+ $x $y))
(: broken-even (-> EvenNumber EvenNumber))
(= (broken-even $x) (+ $x 1))
(: even-id (-> EvenNumber EvenNumber))
(= (even-id $x) $x)
!(collapse (get-type 2))
!(get-type 3)
!(even-add 2 4)
!(even-add 2 3)
!(broken-even 2)
; Unknown is not evidence for this concrete refinement.
!(car-atom (try (even-id banana)))
!(car-atom (try (even-id "two")))
!(car-atom (try (even-id $unbound)))
!(std:get-type 2)
!(type:check (refl (u 0)) (id (u 1) (u 0) (u 1)))
