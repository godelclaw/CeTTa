(hol:profile base)
!(add-atom &self (hol:rule hol-equality))
!(hol:define ReviewAlias (u 0) (= ReviewAlias prop))
!(hol:define FunAlias (u 0) (= FunAlias (-> prop prop)))
!(car-atom (try (hol:proves (pf:fix f (pf:eq-refl FunAlias f)) (all FunAlias (lam f (eq FunAlias f f))))))
!(car-atom (try (hol:check (lam (x : FunAlias) x) (-> FunAlias FunAlias))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl FunAlias p)) (all prop (lam p (eq prop p p))))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl ReviewAlias p)) (all prop (lam p (eq (-> prop prop) p p))))))
!(car-atom (try (hol:check (lam (x : FunAlias) x) (-> prop prop))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl ReviewAlias p)) (all FunAlias (lam p (eq ReviewAlias p p))))))
