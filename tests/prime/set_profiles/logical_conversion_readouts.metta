(hol:profile core)
!(add-atom &self (hol:rule hol-equality))
!(hol:define CarrierAlias (u 0) (= CarrierAlias prop))
!(car-atom (try (hol:check Falsum CarrierAlias)))
!(car-atom (try (hol:eq CarrierAlias prop)))
!(car-atom (try (hol:proves (pf:eq-refl CarrierAlias Falsum) (eq prop Falsum Falsum))))
!(car-atom (try (hol:proves (pf:eq-refl prop Falsum) (eq CarrierAlias Falsum Falsum))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl CarrierAlias p)) (all prop (lam p (eq prop p p))))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl prop p)) (all CarrierAlias (lam p (eq prop p p))))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl CarrierAlias p)) (all CarrierAlias (lam p (eq CarrierAlias p p))))))
!(hol:theorem alias-reflexivity (all CarrierAlias (lam p (eq prop p p))) (pf:fix p (pf:eq-refl CarrierAlias p)))
!(car-atom (try (hol:native-proof alias-reflexivity)))
!(car-atom (try (hol:native-proof alias-reflexivity rule-constants)))
!(car-atom (try (hol:proves (pf:fix X (pf:eq-refl (u 0) X)) (all (u 0) (lam X (eq (u 0) X X))))))
!(car-atom (try (hol:proves (pf:fix X (pf:eq-refl (u 1) X)) (all (u 1) (lam X (eq (u 1) X X))))))
!(car-atom (try (hol:proves (pf:eq-refl set Falsum) (eq set Falsum Falsum))))
!(car-atom (try (hol:proves (pf:fix p (pf:eq-refl CarrierAlias p)) (all prop (lam p (eq set p p))))))
!(car-atom (try (hol:proves (pf:fix p (pf:fix q (pf:eq-refl CarrierAlias p))) (all prop (lam p (all prop (lam q (eq prop p q))))))))
!(car-atom (try (hol:proves (pf:fix X (pf:eq-refl OpaqueCarrier X)) (all OpaqueCarrier (lam X (eq OpaqueCarrier X X))))))
!(car-atom (try (hol:proves (pf:fix X (pf:eq-refl (class 1) X)) (all (class 1) (lam X (eq (class 1) X X))))))
!(remove-atom &self (: CarrierAlias (u 0)))
!(car-atom (try (hol:proves (pf:known alias-reflexivity) (all CarrierAlias (lam p (eq prop p p))))))
!(car-atom (try (hol:native-proof alias-reflexivity)))
!(car-atom (try (hol:proves (pf:eq-refl prop Falsum) (eq prop Falsum Falsum))))
!(add-atom &self (: CarrierAlias (u 0)))
!(car-atom (try (hol:proves (pf:known alias-reflexivity) (all CarrierAlias (lam p (eq prop p p))))))
!(car-atom (try (hol:native-proof alias-reflexivity)))
!(remove-atom &self (hol:rule hol-equality))
!(car-atom (try (hol:proves (pf:known alias-reflexivity) (all CarrierAlias (lam p (eq prop p p))))))
!(car-atom (try (hol:native-proof alias-reflexivity)))
