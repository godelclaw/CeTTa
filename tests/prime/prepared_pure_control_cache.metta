       (control-cache:step 124)
       (control-cache:step 125)
       (control-cache:step 126)
       (control-cache:step 127))))

; Replacing this same head invalidates the old worker. The first following
; call establishes the replacement worker; the second reuses it.
!(remove-atom &self
   (= (control-cache:step $value)
      (if (< $value 0)
          (+ "unselected-cache-branch" 1)
          (+ $value 1))))
!(add-atom &self
   (= (control-cache:step $value) (+ $value 1001)))
!(collapse
   (superpose
      ((control-cache:step 200)
       (control-cache:step 201))))

; Negative/laziness witnesses: compiling the branch schedule must never force
; the unselected faulting arm.
!(if True selected (+ "unselected-branch" 1))
!(if False (+ "unselected-branch" 1) selected)
