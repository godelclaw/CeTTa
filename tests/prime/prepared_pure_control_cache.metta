; Ordinary authored control calls share one revision-pinned generated program.
; The witness deliberately contains no compiler package, plan, or admission
; declaration: the runtime derives control semantics from the LanguageDef.

!(bind! &control-cache:columns (new-space))
!(add-atom &control-cache:columns (column 1))
!(add-atom &control-cache:columns (column 2))
!(add-atom &control-cache:columns (column 3))
!(add-atom &control-cache:columns (column 4))

(= (control-cache:safe $column $placed $distance)
   (if (== $placed ())
       True
       (let ($head $tail) (decons-atom $placed)
         (if (== $column $head)
             False
             (if (== (abs-math (- $column $head)) $distance)
                 False
                 (control-cache:safe
                   $column $tail (+ $distance 1))))){$head $tail}))

(= (control-cache:place $remaining $placed)
   (if (<= $remaining 0)
       $placed
       (match &control-cache:columns (column $column)
         (case (control-cache:safe $column $placed 1)
           ((True
             (control-cache:place
               (- $remaining 1)
               (cons-atom $column $placed)))))){$column}))

!(collapse (control-cache:place 4 ()))

(= (control-cache:step $value)
   (if (< $value 0)
       (+ "unselected-cache-branch" 1)
       (+ $value 1)))

; Independent calls reuse one quiescent compiled worker while the authored
; equation space remains unchanged.
!(collapse
   (superpose
      ((control-cache:step 0)
       (control-cache:step 1)
       (control-cache:step 2)
       (control-cache:step 3)
       (control-cache:step 4)
       (control-cache:step 5)
       (control-cache:step 6)
       (control-cache:step 7)
       (control-cache:step 8)
       (control-cache:step 9)
       (control-cache:step 10)
       (control-cache:step 11)
       (control-cache:step 12)
       (control-cache:step 13)
       (control-cache:step 14)
       (control-cache:step 15)
