; Retain a proof while its context is unavailable. Restoring its original
; context permits reuse; another profile does not silently reinterpret it.
!(bind! &math (new-space))
!(add-atom &math (hol:profile base))
!(hol:theorem &math logical-id (all prop (lam p (imp p p)))
   (pf:all-intro (pf:imp-intro (pf:hyp 0))))
!(hol:proves &math (pf:known logical-id) (all prop (lam p (imp p p))))
!(remove-atom &math (hol:profile base))
!(add-atom &math (set:profile none))
!(let $r (hol:proves &math (pf:known logical-id) (all prop (lam p (imp p p)))) (car-atom $r))
!(remove-atom &math (set:profile none))
!(add-atom &math (hol:profile base))
!(hol:proves &math (pf:known logical-id) (all prop (lam p (imp p p))))
!(remove-atom &math (hol:profile base))
!(add-atom &math (set:profile megalodon-hotg))
!(let $r (try (set:proves &math (pf:known logical-id) (all prop (lam p (imp p p))))) (car-atom $r))
!(let $r (try (set:recheck &math logical-id)) (car-atom $r))
!(set:proves &math (pf:all-intro (pf:imp-intro (pf:hyp 0))) (all prop (lam p (imp p p))))
!(remove-atom &math (set:profile megalodon-hotg))
!(add-atom &math (hol:profile base))
!(hol:proves &math (pf:known logical-id) (all prop (lam p (imp p p))))
