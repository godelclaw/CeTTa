!(import! &self fs)

(= (test-fs-error? $x)
   (case $x
     (((FsError $msg) True)
      ($other False))))

!(assertEqual (fs:exists "tests/support/fs_fixture.txt") True)
!(assertEqual (fs:read-text "tests/support/fs_fixture.txt") "first line\nsecond line\n\nthird line\n")
!(assertEqual (fs:read-lines "tests/support/fs_fixture.txt") ("first line" "second line" "" "third line"))
!(assertEqual (fs:write-text "runtime/test_fs_interface_output.txt" "alpha") ())
!(assertEqual (fs:append-text "runtime/test_fs_interface_output.txt" "\nbeta") ())
!(assertEqual (fs:read-text "runtime/test_fs_interface_output.txt") "alpha\nbeta")
!(assertEqual (fs:read-lines "runtime/test_fs_interface_output.txt") ("alpha" "beta"))
!(assertEqual (fs:write-text "runtime/test_fs_interface_new.txt" "old") ())
!(assertEqual (fs:remove "runtime/test_fs_interface_new.txt") ())
!(assertEqual (fs:write-new-text "runtime/test_fs_interface_new.txt" "fresh") ())
!(assertEqual (fs:write-new-text "runtime/test_fs_interface_new.txt" "again") AlreadyExists)
!(assertEqual (fs:read-text "runtime/test_fs_interface_new.txt") "fresh")
!(assertEqual (fs:remove "runtime/test_fs_interface_new.txt") ())
!(assertEqual (fs:exists "runtime/test_fs_interface_new.txt") False)
!(assertEqual (fs:mkdirs "runtime/test_fs_interface_nested/a/b") ())
!(assertEqual (fs:write-text "runtime/test_fs_interface_nested/a/b/out.txt" "nested") ())
!(assertEqual (fs:read-text "runtime/test_fs_interface_nested/a/b/out.txt") "nested")

!(assertEqual (test-fs-error? (fs:write-text "runtime/test_fs_missing_dir/out.txt" "x")) True)
!(assertEqual (test-fs-error? (fs:append-text "runtime/test_fs_missing_dir/out.txt" "x")) True)
!(assertEqual (test-fs-error? (fs:write-new-text "runtime/test_fs_missing_dir/out.txt" "x")) True)
!(assertEqual (test-fs-error? (fs:remove "runtime/test_fs_missing_dir/out.txt")) True)
!(assertEqual (test-fs-error? (fs:read-text "runtime/test_fs_missing_dir/out.txt")) True)
