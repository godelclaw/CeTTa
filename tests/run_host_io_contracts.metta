!(import! &self (library proc))
!(import! &self (library system))
!(import! &self (library str))
(= (host-driver:one $language)
   (let* (($binary (system:executable))
          ($command (if (== $language "prime")
             ($binary "--quiet" "--lang" $language "tests/host_io_contracts.metta")
             ($binary "--quiet" "--lang" $language "--profile" "extended" "tests/host_io_contracts.metta")))
          ($result (proc:run $command (system:getcwd) inherit 10000 65536)))
     (case $result
       (((proc:exited 0 $out $err)
         (case (str:find $out "HOST_IO_SHARED_CONTRACTS_OK")
           (((TextNotFound $_) (system:exit 1)) ($found True))))
        ($failed (progn (println! ($language $failed)) (system:exit 1)))))))
!(host-driver:one "petta")
!(host-driver:one "he")
!(host-driver:one "prime")
!(println! HOST_IO_PROFILE_MATRIX_OK)
