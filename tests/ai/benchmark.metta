; Alternating, independently checked complete CLI invocations. This measures
; fresh processes with warm filesystem caches, not a cold-disk benchmark.
!(import! &self (library proc))
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library system))

(= (bp:fail $problem)
   (let $shown (println! $problem) (system:exit 1)))
(= (bp:code $size)
   (str:join "" (
     "(= (bf $n $sum) (if (== $n 0) $sum (bf (- $n 1) (+ $sum $n)))) "
     "(= (br $runs $n $sum) (if (== $runs 0) $sum (let $v (bf $n $sum) (br (- $runs 1) $n $v)))) "
     "!(br 64 " (repr $size) " 0)")))
(= (bp:environment)
   (("PATH" "/usr/local/bin:/usr/bin:/bin") ("LANG" "C.UTF-8")
    ("LC_ALL" "C.UTF-8") ("TZ" "UTC")))
(= (bp:one $binary $language $size $cwd $rss-path)
   (let* (($code (bp:code $size))
          ($value (* 32 (* $size (+ $size 1))))
          ($wanted (if (== $language "he") (str:join "" ("[" (repr $value) "]\n"))
                     (str:concat (repr $value) "\n")))
          ($argv ("/usr/bin/time" "-f" "%M" "-o" $rss-path $binary "--lang" $language "-e" $code))
          ($start (system:monotonic-ns))
          ($ran (proc:run $argv $cwd (bp:environment) 60000 1048576))
          ($end (system:monotonic-ns)))
     (case $ran
       (((proc:exited 0 $actual "")
          (if (== $actual $wanted)
            (let $rss (str:string->number (str:trim (fs:read-text $rss-path)))
              (if (> $rss 0) (Measurement (- $end $start) $rss)
                (bp:fail (InvalidRSS $binary $rss))))
            (bp:fail (BenchmarkValueMismatch $language $size $wanted $actual))))
        ($bad (bp:fail (BenchmarkExecutionFailed $language $size $bad)))))))
(= (bp:pair $baseline $candidate $language $size $cwd $dir $baseline-first)
   (let* (($br (str:concat $dir "/baseline.rss")) ($cr (str:concat $dir "/candidate.rss"))
          ($first (if $baseline-first (bp:one $baseline $language $size $cwd $br)
                     (bp:one $candidate $language $size $cwd $cr)))
          ($second (if $baseline-first (bp:one $candidate $language $size $cwd $cr)
                      (bp:one $baseline $language $size $cwd $br))))
     (case ($first $second)
       ((((Measurement $fns $frss) (Measurement $sns $srss))
          (if $baseline-first (Sample $fns $sns $frss $srss)
            (Sample $sns $fns $srss $frss)))
        ($bad (bp:fail (InvalidSamplePair $bad)))))))
(= (bp:nth $values $index)
   (if (== $index 0) (car-atom $values) (bp:nth (cdr-atom $values) (- $index 1))))
(= (bp:walk $baseline $candidate $language $size $cwd $dir $left $baseline-first $rows)
   (if (== $left 0) $rows
     (let* (($row (bp:pair $baseline $candidate $language $size $cwd $dir $baseline-first))
            ($shown (println! (BenchmarkSample $language $size $left $baseline-first $row))))
       (bp:walk $baseline $candidate $language $size $cwd $dir (- $left 1)
         (not $baseline-first) (cons-atom $row $rows)))))
(= (bp:columns $rows $base-times $candidate-times $base-rss $candidate-rss)
   (if (== $rows ()) (Columns $base-times $candidate-times $base-rss $candidate-rss)
     (let* (((Sample $bn $cn $brn $crn) (car-atom $rows)) ($rest (cdr-atom $rows)))
       (bp:columns $rest (cons-atom $bn $base-times) (cons-atom $cn $candidate-times)
         (cons-atom $brn $base-rss) (cons-atom $crn $candidate-rss)))))
(= (bp:summary $language $size $rows)
   (if (== (size-atom $rows) 9)
     (let* (((Columns $bts $cts $brs $crs) (bp:columns $rows () () () ()))
            ($bt (msort $bts)) ($ct (msort $cts)) ($br (msort $brs)) ($cr (msort $crs))
            ($bm (bp:nth $bt 4)) ($cm (bp:nth $ct 4))
            ($overhead (* 100.0 (- (/ (* 1.0 $cm) $bm) 1.0))))
       (BenchmarkSummary $language $size 9 $bm $cm (bp:nth $bt 8) (bp:nth $ct 8)
         (bp:nth $br 8) (bp:nth $cr 8) $overhead))
     (bp:fail (BenchmarkCountMismatch (size-atom $rows)))))
(= (bp:run $baseline $candidate $language $size $cwd $dir)
   (let* (($prepared (fs:make-directories $dir 511))
          ($warm-b (bp:one $baseline $language $size $cwd (str:concat $dir "/warm-b.rss")))
          ($warm-c (bp:one $candidate $language $size $cwd (str:concat $dir "/warm-c.rss")))
          ($rows (bp:walk $baseline $candidate $language $size $cwd $dir 9 True ())))
     (bp:summary $language $size $rows)))
