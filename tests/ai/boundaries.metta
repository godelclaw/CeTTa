!(import! &self "./activation.metta")
!(import! &self "./value_outputs.metta")
!(import! &self "./substitution.metta")
!(import! &self "./memo_roles.metta")

(= (ab:run $binary)
   (case ((act:run $binary "he" "CETTA_HE_CANONICAL_EXECUTION=1")
          (act:run $binary "he" "CETTA_HE_CANONICAL_EXECUTION=0")
          (act:run $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=1")
          (act:run $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=0")
          (vo:run $binary "he" "CETTA_HE_CANONICAL_EXECUTION=1")
          (vo:run $binary "he" "CETTA_HE_CANONICAL_EXECUTION=0")
          (vo:run $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=1")
          (vo:run $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=0")
          (sc:run $binary "CETTA_HE_CANONICAL_EXECUTION=1")
          (sc:run $binary "CETTA_HE_CANONICAL_EXECUTION=0")
          (mr:run $binary "CETTA_PETTA_TRANSLATOR_EXPANSION=1")
          (mr:run $binary "CETTA_PETTA_TRANSLATOR_EXPANSION=0")
          (sc:graph $binary "CETTA_HE_CANONICAL_EXECUTION=1")
          (sc:graph $binary "CETTA_HE_CANONICAL_EXECUTION=0"))
     ((((ActivationResults $he1 $hc1 17 0) (ActivationResults $he0 $hc0 17 0)
        (ActivationResults $p1 $pc1 17 0) (ActivationResults $p0 $pc0 17 0)
        (ValueOutputResults $he1 $hc1 48 0) (ValueOutputResults $he0 $hc0 48 0)
        (ValueOutputResults $p1 $pc1 44 0) (ValueOutputResults $p0 $pc0 44 0)
        (SubstitutionResults $hc1 6 0) (SubstitutionResults $hc0 6 0)
        (MemoRoleResults $pc1 6 0) (MemoRoleResults $pc0 6 0)
        (SubstitutionGraphPass $hc1 60) (SubstitutionGraphPass $hc0 60))
       (AIBoundariesPass 68 184 12 12 2))
      ($bad (let $shown (println! (AIBoundariesFailed $bad)) (system:exit 1))))))
