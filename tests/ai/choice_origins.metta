; Equation selection must save sibling continuations before surfacing a
; failure. Predictions retain declaration order and duplicate occurrences.
!(import! &self "./activation.metta")

(COConsumer let "(let $r (pick 3) (Got $r))")
(COConsumer constructor "(Got (pick 3))")
(COConsumer collapse "(collapse (Got (pick 3)))")
(COConsumer catch "(let $r (catch (Got (pick 3))) (After $r))")

(= (co:wrap $values)
   (if (== $values ()) ()
     (cons-atom (str:join "" ("(After " (car-atom $values) ")"))
                (co:wrap (cdr-atom $values)))))
(= (co:spec $kind $layout)
   (let* (($failure (str:join "" ("(= (pick $x) (Error $x (" $kind " reason))) ")))
          ($value "(= (pick $x) $x) ")
          ($error (str:join "" ("(Error 3 (" $kind " reason))"))))
     (case $layout
       ((first (Spec (str:concat $failure $value) ($error "(Got 3)")))
        (last (Spec (str:concat $value $failure) ("(Got 3)" $error)))
        (duplicate (Spec (str:join "" ($failure $failure $value))
                         ($error $error "(Got 3)")))))))
(= (co:check $binary $language $route (Choice $kind $layout $typed $consumer $expression))
   (let* (((Spec $definitions $values) (co:spec $kind $layout))
          ($declaration (if $typed "(: pick (-> Atom Atom)) " ""))
          ($source (str:join "" ("!(ai:experiment failure-values) " $declaration
                                 $definitions "!" $expression)))
          ($collected (str:join "" ("(" (str:join " " $values) ")")))
          ($outputs (if (== $consumer collapse) ($collected)
                      (if (== $consumer catch) (co:wrap $values) $values)))
          ($wanted (if (== $language "he")
                     (str:join "" ("[()]\n[" (str:join ", " $outputs) "]\n"))
                     (str:join "" ("()\n" (str:join "\n" $outputs) "\n")))))
     (case (proc:run ("/usr/bin/env" $route $binary "--lang" $language "--profile" "ai" "-e" $source)
                     "." inherit 15000 1048576)
       (((proc:exited 0 $actual "")
          (if (== $actual $wanted) 0
            (let $shown (println! (ChoiceOriginMismatch $language $route $kind $layout $typed $consumer $wanted $actual)) 1)))
        ($bad (let $shown (println! (ChoiceOriginExecutionFailed $language $route $kind $layout $typed $consumer $bad)) 1))))))
(= (co:walk $binary $language $route $cases $index $bad)
   (if (== $index (size-atom $cases)) (ChoiceOriginResults $language $route $index $bad)
     (let $failed (co:check $binary $language $route (index-atom $cases $index))
       (co:walk $binary $language $route $cases (+ $index 1) (+ $bad $failed)))))
(= (co:run $binary $language $route)
   (let $cases (collapse
          (let* (($kind (superpose ("Unsolvable" "Forbidden" "Incomplete" "Fault")))
                 ($layout (superpose (first last duplicate)))
                 ($typed (superpose (False True))))
            (match &self (COConsumer $consumer $expression)
               (Choice $kind $layout $typed $consumer $expression))))
     (co:walk $binary $language $route $cases 0 0)))

(R4 all sealed-source "" "(let $r (sealed () (Error origin (Forbidden reason))) never)" "(Error origin (Forbidden reason))")
(R4 all sealed-data "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (sealed () $d) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(R4 all if-equal-source "" "(let $r (if-equal a a (Error origin (Forbidden reason)) unused) never)" "(Error origin (Forbidden reason))")
(R4 all if-equal-data "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (if-equal a a $d unused) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(R4 all tuple-source "" "(let $r (__cetta_lib_list_to_expression (Error origin (Forbidden reason))) never)" "(Error origin (Forbidden reason))")
(R4 all tuple-new-root "" "(let $r (__cetta_lib_list_to_expression [Error origin (Forbidden reason)]) (Box $r))" "(Box (Error origin (Forbidden reason)))")
(R4 all tuple-data "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (__cetta_lib_list_to_expression $d) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(R4 he noeval-source "" "(let $r (noeval (Error origin (Forbidden reason))) never)" "(Error origin (Forbidden reason))")
(R4 he noeval-data "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (noeval $d) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(R4 he metta-atom-data "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (metta $d Atom &self) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(R4 he metta-expression-data "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (metta $d Expression &self) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(R4 he reentered-container "" "(let $box (cons-atom Box ((Error origin (Forbidden reason)))) (let (Box $e) $box reached))" "(Error origin (Forbidden reason))")
(R4 he direct-container "" "(let (Box $e) (cons-atom Box ((Error origin (Forbidden reason)))) reached)" "reached")
(R4 he sealed-renamed-data "" "(let $d (catch (Error $x (Fault reason))) (let $r (sealed () $d) (case (Box $r) (((Box (Error $w (Fault reason))) preserved)))))" "preserved")
(R4 he sort-source "" "(let ($e) (sort-atom ((Error origin (Forbidden reason)))) (Box $e))" "(Error origin (Forbidden reason))")
(R4 he sort-data "" "(let $d (catch (Error origin (Forbidden reason))) (let ($e) (sort-atom ($d)) (Box $e)))" "(Box (Error origin (Forbidden reason)))")
(R4 he unique-source "" "(let ($e) (unique-atom ((Error origin (Forbidden reason)))) (Box $e))" "(Error origin (Forbidden reason))")
(R4 he unique-data "" "(let $d (catch (Error origin (Forbidden reason))) (let ($e) (unique-atom ($d)) (Box $e)))" "(Box (Error origin (Forbidden reason)))")
(R4 he union-source "" "(let ($e) (union-atom ((Error origin (Forbidden reason))) ()) (Box $e))" "(Error origin (Forbidden reason))")
(R4 he union-data "" "(let $d (catch (Error origin (Forbidden reason))) (let ($e) (union-atom ($d) ()) (Box $e)))" "(Box (Error origin (Forbidden reason)))")
(R4 he intersection-source "" "(let ($e) (intersection-atom ((Error origin (Forbidden reason))) ((Error origin (Forbidden reason)))) (Box $e))" "(Error origin (Forbidden reason))")
(R4 he intersection-data "" "(let $d (catch (Error origin (Forbidden reason))) (let ($e) (intersection-atom ($d) ($d)) (Box $e)))" "(Box (Error origin (Forbidden reason)))")
(R4 he subtraction-source "" "(let ($e) (subtraction-atom ((Error origin (Forbidden reason))) ()) (Box $e))" "(Error origin (Forbidden reason))")
(R4 he subtraction-data "" "(let $d (catch (Error origin (Forbidden reason))) (let ($e) (subtraction-atom ($d) ()) (Box $e)))" "(Box (Error origin (Forbidden reason)))")
(R4 he from-expression-source "" "(let [$e] (__cetta_lib_list_from_expression ((Error origin (Forbidden reason)))) (Box $e))" "(Error origin (Forbidden reason))")
(R4 he from-expression-data "" "(let $d (catch (Error origin (Forbidden reason))) (let [$e] (__cetta_lib_list_from_expression ($d)) (Box $e)))" "(Box (Error origin (Forbidden reason)))")
(R4 he conversion-new-root-source-child "" "(let (Error $where $kind) (__cetta_lib_list_to_expression [Error (Error inner (Fault reason)) (Fault outer)]) (Box $where))" "(Error inner (Fault reason))")
(R4 he conversion-new-root-data-child "" "(let $inner (catch (Error inner (Fault reason))) (let (Error $where $kind) (__cetta_lib_list_to_expression [Error $inner (Fault outer)]) (Box $where)))" "(Box (Error inner (Fault reason)))")
(R4 he late-observed-code "(Item (g y)) " "(match &self (Item $code) (let $added (add-atom &self (= (g y) done)) $code))" "done")

(= (r4:walk $binary $language $route $cases $index $bad)
   (if (== $index (size-atom $cases)) (Review4Results $language $route $index $bad)
     (let* (((ReviewCase $name $prefix $source $wanted) (index-atom $cases $index))
            ($failure (act:check-source $binary $language $route $name $prefix $source $wanted)))
       (r4:walk $binary $language $route $cases (+ $index 1) (+ $bad $failure)))))
(= (r4:one $binary $language $route)
   (let $cases (collapse
          (let (Entry $scope $name $prefix $source $wanted)
               (match &self (R4 $scope $name $prefix $source $wanted)
                            (Entry $scope $name $prefix $source $wanted))
            (if (or (== $scope all) (== (repr $scope) $language))
                (ReviewCase $name $prefix $source $wanted) (superpose ()))))
     (r4:walk $binary $language $route $cases 0 0)))
(= (r4:run $binary)
   (case ((co:run $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=1")
          (co:run $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=0")
          (co:run $binary "ai" "CETTA_PETTA_TRANSLATOR_EXPANSION=1")
          (co:run $binary "ai" "CETTA_PETTA_TRANSLATOR_EXPANSION=0")
          (co:run $binary "he" "CETTA_HE_CANONICAL_EXECUTION=1")
          (co:run $binary "he" "CETTA_HE_CANONICAL_EXECUTION=0")
          (r4:one $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=1")
          (r4:one $binary "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=0")
          (r4:one $binary "he" "CETTA_HE_CANONICAL_EXECUTION=1")
          (r4:one $binary "he" "CETTA_HE_CANONICAL_EXECUTION=0"))
     ((((ChoiceOriginResults $p1 $r1 96 0) (ChoiceOriginResults $p0 $r0 96 0)
        (ChoiceOriginResults $a1 $r1 96 0) (ChoiceOriginResults $a0 $r0 96 0)
        (ChoiceOriginResults $h1 $hr1 96 0) (ChoiceOriginResults $h0 $hr0 96 0)
        (Review4Results $p1 $r1 7 0) (Review4Results $p0 $r0 7 0)
        (Review4Results $h1 $hr1 29 0) (Review4Results $h0 $hr0 29 0))
       (AIReview4Pass 576 72))
      ($bad (let $shown (println! (AIReview4Failed $bad)) (system:exit 1))))))
