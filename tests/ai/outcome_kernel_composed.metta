; This is a separate experiment from the outcome channel. Exact process
; outcomes are compared with HE's fenced canonical source-import path.
!(import! &self (library proc))
!(import! &self (library str))
!(import! &self "./outcome_kernel_routes.metta")

(OICase add "!(import! &m ./tests/ai/outcome_kernel_imports/seed.metta) !(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(oi:f 1) !(add-atom &m (= (oi:f $x) (+ $x 9))) !(collapse (oi:f 1))")
(OICase remove "!(import! &m ./tests/ai/outcome_kernel_imports/seed.metta) !(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(oi:f 1) !(remove-atom &m (= (oi:f $x) (+ $x 1))) !(collapse (oi:f 1))")
(OICase later-root-import "!(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(oi:f 1) !(import! &self ./tests/ai/outcome_kernel_imports/second.metta) !(collapse (oi:f 1))")
(OICase type-after-call "!(import! &m ./tests/ai/outcome_kernel_imports/seed.metta) !(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(oi:f (+ 1 2)) !(add-atom &m (: oi:f (-> Atom Atom))) !(oi:f (+ 1 2))")
(OICase transitive "!(import! &child ./tests/ai/outcome_kernel_imports/child.metta) !(import! &self ./tests/ai/outcome_kernel_imports/parent.metta) !(oi:parent 1) !(add-atom &child (= (oi:g $x) (+ $x 8))) !(collapse (oi:parent 1))")
(OICase diamond "!(import! &self ./tests/ai/outcome_kernel_imports/diamond.metta) !(collapse (oi:g 1)) !(collapse (oi:parent 1))")
(OICase cycle "!(import! &self ./tests/ai/outcome_kernel_imports/cycle_a.metta) !(collapse (oi:cycle-a))")
(OICase root-and-module "(= (oi:f $x) (+ $x 100)) !(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(collapse (oi:f 1))")
(OICase bind-after-call "!(import! &m ./tests/ai/outcome_kernel_imports/seed.metta) !(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(oi:f 1) !(bind! &oi:new 99) !(oi:f 1)")
(OICase late-child-import "!(import! &m ./tests/ai/outcome_kernel_imports/seed.metta) !(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) !(oi:f 1) !(oi:late 1) !(import! &m ./tests/ai/outcome_kernel_imports/late.metta) !(oi:f 1) !(oi:late 1)")
(OICase raw-and-completed "!(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) (: held (-> Atom Atom)) (= (held $x) $x) (= (wrapped $x) (Box (held $x))) !(wrapped (+ 1 2)) !(let $data (quote (+ 1 2)) (wrapped $data))")
(OICase returned-collection "!(import! &self ./tests/ai/outcome_kernel_imports/seed.metta) (= (items) (collapse (superpose (1 2 3)))) !(items) !(let $xs (items) (superpose $xs))")

(= (oi:one $binary $root $route $name $source)
   (let* (($reference (proc:run (okroute:argv $binary "he" $route $source)
                      $root inherit 10000 1048576))
          ($candidate-source (str:concat "!(ai:experiment he-composed-execution) " $source))
          ($candidate (proc:run (okroute:argv $binary "he" $route $candidate-source)
                      $root inherit 10000 1048576)))
     (case ($reference $candidate)
       ((((proc:exited $ref-code $ref-out $ref-err) (proc:exited $new-code $new-out $new-err))
          (if (and (== $ref-code $new-code)
                   (and (== $ref-err $new-err)
                        (== (str:concat "[()]\n" $ref-out) $new-out)))
            0 (let $shown (println! (ComposedMismatch $route $name $reference $candidate)) 1)))
        ($bad (let $shown (println! (ComposedExecutionFailure $name $bad)) 1))))))
(= (oi:walk $binary $root $route $cases $count $bad)
   (if (== $cases ()) (ComposedResults $route $count $bad)
     (let* (((Case $name $source) (car-atom $cases))
            ($failed (oi:one $binary $root $route $name $source)))
       (oi:walk $binary $root $route (cdr-atom $cases) (+ $count 1) (+ $bad $failed)))))
(= (oi:run $binary $root $route)
   (let $cases (collapse (match &self (OICase $name $source) (Case $name $source)))
     (oi:walk $binary $root $route $cases 0 0)))
