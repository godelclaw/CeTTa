!(ai:experiment failure-values)
; Each directive is an independent occurrence/observer test. Diagnostic
; fields deliberately contain executable-looking syntax: they stay data.
!(Error origin (Unsolvable ill-posed))
!(Error origin (Forbidden refused))
!(Error origin (Incomplete no-verdict))
!(Error origin (Fault broken))
!(Error origin legacy-reason)
!(let $x (Error bound (Forbidden denied)) must-not-run)
!(let* (($x (Error first (Fault one))) ($y (Error later (Fault two)))) unreachable)
!(if (Error condition (Incomplete unresolved)) then else)
!(if True yes (Error undemanded (Fault no)))
!(if False (Error undemanded (Fault no)) yes)
!(collapse (if (superpose (True (Error condition (Fault bad)) False)) yes no))
!(collapse (let* (($x (superpose (1 (Error branch (Fault bad)) 2))) ($y (superpose (10 20)))) (Pair $x $y)))
!(collapse (superpose ((Error first (Fault bad)) 7 (Error last (Forbidden denied)))))
!(collapse (superpose ((Error duplicate (Fault same)) (Error duplicate (Fault same)))))
!(collapse (empty))
!(collapse (superpose (() (Box ()) (Empty scope))))
!(collapse (superpose ()))
!(case (Error source (Fault bad)) (((Error $where (Fault $detail)) (Seen $where $detail)) ($other hidden)))
!(case (Error source (Forbidden denied)) (((Error $where (Fault $detail)) wrong) ($other hidden)))
!(case (Error source (Fault bad)) (($other hidden)))
!(collapse (case (superpose ((Error source (Fault bad)) 7)) (((Error $where $reason) handled) ($other $other))))
!(let $value (catch (Error source (Fault bad))) (case $value (($other data))))
!(let $value (catch (Error source (Fault bad))) (Box $value))
!(let $value (catch (Error source (Fault bad))) (== $value $value))
!(collapse (catch (superpose ((Error source (Fault bad)) 7))))
!(Error (+ 1 2) (Fault (+ 3 4)))
!(case (Error (+ 1 2) (Fault (+ 3 4))) (((Error $where $reason) $where)))
!(case (Error (+ 1 2) (Fault (+ 3 4))) (((Error $where (Fault $detail)) $detail)))
!(Box (Error field (Fault bad)))
!(Box (Error first (Forbidden one)) (Error last (Fault two)))
!(+ (Error left (Fault first)) (Error right (Fault second)))
!((Error operator (Forbidden bad)) (Error argument (Fault later)))
!(collapse (let $x (superpose (1 2)) (Pair $x $x)))
!(collapse (let* (($x (superpose (1 2))) ($x (superpose (1 2)))) $x))
!(unify (Error syntax (Fault data)) (Error $where (Fault $detail)) (Seen $where $detail) no)
!(unify 1 2 yes no)
!(collapse (let (Box $x) (Other 1) $x))
!(collapse (if (superpose ()) yes no))
(: Hold (-> Atom Atom))
(= (Hold $syntax) $syntax)
!(Hold (Error held (Fault data)))
!(Empty (Scope example))
!(let $x (Empty scope) (Box $x))
!(== (Empty scope) ())
