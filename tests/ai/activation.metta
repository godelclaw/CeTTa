; Activation selects a code view of the root. Returned data, inspection,
; ordinary held parameters and completed children retain their own roles.
!(import! &self "./he_contract.metta")

(ACT root-eval "" "(let $d (catch (Error origin (Forbidden reason))) (let $v (eval $d) reached))" "(Error origin (Forbidden reason))")
(ACT root-metta "" "(let $d (catch (Error origin (Forbidden reason))) (let $v (metta $d %Undefined% &self) reached))" "(Error origin (Forbidden reason))")
(ACT standard-opener "" "(let $d (catch (Error origin (Forbidden reason))) (let $v (unquote (quote $d)) reached))" "(Error origin (Forbidden reason))")
(ACT user-opener "(= (qopen (quote $x)) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $v (qopen (quote $d)) reached))" "(Error origin (Forbidden reason))")
(ACT quoted-data-pattern "" "(let $d (catch (Error origin (Forbidden reason))) (let (quote $a) (quote $d) (Box $a)))" "(Box (Error origin (Forbidden reason)))")
(ACT selected-data-branch "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (if True $d 0) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(ACT ordinary-held-data "(: plain (-> Atom %Undefined%)) (= (plain $x) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (plain $d) (Box $r)))" "(Box (Error origin (Forbidden reason)))")
(ACT held-source-program "(: plain (-> Atom %Undefined%)) (= (plain $x) $x) " "(let $r (plain (Error origin (Forbidden reason))) reached)" "(Error origin (Forbidden reason))")
(ACT data-output-after-opening "(: qdata (-> Atom Atom)) (= (qdata (quote $x)) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (qdata (quote $d)) (Box $r)))" "(Error origin (Forbidden reason))")
(ACT ordinary-code-opener "(= (qf x) reduced) " "(let $r (unquote (quote (qf x))) (Box $r))" "(Box reduced)")
(ACT completed-child-opener "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (unquote (quote (Box $d))) (Nested $r)))" "(Nested (Box (Error origin (Forbidden reason))))")
(ACT completed-child-eval "" "(let $d (catch (Error origin (Forbidden reason))) (let $r (eval (unquote (quote (Box $d)))) (Nested $r)))" "(Nested (Box (Error origin (Forbidden reason))))")
(ACT admitted-piece "" "(let $d (catch (Error origin (Forbidden reason))) (let $box (cons-atom Box ($d)) (let $r (car-atom (cdr-atom $box)) (Piece $r))))" "(Piece (Error origin (Forbidden reason)))")
(ACT held-source-piece "" "(let $r (car-atom ((Error origin (Forbidden reason)) 1)) reached)" "(Error origin (Forbidden reason))")
(ACT plain-pattern "(= (plain $x) user-owned) " "(let $d (catch (Error origin (Forbidden reason))) (plain (quote $d)))" "user-owned")
(ACT shared-pattern-activation "(= (qshared (quote $x) $x) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (qshared (quote $d) $d) reached))" "(Error origin (Forbidden reason))")
(ACT original-value-unmodified "(= (qshared (quote $x) $x) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (catch (qshared (quote $d) $d)) (Box $d)))" "(Box (Error origin (Forbidden reason)))")

(ACTSource "petta" standard-opener "(: unquote (-> Atom %Undefined%)) (= (unquote (quote $x)) (eval $x)) " "(let $d (catch (Error origin (Forbidden reason))) (let $v (unquote (quote $d)) reached))")
(ACTSource "petta" user-opener "(= (qopen (quote $x)) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $v (qopen (quote (quote $d))) reached))")
(ACTSource "petta" quoted-data-pattern "" "(let $d (catch (Error origin (Forbidden reason))) (let (quote $a) (quote (quote $d)) (Box $a)))")
(ACTSource "petta" ordinary-code-opener "(: unquote (-> Atom %Undefined%)) (= (unquote (quote $x)) (eval $x)) (= (qf x) reduced) " "(let $r (unquote (quote (qf x))) (Box $r))")
(ACTSource "petta" completed-child-opener "(: unquote (-> Atom %Undefined%)) (= (unquote (quote $x)) (eval $x)) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (unquote (quote (Box $d))) (Nested $r)))")
(ACTSource "petta" completed-child-eval "(: unquote (-> Atom %Undefined%)) (= (unquote (quote $x)) (eval $x)) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (eval (unquote (quote (Box $d)))) (Nested $r)))")
(ACTSource "petta" shared-pattern-activation "(= (qshared (quote $x) $x) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (qshared (quote (quote $d)) $d) reached))")
(ACTSource "petta" original-value-unmodified "(= (qshared (quote $x) $x) $x) " "(let $d (catch (Error origin (Forbidden reason))) (let $r (catch (qshared (quote (quote $d)) $d)) (Box $d)))")
(ACTSource "all" admitted-piece "" "(let $d (catch (Error origin (Forbidden reason))) (let $box (cons-atom Box ($d)) (let ($h $tail) (decons-atom $box) (Piece (car-atom $tail)))))")

; PeTTa's quote returns its payload; HE retains the wrapper. PeTTa's
; equation opener is declared explicitly rather than assumed from HE's prelude.
(= (act:source $language $name $prefix $source)
   (let $override (collapse
          (let (Source $scope $newPrefix $newSource)
               (match &self (ACTSource $scope $name $newPrefix $newSource)
                    (Source $scope $newPrefix $newSource))
            (if (or (== $scope "all") (== $scope $language))
                (Source $newPrefix $newSource) (superpose ()))))
     (if (== $override ()) (Source $prefix $source) (index-atom $override 0))))

(= (act:check $binary $language $route (ActivationCase $name $oldPrefix $oldSource $wanted))
   (let (Source $prefix $source) (act:source $language $name $oldPrefix $oldSource)
     (act:check-source $binary $language $route $name $prefix $source $wanted)))
(= (act:check-source $binary $language $route $name $prefix $source $wanted)
   (let* (($program (str:join "" ("!(ai:experiment failure-values) " $prefix "!" $source)))
          ($expected (if (== $language "he") (str:join "" ("[()]\n[" $wanted "]\n"))
                           (str:join "" ("()\n" $wanted "\n")))))
     (case (proc:run ("/usr/bin/env" $route $binary "--lang" $language "--profile" "ai" "-e" $program)
                     "." inherit 15000 1048576)
       (((proc:exited 0 $actual "")
          (if (== $actual $expected) 0
            (let $shown (println! (ActivationMismatch $language $route $name $expected $actual)) 1)))
        ($bad (let $shown (println! (ActivationExecutionFailed $language $route $name $bad)) 1))))))
(= (act:walk $binary $language $route $cases $index $bad)
   (if (== $index (size-atom $cases)) (ActivationResults $language $route $index $bad)
     (let $failure (act:check $binary $language $route (index-atom $cases $index))
       (act:walk $binary $language $route $cases (+ $index 1) (+ $bad $failure)))))
(= (act:run $binary $language $route)
   (let $cases (collapse (match &self (ACT $name $prefix $source $wanted)
                              (ActivationCase $name $prefix $source $wanted)))
     (act:walk $binary $language $route $cases 0 0)))
