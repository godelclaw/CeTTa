!(import! &self "./outcome_kernel_matrix.metta")
!(import! &self "./outcome_kernel_compiler.metta")
!(import! &self "./outcome_kernel_composed.metta")

(= (oksuite:host $binary $root $lang $route)
   (let* (($kernel (oktest:run $binary $root $lang $route))
          ($compiler (oc:run $binary $root $lang $route)))
     (if (and (== $kernel (OutcomeKernelPass $lang $route 70))
              (== $compiler (OutcomeCompilerResults $lang $route 15 0)))
       True (OutcomeKernelHostFailed $lang $route $kernel $compiler))))
(= (oksuite:family $binary $root $lang $first $second)
   (let* (($a (oksuite:host $binary $root $lang (Routes "CETTA_PREPARED_PURE_REFERENCE=0" $first)))
          ($b (oksuite:host $binary $root $lang (Routes "CETTA_PREPARED_PURE_REFERENCE=0" $second)))
          ($c (oksuite:host $binary $root $lang (Routes "CETTA_PREPARED_PURE_REFERENCE=1" $first)))
          ($d (oksuite:host $binary $root $lang (Routes "CETTA_PREPARED_PURE_REFERENCE=1" $second))))
     (and (and (== $a True) (== $b True)) (and (== $c True) (== $d True)))))
(= (oksuite:run $binary $root)
   (let* (($p (oksuite:family $binary $root "petta" "CETTA_PETTA_TRANSLATOR_EXPANSION=1" "CETTA_PETTA_TRANSLATOR_EXPANSION=0"))
          ($h (oksuite:family $binary $root "he" "CETTA_HE_CANONICAL_EXECUTION=1" "CETTA_HE_CANONICAL_EXECUTION=0"))
          ($c0 (oi:run $binary $root "CETTA_PREPARED_PURE_REFERENCE=0"))
          ($c1 (oi:run $binary $root "CETTA_PREPARED_PURE_REFERENCE=1")))
     (if (and (and (== $p True) (== $h True))
                   (and (== $c0 (ComposedResults "CETTA_PREPARED_PURE_REFERENCE=0" 12 0))
                        (== $c1 (ComposedResults "CETTA_PREPARED_PURE_REFERENCE=1" 12 0))))
       (OutcomeKernelSuitePass 560 120 24)
       (OutcomeKernelSuiteFailed $p $h $c0 $c1))))
