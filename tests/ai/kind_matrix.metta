; Independent context substitution tests. The predicted surface result comes
; from the observation contract, not from either evaluator's output.
!(import! &self (library proc))
!(import! &self (library str))
!(import! &self (library system))

(KMCase let "!(let $v " " never)" (View "" ""))
(KMCase let-star "!(let* (($v " ") ($later (superpose (1 2)))) never)" (View "" ""))
(KMCase if "!(if " " yes no)" (View "" ""))
(KMCase constructor "!(Box " ")" (View "" ""))
(KMCase constructor-first "!(Box " " (Error later (Fault secondary)))" (View "" ""))
(KMCase arithmetic-left "!(+ " " 1)" (View "" ""))
(KMCase arithmetic-right "!(+ 1 " ")" (View "" ""))
(KMCase comparison-left "!(== " " 1)" (View "" ""))
(KMCase comparison-right "!(== 1 " ")" (View "" ""))
(KMCase and "!(and False " ")" (View "" ""))
(KMCase or "!(or True " ")" (View "" ""))
(KMCase case-wildcard "!(case " " (($other hidden)))" (View "" ""))
(KMCase case-explicit "!(case " " (((Error $w $reason) caught) ($other hidden)))" (Literal "caught"))
(KMCase catch-data "!(let $v (catch " ") (Box $v))" (View "(Box " ")"))
(KMCase collected "!(collapse (superpose (" " 7)))" (View "(" " 7)"))
(KMCase holding "(: hold (-> Atom Atom)) (= (hold $v) $v) !(Box (hold " "))" (View "" ""))
(KMCase unification "!(unify " " (Error first $reason) yes no)" (Literal "yes"))
(KMCase receiver-refutation "!(let (Other $x) (Box " ") never)" (View "" ""))
(KMCase type-preflight "!(+ " " \"bad\")" (View "" ""))
(KMCase function-call "(= (consume $v) (Box $v)) !(consume " ")" (View "" ""))
(KMCase metta "!(metta " " %Undefined% &self)" (View "" ""))
(KMCase eval "!(eval " ")" (View "" ""))
(KMCase positive-binding "!(let $unused anchor (collapse (superpose (" " live))))" (View "(" " live)"))

(KMProp let)
(KMProp let-star)
(KMProp if)
(KMProp constructor)
(KMProp constructor-first)
(KMProp arithmetic-left)
(KMProp arithmetic-right)
(KMProp comparison-left)
(KMProp comparison-right)
(KMProp and)
(KMProp or)
(KMProp case-wildcard)
(KMProp receiver-refutation)
(KMProp type-preflight)
(KMProp metta)

(= (km:expect (View $before $after) $error)
   (str:join "" ($before $error $after)))
(= (km:expect (Literal $text) $error) $text)
(= (km:check $binary $language $route $kind $template)
   (let* (((Template $name $before $after $view) $template)
          ($error (str:join "" ("(Error first (" $kind " detail))")))
          ($program (str:join "" ("!(ai:experiment failure-values) " $before $error $after)))
          ($plain (km:expect $view $error))
          ($expected (if (== $language "he") (str:join "" ("[" $plain "]\n"))
                       (str:join "" ("()\n" $plain "\n"))))
          ($argv ("/usr/bin/env" $route $binary "--lang" $language "--profile" "ai" "-e" $program)))
     (case (proc:run $argv "." inherit 10000 1048576)
       (((proc:exited 0 $actual "")
          (if (== $actual $expected) ()
            (let $shown (println! (MatrixMismatch $language $route $kind $name $program $expected $actual))
              (system:exit 1))))
        ($other
          (let $shown (println! (MatrixExecutionFailed $language $route $kind $name $other))
            (system:exit 1)))))))
(= (km:walk $binary $language $route $kind $templates $count)
   (if (== $templates ()) $count
     (let* (($head (car-atom $templates)) ($tail (cdr-atom $templates))
            ($checked (km:check $binary $language $route $kind $head)))
       (km:walk $binary $language $route $kind $tail (+ $count 1)))))
(= (km:kinds $binary $language $route $kinds $templates $count)
   (if (== $kinds ()) (MatrixPass $language $route $count)
     (let* (($kind (car-atom $kinds)) ($tail (cdr-atom $kinds))
            ($next (km:walk $binary $language $route $kind $templates $count)))
       (km:kinds $binary $language $route $tail $templates $next))))
(= (km:run $binary $language $route)
   (let $templates (collapse (match &self (KMCase $name $before $after $view)
                                      (Template $name $before $after $view)))
     (if (== (size-atom $templates) 23)
       (km:kinds $binary $language $route
         ("Unsolvable" "Forbidden" "Incomplete" "Fault") $templates 0)
       (system:exit 2))))

; Each pair instantiates propagation_composes: the inner and outer contexts
; both propagate, so their composition preserves the original occurrence.
(= (km:compose (Template $outer $ob $oa $ov) (Template $inner $ib $ia $iv))
   (let* (($ib-code (str:byte-slice $ib 1 (str:codepoint-count $ib)))
          ($before (str:concat $ob $ib-code)) ($after (str:concat $ia $oa)))
     (Template (Nested $outer $inner) $before $after (View "" ""))))
(= (km:nested-each $binary $language $route $kind $outer $inners $count)
   (if (== $inners ()) $count
     (let* (($inner (car-atom $inners)) ($rest (cdr-atom $inners))
            ($composed (km:compose $outer $inner))
            ($checked (km:check $binary $language $route $kind $composed)))
       (km:nested-each $binary $language $route $kind $outer $rest (+ $count 1)))))
(= (km:nested-walk $binary $language $route $kind $outers $inners $count)
   (if (== $outers ()) $count
     (let* (($outer (car-atom $outers)) ($rest (cdr-atom $outers))
            ($next (km:nested-each $binary $language $route $kind $outer $inners $count)))
       (km:nested-walk $binary $language $route $kind $rest $inners $next))))
(= (km:nested-kinds $binary $language $route $kinds $templates $count)
   (if (== $kinds ()) (NestedMatrixPass $language $route $count)
     (let* (($kind (car-atom $kinds)) ($rest (cdr-atom $kinds))
            ($next (km:nested-walk $binary $language $route $kind $templates $templates $count)))
       (km:nested-kinds $binary $language $route $rest $templates $next))))
(= (km:nested $binary $language $route)
   (let $templates (collapse
       (let $name (match &self (KMProp $name) $name)
         (match &self (KMCase $name $before $after $view)
                      (Template $name $before $after $view))))
     (if (== (size-atom $templates) 15)
       (km:nested-kinds $binary $language $route
         ("Unsolvable" "Forbidden" "Incomplete" "Fault") $templates 0)
       (system:exit 2))))
