; No expansion may execute source or sever its variable co-occurrence.
!(import! &self (library proc))
!(import! &self (library str))
!(import! &self "./outcome_kernel_routes.metta")
(OCCase basic "!(outcome:define (cf $n) (outcome:bind (outcome:capture (+ $n 1)) $v (outcome:value (Box $v)))) !(outcome:payload (cf 5))" "true\n(Box 6)\n" "[()]\n[(Box 6)]\n")
(OCCase separate-variables "!(outcome:define (cf $a $b) (outcome:bind (outcome:capture (+ $a 1)) $v (outcome:value (Pair $v $b)))) !(outcome:payload (cf 3 9))" "true\n(Pair 4 9)\n" "[()]\n[(Pair 4 9)]\n")
(OCCase shared-variable "!(outcome:define (cf $a) (outcome:value (Pair $a $a))) !(outcome:payload (cf 8))" "true\n(Pair 8 8)\n" "[()]\n[(Pair 8 8)]\n")
(OCCase held-code "!(outcome:define (cf $a) (outcome:value (+ $a 1))) !(outcome:payload (cf 5))" "true\n(+ 5 1)\n" "[()]\n[(+ 5 1)]\n")
(OCCase plain-source "!(outcome:define (cf $a) (Box (+ $a 1))) !(cf 5)" "true\n(Box 6)\n" "[()]\n[(Box 6)]\n")
(OCCase nested-binds "!(outcome:define (cf $a $b) (outcome:bind (outcome:capture (+ $a 1)) $x (outcome:bind (outcome:capture (+ $b 2)) $y (outcome:capture (+ $x $y))))) !(outcome:payload (cf 3 5))" "true\n11\n" "[()]\n[11]\n")
(OCCase private-name-collision "!(outcome:define (cf $outcome:event $final-first) (outcome:bind (outcome:capture (+ $outcome:event 1)) $v (outcome:value (Pair $v $final-first)))) !(outcome:payload (cf 3 9))" "true\n(Pair 4 9)\n" "[()]\n[(Pair 4 9)]\n")
(OCCase error-data "!(outcome:define (cf $a) (outcome:bind (outcome:value (Error source (Fault $a))) $x (outcome:value (Box $x)))) !(outcome:payload (cf data))" "true\n(Box (Error source (Fault data)))\n" "[()]\n[(Box (Error source (Fault data)))]\n")
(OCCase earliest "!(outcome:define (cf $a) (outcome:bind (outcome:raise (Error first (Forbidden $a))) $x (outcome:raise (Error later (Fault wrong))))) !(outcome:payload (cf reason))" "true\n(Error first (Forbidden reason))\n" "[()]\n[(Error first (Forbidden reason))]\n")
(OCCase catch-before-bind "!(outcome:define (cf $a) (outcome:bind (outcome:catch (outcome:raise (Error source (Fault $a)))) $x (outcome:value (Box $x)))) !(outcome:payload (cf detail))" "true\n(Box (Error source (Fault detail)))\n" "[()]\n[(Box (Error source (Fault detail)))]\n")
(OCCase alternatives "!(outcome:define (cf $a) (outcome:collapse (outcome:choice ((outcome:value $a) (outcome:raise (Error source (Fault bad))))))) !(outcome:payload (cf 7))" "true\n(7 (Error source (Fault bad)))\n" "[()]\n[(7 (Error source (Fault bad)))]\n")
(OCCase set-observer "!(outcome:define (cf $a) (outcome:collapse (outcome:unique (outcome:choice ((outcome:raise (Error source (Fault bad))) (outcome:value $a) (outcome:raise (Error source (Fault bad)))))))) !(outcome:payload (cf 7))" "true\n((Error source (Fault bad)) 7)\n" "[()]\n[((Error source (Fault bad)) 7)]\n")
(OCCase no-verdict "!(outcome:define (cf $a) (outcome:if (outcome:value $a) (outcome:value yes) (outcome:value no))) !(outcome:kind (cf unknown))" "true\nincomplete\n" "[()]\n[incomplete]\n")
(OCCase compile-does-not-run "!(let $events (new-space) (let $defined (outcome:define (cf $target) (outcome:bind (outcome:capture (add-atom $target happened)) $unused (outcome:value done))) (let $before (collapse (match $events happened yes)) (let $got (outcome:payload (eval (cf $events))) (let $after (collapse (match $events happened yes)) (CompileEffects $before $got $after))))))" "(CompileEffects () done (yes))\n" "[(CompileEffects () done (yes))]\n")
(OCCase unused-branch-inert "!(let $events (new-space) (let $defined (outcome:define (cf $target) (outcome:if (outcome:value True) (outcome:value yes) (outcome:capture (add-atom $target wrong)))) (let $got (outcome:payload (eval (cf $events))) (let $after (collapse (match $events wrong found)) (LazyBranch $got $after)))))" "(LazyBranch yes ())\n" "[(LazyBranch yes ())]\n")

(= (oc:one $binary $root $lang $route $name $source $pe $he)
   (let* (($program (str:concat "!(ai:experiment outcome-kernel) !(import! &self (library outcome_compile)) " $source))
          ($expected (if (== $lang "he") (str:concat "[()]\n[()]\n" $he) (str:concat "()\ntrue\n" $pe)))
          ($reply (proc:run (okroute:argv $binary $lang $route $program)
                         $root inherit 10000 1048576)))
     (case $reply
       (((proc:exited 0 $out "")
          (if (== $out $expected) 0
            (let $shown (println! (OutcomeCompilerMismatch $lang $route $name $expected $out)) 1)))
        ($bad (let $shown (println! (OutcomeCompilerExecutionFailed $lang $route $name $bad)) 1))))))
(= (oc:walk $binary $root $lang $route $cases $count $bad)
   (if (== $cases ()) (OutcomeCompilerResults $lang $route $count $bad)
     (let* (((Case $name $source $pe $he) (car-atom $cases))
            ($failed (oc:one $binary $root $lang $route $name $source $pe $he)))
       (oc:walk $binary $root $lang $route (cdr-atom $cases) (+ $count 1) (+ $bad $failed)))))
(= (oc:run $binary $root $lang $route)
   (let $cases (collapse (match &self (OCCase $name $source $pe $he) (Case $name $source $pe $he)))
     (oc:walk $binary $root $lang $route $cases 0 0)))
