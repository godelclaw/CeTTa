; Byte comparisons use raw file reads, including NUL and malformed UTF-8.
; A fixed shell command supplies only descriptor redirection. CeTTa selects
; cases, launches both engines, checks statuses/bytes and records the result.
!(import! &self (library proc))
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library system))

(= (audit:redirect)
   "out=$1; err=$2; shift 2; exec \"$@\" >\"$out\" 2>\"$err\"")
(= (audit:environment $cache)
   (("PATH" "/usr/local/bin:/usr/bin:/bin") ("LANG" "C.UTF-8")
    ("LC_ALL" "C.UTF-8") ("TZ" "UTC")
    ("CETTA_GIT_MODULE_CACHE_DIR" $cache) ("GIT_CONFIG_NOSYSTEM" "1")
    ("GIT_TERMINAL_PROMPT" "0") ("GIT_SSH_COMMAND" "/bin/false")))
(= (audit:raw $path)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $bytes) (ReadOk $bytes)) ($other (ReadFailed $path $other)))))
(= (audit:arguments $binary $language $profile $file)
   (if (or (== $profile "ai-inline") (== $profile "ai-declared"))
     (case (audit:raw $file)
       (((ReadOk $source)
          (let $code (if (== $profile "ai-declared")
                      (str:concat "!(cetta_audit_begin_e37a1e29) !(ai:experiment failure-values) !(cetta_audit_end_e37a1e29)\n" $source) $source)
            ($binary "--lang" $language "--profile" "ai" "-e" $code $file)))
        ($bad (let $shown (println! $bad) (system:exit 2)))))
     (if (== $profile "default") ($binary "--lang" $language $file)
       ($binary "--lang" $language "--profile" $profile $file))))
(= (audit:normalise $profile $bytes)
   (if (== $profile "ai-declared")
     (let $parts (str:split "(cetta_audit_begin_e37a1e29)\n()\n(cetta_audit_end_e37a1e29)\n" $bytes)
       (if (== (size-atom $parts) 2) (ReadOk (str:join "" $parts))
         (DeclarationReceiptMissing (str:sha256 $bytes) (str:byte-length $bytes))))
     (ReadOk $bytes)))
(= (audit:launch $binary $language $profile $file $cwd $cache $out $err)
   (let* (($script (audit:redirect))
          ($arguments (audit:arguments $binary $language $profile $file))
          ($argv (union-atom ("/bin/sh" "-c" $script "cetta-audit" $out $err)
                   $arguments))
          ($env (audit:environment $cache)))
     (proc:run $argv $cwd $env 15000 4096)))
(= (audit:one $baseline $candidate $language $base-profile $candidate-profile $file $cwd $cache $dir $index)
   (function
     (let* (($stem (str:join "" ($dir "/" (repr $index))))
            ($bo (str:concat $stem ".base.out")) ($be (str:concat $stem ".base.err"))
            ($co (str:concat $stem ".candidate.out")) ($ce (str:concat $stem ".candidate.err"))
            ($left (audit:launch $baseline $language $base-profile $file $cwd $cache $bo $be))
            ($right (audit:launch $candidate $language $candidate-profile $file $cwd $cache $co $ce)))
       (case ($left $right)
         ((((proc:exited $bc "" "") (proc:exited $cc "" ""))
            (case ((audit:raw $bo) (audit:raw $be) (audit:raw $co) (audit:raw $ce))
              ((((ReadOk $bout) (ReadOk $berr) (ReadOk $cout) (ReadOk $cerr))
                 (case ((audit:normalise $base-profile $bout)
                        (audit:normalise $candidate-profile $cout))
                   ((((ReadOk $b) (ReadOk $c))
                      (let $row (if (and (== $bc $cc) (and (== $b $c) (== $berr $cerr)))
                        (AuditSame $index $file $bc)
                        (AuditChanged $index $file $bc $cc))
                        (return $row)))
                    ($other (return (AuditUnqualified $index $file $other))))))
               ($other (return (AuditUnqualified $index $file $other))))))
          ($other (return (AuditUnqualified $index $file $other))))))))
(= (audit:nonempty $lines)
   (if (== $lines ()) ()
     (let* (($head (str:trim (car-atom $lines))) ($tail (cdr-atom $lines))
            ($rest (audit:nonempty $tail)))
       (if (== $head "") $rest (cons-atom $head $rest)))))
(= (audit:walk $baseline $candidate $language $base-profile $candidate-profile $files $cwd $cache $dir $index $same $changed $failed)
   (if (== $files ()) (AuditSummary $language $base-profile $candidate-profile $index $same $changed $failed)
     (let* (($file (car-atom $files)) ($rest (cdr-atom $files))
            ($row (audit:one $baseline $candidate $language $base-profile $candidate-profile $file $cwd $cache $dir $index))
            ($shown (println! $row)))
       (case $row
         (((AuditSame $at $path $code)
            (audit:walk $baseline $candidate $language $base-profile $candidate-profile $rest $cwd $cache $dir (+ $index 1) (+ $same 1) $changed $failed))
          ((AuditChanged $at $path $bc $cc)
            (audit:walk $baseline $candidate $language $base-profile $candidate-profile $rest $cwd $cache $dir (+ $index 1) $same (+ $changed 1) $failed))
          ($other
            (audit:walk $baseline $candidate $language $base-profile $candidate-profile $rest $cwd $cache $dir (+ $index 1) $same $changed (+ $failed 1))))))))
(= (audit:run $baseline $candidate $language $base-profile $candidate-profile $manifest $cwd $cache $dir)
   (case (audit:raw $manifest)
     (((ReadOk $text)
       (let $files (audit:nonempty (str:split "\n" $text))
         (if (== $files ()) (system:exit 2)
           (audit:walk $baseline $candidate $language $base-profile $candidate-profile $files $cwd $cache $dir 0 0 0 0))))
      ($other (system:exit 2)))))

(= (audit:stable $baseline $candidate $language $profile $manifest $cwd $cache $dir)
   (let $summary (audit:run $baseline $candidate $language $profile $profile $manifest $cwd $cache $dir)
     (case $summary
       (((AuditSummary $lang $base $next $total $same 0 0)
          (if (and (> $total 0) (== $total $same))
            (ByteIdentical $lang $base $total)
            (system:exit 1)))
        ($other (let $shown (println! (StableAuditFailed $other)) (system:exit 1)))))))
