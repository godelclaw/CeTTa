; Prepare a private instrumented evaluator from exact source bytes. This
; overlay does not enter a production binary or supply runtime authority.
!(import! &self "./mutations.metta")

(PAEntry "void result_set_add(" "atom" "CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "void outcome_set_add(" "atom" "CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "static void outcome_set_add_unfactored(" "atom" "CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "bool outcome_set_add_move(" "atom" "CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "static void outcome_set_add_existing(" "outcome_preview_atom(src)" "src->result_form")
(PAEntry "static void outcome_set_add_existing_move(" "outcome_preview_atom(src)" "src->result_form")
(PAEntry "static void outcome_set_add_existing_with_env(" "outcome_preview_atom(src)" "src->result_form")
(PAEntry "static void outcome_set_add_with_variant(" "atom" "CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "static bool outcome_set_add_promoted_existing(" "outcome_preview_atom(src)" "src ? src->result_form : CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "static void outcome_set_add_prefixed(Arena *a, OutcomeSet *os, Atom *atom,\n                                     const Bindings *local_env," "atom" "CETTA_CALL_RESULT_COMPLETED_VALUE")
(PAEntry "static void outcome_set_add_prefixed_outcome(" "outcome_preview_atom(src)" "src->result_form")
(PAEntry "static void ai_add_failure(" "error" "CETTA_CALL_RESULT_RAISED")
(PAEntry "static void ai_publish_prefixed_error(" "error" "CETTA_CALL_RESULT_RAISED")

(= (pa:entries $source $entries)
   (if (== $entries ()) $source
     (let* (((Entry $signature $value $form) (car-atom $entries))
            ($parts (str:split $signature $source)))
       (if (> (size-atom $parts) 1)
            (let* (($after (index-atom $parts (- (size-atom $parts) 1)))
                   ($parameters (car-atom (str:split "{" $after)))
                   ($anchor (str:join "" ($signature $parameters "{")))
                   ($injected (str:join "" ($anchor " AI_AUDIT_ENTRY(" $value ", " $form ");")))
                   ($changed (if (== (size-atom (str:split ";" $parameters)) 1)
                               (am:replace $source $anchor $injected 1)
                               (am:fail (AuditLastDeclarationIsNotDefinition $signature)))))
              (pa:entries $changed (cdr-atom $entries)))
          (am:fail (AuditEntryMissing $signature))))))

(= (pa:insert $original $source $needle $payload $name)
   (case (str:split $needle $original)
     ((($before $after)
        (let* (($line (size-atom (str:split "\n" $before)))
               ($replacement (str:join "" ("#line 1 \"" $name "\"\n" $payload
                  "\n#line " (repr $line) " \"src/eval.c\"\n" $needle))))
          (am:replace $source $needle $replacement 1)))
      ($other (am:fail (AuditAnchorNotUnique $needle (size-atom $other)))))))
(= (pa:prepare $root $dev $dir)
   (let* (($made (fs:make-directories $dir 511))
          ($original (am:read (str:concat $root "/src/eval.c")))
          ($prelude (am:read (str:concat $root "/tests/ai/publication_audit.h")))
          ($a (pa:insert $original $original "static bool eval_failure_values(void);"
                $prelude "tests/ai/publication_audit.h"))
          ($entries (collapse (match &self (PAEntry $signature $value $form) (Entry $signature $value $form))))
          ($b (pa:entries $a $entries))
          ($c (am:replace $b "    CettaCount ai_published_start = ai_published_target->len;"
                "    AI_AUDIT_RECORD(ai_published_error, CETTA_CALL_RESULT_RAISED); CettaCount ai_published_start = ai_published_target->len;" 1))
          ($written (am:write (str:concat $dir "/eval.c") $c))
          ($canonical (am:write (str:concat $dir "/eval_he_canonical.inc")
                         (am:read (str:concat $root "/src/eval_he_canonical.inc"))))
          ($boundary (am:write (str:concat $dir "/eval_he_boundary.inc")
                         (am:read (str:concat $root "/src/eval_he_boundary.inc"))))
          ($bindings (am:write (str:concat $dir "/eval_ai_bindings.inc")
                         (am:read (str:concat $root "/src/eval_ai_bindings.inc"))))
          ($response (am:compile-response $dev $dir "eval" "eval.c" "eval.o"))
          ($link-source (am:read (str:concat $dev "/link.rsp")))
          ($link-a (am:replace $link-source (str:concat $dev "/eval.o") (str:concat $dir "/eval.o") 1))
          ($link-b (am:replace $link-a (str:concat $dev "/cetta") (str:concat $dir "/cetta") 1))
          ($link-written (am:write (str:concat $dir "/link.rsp") $link-b)))
     (PublicationAuditPrepared (size-atom $entries) (str:sha256 $original) (str:sha256 $c))))

; Counts are publication entries, not answer occurrences or committed work.
(= (pa:count $rows $index $raised $data $expression $unknown $offsets)
   (if (== $index (size-atom $rows))
     (AuditCounts $raised $data $expression $unknown (unique-atom $offsets))
     (let $row (index-atom $rows $index)
       (if (== $row "") (pa:count $rows (+ $index 1) $raised $data $expression $unknown $offsets)
         (case (str:split "\t" $row)
           ((($file $line $function $host "raised" $offset)
              (pa:count $rows (+ $index 1) (+ $raised 1) $data $expression $unknown $offsets))
            (($file $line $function $host "data" $offset)
              (pa:count $rows (+ $index 1) $raised (+ $data 1) $expression $unknown $offsets))
            (($file $line $function $host "expression" $offset)
              (pa:count $rows (+ $index 1) $raised $data (+ $expression 1) $unknown $offsets))
            (($file $line $function $host "unclassified" $offset)
              (pa:count $rows (+ $index 1) $raised $data $expression (+ $unknown 1) (cons-atom $offset $offsets)))
            ($bad (am:fail (InvalidAuditRow $bad)))))))))
(= (pa:summarise $path $binary)
   (let* (($rows (str:split "\n" (am:read $path)))
          ($sites (unique-atom $rows))
          ($saved (am:write (str:concat $path ".sites") (str:join "\n" $sites)))
          ((AuditCounts $raised $data $expression $unknown $offsets) (pa:count $rows 0 0 0 0 0 ()))
          ($shown (println! (PublicationAuditSummary (+ $raised (+ $data (+ $expression $unknown)))
                     (- (size-atom $sites) 1) $raised $data $expression $unknown))))
     (if (== $offsets ()) (PublicationAuditNoUnclassifiedEntries)
       (proc:run (union-atom ("/usr/bin/addr2line" "-f" "-p" "-a" "-e" $binary) $offsets)
                 "." inherit 15000 262144))))
