!(ai:experiment failure-values)
; Producer provenance survives rebinding and aggregate control. Only an
; explicit observer converts the raised occurrence into ordinary data.
(= (ar:fail) (Error src (Forbidden refused)))
(= (ar:true $value) True)
(= (ar:bad $value) (Error predicate (Fault broken)))
!(let $v (cons-atom Error (a (Fault b))) (let $u $v (Box $u)))
!(get-state (ar:fail))
!(collapse (let $x (hyperpose ((ar:fail) 1)) (Box $x)))
!(collapse (forall (superpose (1 (ar:fail))) ar:true))
!(forall (superpose (1 2)) ar:bad)
!(forall (superpose (1 2)) ar:true)
!(let $data (catch (ar:fail))
   (collapse (let $x (hyperpose ($data 1)) (Box $x))))
!(collapse (hyperpose ((ar:fail) (ar:fail))))
!(bind! &ai-review (new-space))
!(let $failed (forall (superpose (1 2)) ar:bad)
   (add-atom &ai-review later-effect))
!(collapse (match &ai-review later-effect reached))
(= (ar:add $a $b) (+ $a $b))
!(foldall ar:add (superpose ((ar:fail))) 10)
!(foldall ar:add (superpose (1 (ar:fail) 3)) 0)
!(let $c (collapse (superpose (1 (ar:fail) 3))) (Pair (length $c) (size-atom $c)))
!(collapse (superpose ($x $y)))
; The atom-only directive cannot export the machine's pending solver owner.
!(collapse (let $_ (translatePredicate (dif $x 1)) (Box $x)))
(: ARList (-> Type Type))
(: ARNil (ARList $a))
(: ARCons (-> $a (ARList $a) (ARList $a)))
(: ar:len (-> (ARList $a) Number))
(= (ar:len ARNil) 0)
(= (ar:len (ARCons $x $xs)) (+ 1 (ar:len $xs)))
!(collapse (ar:len (ARCons 1 (ARCons "x" ARNil))))
(= (ar:two) (a b))
!(let (cons $h $t) (ar:two) ($h $t))
!(collapse (let* (((cons $h $t) (superpose ((a b) (c d))))) ($h $t)))
!(let $code (quote (+ 1 2)) (reduce $code))
!(collapse (unique (superpose ((ar:fail) (ar:fail)))))
!(collapse (unique (superpose ((ar:fail) (Error elsewhere (Forbidden refused)) (Error src (Fault refused))))))
!(collapse (intersection (superpose (1 (ar:fail) 2)) (superpose (2 1))))
!(collapse (subtraction (superpose ((ar:fail) 1)) (superpose ((ar:fail)))))
!((Error operator (Forbidden stopped)) (unique (superpose (1 2))))
!(let $value (unique (superpose (1))) (Error consumer (Fault broken)))
; A user's alternative is visible at the root as well as under a binding.
(= (collapse $source) (MyCollection $source))
!(collapse 1)
!(let $value (collapse 1) (R $value))
