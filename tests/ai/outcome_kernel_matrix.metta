; Each case predicts one observable result in both dialect hosts. The
; driver checks exit status, stderr and full output, never only a substring.
!(import! &self (library proc))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self "./outcome_kernel_routes.metta")

(OKCase value "!(outcome:kind (outcome:value 3))" "value")
(OKCase error-data "!(outcome:kind (outcome:value (Error data (Fault ordinary))))" "value")
(OKCase raised "!(outcome:kind (outcome:raise (Error first (Forbidden detail))))" "raised")
(OKCase incomplete "!(outcome:kind (outcome:incomplete (Error cut (Incomplete budget))))" "incomplete")
(OKCase forged "!(outcome:kind (NativeHandle outcome-kernel-event 1))" "data")
(OKCase captured-value "!(outcome:payload (outcome:capture (+ 1 2)))" "3")
(OKCase captured-fault "!(outcome:kind (outcome:capture (/ 1 0)))" "raised")
(OKCase local-cut "!(outcome:kind (outcome:budget (+ 1 2) 0))" "incomplete")
(OKCase zero "!(collapse (outcome:capture (superpose ())))" "()")
(OKCase unit "!(outcome:payload (outcome:capture ()))" "()")
(OKCase bound-source "!(let $x 7 (outcome:payload (outcome:capture (+ $x 1))))" "8")
(OKCase prepared-fault "(= (divide $n $d) (/ (+ $n 1) $d)) !(outcome:kind (outcome:capture (divide 5 0)))" "raised")
(OKCase native-invoke "!(outcome:payload (outcome:invoke + ((outcome:value 2) (outcome:value 3))))" "5")
(OKCase nested-envelope "!(let $event (outcome:value 8) (outcome:kind (outcome:payload (outcome:value $event))))" "value")
(OKCase serialized-envelope "!(let $event (outcome:value 8) (outcome:kind (parse (repr $event))))" "data")
(OKCase bind-value "!(outcome:payload (outcome:bind (outcome:capture (+ 1 2)) $v (outcome:value (Box $v))))" "(Box 3)")
(OKCase bind-error-data "!(outcome:payload (outcome:bind (outcome:value (Error data (Fault ordinary))) $v (outcome:value (Box $v))))" "(Box (Error data (Fault ordinary)))")
(OKCase earliest "!(outcome:payload (outcome:bind (outcome:raise (Error first (Forbidden detail))) $v (outcome:raise (Error later (Fault bad)))))" "(Error first (Forbidden detail))")
(OKCase bind-cut "!(outcome:kind (outcome:bind (outcome:budget (+ 1 2) 0) $v (outcome:value hidden)))" "incomplete")
(OKCase bind-zero "!(collapse (outcome:bind (outcome:capture (superpose ())) $v (outcome:value hidden)))" "()")
(OKCase choice "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:value 7)))))" "((Error first (Forbidden detail)) 7)")
(OKCase branch-local "!(outcome:payload (outcome:collapse (outcome:bind (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:value 7))) $v (outcome:value (Box $v)))))" "((Error first (Forbidden detail)) (Box 7))")
(OKCase observe-kind "!(outcome:kind (outcome:catch (outcome:raise (Error first (Forbidden detail)))))" "value")
(OKCase catch-before-bind "!(outcome:payload (outcome:bind (outcome:catch (outcome:raise (Error first (Forbidden detail)))) $v (outcome:raise (Error later (Fault bad)))))" "(Error later (Fault bad))")
(OKCase duplicate-occurrences "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:raise (Error first (Forbidden detail)))))))" "((Error first (Forbidden detail)) (Error first (Forbidden detail)))")
(OKCase unique-observation "!(outcome:payload (outcome:collapse (outcome:unique (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:value 1) (outcome:raise (Error first (Forbidden detail))))))))" "((Error first (Forbidden detail)) 1)")
(OKCase intersection-observation "!(outcome:payload (outcome:intersection (outcome:raise (Error first (Forbidden detail))) (outcome:raise (Error first (Forbidden detail)))))" "(Error first (Forbidden detail))")
(OKCase subtraction-observation "!(collapse (outcome:subtraction (outcome:raise (Error first (Forbidden detail))) (outcome:raise (Error first (Forbidden detail)))))" "()")
(OKCase condition-true "!(outcome:payload (outcome:if (outcome:value True) (outcome:value yes) (outcome:raise (Error wrong (Fault branch)))))" "yes")
(OKCase condition-false "!(outcome:payload (outcome:if (outcome:value False) (outcome:raise (Error wrong (Fault branch))) (outcome:value no)))" "no")
(OKCase condition-no-verdict "!(outcome:kind (outcome:if (outcome:value unknown) (outcome:value yes) (outcome:value no)))" "incomplete")
(OKCase condition-raised "!(outcome:kind (outcome:if (outcome:raise (Error first (Forbidden detail))) (outcome:value yes) (outcome:value no)))" "raised")
(OKCase empty-scope "(: Empty (-> Atom ScopedObservation)) !(outcome:payload (outcome:value (Empty scope)))" "(Empty scope)")
(OKCase partial-cut "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:value 7) (outcome:incomplete (Error cut (Incomplete budget)))))))" "(7 (Error cut (Incomplete budget)))")
(OKCase native-fault "!(outcome:kind (outcome:invoke / ((outcome:value 1) (outcome:value 0))))" "raised")
(OKCase native-pending-completion "!(outcome:kind (outcome:invoke index-atom ((outcome:value ((Error data reason))) (outcome:value 0))))" "incomplete")
(OKCase native-report-vocabulary "!(outcome:failure-kind (outcome:capture (/ 1 0)))" "Fault")
(OKCase data-has-no-failure-kind "!(outcome:failure-kind (outcome:value (Error data (Forbidden inert))))" "NotFailure")
(OKCase report-is-data "!(outcome:kind (outcome:report (outcome:capture (/ 1 0))))" "value")
(OKCase four-Unsolvable-kind "!(outcome:failure-kind (outcome:raise (Error first (Unsolvable detail))))" "Unsolvable")
(OKCase four-Unsolvable-bind "!(outcome:failure-kind (outcome:bind (outcome:raise (Error first (Unsolvable detail))) $x (outcome:value hidden)))" "Unsolvable")
(OKCase four-Unsolvable-catch "!(outcome:payload (outcome:catch (outcome:raise (Error first (Unsolvable detail)))))" "(Error first (Unsolvable detail))")
(OKCase four-Unsolvable-report "!(outcome:payload (outcome:report (outcome:raise (Error first (Unsolvable detail)))))" "(Error first (Unsolvable detail))")
(OKCase four-Unsolvable-duplicates "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Unsolvable detail))) (outcome:raise (Error first (Unsolvable detail)))))))" "((Error first (Unsolvable detail)) (Error first (Unsolvable detail)))")
(OKCase four-Unsolvable-data "!(outcome:failure-kind (outcome:value (Error first (Unsolvable detail))))" "NotFailure")
(OKCase four-Forbidden-kind "!(outcome:failure-kind (outcome:raise (Error first (Forbidden detail))))" "Forbidden")
(OKCase four-Forbidden-bind "!(outcome:failure-kind (outcome:bind (outcome:raise (Error first (Forbidden detail))) $x (outcome:value hidden)))" "Forbidden")
(OKCase four-Forbidden-catch "!(outcome:payload (outcome:catch (outcome:raise (Error first (Forbidden detail)))))" "(Error first (Forbidden detail))")
(OKCase four-Forbidden-report "!(outcome:payload (outcome:report (outcome:raise (Error first (Forbidden detail)))))" "(Error first (Forbidden detail))")
(OKCase four-Forbidden-duplicates "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:raise (Error first (Forbidden detail)))))))" "((Error first (Forbidden detail)) (Error first (Forbidden detail)))")
(OKCase four-Forbidden-data "!(outcome:failure-kind (outcome:value (Error first (Forbidden detail))))" "NotFailure")
(OKCase four-Incomplete-kind "!(outcome:failure-kind (outcome:raise (Error first (Incomplete detail))))" "Incomplete")
(OKCase four-Incomplete-bind "!(outcome:failure-kind (outcome:bind (outcome:raise (Error first (Incomplete detail))) $x (outcome:value hidden)))" "Incomplete")
(OKCase four-Incomplete-catch "!(outcome:payload (outcome:catch (outcome:raise (Error first (Incomplete detail)))))" "(Error first (Incomplete detail))")
(OKCase four-Incomplete-report "!(outcome:payload (outcome:report (outcome:raise (Error first (Incomplete detail)))))" "(Error first (Incomplete detail))")
(OKCase four-Incomplete-duplicates "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Incomplete detail))) (outcome:raise (Error first (Incomplete detail)))))))" "((Error first (Incomplete detail)) (Error first (Incomplete detail)))")
(OKCase four-Incomplete-data "!(outcome:failure-kind (outcome:value (Error first (Incomplete detail))))" "NotFailure")
(OKCase four-Fault-kind "!(outcome:failure-kind (outcome:raise (Error first (Fault detail))))" "Fault")
(OKCase four-Fault-bind "!(outcome:failure-kind (outcome:bind (outcome:raise (Error first (Fault detail))) $x (outcome:value hidden)))" "Fault")
(OKCase four-Fault-catch "!(outcome:payload (outcome:catch (outcome:raise (Error first (Fault detail)))))" "(Error first (Fault detail))")
(OKCase four-Fault-report "!(outcome:payload (outcome:report (outcome:raise (Error first (Fault detail)))))" "(Error first (Fault detail))")
(OKCase four-Fault-duplicates "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Fault detail))) (outcome:raise (Error first (Fault detail)))))))" "((Error first (Fault detail)) (Error first (Fault detail)))")
(OKCase four-Fault-data "!(outcome:failure-kind (outcome:value (Error first (Fault detail))))" "NotFailure")
(OKCase genuine-partial-budget "(= (forever $x) (forever $x)) !(collapse (outcome:kind (outcome:budget (superpose (1 (forever 0))) 64)))" "(value incomplete)")
(OKCase nested-channel-is-data "!(outcome:kind (outcome:capture (outcome:raise (Error first (Forbidden detail)))))" "value")
(OKCase nested-native-handler "!(outcome:kind (outcome:payload (outcome:capture (outcome:invoke / ((outcome:value 1) (outcome:value 0))))))" "raised")
(OKCase malformed-event-source "!(outcome:failure-kind (outcome:bind 3 $v (outcome:value hidden)))" "Unsolvable")
(OKCase forged-event-source "!(outcome:kind (outcome:bind (NativeHandle outcome-kernel-event 1) $v (outcome:value hidden)))" "raised")
(OKCase unselected-native-fault "(= (safe $x) (if (== $x 0) (/ 1 0) 7)) !(outcome:payload (outcome:capture (safe 1)))" "7")
(OKCase capture-quotation "!(outcome:payload (outcome:capture (quote (+ 1 2))))" (HostAnswer "(+ 1 2)" "(quote (+ 1 2))"))

(= (oktest:fail $problem)
   (let $shown (println! $problem) (system:exit 1)))
(= (oktest:answer $language $offered)
   (case $offered (((HostAnswer $pe $he) (if (== $language "he") $he $pe)) ($single $single))))
(= (oktest:one $binary $root $language $route $name $source $answer)
   (let* (($wanted (oktest:answer $language $answer))
          ($program (str:join "" ("!(ai:experiment outcome-kernel) !(import! &self "
                    (repr (str:concat $root (if (== $language "petta")
                              "/lib/petta/outcome_kernel.metta" "/lib/outcome_kernel.metta"))) ") " $source)))
          ($expected (if (== $language "he")
                      (str:join "" ("[()]\n[()]\n[" $wanted "]\n"))
                      (str:join "" ("()\ntrue\n" $wanted "\n"))))
          ($reply (proc:run (okroute:argv $binary $language $route $program)
                    $root inherit 10000 1048576)))
     (case $reply
       (((proc:exited 0 $actual "")
          (if (== $expected $actual) ()
            (oktest:fail (OutcomeKernelMismatch $language $route $name $expected $actual))))
        ($bad (oktest:fail (OutcomeKernelExecutionFailed $language $route $name $bad)))))))
(= (oktest:walk $binary $root $language $route $cases $count)
   (if (== $cases ()) (OutcomeKernelPass $language $route $count)
     (let* (((Case $name $source $answer) (car-atom $cases))
            ($checked (oktest:one $binary $root $language $route $name $source $answer)))
       (oktest:walk $binary $root $language $route (cdr-atom $cases) (+ $count 1)))))
(= (oktest:run $binary $root $language $route)
   (let $cases (collapse (match &self (OKCase $name $source $answer) (Case $name $source $answer)))
     (oktest:walk $binary $root $language $route $cases 0)))
