; Compare the scratch AI provider-preparation slice with its exact committed
; reference. Both sides prepare data; neither invokes a provider transport.
!(import! &self (library proc))
!(import! &self (library str))
!(import! &self (library system))

(APCase plain "responses" 100 "default" "hello" "5m")
(APCase anthropic "anthropic" "128" "high" "hello" "1h")
(APCase bad-tokens "responses" "bad" "default" "hello" "5m")
(APCase bad-ttl "anthropic" 100 "default" "hello" "invalid")
(APCase bad-frame "responses" 100 "default" "{\"kind\":\"role-context-v1\",\"messages\":[]}" "5m")
(APCase first-failure "anthropic" "bad" "default" "{\"kind\":\"role-context-v1\",\"messages\":[]}" "invalid")
(APCase ignored-ttl "responses" 100 "default" "hello" "invalid")
(APCase boolean-budget "responses" False "default" "hello" "5m")
(APCase negative-budget "responses" -1 "default" "hello" "5m")
(APCase unicode "anthropic" 64 "default" "∀日本語 🌱 (Error text (Fault inert))" "5m")
(APCase cached "responses" 64 "default" "instructions_cache_boundary_evidence_cache_boundary_request" "5m")
(APCase roles "responses" 96 "default" "{\"kind\":\"role-context-v1\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}],\"cache_points\":[]}" "5m")

(= (ap:fail $problem) (let $shown (println! $problem) (system:exit 1)))
(= (ap:environment)
   (("PATH" "/usr/local/bin:/usr/bin:/bin") ("LANG" "C.UTF-8")
    ("LC_ALL" "C.UTF-8") ("TZ" "UTC")))
(= (ap:arguments (Input $name $protocol $tokens $effort $prompt $ttl))
   (str:join " " ((repr $protocol) "\"fixture-model\"" (repr $tokens)
                    (repr $effort) (repr $prompt) "JsonNull" (repr $ttl))))
(= (ap:expression $row $ai)
   (let $arguments (ap:arguments $row)
     (if $ai
       (str:join "" ("(aipr:legacy-view (catch (aipr:prepare-command " $arguments ")))"))
       (str:join "" ("(preq:prepare-command " $arguments ")")))))
(= (ap:program $snapshot $row $ai)
   (let* (($module (str:join "" ($snapshot "/src/"
                     (if $ai "provider_request_ai.metta" "provider_request_cetta.metta"))))
          ($expression (ap:expression $row $ai)))
     (str:join "" ((if $ai "!(ai:experiment failure-values) " "")
                     "!(import! &self " (repr $module) ") !" $expression))))
(= (ap:one $binary $snapshot $row $ai $cwd)
   (let* (($profile (if $ai "ai" "extended")) ($program (ap:program $snapshot $row $ai)))
     (case (proc:run ($binary "--lang" "petta" "--profile" $profile "-e" $program)
              $cwd (ap:environment) 15000 4194304)
       (((proc:exited 0 $out "")
          (if $ai (str:byte-slice $out 3 (str:byte-length $out)) $out))
        ($bad (ap:fail (ConsumerExecutionFailed $profile $row $bad)))))))
(= (ap:walk $binary $snapshot $rows $cwd $count)
   (if (== $rows ()) (ConsumerComparisonPass $count)
     (let* (($row (car-atom $rows)) ($rest (cdr-atom $rows))
            ($old (ap:one $binary $snapshot $row False $cwd))
            ($new (ap:one $binary $snapshot $row True $cwd)))
       (if (== $old $new)
         (ap:walk $binary $snapshot $rest $cwd (+ $count 1))
         (ap:fail (ConsumerMismatch $row $old $new))))))
(= (ap:run $binary $snapshot $cwd)
   (let $rows (collapse (match &self (APCase $name $protocol $tokens $effort $prompt $ttl)
                                (Input $name $protocol $tokens $effort $prompt $ttl)))
     (if (== (size-atom $rows) 12) (ap:walk $binary $snapshot $rows $cwd 0)
       (ap:fail (ConsumerCaseCount (size-atom $rows))))))

; Compare repeated request preparation after imports and one warmup. The
; measured AI path includes its explicit observer and compatibility adapter.
(= (ap:last $items)
   (if (== (cdr-atom $items) ()) (car-atom $items) (ap:last (cdr-atom $items))))
(= (ap:timed-code $snapshot $row $ai $repetitions)
   (let* (($expression (ap:expression $row $ai))
          ($module (str:join "" ($snapshot "/src/"
                     (if $ai "provider_request_ai.metta" "provider_request_cetta.metta")))))
     (str:join "" ((if $ai "!(ai:experiment failure-values) " "")
       "!(import! &self (library system)) !(import! &self " (repr $module) ") "
       "(= (ap:step) " $expression ") "
       "(= (ap:repeat $left $last) (if (== $left 0) $last (let $next (ap:step) "
       "(ap:repeat (- $left 1) $next)))) "
       "!(let $warm (ap:step) (let $start (system:monotonic-ns) "
       "(let $last (ap:repeat " (repr $repetitions) " $warm) "
       "(let $elapsed (- (system:monotonic-ns) $start) "
       "(PreparationMeasurement (str:sha256 (repr $last)) $elapsed)))))"))))
(= (ap:timed-one $binary $snapshot $row $ai $repetitions $cwd)
   (let* (($profile (if $ai "ai" "extended"))
          ($code (ap:timed-code $snapshot $row $ai $repetitions)))
     (case (proc:run ($binary "--lang" "petta" "--profile" $profile "-e" $code)
              $cwd (ap:environment) 60000 1048576)
       (((proc:exited 0 $output "")
          (case (parse (ap:last (str:split "\n" (str:trim $output))))
            (((PreparationMeasurement $hash $ns)
               (if (> $ns 0) (PreparationMeasurement $hash $ns)
                 (ap:fail (InvalidConsumerDuration $ns))))
             ($bad (ap:fail (InvalidConsumerMeasurement $bad))))))
        ($bad (ap:fail (TimedConsumerFailed $row $ai $bad)))))))
(= (ap:time-pair $binary $snapshot $row $repetitions $cwd $reference-first)
   (let* (((PreparationMeasurement $fh $fn)
             (ap:timed-one $binary $snapshot $row (not $reference-first) $repetitions $cwd))
          ((PreparationMeasurement $sh $sn)
             (ap:timed-one $binary $snapshot $row $reference-first $repetitions $cwd)))
     (if (== $fh $sh)
       (if $reference-first (PreparationSample $fn $sn) (PreparationSample $sn $fn))
       (ap:fail (TimedConsumerValueMismatch $row $fh $sh)))))
(= (ap:time-walk $binary $snapshot $row $repetitions $cwd $remaining $first $base $candidate)
   (if (== $remaining 0)
     (let* (($bs (msort $base)) ($cs (msort $candidate))
            ($bm (index-atom $bs 4)) ($cm (index-atom $cs 4)))
       (ConsumerTimingSummary $repetitions 9 $bm $cm
         (index-atom $bs 8) (index-atom $cs 8) (/ (* 1.0 $cm) $bm)))
     (let* (((PreparationSample $bn $cn)
              (ap:time-pair $binary $snapshot $row $repetitions $cwd $first))
            ($shown (println! (PreparationSample $remaining $bn $cn))))
       (ap:time-walk $binary $snapshot $row $repetitions $cwd (- $remaining 1) (not $first)
         (cons-atom $bn $base) (cons-atom $cn $candidate)))))
(= (ap:time $binary $snapshot $row $repetitions $cwd)
   (ap:time-walk $binary $snapshot $row $repetitions $cwd 9 True () ()))
