!(ai:experiment outcome-kernel)
!(import! &self (library outcome_kernel))
!(import! &self (library lib_memo))
(= (ok-cache-square $x) (* $x $x))
!(memoize ok-cache-square)
!(outcome:payload (outcome:capture (ok-cache-square 9)))
!(outcome:payload (outcome:capture (ok-cache-square 9)))
!(get-memoize-stats)
(= (ok-cache-fault $x) (/ 1 0))
!(memoize ok-cache-fault)
; The base memo implementation observes/caches its native diagnostic as
; data. The outer capture must not resurrect a failure from its spelling.
!(outcome:kind (outcome:capture (ok-cache-fault 1)))
!(outcome:kind (outcome:capture (ok-cache-fault 1)))
!(get-memoize-stats)

!(import! &self (library lib_tabling))
!(tabled (ok-table-value $x))
(= (ok-table-value one) same)
(= (ok-table-value one) same)
!(outcome:payload (outcome:collapse (outcome:capture (ok-table-value one))))
!(outcome:payload (outcome:collapse (outcome:capture (ok-table-value one))))
!(tabled (ok-table-fault $x))
(= (ok-table-fault one) (/ 1 0))
!(outcome:kind (outcome:capture (ok-table-fault one)))
!(outcome:kind (outcome:capture (ok-table-fault one)))
