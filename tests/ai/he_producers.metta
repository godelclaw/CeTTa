; Concrete producer families and effects, independent of pretty diagnostics.
!(import! &self "./he_contract.metta")

(HC native-index "!(case (catch (index-atom (a b) 9)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC native-arithmetic "!(case (catch (/ 1 0)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC native-list "!(case (catch (__cetta_lib_list_from_expression 3)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC native-error-data "!(let $datum (cons-atom Error (native datum)) (let $d (index-atom ($datum) 0) (let $v $d (Box $v))))" "[(Box (Error native datum))]\n")
(HC library-selection-code "!(let $d (index-atom ((+ 1 2)) 0) (Box $d))" "[(Box 3)]\n")
(HC native-empty-data "(: Empty (-> Atom ScopedObservation)) !(let $d (index-atom ((Empty scope)) 0) (Box $d))" "[(Box (Empty scope))]\n")
(HC body-failure "(= (fail) (Error original (Forbidden denied))) !(get-state (fail))" "[(Error original (Forbidden denied))]\n")
(HC state-type "!(case (catch (get-state not-a-state)) (((Error $w (Unsolvable $d)) caught) ($x missed)))" "[caught]\n")
(HC state-arity "!(case (catch (get-state)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC function-no-return "!(case (catch (function (Box 1))) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC function-arity "!(case (catch (function 1)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC function-original-failure "!(function (Error original (Forbidden denied)))" "[(Error original (Forbidden denied))]\n")
(HC instruction-chain-arity "!(case (catch (function (chain (eval 1) not-a-variable (return 2)))) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC native-effect-fence "!(let $s (new-state ()) (let $f (catch (let* (($bad (index-atom (a b) 9)) ($after (change-state! $s touched))) done)) (NativeStop (get-state $s) (case $f (((Error $w (Fault $d)) caught) ($x missed))))))" "[(NativeStop () caught)]\n")
(HC state-write-fence "!(let $s (new-state before) (let $f (catch (change-state! $s (Error write (Forbidden denied)))) (WriteStop $f (get-state $s))))" "[(WriteStop (Error write (Forbidden denied)) before)]\n")
(HC error-fields-inert "!(let $s (new-state before) (let $d (catch (Error (change-state! $s where) (Fault (change-state! $s detail)))) (case $d (((Error $w (Fault $detail)) (Fields (get-state $s)))))))" "[(Fields before)]\n")
(HC quoted-data "!(let $d (quote (Error quoted (Fault inert))) (Box $d))" "[(Box (quote (Error quoted (Fault inert))))]\n")
(HC quotation-activation "!(let $d (quote (Error quoted (Fault inert))) (unquote $d))" "[(Error quoted (Fault inert))]\n")
(HC minimal-eval-quotation "!(let $d (quote (Error quoted (Fault inert))) (eval $d))" "[(quote (Error quoted (Fault inert)))]\n")
(HC mixed-alternatives "!(collapse (let $v (superpose ((Error branch (Fault bad)) live)) (Box $v)))" "[((Error branch (Fault bad)) (Box live))]\n")
(HC duplicate-failures "!(collapse (superpose ((Error branch (Fault same)) (Error branch (Fault same)))))" "[((Error branch (Fault same)) (Error branch (Fault same)))]\n")
(HC zero-unit-container "(: Empty (-> Atom ScopedObservation)) !(collapse (superpose ())) !(collapse (superpose (() (Box ()) (Empty scope))))" "[()]\n[(() (Box ()) (Empty scope))]\n")
(HC later-directive "!(Error first (Fault bad)) !(+ 1 2)" "[(Error first (Fault bad))]\n[3]\n")
(HC user-handler "(= (catch $x) user-owned) !(catch 7)" "[user-owned]\n")
(HC user-held-handler "(: catch (-> Atom Atom)) (= (catch $x) (Owned $x)) !(catch (Error held (Fault data)))" "[(Owned (Error held (Fault data)))]\n")
(HC unicode-detail "!(let $d (catch (Error 森 (Incomplete \"žluťoučký 🌸\"))) (Box $d))" "[(Box (Error 森 (Incomplete \"žluťoučký 🌸\")))]\n")
(HC step-return-source "!(function (return (Error returned (Fault datum))))" "[(Error returned (Fault datum))]\n")
(HC native-fold-failure "!(case (catch (_minimal-foldl-llist (LCons 1 LNil) 0 $a $x (Error step (Forbidden denied)) &self)) (((Error step (Forbidden denied)) caught) ($x missed)))" "[caught]\n")
(HC native-fold-error-data "!(let $d (cons-atom Error (native datum)) (_minimal-foldl-llist (LCons 1 LNil) $d $a $x $a &self))" "[(return (Error native datum))]\n")
(HC nop-raised "!(let $ignored (nop (Error original (Incomplete unresolved))) never)" "[(Error original (Incomplete unresolved))]\n")
(HC nop-data "!(nop (cons-atom Error (native datum)))" "[()]\n")
(HC type-query-space "!(case (catch (get-type 1 not-a-space)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC invalid-space "!(case (catch (space-union wrong wrong)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC fold-source-failure "!(fold (superpose (1 (Error original (Forbidden denied)) 3)) 0 $a $x (+ $a $x))" "[(Error original (Forbidden denied))]\n")
(HC fold-step-failure "!(fold (superpose (1 2)) 0 $a $x (Error original (Incomplete no-verdict)))" "[(Error original (Incomplete no-verdict))]\n")
(HC fold-error-data "!(let $d (cons-atom Error (native datum)) (fold (superpose (1)) $d $a $x $a))" "[(Error native datum)]\n")
(HC native-mutation-failure "!(case (catch (function (chain (eval (add-atom 7 payload)) $r (return never)))) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC native-value-typecheck "(: only-number (-> Number Number)) (= (only-number $x) $x) !(case (catch (only-number (cons-atom Error (native datum)))) (((Error $w (Unsolvable $d)) rejected) ($x missed)))" "[rejected]\n")
(HC match-space-failure "!(case (catch (match wrong (K $x) $x)) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC malformed-cons "!(case (catch (function (cons-atom 1 2))) (((Error $w (Fault $d)) caught) ($x missed)))" "[caught]\n")
(HC type-failure-effect-fence "(: tf (-> Number Number)) (= (tf $x) $x) !(let* (($x (tf \"s\")) ($y (add-atom &self (eff-tf)))) done) !(collapse (match &self (eff-tf) yes))" "[(Error (tf \"s\") (Unsolvable (BadArgType 1 Number String)))]\n[()]\n")
(HC stored-error-data "(Item (Error stored s)) !(match &self (Item $x) (Box $x))" "[(Box (Error stored s))]\n")
(HC stored-error-rebinding "(Item (Error stored s)) !(let $v (match &self (Item $x) $x) (Box $v))" "[(Box (Error stored s))]\n")
(HC constructed-error-data "!(let $v (cons-atom Error (w d)) (Box $v))" "[(Box (Error w d))]\n")
(HC constructed-error-wrapper "(= (mk) (cons-atom Error (w d))) !(let $v (mk) (Box $v))" "[(Box (Error w d))]\n")
(HC deconstructed-error-data "!(let $datum (cons-atom Error (a b)) (let ($h $t) (decons-atom ($datum 1)) (Box $h)))" "[(Box (Error a b))]\n")
(HC held-code-through-match "(Flag a) (: choose (-> Atom %Undefined%)) (= (choose $body) (match &self (Flag a) $body)) !(choose (+ 1 2))" "[3]\n")
(HC constructed-code-policy "(= (f x) reduced) (= (one-of $x) NotReducible) !(let $l (one-of x) (let $t (cdr-atom $l) (let $c (cons-atom f $t) $c)))" "[reduced]\n")
(HC unquote-effect-policy "!(let $s (new-state before) (let $ignored (unquote (quote (change-state! $s after))) (get-state $s)))" "[after]\n")
(HC late-constructed-code "(= (one-of $x) NotReducible) !(let $l (one-of y) (let $t (cdr-atom $l) (let $c (cons-atom g $t) (let $added (add-atom &self (= (g y) done)) $c))))" "[done]\n")
(HC caught-open-data "!(let $d (catch (Error $w (Fault b))) (let $w 5 (Box $d)))" "[(Box (Error 5 (Fault b)))]\n")
(HC caught-open-pattern "!(let $d (catch (Error $w (Fault b))) (let (Error 5 $k) $d (Box $d)))" "[(Box (Error 5 (Fault b)))]\n")
(HC constructed-open-data "!(let $d (cons-atom Error ($w (Fault b))) (let $w 5 (Box $d)))" "[(Box (Error 5 (Fault b)))]\n")
(HC nested-diagnostic-source-child "!(let $d (cons-atom Error ((Error inner (Fault b)) (Fault outer))) (case $d (((Error $w $k) (Box $w)))))" "[(Error inner (Fault b))]\n")
(HC nested-diagnostic-data-child "!(let $inner (cons-atom Error (inner (Fault b))) (let $d (cons-atom Error ($inner (Fault outer))) (case $d (((Error $w $k) (Box $w))))))" "[(Box (Error inner (Fault b)))]\n")
(HC independent-diagnostic-occurrences "(Item (Error same (Fault b))) !(match &self (Item $x) (Box $x)) !(let* (($bad (Error same (Fault b))) ($effect (add-atom &self happened))) never) !(collapse (match &self happened yes))" "[(Box (Error same (Fault b)))]\n[(Error same (Fault b))]\n[()]\n")
(HC diagnostic-storage-roundtrip "!(let $d (cons-atom Error (w (Fault b))) (let $s (new-space) (let $added (add-atom $s (Item $d)) (match $s (Item $x) (Box $x)))))" "[(Box (Error w (Fault b)))]\n")
(HC diagnostic-stream-dedup "!(let $d (cons-atom Error (w (Fault b))) (let $u (unique (superpose ($d $d))) (Box $u)))" "[(Box (Error w (Fault b)))]\n")
(HC diagnostic-container-dedup "!(let $d (cons-atom Error (w (Fault b))) (let $items (unique-atom ($d $d)) (let $u (superpose $items) (Box $u))))" "[(Box (Error w (Fault b)))]\n")
(HC stored-atoms-data "!(let $s (new-space) (let $added (add-atom $s (Error stored s)) (let $v (get-atoms $s) (Box $v))))" "[(Box (Error stored s))]\n")
(HC stored-peek-data "!(let $s (new-space queue) (let $added (space-push $s (Error stored s)) (let $v (space-peek $s) (Box $v))))" "[(Box (Error stored s))]\n")
(HC stored-get-data "!(let $s (new-space queue) (let $added (space-push $s (Error stored s)) (let $v (space-get $s 0) (Box $v))))" "[(Box (Error stored s))]\n")
(HC stored-pop-data "!(let $s (new-space queue) (let $added (space-push $s (Error stored s)) (let $v (space-pop $s) (Box $v))))" "[(Box (Error stored s))]\n")

(= (hp:check $binary $route (ProducerCase $name $source $wanted))
   (let* (($program (str:concat "!(ai:experiment failure-values) " $source))
          ($expected (str:concat "[()]\n" $wanted)))
     (case (proc:run ("/usr/bin/env" $route $binary "--lang" "he" "--profile" "ai" "-e" $program)
                    "." inherit 15000 1048576)
       (((proc:exited 0 $actual "")
          (if (== $actual $expected) 0
            (let $shown (println! (HEProducerMismatch $route $name $program $expected $actual)) 1)))
        ($other (let $shown (println! (HEProducerExecutionFailed $route $name $other)) 1))))))
(= (hp:walk $binary $route $cases $count $bad)
   (if (== $cases ()) (HEProducerResults $route $count $bad)
     (let* (($entry (car-atom $cases)) ($rest (cdr-atom $cases))
            ($failed (hp:check $binary $route $entry)))
       (hp:walk $binary $route $rest (+ $count 1) (+ $bad $failed)))))
(= (hp:run $binary $route)
   (let $cases (collapse (match &self (HC $name $source $expected)
                                   (ProducerCase $name $source $expected)))
     (hp:walk $binary $route $cases 0 0)))
