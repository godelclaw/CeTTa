; Inventory real lexical producer calls. Cesta excludes comments; quoted C
; literals remain quoted tokens and cannot masquerade as identifiers.
!(import! &self (library proc))
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library json))

(ErrorProducer "\"atom_error\"")
(ErrorProducer "\"call_signature_error\"")
(ErrorProducer "\"space_arg_error\"")
(ErrorProducer "\"space_backend_error_if_set\"")
(ErrorProducer "\"space_backend_or_symbol_error\"")
(ErrorProducer "\"bad_arg_type_error\"")
(ErrorProducer "\"bad_arg_type_error_of_type\"")
(ErrorProducer "\"state_bad_arg_type_error\"")

(= (pi:take $count $tokens)
   (if (or (== $count 0) (== $tokens ())) ()
     (cons-atom (car-atom $tokens) (pi:take (- $count 1) (cdr-atom $tokens)))))
(= (pi:window $tokens $offset $count)
   (if (or (== $count 0) (== $offset (size-atom $tokens))) ()
     (let $token (index-atom $tokens $offset)
       (if (== $token "") ()
         (cons-atom $token (pi:window $tokens (+ $offset 1) (- $count 1)))))))
(= (pi:walk $file $tokens $previous $offset $ordinal)
   (if (== $offset (size-atom $tokens)) (PublicationInventory $file $ordinal $offset)
     (let* (($token (index-atom $tokens $offset))
            ($known (collapse (match &self (ErrorProducer $token) yes)))
            ($next (+ $offset 1))
            ($call (if (and (not (== $known ())) (< $next (size-atom $tokens)))
                     (== (index-atom $tokens $next) "\"(\"") False))
            ($count (if $call
              (let $shown (println! (ProducerSite $file $ordinal $offset (json:parse $token)
                        (map-atom $previous $part (json:parse $part))
                        (map-atom (pi:window $tokens $next 28) $part (json:parse $part)))) (+ $ordinal 1)) $ordinal))
            ($history (pi:take 12 (cons-atom $token $previous))))
       (pi:walk $file $tokens $history $next $count))))
(= (pi:run $cesta $file)
   (case (proc:run ($cesta "source" "--tokens" $file) "." inherit 60000 67108864)
     (((proc:exited 0 $text "")
        (pi:walk $file (str:split "\n" $text) () 0 0))
      ($bad (InventoryFailed $file $bad)))))
