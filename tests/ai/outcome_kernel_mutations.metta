; Source-level policy mutants, generated in a caller-selected scratch directory.
; Every mutant's witness must pass against production before it may count.
!(import! &self "../../tools/generate_outcome_kernel.metta")
!(import! &self (library proc))
(OKMutant continue-after-raise "(if (== (outcome:kind $outcome:event) value)" "(if True" 1 "!(outcome:kind (outcome:bind (outcome:raise (Error first (Forbidden detail))) $v (outcome:value hidden)))" "raised")
(OKMutant reclassify-earliest "(outcome-internal:propagate $outcome:event)" "(outcome:raise (Error changed (Fault wrong)))" 1 "!(outcome:payload (outcome:bind (outcome:raise (Error first (Forbidden detail))) $v (outcome:value hidden)))" "(Error first (Forbidden detail))")
(OKMutant catch-retains-control "(outcome:observe $outcome:event)))" "$outcome:event))" 1 "!(outcome:kind (outcome:catch (outcome:raise (Error first (Forbidden detail)))))" "value")
(OKMutant collapse-loses-failure "(outcome:pack (map-atom $outcome:events $outcome:item (outcome:observe $outcome:item)))" "(outcome:pack (filter-atom $outcome:events $outcome:item (== (outcome:kind $outcome:item) value)))" 1 "!(outcome:payload (outcome:collapse (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:value 7)))))" "((Error first (Forbidden detail)) 7)")
(OKMutant choice-catches-branch "(metta $outcome:branch %Undefined% (context-space))" "(outcome:catch $outcome:branch)" 1 "!(collapse (outcome:kind (outcome:choice ((outcome:raise (Error first (Forbidden detail))) (outcome:value 7)))))" "(raised value)")
(OKMutant no-verdict-means-false "(outcome:incomplete (Error if (Incomplete (NoVerdict $outcome:condition))))" "$no" 1 "!(outcome:kind (outcome:if (outcome:value unknown) (outcome:value yes) (outcome:value no)))" "incomplete")
(OKMutant cut-is-raise "(__cetta_lib_outcome_incomplete $diagnostic)" "(__cetta_lib_outcome_raised $diagnostic)" 1 "!(outcome:kind (outcome:incomplete (Error cut (Incomplete budget))))" "incomplete")
(OKMutant unique-is-not-observer "($outcome:observed (map-atom $outcome:events $outcome:item (outcome:observe $outcome:item)))" "($outcome:observed $outcome:events)" 1 "!(outcome:kind (outcome:unique (outcome:raise (Error first (Forbidden detail)))))" "value")
(OKMutant intersection-is-not-observer "(map-atom $outcome:first $outcome:item (outcome:observe $outcome:item))" "$outcome:first" 2 "!(outcome:payload (outcome:intersection (outcome:raise (Error first (Forbidden detail))) (outcome:value (Error first (Forbidden detail)))))" "(Error first (Forbidden detail))")
(OKMutant subtraction-is-not-observer "(map-atom $outcome:first $outcome:item (outcome:observe $outcome:item))" "$outcome:first" 2 "!(collapse (outcome:subtraction (outcome:raise (Error first (Forbidden detail))) (outcome:value (Error first (Forbidden detail)))))" "()")
(OKMutant data-constructor-demands-code "(: outcome:value (-> Atom %Undefined%))" "(: outcome:value (-> %Undefined% %Undefined%))" 1 "!(outcome:payload (outcome:value (+ 1 2)))" "(+ 1 2)")
(OKMutant error-data-becomes-control "(__cetta_lib_outcome_value $value)" "(__cetta_lib_outcome_raised $value)" 1 "!(outcome:kind (outcome:value (Error first (Forbidden detail))))" "value")

(= (okmut:process $binary $root $lang $module $source)
   (let $program (str:join "" ("!(ai:experiment outcome-kernel) !(import! &self " (repr $module) ") " $source))
     (proc:run ($binary "--lang" $lang "--profile" "ai" "-e" $program) $root inherit 10000 1048576)))
(= (okmut:one-host $binary $root $lang $module $source $wanted $name)
   (let* (($real (str:concat $root (if (== $lang "petta") "/lib/petta/outcome_kernel.metta" "/lib/outcome_kernel.metta")))
          ($expected (if (== $lang "he") (str:join "" ("[()]\n[()]\n[" $wanted "]\n"))
                        (str:join "" ("()\ntrue\n" $wanted "\n"))))
          ($baseline (okmut:process $binary $root $lang $real $source))
          ($mutant (okmut:process $binary $root $lang $module $source)))
     (case ($baseline $mutant)
       ((((proc:exited 0 $base-out "") (proc:exited 0 $new-out ""))
          (if (== $base-out $expected)
            (if (not (== $new-out $expected)) 0
              (let $shown (println! (OutcomeMutantSurvived $lang $name $new-out)) 1))
            (let $shown (println! (OutcomeMutantInvalidBaseline $lang $name $expected $base-out)) 1)))
        ($bad (let $shown (println! (OutcomeMutantExecutionFailed $lang $name $bad)) 1))))))
(= (okmut:one $binary $root $directory (Mutant $name $old $new $count $source $wanted))
   (let* (($original (fs:read-text (str:concat $root "/lib/outcome_kernel.metta")))
          ($parts (str:split $old $original)))
     (if (== (size-atom $parts) (+ $count 1))
       (let* (($changed (str:join $new $parts))
              ($he (str:concat $directory "/mutant-shared.metta"))
              ($pe (str:concat $directory "/mutant-petta.metta"))
              ($written (fs:write $he $changed))
              ($generated (okgen:write $he $pe))
              ($p (okmut:one-host $binary $root "petta" $pe $source $wanted $name))
              ($h (okmut:one-host $binary $root "he" $he $source $wanted $name))
              ($shown (println! (OutcomeMutation $name $p $h))))
         (+ $p $h))
       (let $shown (println! (OutcomeMutantStale $name $count (size-atom $parts))) 2))))
(= (okmut:walk $binary $root $directory $cases $count $bad)
   (if (== $cases ()) (OutcomeMutationResults $count $bad)
     (let $failed (okmut:one $binary $root $directory (car-atom $cases))
       (okmut:walk $binary $root $directory (cdr-atom $cases) (+ $count 2) (+ $bad $failed)))))
(= (okmut:run $binary $root $directory)
   (let* (($made (fs:make-directories $directory 511))
          ($cases (collapse (match &self (OKMutant $name $old $new $count $source $wanted)
                               (Mutant $name $old $new $count $source $wanted)))))
     (okmut:walk $binary $root $directory $cases 0 0)))
