; HE uses the same occurrence contract with its own public result syntax.
; Predictions come from the semantic table, never a captured candidate run.
!(import! &self "./kind_matrix.metta")

(= (kh:check $binary $route $kind (Template $name $before $after $view))
   (let* (($error (str:join "" ("(Error first (" $kind " detail))")))
          ($program (str:join "" ("!(ai:experiment failure-values) " $before $error $after)))
          ($expected (str:join "" ("[()]\n[" (km:expect $view $error) "]\n"))))
     (case (proc:run ("/usr/bin/env" $route $binary "--lang" "he" "--profile" "ai" "-e" $program)
                     "." inherit 10000 1048576)
       (((proc:exited 0 $actual "")
          (if (== $actual $expected) 0
            (let $shown (println! (HEContractMismatch $route $kind $name $expected $actual)) 1)))
        ($other (let $shown (println! (HEContractExecutionFailed $route $kind $name $other)) 1))))))
(= (kh:walk $binary $route $kind $templates $count $bad)
   (if (== $templates ()) (Counts $count $bad)
     (let* (($template (car-atom $templates)) ($rest (cdr-atom $templates))
            ($failed (kh:check $binary $route $kind $template)))
       (kh:walk $binary $route $kind $rest (+ $count 1) (+ $bad $failed)))))
(= (kh:kinds $binary $route $kinds $templates $count $bad)
   (if (== $kinds ()) (HEContractResults $route $count $bad)
     (let* (($kind (car-atom $kinds)) ($rest (cdr-atom $kinds))
            ((Counts $next $failed) (kh:walk $binary $route $kind $templates $count $bad)))
       (kh:kinds $binary $route $rest $templates $next $failed))))
(= (kh:run $binary $route)
   (let $templates (collapse (match &self (KMCase $name $before $after $view)
                                      (Template $name $before $after $view)))
     (kh:kinds $binary $route ("Unsolvable" "Forbidden" "Incomplete" "Fault") $templates 0 0)))

(= (kh:compositions $outer $inners)
   (if (== $inners ()) ()
     (cons-atom (km:compose $outer (car-atom $inners))
                (kh:compositions $outer (cdr-atom $inners)))))
(= (kh:outer $outers $inners)
   (if (== $outers ()) ()
     (union-atom (kh:compositions (car-atom $outers) $inners)
                 (kh:outer (cdr-atom $outers) $inners))))
(= (kh:nested $binary $route)
   (let* (($strict (collapse
             (let $name (match &self (KMProp $name) $name)
               (match &self (KMCase $name $before $after $view)
                            (Template $name $before $after $view)))))
          ($templates (kh:outer $strict $strict)))
     (kh:kinds $binary $route ("Unsolvable" "Forbidden" "Incomplete" "Fault") $templates 0 0)))
