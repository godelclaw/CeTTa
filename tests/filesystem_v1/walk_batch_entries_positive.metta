!(import! &self fs)
!(import! &self system)
(= (walk-example:batch $path)
  (let $owner (fs:walk-open $path)
    (let $space (context-space)
      (case (_minimal-foldl-llist (LCons tick (LCons tick (LCons tick (LCons tick LNil))))
          0 $acc $tick
          (case (fs:walk-next $owner no-follow ())
            (((fs:walk-entry $p $r $n $h $i) (+ $acc 1))
             ((fs:end $observed) $acc))) $space)
        (((return $count)
          (let $closed (fs:close $owner)
            (function (return (BatchEntries $count $closed))))))))))
!(walk-example:batch (system:arg 0))
