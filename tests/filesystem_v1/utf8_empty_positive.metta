!(import! &self str)
!(let $first-bytes (str:unescape metta "\\xc3")
  (let $last-bytes (str:unescape metta "\\xa9")
    (let $initial (str:utf8-new strict)
      (case (str:utf8-feed $initial $first-bytes False)
        (((Utf8DecodedV1 $prefix $middle)
          (case (str:utf8-feed $middle "" False)
            (((Utf8DecodedV1 $empty $same)
              (case (str:utf8-feed $same $last-bytes True)
                (((Utf8DecodedV1 $value $finished)
                  (function (return (Utf8Empty $prefix $empty $value $finished)))))))))))))))
