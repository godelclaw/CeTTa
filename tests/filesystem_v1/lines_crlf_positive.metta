!(import! &self str)
!(let $initial (str:line-new)
  (let $one (str:line-segments "first\r" False)
    (case (str:collect-lines $initial $one False)
      (((LinesCollectedV1 $before $middle)
        (let $two (str:line-segments "\n\nlast" True)
          (case (str:collect-lines $middle $two True)
            (((LinesCollectedV1 $after $finished)
              (function (return (LinesCRLF $before $after $finished))))))))))))
