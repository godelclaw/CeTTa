!(import! &self fs)
!(import! &self str)
!(import! &self system)
!(let $owner (fs:open-read (system:arg 0))
  (case (fs:read-chunk $owner 65536)
    (((fs:chunk $bytes $offset)
      (let $closed (fs:close $owner)
        (let $fault (fs:read-chunk $owner 1)
          (let $length (str:byte-length $bytes)
            (function (return (RetainedBytesFault $length $fault))))))))))
