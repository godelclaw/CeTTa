!(import! &self fs)
!(import! &self str)
!(import! &self system)
!(let $owner (fs:open-read (system:arg 0))
  (case (fs:read-chunk $owner 65536)
    (((fs:chunk $bytes $offset)
      (let $closed (fs:close $owner)
        (add-atom &self (saved-bytes $bytes)))))))
!(match &self (saved-bytes $bytes)
  (let $length (str:byte-length $bytes)
    (function (return (RetainedBytesSpace $length)))))
