!(import! &self str)
!(let $first-bytes (str:unescape metta "a\\xc3")
  (let $last-bytes (str:unescape metta "\\xa9\\x00z")
    (let $initial (str:utf8-new strict)
      (case (str:utf8-feed $initial $first-bytes False)
        (((Utf8DecodedV1 $first $middle)
          (case (str:utf8-feed $middle $last-bytes True)
            (((Utf8DecodedV1 $last $finished)
              (function (return (Utf8Chunks $first $last $finished))))))))))))
