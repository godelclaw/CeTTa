!(import! &self fs)
!(import! &self system)
!(let $one (fs:open-read (system:arg 0))
  (let $two (fs:open-read (system:arg 0))
    (let $a (fs:read-chunk $one 1)
      (let $b (fs:read-chunk $two 1)
        (let $c (fs:read-chunk $one 1)
          (let $closed-one (fs:close $one)
            (let $closed-two (fs:close $two) (Independent $a $b $c))))))))
