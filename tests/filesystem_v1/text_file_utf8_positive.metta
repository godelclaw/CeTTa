!(import! &self fs)
!(import! &self system)
!(import! &self str)
!(let $owner (fs:open-read (system:arg 0))
  (let $decoder (str:utf8-new strict)
    (let $buffer (str:line-new)
      (let (fs:chunk $bytes $offset) (fs:read-chunk $owner 2)
        (let (Utf8DecodedV1 $text $next-decoder) (str:utf8-feed $decoder $bytes False)
          (let $segments (str:line-segments $text False)
            (let (LinesCollectedV1 $before $next-buffer) (str:collect-lines $buffer $segments False)
              (let (fs:chunk $last-bytes $last-offset) (fs:read-chunk $owner 2)
                (let (Utf8DecodedV1 $last-text $finished-decoder) (str:utf8-feed $next-decoder $last-bytes False)
                  (let $last-segments (str:line-segments $last-text False)
                    (let (LinesCollectedV1 $after $finished-buffer) (str:collect-lines $next-buffer $last-segments False)
                      (let (fs:end $end-offset) (fs:read-chunk $owner 1)
                        (let $closed (fs:close $owner)
                          (function (return (FileUtf8 $before $after $end-offset))))))))))))))))
