!(import! &self fs)
!(import! &self system)
!(import! &self str)
!(let $owner (fs:open-read (system:arg 0))
  (let $decoder (str:utf8-new strict)
    (let (fs:chunk $bytes $offset) (fs:read-chunk $owner 32)
      (let (Utf8DecodedV1 $text $pending) (str:utf8-feed $decoder $bytes False)
        (let (fs:end $end-offset) (fs:read-chunk $owner 1)
          (let $closed (fs:close $owner) (str:utf8-feed $pending "" True)))))))
