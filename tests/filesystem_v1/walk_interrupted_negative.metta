!(import! &self fs)
!(import! &self system)
!(let $owner (fs:walk-open (system:arg 0))
  (let $work (work-new (fs:walk-next $owner no-follow ()))
    (let $bounded (work-budget $work 1)
      (let $unfinished (work-take $work 1)
        (let $cancelled (work-cancel $work)
          (let $position (fs:walk-current $owner)
            (let $closed (fs:close $owner)
              (StoppedWalk $unfinished $cancelled $position $closed))))))))
