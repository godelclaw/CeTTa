!(import! &self fs)
!(import! &self system)
(= (walk-example:empty $path)
  (let $owner (fs:walk-open $path)
    (let $space (context-space)
      (case (_minimal-foldl-llist (LCons tick (LCons tick LNil))
          0 $acc $tick
          (case (fs:walk-next $owner no-follow ())
            (((fs:end $observed) $acc)
             ($unexpected (+ $acc 1)))) $space)
        (((return $count)
          (let $end (fs:walk-current $owner)
            (let $closed (fs:close $owner)
              (function (return (BatchEmpty $count $end $closed)))))))))))
!(walk-example:empty (system:arg 0))
