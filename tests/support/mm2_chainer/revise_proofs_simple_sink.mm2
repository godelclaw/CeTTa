; Native counterpart to revise_proofs_symbolic.mm2.
;
; Both files use the same input relations and produce the same public output:
;   (proved TYPE GOAL PROOF-ID STV)
;   (revised TYPE GOAL MERGED-STV MERGED-PROOF)
;   (revised-evidence TYPE GOAL EVIDENCE-ID)
;
; This executor sends only the proof declarations to the sink.  The sink reads
; the matching proof-evidence facts from the same space.
(exec 0
  (, (open-proof $type $goal $proof $stv))
  (O
    (revise-proofs-simple
      $type $goal $proof $stv)))

; ---------------------------------------------------------------------------
; Demo data
