!(import! &self (library store))

(= (store-fixture:run (Create $path))
  (case (store:open $path "create")
    (((StoreOpened $owner) (let $closed (store:close $owner) Created))
     ($error $error))))

(= (store-fixture:run (Apply $path $reads $writes $ops))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
       (let $answer
         (case (store:snapshot $owner)
           (((StoreSnapshot $view $epoch $before)
              (let* (($answer
                (case (store:commit-scoped $owner $view $reads $writes $ops)
                  (((StoreSnapshot $updated $same-epoch $after)
                     (let $closed (store:close $updated) (Applied $after)))
                   ($error $error))))
                ($closed (store:close $view))) $answer))
            ($error $error)))
         (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (store-fixture:run (Read $path $key $budget))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (store:get $view $key $budget)) ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (store-fixture:run (Maintenance $path))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:compact $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($closed (store:close $view)) ($collected (store:collect $owner)))
              (Maintained $revision $collected)))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (store-fixture:scan $scan $position $reverse)
  (case (store:scan-next $scan $position)
    ((StoreEnd $reverse)
     ((StoreKey $key $bytes $next)
       (let $again (store:scan-next $scan $position)
         (if (== $again (StoreKey $key $bytes $next))
           (let $rows (cons-atom ($key $bytes) $reverse)
             (store-fixture:scan $scan $next $rows))
           (BadRepeatedPage $again))))
     ($error $error))))

(= (store-fixture:run (Keys $path $lower $upper))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $answer
              (case (store:scan-open $view $lower $upper)
                (((StoreScan $scan)
                  (let* (($rows (store-fixture:scan $scan 0 ())) ($closed (store:close $scan))) $rows))
                 ($error $error)))
              (let $closed (store:close $view) $answer)))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (store-fixture:run (Codec $value))
  (case (store:encode $value)
    (((StoreEncoded $bytes) (store:decode $bytes))
     ($error $error))))

; The worker must release these intentionally unreturned owners when its
; request arena retires. The open body and cursor also outlive their parents.
(= (store-fixture:run (Resources $path $key $explicit))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (case (store:snapshot $owner)
        (((StoreSnapshot $view $epoch $revision)
          (case (store:blob-open $view $key)
            (((StoreBlob $body $size)
              (case (store:scan-open $view $key NoBound)
                (((StoreScan $scan)
                  (let* (($view-closed (if $explicit (store:close $view) Automatic))
                         ($owner-closed (if $explicit (store:close $owner) Automatic))
                         ($first (store:blob-read $body 0 7))
                         ($again (store:blob-read $body 0 7))
                         ($row (store:scan-next $scan 0))
                         ($same-row (store:scan-next $scan 0))
                         ($body-closed (if $explicit (store:close $body) Automatic))
                         ($scan-closed (if $explicit (store:close $scan) Automatic)))
                    (if (== $first $again)
                      (if (== $row $same-row) (ResourcesRead $size $first $row) BadRepeatedKey)
                      BadRepeatedBytes)))
                 ($error $error))))
             ($error $error))))
         ($error $error))))
     ($error $error))))
