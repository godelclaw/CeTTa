!(import! &self (library store))
(= (kb-codec:produce $effects $value)
   (progn (add-atom $effects tick) $value))
(= (kb-codec:run (Encode $value)) (store:encode $value))
(= (kb-codec:run (Roundtrip $value))
   (case (store:encode $value)
     (((StoreEncoded $bytes) (store:decode $bytes)) ($error $error))))
(= (kb-codec:run (Produced $value))
   (let* (($effects (new-space))
          ($answer (store:encode (kb-codec:produce $effects $value)))
          ($count (size-atom (collapse (get-atoms $effects)))))
     (CodecObserved $answer $count)))
