!(import! &self "../../lib/petta/rel.metta")
(= (kb-rel:equal-key $a $b)
   (if (== (car-atom $a) (car-atom $b)) RelTrue RelFalse))
(= (kb-rel:unknown $a $b) RelUnknown)
(= (kb-rel:pair $a $b) ($a $b))
(= (kb-rel:empty $a $b) ())
(= (kb-rel:several $a $b) (superpose (one two)))
(= (kb-rel:run (Left $left $right))
   (rel:left-join kb-rel:equal-key kb-rel:pair KbMissing $left $right))
(= (kb-rel:run (Unknown $left $right))
   (rel:left-join kb-rel:unknown kb-rel:pair KbMissing $left $right))
(= (kb-rel:run (EmptyRow $left $right))
   (rel:left-join kb-rel:equal-key kb-rel:empty KbMissing $left $right))
(= (kb-rel:run (Several $left $right))
   (case (rel:left-join kb-rel:equal-key kb-rel:several KbMissing $left $right)
     (((Error $source $why) (RelFailure $source $why)) ($unexpected $unexpected))))
