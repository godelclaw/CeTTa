!(import! &self "../../lib/petta/kb_graph.metta")
!(import! &self "kb_probe.metta")
(= (kbg-probe:pages $cursor $count $fuel $rounds $reversed)
   (if (== $rounds 0)
     (let $closed (kbg:close $cursor) (KgStopped (list:reverse $reversed)))
     (case (kbg:page $cursor $count $fuel)
       (((KgPage $rows (KgMore $next))
         (kbg-probe:pages $next $count $fuel (- $rounds 1) (cons-atom $rows $reversed)))
        ((KgPage $rows (KgPaused $next))
         (kbg-probe:pages $next $count $fuel (- $rounds 1) (cons-atom $rows $reversed)))
        ((KgPage $rows (KgComplete $work)) (KgPages (list:reverse (cons-atom $rows $reversed)) $work))
        ((KgPage $rows (KgFailure $error $work))
         (KgFailedPages (list:reverse (cons-atom $rows $reversed)) $error $work))
        ($bad (let $closed (kbg:close $cursor) $bad))))))
(= (kbg-probe:first $cursor $count $fuel)
   (case (kbg:page $cursor $count $fuel)
     (((KgPage $rows (KgMore $next))
       (let* (($work (kbg:work $next)) ($closed (kbg:close $next))) (KgFirst $rows more $work)))
      ((KgPage $rows (KgPaused $next))
       (let* (($work (kbg:work $next)) ($closed (kbg:close $next))) (KgFirst $rows paused $work)))
      ((KgPage $rows (KgComplete $work)) (KgFirst $rows complete $work))
      ((KgPage $rows (KgFailure $error $work)) (KgFirstFailure $rows $error $work))
      ($bad (let $closed (kbg:close $cursor) $bad)))))
(= (kbg-probe:query $owner $view $plan $limit $command)
   (let $cursor (kbg:open $view $plan 1048576 $limit)
     (if (kbg:cursor? $cursor)
       (case $command
         (((Pages $count $fuel) (kbg-probe:pages $cursor $count $fuel 10000 ()))
          ((First $count $fuel) (kbg-probe:first $cursor $count $fuel))
          ((Held $changes $count $fuel)
           (let $committed (kb-probe:commit $owner $view (GraphHeld $changes) $changes (kb:observe-empty $view))
             (KgHeld $committed (kbg-probe:pages $cursor $count $fuel 10000 ()))))
          ((Race $changes $decision)
           (let* (($reads (kbg:observe $cursor))
                  ($answers (kbg-probe:pages $cursor 2 3 10000 ()))
                  ($first (kb-probe:commit $owner $view (GraphRaceFirst $changes) $changes (kb:observe-empty $view)))
                  ($second (kb-probe:commit $owner $view (GraphRaceSecond $decision) $decision $reads)))
             (KgRace $answers $first $second)))
          ((CloseThenStep)
           (case (kbg:step $cursor)
             (((KgContinue $opened) (let $closed (kbg:close $opened) (kbg:step $opened)))
              ($other $other))))
          ($bad (let $closed (kbg:close $cursor) (KbRefused graph-probe-command))))) $cursor)))
(= (kbg-probe:run $request)
   (case $request
     (((Graph $path $plan $limit $command)
       (case (store:open $path "existing")
         (((StoreOpened $owner)
           (let $answer
             (case (store:snapshot $owner)
               (((StoreSnapshot $view $epoch $revision)
                 (let* (($value (kbg-probe:query $owner $view $plan $limit $command))
                        ($view-closed (store:close $view))) $value))
                ($error $error)))
             (let $owner-closed (store:close $owner) $answer)))
          ($error $error))))
      ((ExplainGraph $plan) (kbg:explain $plan))
      ((GraphCursorOperations $cursor)
       ((kbg:work $cursor) (kbg:observe $cursor) (kbg:close $cursor)
        (kbg:step $cursor) (kbg:page $cursor 1 1) (get-metatype $cursor)))
      ($ordinary (kb-probe:run $ordinary)))))
