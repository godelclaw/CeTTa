; One bounded TPTP interpretation, independently checked by three kernels.
; p and q denote Boolean objects. Equality is native HOL equality on one
; side and Leibniz equality on the Megalodon side. The MM0 presentation
; explicitly declares equality reflexivity. Parsing admits no axiom.
!(import! &self ../../../lib/lib_tptp.metta)
!(import! &self holkernel)
!(import! &self megalodon)
!(import! &self mm0kernel)
!(import! &self seal)

(= (eq-demo:hol-object p) (v "p" (T "bool")))
(= (eq-demo:hol-object q) (v "q" (T "bool")))
(= (eq-demo:mg-object p) (Tm.named "p"))
(= (eq-demo:mg-object q) (Tm.named "q"))
(= (eq-demo:mm-object p) (p))
(= (eq-demo:mm-object q) (q))
(= (eq-demo:hol-formula (≈ $a $b))
   (A (A (c "=" (T "fun" (T "bool") (T "fun" (T "bool") (T "bool"))))
         (eq-demo:hol-object $a)) (eq-demo:hol-object $b)))
(= (eq-demo:mg-formula (≈ $a $b))
   (Tm.all (Tp.arr (Tp.prop) (Tp.prop))
     (Tm.imp (Tm.app (Tm.db 0) (eq-demo:mg-object $a))
             (Tm.app (Tm.db 0) (eq-demo:mg-object $b)))))
(= (eq-demo:mg-proof $object)
   (Pf.termLam (Tp.arr (Tp.prop) (Tp.prop))
     (Pf.proofLam (Tm.app (Tm.db 0) (eq-demo:mg-object $object)) (Pf.hyp 0))))

(= (eq-demo:hol-check $kernel [(fof $_name conjecture (≈ $a $b))])
   (let $term (eq-demo:hol-object $a)
     (let $claim (eq-demo:hol-formula (≈ $a $b))
       (hol:check-dag $kernel ((HolNode 0 (REFL $term) () (thm () $claim))) 0))))
(= (eq-demo:mg-check $theory $name [(fof $_source conjecture (≈ $a $b))])
   (mg:try-prove $theory $name (eq-demo:mg-formula (≈ $a $b)) (eq-demo:mg-proof $a)))
(= (eq-demo:mm-check $theory $name [(fof $_source conjecture (≈ $a $b))])
   (let $left (eq-demo:mm-object $a)
     (let $right (eq-demo:mm-object $b)
       (mm0:prove $theory (theorem $name () () (equal $left $right)) ()
         ((Mm0Row 0 (thm equality-reflexivity ($left)) ())) 0))))

!(let $k (hol:kernel sealed) (bind! &hol (new-state $k)))
(= (H) (get-state &hol))
!(let $s (mg:new-theory-state egal) (bind! &mg $s))
(= (MG) (mg:use (get-state &mg)))
!(mg:parameter (mg:authority (get-state &mg)) "p" (Tp.prop))
!(mg:parameter (mg:authority (get-state &mg)) "q" (Tp.prop))
!(let $t (mm0:theory) (bind! &mm (new-state $t)))
(= (MM) (get-state &mm))
!(mm0:declare (MM) (sort object (strict)))
!(mm0:declare (MM) (sort wff (strict provable)))
!(mm0:declare (MM) (term p () (object ())))
!(mm0:declare (MM) (term q () (object ())))
!(mm0:declare (MM) (term equal ((var x object) (var y object)) (wff ())))
!(let $axiom (mm0:declare (MM)
     (axiom equality-reflexivity ((var x object)) () (equal x x)))
   (seal:kind $axiom))

!(let $t (eq-demo:hol-check (H) (tptp:read-text "fof(p_self,conjecture,(p = p))."))
   (seal:kind $t))
!(let $t (eq-demo:hol-check (H) (tptp:read-text "fof(q_self,conjecture,(q = q))."))
   (seal:kind $t))
!(let $t (eq-demo:mg-check (MG) "p-self" (tptp:read-text "fof(p_self,conjecture,(p = p))."))
   (seal:kind $t))
!(let $t (eq-demo:mg-check (MG) "q-self" (tptp:read-text "fof(q_self,conjecture,(q = q))."))
   (seal:kind $t))
!(let $t (eq-demo:mm-check (MM) p-self (tptp:read-text "fof(p_self,conjecture,(p = p))."))
   (seal:kind $t))
!(let $t (eq-demo:mm-check (MM) q-self (tptp:read-text "fof(q_self,conjecture,(q = q))."))
   (seal:kind $t))
; Changing the parsed claim is refused by each source checker.
!(case (eq-demo:hol-check (H) (tptp:read-text "fof(wrong,conjecture,(p = q))."))
   (((hol:refused $status $why) (hol-refused $status)) ($other unexpected-acceptance)))
!(case (eq-demo:mg-check (MG) "wrong" (tptp:read-text "fof(wrong,conjecture,(p = q))."))
   (((Error $call $why) (mg-refused $why)) ($other unexpected-acceptance)))
!(case (eq-demo:mm-check (MM) wrong (tptp:read-text "fof(wrong,conjecture,(p = q))."))
   (((mm0:refused $status $why) (mm0-refused $status)) ($other unexpected-acceptance)))
; The representations are different: crossing requires a translation and
; fresh checking, not a cast between the two sealed theorem kinds.
!(case (hol:sequent (mg:known (MG) "p-self"))
   (((hol:error $status $why) (hol-refused-megalodon $status)) ($other leaked-authority)))
!(let $t (eq-demo:hol-check (H)
     (tptp:read-text "fof(p_self,conjecture,(p = p))."))
   (case (mg:try-proof-app $t (mg:known (MG) "p-self"))
     (((Error $call $why) (megalodon-refused-hol $why)) ($other leaked-authority))))
!(case (hol:sequent (mm0:theorem (MM) p-self))
   (((hol:error $status $why) (hol-refused-mm0 $status)) ($other leaked-authority)))
!(case (mm0:statement (eq-demo:hol-check (H)
     (tptp:read-text "fof(p_self,conjecture,(p = p)).")))
   (((mm0:error $status $why) (mm0-refused-hol $status)) ($other leaked-authority)))
