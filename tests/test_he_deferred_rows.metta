; A candidate row is named by its coordinate and matched into the consumer's
; frame. Rows offered by cold scans, the match trie or a position index that
; fail the final match are dropped there: repeated query variables, stored
; variables, a rigid field after an unbound one, and numbers by value. The
; queries repeat past the cold allowance and past the tree's rent, so every
; candidate path answers some of them.
(r a 1)
(r b 2)
(r c 3)
(r d d)
(r e e)
(r $v 4)
(r f $w)
(r $u $u)
(r g 1/2)
(r h 0.5)
(s 1 one)
(s 2 two)
(s 3 three)
(s 4 four)
(s 0.5 half)
(t a b c)
(t a a a)
(t b $z c)
(t $y b c)
(pad 1) (pad 2) (pad 3) (pad 4) (pad 5) (pad 6) (pad 7) (pad 8)
; An unbound answer is shown as var: fresh names are not part of the answer.
(= (show $x) (if (== (get-metatype $x) Variable) var $x))
(= (same) (let $bag (collapse (match &self (r $x $x) (show $x))) (sort-atom $bag)))
(= (lead $k) (let $bag (collapse (match &self (r $k $n) (show $n))) (sort-atom $bag)))
(= (tail $n) (let $bag (collapse (match &self (r $x $n) (show $x))) (sort-atom $bag)))
(= (join) (let $bag (collapse (match &self (, (r $x $n) (s $n $y)) ((show $x) $y))) (sort-atom $bag)))
(= (middle) (let $bag (collapse (match &self (t $p b $q) ((show $p) (show $q)))) (sort-atom $bag)))
!(same)
!(lead a)
!(lead d)
!(lead f)
!(lead q)
!(tail 1)
!(tail 4)
!(tail 0.5)
!(tail 1/2)
!(tail d)
!(join)
!(middle)
!(same)
!(lead e)
!(tail 2)
!(join)
!(middle)
!(let $bag (collapse (match &self (t a $m $m) (show $m))) (sort-atom $bag))
!(let $bag (collapse (match &self (t $p $p $p) (show $p))) (sort-atom $bag))
!(let $bag (collapse (match &self (, (t $p b c) (r $p $n)) ((show $p) (show $n)))) (sort-atom $bag))
; Negative cases: no row survives the final match.
!(let $bag (collapse (match &self (r d e) found)) (sort-atom $bag))
!(let $bag (collapse (match &self (s 5 $y) $y)) (sort-atom $bag))
!(let $bag (collapse (match &self (t c $m $m) $m)) (sort-atom $bag))
!(same)
!(join)
