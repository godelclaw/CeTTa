!(import! &self ../../lib/hol_light/data.metta)
!(import! &self ../../lib/hol_light/syntax.metta)
!(import! &self ../../lib/hol_light/kernel.metta)
!(import! &self ../../lib/hol_light/definitions.metta)
!(import! &self ../../lib/hol_light/derived.metta)
!(import! &self ../../lib/hol_light/profile.metta)
!(import! &self ../../lib/hol_light/receive.metta)

(= (axiom-control:p) (Var "p" (hol-light:bool)))
(= (axiom-control:q) (Var "q" (hol-light:bool)))
(= (axiom-control:commitments $term)
  (HOL:Cons (HOL:Entry "selected" $term) HOL:Nil))
(= (axiom-control:state $term) (hol-light:initial (axiom-control:commitments $term)))
(= (axiom-control:accepts $commitment $source)
  (case (hol-light:axiom (axiom-control:state $commitment) "selected" $source)
    (((Some $theorem) True) ($refused False))))
(= (axiom-control:event)
  (hol-light:step (axiom-control:state (axiom-control:p)) "earned" (AXIOM "selected" (axiom-control:p))))
(= (axiom-control:retained)
  (case (axiom-control:event)
    (((Some $state)
      (case (hol-light:known $state "earned")
        (((Some (HOL:Thm $h $c $d $o))
          (and (== $h HOL:Nil)
            (and (== $c (HOL:Free "p" (hol-light:bool)))
              (and (== $d (HOL:Cons (HOL:AxiomDependency "selected" $c) HOL:Nil))
                (== $o (HOL:Origin "earned" (AXIOM "selected" (axiom-control:p))))))))
         ($malformed False))))
     ($refused False))))
(= (axiom-control:receipt)
  (case (axiom-control:event)
    (((Some (HOL:State $op $c $a $proofs $receipts))
      (== $receipts (HOL:Cons (HOL:Receipt "earned" (AXIOM "selected" (axiom-control:p)) HOL:Nil) HOL:Nil)))
     ($refused False))))

!(AxiomExecutionControl selected-formula (== (axiom-control:accepts (axiom-control:p) (axiom-control:p)) True))
!(AxiomExecutionControl wrong-formula (== (axiom-control:accepts (axiom-control:p) (axiom-control:q)) False))
!(AxiomExecutionControl non-boolean
  (== (axiom-control:accepts (Var "x" (Tyvar "a")) (Var "x" (Tyvar "a"))) False))
!(AxiomExecutionControl missing-label
  (== (hol-light:axiom (hol-light:initial HOL:Nil) "missing" malformed-source) None))
!(AxiomExecutionControl malformed-selected
  (== (hol-light:axiom (axiom-control:state malformed-source) "selected" malformed-source) None))
!(AxiomExecutionControl first-commitment
  (== (hol-light:axiom (hol-light:initial
    (HOL:Cons (HOL:Entry "selected" (axiom-control:q)) (axiom-control:commitments (axiom-control:p))))
    "selected" (axiom-control:p)) None))
!(AxiomExecutionControl dependency-and-origin (== (axiom-control:retained) True))
!(AxiomExecutionControl no-proof-premises (== (axiom-control:receipt) True))
