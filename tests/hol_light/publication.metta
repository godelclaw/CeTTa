!(import! &self ../../lib/hol_light/data.metta)
!(import! &self ../../lib/hol_light/syntax.metta)
!(import! &self ../../lib/hol_light/kernel.metta)
!(import! &self ../../lib/hol_light/definitions.metta)
!(import! &self ../../lib/hol_light/derived.metta)
!(import! &self ../../lib/hol_light/profile.metta)
!(import! &self ../../lib/hol_light/receive.metta)

(= (pub-control:base)
  (hol-light:run HOL:Nil
    (HOL:Cons (HOL:Step "r" (REFL (Var "x" (Tyapp "bool" HOL:Nil)))) HOL:Nil)))

(= (pub-control:eq $left $right)
  (Comb (Comb (Const "=" (hol-light:eq-type (hol-light:bool))) $left) $right))

(= (pub-control:fresh)
  (hol-light:check-result (pub-control:base) "r" HOL:Nil
    (pub-control:eq (Var "x" (hol-light:bool)) (Var "x" (hol-light:bool)))))

(= (pub-control:origin)
  (case (pub-control:base)
    (((Some $state)
      (case (hol-light:known $state "r")
        (((Some (HOL:Thm $hyps $conclusion $deps $origin))
          (== $origin (HOL:Origin "r" (REFL (Var "x" (Tyapp "bool" HOL:Nil))))))
         ($malformed False))))
     ($refused False))))

(= (pub-control:repeat)
  (case (pub-control:base)
    (((Some $state)
      (case (hol-light:step $state "t" (TRANS "r" "r"))
        (((Some (HOL:State $operators $constants $axioms $cache
            (HOL:Cons (HOL:Receipt "t" (TRANS "r" "r") $premises) $rest)))
          (== $premises (HOL:Cons "r" (HOL:Cons "r" HOL:Nil))))
         ($malformed False))))
     ($refused False))))

(= (pub-control:receipt-only)
  (case (pub-control:base)
    (((Some (HOL:State $operators $constants $axioms $cache $receipts))
      (let $state (HOL:State $operators $constants $axioms HOL:Nil $receipts)
        (== (hol-light:publish $state "r" (REFL (Var "x" (Tyapp "bool" HOL:Nil)))
              (hol-light:known (HOL:State $operators $constants $axioms $cache $receipts) "r")) None)))
     ($refused False))))

(= (pub-control:cache-only)
  (case (pub-control:base)
    (((Some (HOL:State $operators $constants $axioms $cache $receipts))
      (let $state (HOL:State $operators $constants $axioms
                    (HOL:Cons (HOL:Entry "occupied" NonTheorem) HOL:Nil) HOL:Nil)
        (== (hol-light:publish $state "occupied" (REFL (Var "x" (Tyapp "bool" HOL:Nil)))
              (hol-light:known (HOL:State $operators $constants $axioms $cache $receipts) "r")) None)))
     ($refused False))))

(= (pub-control:retained)
  (case (pub-control:base)
    (((Some $state)
      (case (hol-light:step $state "s" (REFL (Var "y" (Tyapp "bool" HOL:Nil))))
        (((Some $next) (== (hol-light:known $state "r") (hol-light:known $next "r")))
         ($refused False))))
     ($refused False))))

(= (pub-control:receipt-order)
  (case (pub-control:base)
    (((Some $state)
      (case (hol-light:step $state "s" (REFL (Var "y" (Tyapp "bool" HOL:Nil))))
        (((Some (HOL:State $operators $constants $axioms $cache $receipts))
          (== $receipts
            (HOL:Cons (HOL:Receipt "s" (REFL (Var "y" (Tyapp "bool" HOL:Nil))) HOL:Nil)
              (HOL:Cons (HOL:Receipt "r" (REFL (Var "x" (Tyapp "bool" HOL:Nil))) HOL:Nil) HOL:Nil))))
         ($refused False))))
     ($refused False))))

(= (pub-control:context)
  (case (pub-control:base)
    (((Some (HOL:State $operators $constants $axioms $cache $receipts))
      (case (hol-light:step (HOL:State $operators $constants $axioms $cache $receipts)
              "s" (REFL (Var "y" (Tyapp "bool" HOL:Nil))))
        (((Some (HOL:State $newOperators $newConstants $newAxioms $newCache $newReceipts))
          (and (== $operators $newOperators) (and (== $constants $newConstants) (== $axioms $newAxioms))))
         ($refused False))))
     ($refused False))))

(= (pub-control:dependencies)
  (let $p (Var "p" (hol-light:bool))
    (case (hol-light:run (HOL:Cons (HOL:Entry "explicit" $p) HOL:Nil)
            (HOL:Cons (HOL:Step "a" (AXIOM "explicit" $p)) HOL:Nil))
      (((Some $state)
        (case (hol-light:step $state "i" (INST HOL:Nil "a"))
          (((Some $next)
            (case ((hol-light:known $state "a") (hol-light:known $next "i"))
              ((((Some (HOL:Thm $h1 $c1 $deps1 $o1)) (Some (HOL:Thm $h2 $c2 $deps2 $o2)))
                (and (== $deps1 $deps2) (and (== $c1 $c2) (== $o2 (HOL:Origin "i" (INST HOL:Nil "a"))))))
               ($malformed False))))
           ($refused False))))
       ($refused False)))))

(= (pub-control:bad-receipts $receipts)
  (case (pub-control:base)
    (((Some (HOL:State $operators $constants $axioms $cache $oldReceipts))
      (== (hol-light:step (HOL:State $operators $constants $axioms $cache $receipts)
            "new" (REFL (Var "y" (Tyapp "bool" HOL:Nil)))) None))
     ($refused False))))

(= (pub-control:refused $result)
  (case (pub-control:base)
    (((Some $state) (== (hol-light:publish $state "new" (REFL (Var "y" (Tyapp "bool" HOL:Nil))) $result) None))
     ($refused False))))

(= (pub-control:structured)
  (hol-light:accepted (hol-light:run HOL:Nil
    (HOL:Cons (HOL:Step (Key 0) (REFL (Var "x" (Tyapp "bool" HOL:Nil))))
      (HOL:Cons (HOL:Step (Key 1) (REFL (Var "x" (Tyapp "bool" HOL:Nil)))) HOL:Nil)))))

(= (pub-control:duplicate-step)
  (case (pub-control:base)
    (((Some $state) (== (hol-light:step $state "r" UnknownRequest) None))
     ($refused False))))

!(PublicationControl fresh-refl (== (pub-control:fresh) True))
!(PublicationControl command-origin (== (pub-control:origin) True))
!(PublicationControl ordered-repeated-premises (== (pub-control:repeat) True))
!(PublicationControl receipt-only-occupied (== (pub-control:receipt-only) True))
!(PublicationControl cache-only-occupied (== (pub-control:cache-only) True))
!(PublicationControl old-cache-retained (== (pub-control:retained) True))
!(PublicationControl receipt-order (== (pub-control:receipt-order) True))
!(PublicationControl context-retained (== (pub-control:context) True))
!(PublicationControl dependencies-retained (== (pub-control:dependencies) True))
!(PublicationControl refused-result (== (pub-control:refused None) True))
!(PublicationControl malformed-result (== (pub-control:refused ForgedResult) True))
!(PublicationControl malformed-receipt (== (pub-control:bad-receipts (HOL:Cons Broken HOL:Nil)) True))
!(PublicationControl malformed-tail (== (pub-control:bad-receipts (HOL:Cons (HOL:Receipt "other" UnknownRequest HOL:Nil) Broken)) True))
!(PublicationControl missing-premise (== (== (hol-light:run HOL:Nil (HOL:Cons (HOL:Step "new" (TRANS "missing" "missing")) HOL:Nil)) None) True))
!(PublicationControl duplicate-run-key (== (== (hol-light:run HOL:Nil (HOL:Cons (HOL:Step "r" (REFL (Var "x" (Tyapp "bool" HOL:Nil)))) (HOL:Cons (HOL:Step "r" (REFL (Var "y" (Tyapp "bool" HOL:Nil)))) HOL:Nil))) None) True))
!(PublicationControl structured-keys (== (pub-control:structured) True))
!(PublicationControl duplicate-before-dispatch (== (pub-control:duplicate-step) True))
