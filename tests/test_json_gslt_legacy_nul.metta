!(import! &self str)
!(import! &self json)

; Operational strings and keys retain the entire decoded byte sequence.
!(str:byte-length (json:parse "\"\\u0000\""))
!(str:byte-length (json:parse "\"a\\u0000b\""))
!(json:stringify (json:parse "\"a\\u0000b\""))
!(json:stringify (json:parse "\"\""))
!(json:stringify (json:parse "{\"\":\"\"}"))
!(json:get (json:parse "{\"\":\"\"}") "")
!(json:stringify (json:parse "[\"\\u0000\",\"λ\",\"\"]"))

(= (json-legacy-nul-object)
   (json:parse "{\"x\":1,\"x\\u0000y\":2,\"x\\u0000y\":3}"))
!(json:stringify (json-legacy-nul-object))
!(json:get (json-legacy-nul-object) "x")
!(let $key (str:from-codepoints (120 0 121))
   (json:get (json-legacy-nul-object) $key))
!(let $key (str:from-codepoints (120 0 121))
   (json:inspect-get-all (json:inspect (json:stringify (json-legacy-nul-object))) $key))
!(let $key (str:from-codepoints (120 0 122))
   (json:inspect-get-first (json:inspect (json:stringify (json-legacy-nul-object))) $key))
