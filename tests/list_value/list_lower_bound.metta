!(import! &self (library list))
!(println! (list:lower-bound-number () 3))
!(println! (list:lower-bound-number [] 3))
!(println! (list:lower-bound-number (-5 -1 0 0 2 2 9) -6))
!(println! (list:lower-bound-number [-5 -1 0 0 2 2 9] 0))
!(println! (list:lower-bound-number (-5 -1 0 0 2 2 9) 2))
!(println! (list:lower-bound-number [-5 -1 0 0 2 2 9] 3))
!(println! (list:lower-bound-number (-5 -1 0 0 2 2 9) 10))
!(println! (list:lower-bound-number (2 2 2 2) 2))
!(println! (list:lower-bound-number (2 2 2 2) 3))
!(println! (list:lower-bound-number (0.1 0.2 0.2 0.7) 0.2))
!(println! (list:lower-bound-number (9007199254740992 9007199254740993) 9007199254740993))
