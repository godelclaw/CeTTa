; Structural reads retain the producing frame and preserve data returns,
; duplicate answers, effects, relational fallback and recursive ownership.
(= (scope-pack $x) (Data $x $local $local))
(= (scope-second $items) (car-atom (cdr-atom $items)))
(= (scope-dup $x) (Data $x $local $local))
(= (scope-dup $x) (Data $x $local $local))
(= (scope-effect) (progn (println! "unexpected-projection-execution") 99))
(= (scope-box $value) (Prefix $value $outside))
(= (scope-roundtrip $n $value)
   (if (> $n 0)
       (scope-roundtrip (- $n 1) (car-atom (cdr-atom (scope-box $value))))
       $value))
!(scope-second (scope-pack 17))
!(let $p (scope-pack 17)
   (== (car-atom (cdr-atom (cdr-atom $p)))
       (car-atom (cdr-atom (cdr-atom (cdr-atom $p))))))
!(size-atom (scope-pack 17))
!(size-atom (cdr-atom (scope-pack 17)))
!(collapse (scope-second (scope-dup 19)))
!(car-atom (quote ((scope-effect) untouched)))
!(car-atom (progn (println! "sequence-before") (scope-pack 23)))
!(let $x (car-atom $unbound) (== $x (car-atom $unbound)))
!(once (length $unbound-length))
!(scope-second (scope-roundtrip 2048 (scope-pack 29)))
