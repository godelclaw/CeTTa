; Settled application/revision probe derived from corrected stable named_space_lambda_revision.
; A saved closure keeps its owner when that owner's live declarations change.
!(bind! &lambda-owner (new-space))
!(add-atom &lambda-owner (: a A))
!(add-atom &lambda-owner (: b B))
!(add-atom &lambda-owner (= (lambda-first $x) (FirstSeen $x)))
!(add-atom &lambda-owner (= (lambda-second $x) (SecondSeen $x)))
!(let $g (eval (|-> ($x) ((lambda-first $x) (lambda-second $x))) &lambda-owner)
   (add-atom &lambda-owner (saved $g)))
!(test (collapse (eval (match &lambda-owner (saved $g) ($g b)) &lambda-owner))
       (((FirstSeen b) (SecondSeen b))))
!(add-atom &lambda-owner (: lambda-first (-> A %Undefined%)))
!(add-atom &lambda-owner (: lambda-second (-> A %Undefined%)))
!(test (collapse (eval (match &lambda-owner (saved $g) ($g b)) &lambda-owner)) ())
!(test (collapse (eval (match &lambda-owner (saved $g) ($g a)) &lambda-owner))
       (((FirstSeen a) (SecondSeen a))))
!(remove-atom &lambda-owner (: $f $type))
!(test (collapse (eval (match &lambda-owner (saved $g) ($g b)) &lambda-owner))
       (((FirstSeen b) (SecondSeen b))))

; Repeated revision must retain the closure's tagged source provenance.
!(add-atom &lambda-owner (: b B))
!(add-atom &lambda-owner (: lambda-first (-> B %Undefined%)))
!(test (collapse (eval (match &lambda-owner (saved $g) ($g b)) &lambda-owner))
       (((FirstSeen b) (SecondSeen b))))
!(test (collapse (eval (match &lambda-owner (saved $g) ($g a)) &lambda-owner)) ())

; Holding a formerly expanded body retires its old executable arity.
!(bind! &eta-owner (new-space))
!(add-atom &eta-owner (= (eta-base $x $y) (pair $x $y)))
!(add-atom &eta-owner (= (eta-value $x) (eta-base $x)))
!(test (eval ((eta-value 1) 2) &eta-owner) (pair 1 2))
!(add-atom &eta-owner (: eta-value (-> %Undefined% Atom)))
!(test (eval (eta-value 1) &eta-owner) (quote (eta-base 1)))
!(test (let (Error $reason $context)
            (catch (eval (eta-value 1 2) &eta-owner)) raised)
       raised)
!(remove-atom &eta-owner (: eta-value $type))
!(test (eval ((eta-value 1) 2) &eta-owner) (pair 1 2))
