(= (observer-wrap $value) (Wrap $value))
(= (observer-pair $pair)
   (let ($head $tail) $pair (ObservedPair $head $tail)))
!(observer-pair (Wrap 7))
!(let (ObservedPair observer-wrap 7) (observer-pair (Wrap 7)) direct)
(= (observer-nested)
   (let (ObservedPair observer-wrap 7) (observer-pair (Wrap 7)) nested))
!(observer-nested)
(= (observer-alias)
   (let* (($wanted (ObservedPair observer-wrap 7))
          ($wanted (observer-pair (Wrap 7)))) alias))
!(observer-alias)
(= (observer-branch $flag $pair)
   (if (== $flag A)
      (let ($head $tail) $pair (ObservedA $head $tail))
      (let ($head $tail) $pair (ObservedB $head $tail))))
!(let (ObservedA observer-wrap 7) (observer-branch A (Wrap 7)) branch-a)
!(let (ObservedB observer-wrap 7) (observer-branch B (Wrap 7)) branch-b)
(= (observer-choice $pair)
   (let ($head $tail) $pair (ObservedChoice $head $tail)))
(= (observer-choice $pair) Other)
!(collapse (let (ObservedChoice observer-wrap 7) (observer-choice (Wrap 7)) choice))
(= (observer-repeat $pair)
   (let ($head $head) $pair (ObservedRepeat $head)))
!(collapse (observer-repeat (Wrap observer-wrap)))
!(let (ObservedRepeat observer-wrap) (observer-repeat (Wrap observer-wrap)) repeated)
(= (observer-computed) (let (+ 20 22) 42 computed))
!(observer-computed)
(= (observer-data $pair) (let (Wrap $value) $pair $value))
!(observer-data (Wrap 42))
(= (observer-effect)
   (progn (println! observer-prefix)
      (let (ObservedPair observer-wrap 7) (observer-pair (Wrap 7)) effect)))
!(observer-effect)
