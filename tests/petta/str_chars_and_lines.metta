!(import! &self str)
!(import! &self fs)
!(str:length "čau")
!(str:char-length "čau")
!(str:char-slice "čau" 0 1)
!(str:char-slice "čau" 1 99)
!(str:char-slice "ab" 5 9)
!(str:lower "Hello WORLD é")
!(fs:write "/tmp/cetta-str-lines-test.txt" "first\nsecond\nthird\n")
!(fs:read-lines-between "/tmp/cetta-str-lines-test.txt" 0 -1)
!(fs:read-lines-between "/tmp/cetta-str-lines-test.txt" 2 -1)
!(fs:read-lines-between "/tmp/cetta-str-lines-test.txt" 0 13)
