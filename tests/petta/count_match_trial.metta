; Every cardinality probe starts from the same unification state.
(= (trial-diagonal $space) (match $space (edge $x $x) matched))
!(bind! &trial-rows (new-space))
!(add-atom &trial-rows (edge a b))
!(add-atom &trial-rows (edge b c))
!(size-atom (collapse (trial-diagonal &trial-rows)))
!(add-atom &trial-rows (edge $stored c))
!(size-atom (collapse (trial-diagonal &trial-rows)))
!(size-atom (collapse (trial-diagonal &trial-rows)))
!(collapse (trial-diagonal &trial-rows))
!(let $answers (collapse (trial-diagonal &trial-rows)) (size-atom $answers))
!(add-atom &trial-rows (edge c c))
!(size-atom (collapse (trial-diagonal &trial-rows)))
!(collapse (trial-diagonal &trial-rows))
