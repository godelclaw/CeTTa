!(bind! &lexical-rows (new-space))
!(add-atom &lexical-rows (item first))
!(add-atom &lexical-rows (item first))
!(add-atom &lexical-rows (item second))
(= (captured-choices $left $right)
   (let $step (|-> ($unused) (match &lexical-rows (item $value) (Triple $left $right $value)))
     ($step ignored)))
!(collapse (let $answer (captured-choices $live $live) (let $live done $answer)))
!(bind! &lexical-effects (new-space))
(= (captured-effects $left $right)
   (let $step (|-> ($value)
        (let $unit (add-atom &lexical-effects (Seen $left $right $value))
          (superpose (($left $value) ($right $value)))))
     ($step payload)))
!(collapse (captured-effects left right))
!(collapse (match &lexical-effects $item $item))
(= (lexical-changing $item) (Old $item))
(= (captured-mutation $left $right)
   (let $step (|-> ($item) (Pair $left (lexical-changing (Pair $right $item))))
     (let $first ($step before)
       (let $unit (add-atom &self (= (lexical-changing $item) (New $item)))
         (Both $first (collapse ($step after)))))))
!(captured-mutation left right)
(= (captured-removal $left $right)
   (let $step (|-> ($item) (remove-atom &lexical-effects (Seen $left $right $item)))
     ($step payload)))
!(captured-removal left right)
!(collapse (match &lexical-effects $item $item))
(= (captured-admit-loop $remaining $left $right)
   (if (< $remaining 1) done
     (let $step (|-> ($item) (add-atom &lexical-effects (Event $left $right $item)))
       (let $unit ($step $remaining)
         (captured-admit-loop (- $remaining 1) $left $right)))))
!(captured-admit-loop 1000 left right)
!(size-atom (collapse (match &lexical-effects (Event left right $n) $n)))
(= (captured-cut $left $right)
   (let $item (superpose (first second))
     (let $step (|-> ($value) (let $unit (cut) (Triple $left $right $value)))
       ($step $item))))
!(collapse (captured-cut left right))
(: lexical-number (-> Number Number))
(= (lexical-number $number) $number)
(= (captured-typed $left $right)
   (let $step (|-> ($value) (Triple $left $right (lexical-number $value)))
     ($step "bad")))
!(collapse (captured-typed left right))
(= (captured-literal $left $right)
   (let $step (|-> ($unused)
        (let $unit (match &lexical-rows (item second) true)
          (Record $left $right 1729 "leased literal")))
     ($step ignored)))
!(let $answer (captured-literal $live $live) (let $live done $answer))
