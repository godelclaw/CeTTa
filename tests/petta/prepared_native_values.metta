!(import! &self (library str))
!(import! &self (library fs))
!(import! &self (library system))

;; A variable-headed singleton forces the producer through open-equation
;; answers. Its consumer may still use the prepared native wrapper.
(= (fixture:tail) (let $text "chunk" ($text)))
(= (fixture:chunks) (let $text "chunk" (cons-atom $text (fixture:tail))))
!(test (== (fixture:chunks) ("chunk" "chunk")) true)
!(test (size-atom (fixture:chunks)) 2)
!(test (__cetta_lib_str join "" (fixture:chunks)) "chunkchunk")
!(test (str:join "" (fixture:chunks)) "chunkchunk")
!(test (== (str:set (fixture:chunks)) (str:set ("chunk" "chunk"))) true)

(= (fixture:code-tail) (let $code 66 ($code)))
(= (fixture:codes) (cons-atom 65 (fixture:code-tail)))
!(test (str:from-codepoints (fixture:codes)) "AB")

;; Observing data must neither rerun the producer nor execute held code.
!(bind! &fixture-count (new-state 0))
(= (fixture:tick)
   (progn (change-state! &fixture-count (+ (get-state &fixture-count) 1)) "chunk"))
(= (fixture:once) (let $text (fixture:tick) (cons-atom $text (fixture:tail))))
!(test (str:join "" (fixture:once)) "chunkchunk")
!(test (get-state &fixture-count) 1)

;; Structural intrinsics and a native-return handoff share that boundary.
(= (fixture:intersection $left $right) (intersection-atom $left $right))
(= (fixture:remove $item $items) (remove-all-atom $item $items))
(= (fixture:equal $left $right) (== $left $right))
!(test (intersection-atom (fixture:chunks) ("chunk" "chunk")) ("chunk" "chunk"))
!(test (fixture:intersection (fixture:chunks) ("chunk" "chunk")) ("chunk" "chunk"))
!(test (remove-all-atom "chunk" (fixture:chunks)) ())
!(test (fixture:remove "chunk" (fixture:chunks)) ())
!(test (fixture:equal (fixture:chunks) ("chunk" "chunk")) true)
!(test (fixture:equal (fixture:chunks) ("other" "chunk")) false)
(= (fixture:number-tail) (let $number 1 ($number)))
(= (fixture:numbers) (cons-atom 2 (fixture:number-tail)))
(= (fixture:sort-after-native $numbers)
   (let $text (str:concat "x" "y")
     (if (== $text "xy") (sort-numbers-atom $numbers) ())))
!(test (fixture:sort-after-native (fixture:numbers)) (1 2))
(= (fixture:receipt-path)
   (str:concat (system:getenv-or-default "CETTA_VALUE_FIXTURE_DIR" ".") "/native-once.txt"))
(= (fixture:sort-after-write $numbers)
   (let* (($started (str:concat "x" "y"))
          ($written (fs:append-text (fixture:receipt-path) "once")))
     (sort-numbers-atom $numbers)))
!(fs:write (fixture:receipt-path) "")
!(test (fixture:sort-after-write (fixture:numbers)) (1 2))
!(test (fs:read-text (fixture:receipt-path)) "once")
!(test (case (str:join "" ((quote (fixture:tick))))
          (((Error $call $why) true) ($other false))) true)
!(test (get-state &fixture-count) 1)
