(= (select-open-loop $remaining $value)
   (if (< $remaining 1) $value
     (let $step
          (|-> ($candidate $fallback)
               (if (is-var $candidate)
                   (cons $candidate $fallback)
                   $fallback))
       (select-open-loop (- $remaining 1) ($step () $value)))))
(= (make-pair $left $right)
   (let $step (|-> ($a $b) (Pair $a $b)) ($step $left $right)))
(= (observe-variable $value)
   (let $step (|-> ($item) (is-var $item)) ($step $value)))
(= (branch-variable $condition)
   (let $step (|-> ($item) (if $item left right)) ($step $condition)))
(= (nonlinear $value)
   (let $step (|-> ($item) (case $item (((Pair $x $x) equal) ($other different))))
     ($step $value)))
!(let $answer (select-open-loop 1000 $live) (let $live done $answer))
!(let $pair (make-pair $live $live) (let $live done $pair))
!(let $first (make-pair $a $a)
   (let $second (make-pair $b $b)
     (let $a first (let $b second (Both $first $second)))))
!(let $before (observe-variable $live) (let $live done $before))
!(collapse (let $answer (branch-variable $condition) (Chosen $condition $answer)))
!(collapse (nonlinear (Pair $left $right)))
!(collapse (let $answer (nonlinear (Pair $left $right))
   (let $left left (let $right right $answer))))
(= (construct-open $head $tail)
   (let $step (|-> ($h $t) (cons $h $t)) ($step $head $tail)))
!(let $list (construct-open first $tail) (let $tail (second third) $list))
(= (captured-loop $remaining $sum)
   (if (< $remaining 1) $sum
     (let $step (|-> ($value) (+ $value $remaining))
       (captured-loop (- $remaining 1) (+ $sum ($step 0))))))
!(captured-loop 3 0)
!(captured-loop 5 0)
(= (capture-return $captured)
   (let $step (|-> ($unused) $captured) ($step ignored)))
(= (capture-observe $captured)
   (let $step (|-> ($unused) (is-var $captured)) ($step ignored)))
!(let $answer (capture-return $live) (let $live held $answer))
!(let $before (capture-observe $live)
   (let $live done (Pair $before (capture-observe $live))))
!(Pair (observe-variable done) (observe-variable $live))
