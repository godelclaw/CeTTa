; PeTTa arithmetic off the native fast path is SWI-Prolog's is/2 and
; arithmetic comparison, as the reference runs them: a build with SWI asks
; it, a build without computes the same values and raises the same errors.
; The expected answers are the Prolog build's: SWI 10's wherever the fast
; path hands a question over.
(= (row $q $v) ($q $v))

; Operands that are not numbers: is/2 evaluates a function's arguments from the last
!(row "(+ 1 a)" (catch (+ 1 a)))
!(row "(+ a 2)" (catch (+ a 2)))
!(row "(+ 1 $x)" (catch (+ 1 $x)))
!(row "(+ $x 2)" (catch (+ $x 2)))
!(row "(+ 1 True)" (catch (+ 1 True)))
!(row "(+ True 2)" (catch (+ True 2)))
!(row "(+ 1 False)" (catch (+ 1 False)))
!(row "(+ False 2)" (catch (+ False 2)))
!(row "(+ 1 pi)" (catch (+ 1 pi)))
!(row "(+ pi 2)" (catch (+ pi 2)))
!(row "(+ 1 e)" (catch (+ 1 e)))
!(row "(+ e 2)" (catch (+ e 2)))
!(row "(+ 1 epsilon)" (catch (+ 1 epsilon)))
!(row "(+ epsilon 2)" (catch (+ epsilon 2)))
!(row "(+ 1 inf)" (catch (+ 1 inf)))
!(row "(+ inf 2)" (catch (+ inf 2)))
!(row "(+ 1 nan)" (catch (+ 1 nan)))
!(row "(+ nan 2)" (catch (+ nan 2)))
!(row "(+ 1 max_tagged_integer)" (catch (+ 1 max_tagged_integer)))
!(row "(+ max_tagged_integer 2)" (catch (+ max_tagged_integer 2)))
!(row "(+ 1 random)" (catch (+ 1 random)))
!(row "(+ random 2)" (catch (+ random 2)))
!(row "(+ 1 realtime)" (catch (+ 1 realtime)))
!(row "(+ realtime 2)" (catch (+ realtime 2)))
!(row "(+ 1 'x')" (catch (+ 1 "x")))
!(row "(+ 'x' 2)" (catch (+ "x" 2)))
!(row "(+ 1 (1 2))" (catch (+ 1 (1 2))))
!(row "(+ (1 2) 2)" (catch (+ (1 2) 2)))
!(row "(+ 1 ())" (catch (+ 1 ())))
!(row "(+ () 2)" (catch (+ () 2)))
!(row "(+ a b)" (catch (+ a b)))
!(row "(+ a $x)" (catch (+ a $x)))
!(row "(+ $x a)" (catch (+ $x a)))
!(row "(- foo 'x')" (catch (- foo "x")))
!(row "(* 'x' foo)" (catch (* "x" foo)))
!(row "(/ $y $z)" (catch (/ $y $z)))
!(row "(% b a)" (catch (% b a)))
!(row "(pow-math a b)" (catch (pow-math a b)))

; A comparison evaluates each operand on its own, the left first
!(row "(< 1 a)" (catch (< 1 a)))
!(row "(>= a 2)" (catch (>= a 2)))
!(row "(< 1 $x)" (catch (< 1 $x)))
!(row "(>= $x 2)" (catch (>= $x 2)))
!(row "(< 1 True)" (catch (< 1 True)))
!(row "(>= True 2)" (catch (>= True 2)))
!(row "(< 1 pi)" (catch (< 1 pi)))
!(row "(>= pi 2)" (catch (>= pi 2)))
!(row "(< 1 inf)" (catch (< 1 inf)))
!(row "(>= inf 2)" (catch (>= inf 2)))
!(row "(< 1 nan)" (catch (< 1 nan)))
!(row "(>= nan 2)" (catch (>= nan 2)))
!(row "(< 1 'x')" (catch (< 1 "x")))
!(row "(>= 'x' 2)" (catch (>= "x" 2)))
!(row "(< 1 (1 2))" (catch (< 1 (1 2))))
!(row "(>= (1 2) 2)" (catch (>= (1 2) 2)))
!(row "(< a b)" (catch (< a b)))
!(row "(> $x a)" (catch (> $x a)))
!(row "(<= 1 nan)" (catch (<= 1 nan)))
!(row "(>= nan nan)" (catch (>= nan nan)))
!(row "(< 1 inf)" (catch (< 1 inf)))
!(row "(> inf 1)" (catch (> inf 1)))
!(row "(<= 1 1.0)" (catch (<= 1 1.0)))
!(row "(< 1 1.0)" (catch (< 1 1.0)))
!(row "(< 9007199254740993 9007199254740992.0)" (catch (< 9007199254740993 9007199254740992.0)))
!(row "(<= 9007199254740993 9007199254740992.0)" (catch (<= 9007199254740993 9007199254740992.0)))
!(row "(min a 1)" (catch (min a 1)))
!(row "(max 1 $x)" (catch (max 1 $x)))

; Float results: an infinity overflows, NaN is undefined, a subnormal stands
!(row "(+ 1e308 1e308)" (catch (+ 1e308 1e308)))
!(row "(* 1e308 10.0)" (catch (* 1e308 10.0)))
!(row "(- -1e308 1e308)" (catch (- -1e308 1e308)))
!(row "(+ inf 0)" (catch (+ inf 0)))
!(row "(- 1 inf)" (catch (- 1 inf)))
!(row "(+ nan 0)" (catch (+ nan 0)))
!(row "(* 0 inf)" (catch (* 0 inf)))
!(row "(- inf inf)" (catch (- inf inf)))
!(row "(* 5e-324 0.5)" (catch (* 5e-324 0.5)))
!(row "(/ 2.2250738585072014e-308 2)" (catch (/ 2.2250738585072014e-308 2)))
!(row "(* 5e-324 1)" (catch (* 5e-324 1)))
!(row "(+ -0.0 0.0)" (catch (+ -0.0 0.0)))
!(row "(* -0.0 1)" (catch (* -0.0 1)))
!(row "(+ 1.5 2)" (catch (+ 1.5 2)))
!(row "(- 0.5 1)" (catch (- 0.5 1)))

; Division
!(row "(/ 1 0)" (catch (/ 1 0)))
!(row "(/ 0 0)" (catch (/ 0 0)))
!(row "(/ 1.0 0)" (catch (/ 1.0 0)))
!(row "(/ 0.0 0)" (catch (/ 0.0 0)))
!(row "(/ 0 0.0)" (catch (/ 0 0.0)))
!(row "(/ -1 0.0)" (catch (/ -1 0.0)))
!(row "(/ 1 -0.0)" (catch (/ 1 -0.0)))
!(row "(/ 1 inf)" (catch (/ 1 inf)))
!(row "(/ -1 inf)" (catch (/ -1 inf)))
!(row "(/ 1.0 inf)" (catch (/ 1.0 inf)))
!(row "(/ -2.5 inf)" (catch (/ -2.5 inf)))
!(row "(/ inf inf)" (catch (/ inf inf)))
!(row "(/ nan inf)" (catch (/ nan inf)))
!(row "(/ 7 2)" (catch (/ 7 2)))
!(row "(/ 6 2)" (catch (/ 6 2)))
!(row "(/ 3 -3)" (catch (/ 3 -3)))
!(row "(/ -9223372036854775808 -1)" (catch (/ -9223372036854775808 -1)))
!(row "(/ 123456789012345678901234567890 3)" (catch (/ 123456789012345678901234567890 3)))
!(row "(/ 123456789012345678901234567891 3)" (catch (/ 123456789012345678901234567891 3)))
!(row "(/ 18446744073709551617 2)" (catch (/ 18446744073709551617 2)))
!(row "(/ 10.0 4)" (catch (/ 10.0 4)))

; mod: integers only, the sign of the divisor
!(row "(% 1.5 2)" (catch (% 1.5 2)))
!(row "(% 1 1.5)" (catch (% 1 1.5)))
!(row "(% 1.5 2.5)" (catch (% 1.5 2.5)))
!(row "(% 1 0)" (catch (% 1 0)))
!(row "(% 0 0)" (catch (% 0 0)))
!(row "(% 1 0.0)" (catch (% 1 0.0)))
!(row "(% 1.5 0)" (catch (% 1.5 0)))
!(row "(% nan 2)" (catch (% nan 2)))
!(row "(% inf 2)" (catch (% inf 2)))
!(row "(% 2 inf)" (catch (% 2 inf)))
!(row "(% -7 2)" (catch (% -7 2)))
!(row "(% 7 -2)" (catch (% 7 -2)))
!(row "(% -7 -3)" (catch (% -7 -3)))
!(row "(% -9223372036854775808 -1)" (catch (% -9223372036854775808 -1)))
!(row "(% 123456789012345678901234567890 7)" (catch (% 123456789012345678901234567890 7)))
!(row "(% -7 123456789012345678901234567890)" (catch (% -7 123456789012345678901234567890)))
!(row "(% 1 pi)" (catch (% 1 pi)))
!(row "(% e 2)" (catch (% e 2)))

; Powers
!(row "(pow-math 2 -1)" (catch (pow-math 2 -1)))
!(row "(pow-math 1 -1)" (catch (pow-math 1 -1)))
!(row "(pow-math -1 -1)" (catch (pow-math -1 -1)))
!(row "(pow-math -1 -2)" (catch (pow-math -1 -2)))
!(row "(pow-math 0 -1)" (catch (pow-math 0 -1)))
!(row "(pow-math 0 0)" (catch (pow-math 0 0)))
!(row "(pow-math 0.0 -1)" (catch (pow-math 0.0 -1)))
!(row "(pow-math -0.0 -1)" (catch (pow-math -0.0 -1)))
!(row "(pow-math 0 -2)" (catch (pow-math 0 -2)))
!(row "(pow-math 3 -2)" (catch (pow-math 3 -2)))
!(row "(pow-math -2 -3)" (catch (pow-math -2 -3)))
!(row "(pow-math 2 -1074)" (catch (pow-math 2 -1074)))
!(row "(pow-math 2.0 -1075)" (catch (pow-math 2.0 -1075)))
!(row "(pow-math 2 0.5)" (catch (pow-math 2 0.5)))
!(row "(pow-math -8 0.5)" (catch (pow-math -8 0.5)))
!(row "(pow-math 2 nan)" (catch (pow-math 2 nan)))
!(row "(pow-math nan 0)" (catch (pow-math nan 0)))
!(row "(pow-math 1 nan)" (catch (pow-math 1 nan)))
!(row "(pow-math inf 0)" (catch (pow-math inf 0)))
!(row "(pow-math 0 inf)" (catch (pow-math 0 inf)))
!(row "(pow-math 2 inf)" (catch (pow-math 2 inf)))
!(row "(pow-math 0.5 inf)" (catch (pow-math 0.5 inf)))
!(row "(pow-math 10 400.0)" (catch (pow-math 10 400.0)))
!(row "(pow-math 10.0 400)" (catch (pow-math 10.0 400)))
!(row "(pow-math 2 100)" (catch (pow-math 2 100)))
!(row "(pow-math -3 3)" (catch (pow-math -3 3)))
!(row "(pow-math 2 9223372036854775808)" (catch (pow-math 2 9223372036854775808)))
!(row "(pow-math 123456789012345678901234567890 9223372036854775808)" (catch (pow-math 123456789012345678901234567890 9223372036854775808)))
!(row "(pow-math 1 9223372036854775808)" (catch (pow-math 1 9223372036854775808)))
!(row "(pow-math -1 9223372036854775809)" (catch (pow-math -1 9223372036854775809)))
!(row "(pow-math 0 9223372036854775808)" (catch (pow-math 0 9223372036854775808)))
!(row "(pow-math -1 9223372036854775808)" (catch (pow-math -1 9223372036854775808)))
!(row "(pow-math 18446744073709557761 -1)" (catch (pow-math 18446744073709557761 -1)))
!(row "(pow-math -18446744073709557761 -1)" (catch (pow-math -18446744073709557761 -1)))
!(row "(pow-math 36893488147419115521 -2)" (catch (pow-math 36893488147419115521 -2)))
!(row "(pow-math  -1)" (catch (pow-math  -1)))

; Functions of one argument
!(row "(sqrt-math -1)" (catch (sqrt-math -1)))
!(row "(sqrt-math -0.0)" (catch (sqrt-math -0.0)))
!(row "(sqrt-math 4)" (catch (sqrt-math 4)))
!(row "(sqrt-math inf)" (catch (sqrt-math inf)))
!(row "(sqrt-math nan)" (catch (sqrt-math nan)))
!(row "(log-math 2 0)" (catch (log-math 2 0)))
!(row "(log-math 2 -1)" (catch (log-math 2 -1)))
!(row "(log-math 2 8)" (catch (log-math 2 8)))
!(row "(log-math 0 8)" (catch (log-math 0 8)))
!(row "(log-math 2 inf)" (catch (log-math 2 inf)))
!(row "(asin-math 1.5)" (catch (asin-math 1.5)))
!(row "(acos-math -2)" (catch (acos-math -2)))
!(row "(asin-math nan)" (catch (asin-math nan)))
!(row "(tan-math inf)" (catch (tan-math inf)))
!(row "(atan-math nan)" (catch (atan-math nan)))
!(row "(atan-math inf)" (catch (atan-math inf)))
!(row "(sin-math inf)" (catch (sin-math inf)))
!(row "(cos-math nan)" (catch (cos-math nan)))
!(row "(sqrt-math a)" (catch (sqrt-math a)))
!(row "(sin-math $x)" (catch (sin-math $x)))
!(row "(tan-math 'x')" (catch (tan-math "x")))
!(row "(trunc-math inf)" (catch (trunc-math inf)))
!(row "(trunc-math -inf)" (catch (trunc-math -inf)))
!(row "(trunc-math nan)" (catch (trunc-math nan)))
!(row "(ceil-math nan)" (catch (ceil-math nan)))
!(row "(floor-math inf)" (catch (floor-math inf)))
!(row "(round-math nan)" (catch (round-math nan)))
!(row "(round-math 2.5)" (catch (round-math 2.5)))
!(row "(round-math -2.5)" (catch (round-math -2.5)))
!(row "(round-math 0.5)" (catch (round-math 0.5)))
!(row "(round-math -0.5)" (catch (round-math -0.5)))
!(row "(round-math -0.0)" (catch (round-math -0.0)))
!(row "(round-math 1e300)" (catch (round-math 1e300)))
!(row "(round-math 9223372036854775808.0)" (catch (round-math 9223372036854775808.0)))
!(row "(round-math 4503599627370497.0)" (catch (round-math 4503599627370497.0)))
!(row "(trunc-math -0.5)" (catch (trunc-math -0.5)))
!(row "(ceil-math -0.5)" (catch (ceil-math -0.5)))
!(row "(floor-math -2.5)" (catch (floor-math -2.5)))
!(row "(trunc-math 1e20)" (catch (trunc-math 1e20)))
!(row "(abs-math -inf)" (catch (abs-math -inf)))
!(row "(abs-math nan)" (catch (abs-math nan)))
!(row "(abs-math -9223372036854775808)" (catch (abs-math -9223372036854775808)))
!(row "(abs-math -0.0)" (catch (abs-math -0.0)))
!(row "(floor-math a)" (catch (floor-math a)))
!(row "(round-math $x)" (catch (round-math $x)))

; Constants whose value is the clock or chance
!(row "cputime" (catch (>= cputime 0)))
!(row "random_float" (catch (and (> random_float 0) (< random_float 1))))

; Rationals
!(pragma! prefer-rationals True)
!(let $r (/ 1 3) (row "(+ 1/3 0.5)" (catch (+ $r 0.5))))
!(let $r (/ 1 3) (row "(% 1/3 2)" (catch (% $r 2))))
!(let $r (/ 1 3) (row "(< 1/3 0.3333333333333333)" (catch (< $r 0.3333333333333333))))
!(let $r (/ 1 3) (row "(>= 1/3 0.3333333333333333)" (catch (>= $r 0.3333333333333333))))
!(let $r (/ 1 3) (row "(sqrt-math 1/3)" (catch (sqrt-math $r))))
!(let $r (/ 1 3) (row "(pow-math 1/3 2)" (catch (pow-math $r 2))))
!(let $r (/ 1 3) (row "(pow-math 1/3 -2)" (catch (pow-math $r -2))))
!(let $r (/ 1 3) (row "(pow-math -8 1/3)" (catch (pow-math -8 $r))))
!(let $r (/ 1 3) (row "(pow-math -7 1/3)" (catch (pow-math -7 $r))))
!(let $r (/ 1 3) (row "(pow-math -8.0 1/3)" (catch (pow-math -8.0 $r))))
!(let $r (/ 1 3) (row "(round-math 1/3)" (catch (round-math $r))))
!(let $r (/ 1 3) (row "(abs-math 1/3)" (catch (abs-math $r))))
!(let $r (/ 1 3) (row "(+ 1/3 inf)" (catch (+ $r inf))))
!(let $r (/ 1 3) (row "(/ 1/3 0)" (catch (/ $r 0))))
!(let $r (/ 1 3) (row "(pow-math 27 1/3)" (catch (pow-math 27 $r))))
!(let $r (/ 1 3) (row "(pow-math 0.0 1/3)" (catch (pow-math 0.0 $r))))
!(let $b (/ 3458764513820541313 3) (row "(< 3458764513820541313/3 1152921504606847232.0)" (catch (< $b 1152921504606847232.0))))
!(let $b (/ 3458764513820541313 3) (row "(>= 3458764513820541313/3 1152921504606847232.0)" (catch (>= $b 1152921504606847232.0))))
!(let $b (/ 3458764513820541313 3) (row "(> 3458764513820541313/3 1152921504606846976.0)" (catch (> $b 1152921504606846976.0))))
!(let $b (/ 3458764513820541313 3) (row "(pow-math 3458764513820541313/3 -1)" (catch (pow-math $b -1))))
!(let $h (/ 1 2) (row "(pow-math 1/2 -1)" (catch (pow-math $h -1))))
!(let $h (/ 1 2) (row "(pow-math 4 1/2)" (catch (pow-math 4 $h))))
!(let $h (/ 1 2) (row "(pow-math -4 1/2)" (catch (pow-math -4 $h))))
!(let $h (/ 1 2) (row "(pow-math 2.0 1/2)" (catch (pow-math 2.0 $h))))
!(let $h (/ 1 2) (row "(round-math (* 1/2 -7))" (catch (round-math (* $h -7)))))
!(let $h (/ 1 2) (row "(floor-math (* 1/2 -7))" (catch (floor-math (* $h -7)))))
!(let $h (/ 1 2) (row "(ceil-math (* 1/2 7))" (catch (ceil-math (* $h 7)))))
!(let $h (/ 1 2) (row "(trunc-math (* 1/2 -7))" (catch (trunc-math (* $h -7)))))
