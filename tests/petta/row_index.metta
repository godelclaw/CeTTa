!(import! &self (library lib_row_index))
!(bind! &projection (new-state Missing))
!(let $index (index:new 1 4 2) (let $saved (change-state! &projection $index) ()))
!(index:insert (get-state &projection) 0 "group" "a")
!(index:insert (get-state &projection) 1 "group" "b")
!(index:insert (get-state &projection) 2 "group" "a")
!(index:insert (get-state &projection) 2 "time" 10)
!(index:insert (get-state &projection) 3 "time" 11)
!(tensor:to-expr (index:mask 1 (get-state &projection) (Eq "group" "a")))
!(tensor:to-expr (index:mask 1 (get-state &projection) (And ((Eq "group" "a") (Eq "time" 10)))))
!(tensor:to-expr (index:mask 1 (get-state &projection) (Or ((Eq "group" "b") (Eq "time" 11)))))
!(tensor:to-expr (index:mask 1 (get-state &projection) (Eq "missing" "a")))
!(tensor:to-expr (index:mask 1 (get-state &projection) (And ())))
!(tensor:to-expr (index:mask 1 (get-state &projection) (Or ())))
!(index:mask 2 (get-state &projection) All)
; Cached selectors are discarded on insertion, even when the row count agrees.
!(tensor:to-expr (index:mask 1 (get-state &projection) (Eq "group" "a")))
!(index:insert (get-state &projection) 3 "group" "a")
!(tensor:to-expr (index:mask 1 (get-state &projection) (Eq "group" "a")))
!(index:insert (get-state &projection) -1 "group" "bad")
!(index:insert (get-state &projection) 4 "group" "bad")
!(index:insert (get-state &projection) 0.5 "group" "bad")
!(index:new 1 -1 2)
!(index:new 1 4 -1)
!(index:new 1 4 0.5)
!(index:describe (get-state &projection))
!(index:mask 1 (get-state &projection) (Unknown "group" "a"))
!(index:insert (get-state &projection) 0 "number" 1)
!(index:insert (get-state &projection) 1 "number" 1.0)
!(tensor:to-expr (index:mask 1 (get-state &projection) (Eq "number" 1)))
!(tensor:to-expr (index:mask 1 (get-state &projection) (Eq "number" 1.0)))
