(: inc (-> Number Number))
(= (inc $x) (+ $x 1))
(= (loop $n $acc) (if (== $n 0) $acc (loop (- $n 1) (inc $acc))))
(: fact (-> Number Number))
(= (fact $n) (if (== $n 0) 1 (* $n (fact (- $n 1)))))
(: same (-> %Undefined% %Undefined%))
(= (same $x) $x)
(: neg (-> Bool Bool))
(= (neg $b) (if $b False True))
(= (flips $n $b) (if (== $n 0) $b (flips (- $n 1) (neg $b))))
(: wrong (-> Number String))
(= (wrong $x) (+ $x 1))
(= (via $v) (inc $v))
(: f (-> Number Number))
(= (f $x) (* $x 10))
!(loop 2000 0)
!(fact 15)
!(same (+ 1 2))
!(flips 101 True)
!(inc (inc 1))
!(collapse (inc "s"))
!(collapse (via "s"))
!(collapse (via foo))
!(collapse (wrong 1))
!(f 5)
