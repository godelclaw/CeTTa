; Wildcards are chosen before a result request binds a declaration variable.
(: (confirmation-pattern a) A)
(: (confirmation-pattern b) A)
(: confirmation-wild (-> %Undefined% Result))
(: confirmation-any (-> _ Result))
(: confirmation-shared (-> $t $t))
!(test (collapse (let Result (get-type (quote (confirmation-wild (confirmation-pattern $x)))) (is-var $x))) (True))
!(test (collapse (let Result (get-type (quote (confirmation-any (confirmation-pattern $x)))) (is-var $x))) (True))
!(test (collapse (let %Undefined% (get-type (quote (confirmation-shared (confirmation-pattern $x)))) wrong)) ())
(: confirmation-request (-> Number A))
!(test (collapse (let $x (get-type (quote (confirmation-request $x))) $x)) (A))
(: confirmation-mixed A)
(: confirmation-mixed %Undefined%)
(: confirmation-mixed B)
(: confirmation-mixed %Undefined%)
!(test (collapse (let %Undefined% (get-type confirmation-mixed) found)) (found found))
!(test (collapse (let Missing (get-type confirmation-mixed) wrong)) ())
