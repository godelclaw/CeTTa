(: arity-inc (-> Number Number))
(: arity-inc (-> Number Number Number))
(= (arity-inc $x) (+ $x 1))
!(collapse (arity-inc 1))
!(collapse (arity-inc "wrong"))
(: arity-reverse (-> Number Number Number))
(: arity-reverse (-> Number Number))
(= (arity-reverse $x) (+ $x 1))
!(collapse (arity-reverse 1))
(: arity-raw (-> Atom %Undefined%))
(: arity-raw (-> Atom Atom %Undefined%))
(= (arity-raw $x) (Single $x))
(= (arity-raw $x $y) (Pair $x $y))
!(collapse (arity-raw (+ 1 2)))
!(collapse (arity-raw (+ 1 2) (+ 3 4)))
(: arity-untyped (-> Number Number Number))
(= (arity-untyped $x) $x)
!(collapse (arity-untyped value))
(: arity-duplicates (-> Number Number))
(: arity-duplicates (-> Number Number Number))
(= (arity-duplicates $x) (+ $x 1))
(= (arity-duplicates $x) (+ $x 1))
!(collapse (arity-duplicates 1))
(: arity-overloads (-> Number %Undefined%))
(: arity-overloads (-> %Undefined% %Undefined%))
(= (arity-overloads $x) $x)
!(collapse (arity-overloads 1))
(: arity-partial (-> Number Number %Undefined%))
(= (arity-partial $x $y) (+ $x $y))
!(collapse ((arity-partial 1) 2))
(: arity-strict-partial (-> Number Number Number))
(= (arity-strict-partial $x $y) (+ $x $y))
!(collapse (arity-strict-partial 1))
(: arity-effect (-> Number %Undefined%))
(: arity-effect (-> Number Number %Undefined%))
(= (arity-effect $x) (let $added (add-atom &self (AritySeen $x)) $x))
!(collapse (arity-effect 7))
!(collapse (match &self (AritySeen $x) $x))
