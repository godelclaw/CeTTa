; Stable term comparison shares msort's order; it is not numeric equality.
!(test (@< 1 2) True)
!(test (@> 2 1) True)
!(test (@<= 1 1) True)
!(test (@>= 1 1) True)
!(test (@< 1 1) False)
!(test (@> 1 1) False)
!(test (@< 1.0 1) True)
!(test (@< 2 1.0) False)
!(test (@< 1 "a") True)
!(test (@< "a" ()) True)
!(test (@< () a) True)
!(test (@< a (a)) True)
!(test (@< (a 2) (a 10)) True)
!(test (@< (a) (a 0)) True)
!(test (@> (b 0) (a 100)) True)
!(test (@< $x 0) True)
!(test (@<= $x $x) True)
!(test (@> $x $x) False)
; Comparing code-shaped data must not run it a second time.
!(bind! &order-count (new-state 0))
(= (order-tick) (change-state! &order-count 1))
!(test (let $value (quote (order-tick)) (@< a $value)) True)
!(test (get-state &order-count) 0)
!(test ((@< 1) 2) True)
!(test (let $compare @>= (($compare 2) 1)) True)
!(test (get-metatype @<) Grounded)
