; The reference prelude's exp, implies, =? and CLP(FD) functions and
; relations, on arguments the two builds answer alike: a build with SWI asks
; its prelude and library(clpfd), a build without answers natively. The
; expected answers are the Prolog build's. A CLP(FD) argument left unbound
; would need the solver; that is clpfd_unbound_core.metta, for builds
; without Prolog.
(= (row $q $v) ($q $v))

; exp/1: R is exp(Arg)
!(row "(exp 0)" (catch (exp 0)))
!(row "(exp 1)" (catch (exp 1)))
!(row "(exp -1)" (catch (exp -1)))
!(row "(exp 2.5)" (catch (exp 2.5)))
!(row "(exp -1000)" (catch (exp -1000)))
!(row "(exp 1000)" (catch (exp 1000)))
!(row "(exp 1.0e308)" (catch (exp 1.0e308)))
!(row "(exp 9223372036854775807)" (catch (exp 9223372036854775807)))
!(row "(exp 18446744073709551616)" (catch (exp 18446744073709551616)))
!(row "(exp a)" (catch (exp a)))
!(row "(exp $x)" (catch (exp $x)))
!(row "(exp 1 2)" (catch (exp 1 2)))

; implies/2: bool(A), bool(B); an unbound one is enumerated true, then false
!(row "(implies True True)" (catch (implies True True)))
!(row "(implies True False)" (catch (implies True False)))
!(row "(implies False True)" (catch (implies False True)))
!(row "(implies False False)" (catch (implies False False)))
!(row "(implies True 1)" (catch (implies True 1)))
!(row "(implies a True)" (catch (implies a True)))
!(row "(implies True \"s\")" (catch (implies True "s")))
!(row "(implies $x True)" (catch (implies $x True)))
!(row "(implies True $y)" (catch (implies True $y)))
!(row "(implies $x $y)" (catch (implies $x $y)))
!(row "(implies $x $y) binds" (let $r (implies $x $y) ($x $y $r)))

; =?/2: \+ \+ A = B
!(row "(=? a a)" (catch (=? a a)))
!(row "(=? a b)" (catch (=? a b)))
!(row "(=? $x a)" (catch (=? $x a)))
!(row "(=? (f $x) (f a))" (catch (=? (f $x) (f a))))
!(row "(=? (f $x b) (f a $x))" (catch (=? (f $x b) (f a $x))))
!(row "(=? (f $x $x) (f a b))" (catch (=? (f $x $x) (f a b))))
!(row "(=? (f a $y) (f $z b))" (catch (=? (f a $y) (f $z b))))
!(row "(=? (f $x) (g $x))" (catch (=? (f $x) (g $x))))
!(row "(=? 1 1.0)" (catch (=? 1 1.0)))
!(row "(=? \"s\" \"s\")" (catch (=? "s" "s")))
!(row "(=? $x $y)" (catch (=? $x $y)))
!(row "(=? $x a) leaves $x" (let $r (=? $x a) ($r $x)))

; CLP(FD) functions on bound integers, small and big
!(row "(#+ 3 4)" (catch (#+ 3 4)))
!(row "(#- 3 4)" (catch (#- 3 4)))
!(row "(#* 3 -4)" (catch (#* 3 -4)))
!(row "(#div 7 2)" (catch (#div 7 2)))
!(row "(#div -7 2)" (catch (#div -7 2)))
!(row "(#div 7 -2)" (catch (#div 7 -2)))
!(row "(#div 0 7)" (catch (#div 0 7)))
!(row "(#// 7 2)" (catch (#// 7 2)))
!(row "(#// -7 2)" (catch (#// -7 2)))
!(row "(#// 7 -2)" (catch (#// 7 -2)))
!(row "(#mod 7 2)" (catch (#mod 7 2)))
!(row "(#mod -7 2)" (catch (#mod -7 2)))
!(row "(#mod 7 -2)" (catch (#mod 7 -2)))
!(row "(#mod -7 -2)" (catch (#mod -7 -2)))
!(row "(#min 3 4)" (catch (#min 3 4)))
!(row "(#max 3 4)" (catch (#max 3 4)))
!(row "(#+ 9223372036854775806 1)" (catch (#+ 9223372036854775806 1)))
!(row "(#+ 9223372036854775807 1)" (catch (#+ 9223372036854775807 1)))
!(row "(#- -9223372036854775807 2)" (catch (#- -9223372036854775807 2)))
!(row "(#* 4611686018427387904 4)" (catch (#* 4611686018427387904 4)))
!(row "(#+ 18446744073709551616 1)" (catch (#+ 18446744073709551616 1)))
!(row "(#div -9223372036854775808 -1)" (catch (#div -9223372036854775808 -1)))
!(row "(#// -9223372036854775808 -1)" (catch (#// -9223372036854775808 -1)))
!(row "(#div 36893488147419103232 -7)" (catch (#div 36893488147419103232 -7)))
!(row "(#// 36893488147419103232 -7)" (catch (#// 36893488147419103232 -7)))
!(row "(#mod 36893488147419103232 -7)" (catch (#mod 36893488147419103232 -7)))
!(row "(#min 18446744073709551616 3)" (catch (#min 18446744073709551616 3)))
!(row "(#max -18446744073709551616 3)" (catch (#max -18446744073709551616 3)))
; a zero divisor has no solution
!(row "(#div 7 0)" (catch (#div 7 0)))
!(row "(#// 7 0)" (catch (#// 7 0)))
!(row "(#mod 7 0)" (catch (#mod 7 0)))
!(row "(#div $x 0)" (catch (#div $x 0)))
; a bound argument that is not an integer is not a clpfd expression
!(row "(#+ 1.5 2)" (catch (#+ 1.5 2)))
!(row "(#- a 2)" (catch (#- a 2)))
!(row "(#* True 1)" (catch (#* True 1)))
!(row "(#div \"s\" 1)" (catch (#div "s" 1)))
!(row "(#max (f 1) 2)" (catch (#max (f 1) 2)))
!(row "(#+ $x 1.5)" (catch (#+ $x 1.5)))
!(row "(#min 1 a)" (catch (#min 1 a)))

; CLP(FD) relations on bound integers
!(row "(#< 3 4)" (catch (#< 3 4)))
!(row "(#< 4 3)" (catch (#< 4 3)))
!(row "(#> 4 3)" (catch (#> 4 3)))
!(row "(#> 3 4)" (catch (#> 3 4)))
!(row "(#= 3 3)" (catch (#= 3 3)))
!(row "(#= 3 4)" (catch (#= 3 4)))
!(row "(#\\= 3 4)" (catch (#\= 3 4)))
!(row "(#\\= 3 3)" (catch (#\= 3 3)))
!(row "(#< 18446744073709551616 3)" (catch (#< 18446744073709551616 3)))
!(row "(#= 18446744073709551616 18446744073709551616)" (catch (#= 18446744073709551616 18446744073709551616)))
!(row "(#< 1.5 2)" (catch (#< 1.5 2)))
!(row "(#< $x a)" (catch (#< $x a)))
!(row "(#= (f 1) 2)" (catch (#= (f 1) 2)))
