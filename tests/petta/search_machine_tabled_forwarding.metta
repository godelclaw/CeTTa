;; A table whose generator ends in a call of a complete table delivers that
;; table's answers through an edge.  Every observation here equals the one a
;; flat replay gives: answers, order, multiplicities and effects.
!(import! &self (library lib_tabling))
!(import! &self (library lib_memo))

;; A chain: each table forwards to its parent's table.
!(tabled (chain_anc $c))
(chain_parent c1 c0)
(chain_parent c2 c1)
(chain_parent c3 c2)
(chain_parent c4 c3)
(chain_parent c5 c4)
(chain_parent c6 c5)
(chain_parent c7 c6)
(chain_parent c8 c7)
(chain_parent c9 c8)
(chain_parent c10 c9)
(chain_parent c11 c10)
(chain_parent c12 c11)
(chain_parent c13 c12)
(chain_parent c14 c13)
(chain_parent c15 c14)
(chain_parent c16 c15)
(= (chain_anc $c) (match &self (chain_parent $p $c) $p))
(= (chain_anc $c) (match &self (chain_parent $p $c) (chain_anc $p)))
!(collapse (chain_anc c0))
!(collapse (chain_anc c8))

;; The edge before the own answer: a reader returns to the own answer.
!(tabled (rev_anc $c))
(rev_parent r1 r0)
(rev_parent r2 r1)
(rev_parent r3 r2)
(rev_parent r4 r3)
(rev_parent r5 r4)
(rev_parent r6 r5)
(rev_parent r7 r6)
(rev_parent r8 r7)
(= (rev_anc $c) (match &self (rev_parent $p $c) (rev_anc $p)))
(= (rev_anc $c) (match &self (rev_parent $p $c) $p))
!(collapse (rev_anc r0))

;; The equation form of the chain.
!(tabled (eq_anc $c))
(= (eq_parent e0) e1)
(= (eq_parent e1) e2)
(= (eq_parent e2) e3)
(= (eq_parent e3) e4)
(= (eq_parent e4) e5)
(= (eq_parent e5) e6)
(= (eq_parent e6) e7)
(= (eq_parent e7) e8)
(= (eq_anc $c) (eq_parent $c))
(= (eq_anc $c) (eq_anc (eq_parent $c)))
!(collapse (eq_anc e0))

;; A diamond: the second parent's table is replayed; top is delivered once.
!(tabled (dia_anc $c))
(dia_parent da d0)
(dia_parent db d0)
(dia_parent dtop da)
(dia_parent dtop db)
(= (dia_anc $c) (match &self (dia_parent $p $c) $p))
(= (dia_anc $c) (match &self (dia_parent $p $c) (dia_anc $p)))
!(collapse (dia_anc d0))

;; An own answer that the forwarded table also delivers: the edge is refused.
!(tabled (ovl_anc $c))
(ovl_parent v1 v0)
(ovl_parent v2 v1)
(ovl_parent v1 v2)
(= (ovl_anc $c) (match &self (ovl_parent $p $c) $p))
(= (ovl_anc $c) (match &self (ovl_parent $p $c) (ovl_anc $p)))
!(collapse (ovl_anc v0))

;; A cycle: tables in one incomplete component are replayed.
!(tabled (cyc_anc $c))
(cyc_parent y1 y0)
(cyc_parent y2 y1)
(cyc_parent y0 y2)
(= (cyc_anc $c) (match &self (cyc_parent $p $c) $p))
(= (cyc_anc $c) (match &self (cyc_parent $p $c) (cyc_anc $p)))
!(collapse (cyc_anc y0))

;; An effect before the forwarded call runs once per table, as before.
!(tabled (eff_anc $c))
(eff_parent f1 f0)
(eff_parent f2 f1)
(eff_parent f3 f2)
(eff_parent f4 f3)
(= (eff_anc $c) (match &self (eff_parent $p $c) $p))
(= (eff_anc $c) (match &self (eff_parent $p $c) (let $u (println! (visit $p)) (eff_anc $p))))
!(collapse (eff_anc f0))

;; An effect after the call runs per answer: that call is not forwarded.
!(tabled (post_anc $c))
(post_parent g1 g0)
(post_parent g2 g1)
(post_parent g3 g2)
(post_parent g4 g3)
(= (post_anc $c) (match &self (post_parent $p $c) $p))
(= (post_anc $c) (match &self (post_parent $p $c) (let $x (post_anc $p) (let $u (println! (seen $x)) $x))))
!(collapse (post_anc g0))

;; Open answers keep fresh variables per delivery; an open call is replayed.
!(tabled (open_anc $c))
(open_parent o1 o0)
(open_parent o2 o1)
(open_parent o3 o2)
(open_parent o4 o3)
(= (open_anc $c) (match &self (open_parent $p $c) (anc $p $fresh)))
(= (open_anc $c) (match &self (open_parent $p $c) (open_anc $p)))
!(collapse (open_anc o0))
!(collapse (open_anc $who))

;; Two callers of one table: the second cannot extend its index.
!(tabled (shr_anc $c))
(shr_parent sx sp)
(shr_parent sx sq)
(shr_parent sy sx)
(shr_parent sz sy)
(= (shr_anc $c) (match &self (shr_parent $p $c) $p))
(= (shr_anc $c) (match &self (shr_parent $p $c) (shr_anc $p)))
!(collapse (shr_anc sp))
!(collapse (shr_anc sq))

;; Memo keeps its answer bag and is never forwarded.
!(memoize memo_anc)
(memo_parent m1 m0)
(memo_parent m2 m1)
(memo_parent m3 m2)
(memo_parent m4 m3)
(memo_parent m5 m4)
(memo_parent m6 m5)
(= (memo_anc $c) (match &self (memo_parent $p $c) $p))
(= (memo_anc $c) (match &self (memo_parent $p $c) (memo_anc $p)))
!(collapse (memo_anc m0))

;; A completed table keeps its answers after a later addition.
!(tabled (upd_anc $c))
(upd_parent u1 u0)
(upd_parent u2 u1)
(upd_parent u3 u2)
(upd_parent u4 u3)
(= (upd_anc $c) (match &self (upd_parent $p $c) $p))
(= (upd_anc $c) (match &self (upd_parent $p $c) (upd_anc $p)))
!(collapse (upd_anc u0))
!(add-atom &self (upd_parent uq u1))
!(collapse (upd_anc u0))

;; Two readers of forwarded tables, interleaved.
!(tabled (two_anc $c))
(two_parent t1 t0)
(two_parent t2 t1)
(two_parent t3 t2)
(two_parent t4 t3)
(= (two_anc $c) (match &self (two_parent $p $c) $p))
(= (two_anc $c) (match &self (two_parent $p $c) (two_anc $p)))
!(collapse (let $a (two_anc t0) (let $b (two_anc t1) (pair $a $b))))

;; A count of a complete table observes its size without its answers.
!(size-atom (collapse (chain_anc c0)))
!(size-atom (collapse (dia_anc d0)))
