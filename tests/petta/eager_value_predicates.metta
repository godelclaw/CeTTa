(= (predicate-open $head) ($head 3))
!(is-var (car-atom (predicate-open $unknown)))
!(collapse (is-var (car-atom (predicate-open $unknown))))
!(pair (is-var (car-atom (predicate-open $unknown))) true)
!(is-ground (cdr-atom (predicate-open $unknown)))
!(is-expr (predicate-open $unknown))
!(is-var $unknown)
!(collapse (is-var (superpose ($unknown 3 (x)))))
!(collapse (is-expr (superpose ((x) 3 $unknown))))
!(collapse (is-ground (superpose ((x) $unknown))))
!(collapse (is-var (empty)))

!(bind! &predicate-effects (new-state 0))
(= (predicate-tick)
   (let $u (change-state! &predicate-effects (+ (get-state &predicate-effects) 1))
      (quote (payload value))))
!(is-expr (predicate-tick))
!(get-state &predicate-effects)
!(let $ready (quote (predicate-tick)) (is-expr $ready))
!(let $ready (quote (predicate-tick)) (is-var $ready))
!(get-state &predicate-effects)

; Argument bindings remain visible after the value is observed.
(= (predicate-bind-open 7) $fresh)
!(let $truth (is-var (predicate-bind-open $input)) (pair $truth $input))
(= (predicate-bind-ground 7) 7)
!(let $truth (is-ground (predicate-bind-ground $input)) (pair $truth $input))
