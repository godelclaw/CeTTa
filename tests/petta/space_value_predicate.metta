!(is-space (new-space))
!(let $space (new-space) (is-space $space))
!(is-space &unwritten-space)
!(is-space ordinary-symbol)
!(is-space "&text")
!(is-space 7)
!(is-space (new-state 0))
!(let $ready (quote (new-space)) (is-space $ready))
(= (space-predicate-observe $value) (is-space $value))
!(let $space (new-space) (space-predicate-observe $space))
