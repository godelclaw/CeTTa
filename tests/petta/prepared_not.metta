; `not` in a deterministic function body runs in the prepared machine.  A
; truth value is negated there; any other argument leaves the call to the
; canonical evaluator, which answers as the reference does.
(= (flip $x) (not $x))
(= (nand $a $b) (not (and $a $b)))
(= (count-up $n $limit $acc)
   (if (not (< $n $limit)) $acc (count-up (+ $n 1) $limit (+ $acc 1))))
(= (quote-state $c $quoted)
   (if $quoted (not (== $c "q")) (== $c "q")))
(= (twice $x) (not (not $x)))
!(flip true)
!(flip false)
!(nand true true)
!(nand true false)
!(nand false false)
!(count-up 0 1000 0)
!(quote-state "q" true)
!(quote-state "a" true)
!(quote-state "q" false)
!(twice true)
!(collapse (flip 5))
!(collapse (flip foo))
!(collapse (flip (a b)))
!(collapse (twice 1))
