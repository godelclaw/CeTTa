!(import! &self proc)
!(let $first (proc:spawn ("/bin/echo" "first-owner") ())
  (let $second (proc:spawn ("/bin/echo" "second-owner") ())
    (let $one (proc:await $first)
      (let $other-status (proc:status $second)
        (let $two (proc:await $second)
          (let $close-first (proc:close $first)
            (let $close-second (proc:close $second)
              (LifetimeIsolated $one $other-status $two))))))))
