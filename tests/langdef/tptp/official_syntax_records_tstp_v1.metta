; Frozen-path TSTP samples produced locally by E and Vampire from PUZ001-1/PUZ001+1.
!(import! &self ../../../lib/lib_tptp.metta)
!(import! &self system)

(= (tstp-test:name-text (tptp-rec:name-word (tptp-rec:word-lower $text))) $text)
(= (tstp-test:name-text (tptp-rec:name-word (tptp-rec:word-quoted $text))) $text)
(= (tstp-test:name-text (tptp-rec:name-integer $text)) $text)
(= (tstp-test:input-name (tptp-rec:fof $name $_r $_f $_a $_s))
   (tstp-test:name-text $name))
(= (tstp-test:input-name (tptp-rec:cnf $name $_r $_f $_a $_s))
   (tstp-test:name-text $name))
(= (tstp-test:input-name (tptp-rec:tff $name $_r $_f $_a $_s))
   (tstp-test:name-text $name))
(= (tstp-test:input-name (tptp-rec:thf $name $_r $_f $_a $_s))
   (tstp-test:name-text $name))
(= (tstp-test:input-kind (tptp-rec:fof $_n $_r $_f $_a $_s)) fof)
(= (tstp-test:input-kind (tptp-rec:cnf $_n $_r $_f $_a $_s)) cnf)
(= (tstp-test:names (tptp-rec:file $inputs $_span))
   (tstp-test:input-names $inputs))
(= (tstp-test:input-names (tptp-rec:inputs-nil)) LNil)
(= (tstp-test:input-names (tptp-rec:inputs-cons $head $tail))
   (LCons (tstp-test:input-name $head) (tstp-test:input-names $tail)))
(= (tstp-test:kinds (tptp-rec:file $inputs $_span))
   (tstp-test:input-kinds $inputs))
(= (tstp-test:input-kinds (tptp-rec:inputs-nil)) LNil)
(= (tstp-test:input-kinds (tptp-rec:inputs-cons $head $tail))
   (LCons (tstp-test:input-kind $head) (tstp-test:input-kinds $tail)))
(= (tstp-test:has-inference (tptp-rec:file $inputs $_span))
   (tstp-test:has-inference-inputs $inputs))
(= (tstp-test:has-inference-inputs (tptp-rec:inputs-nil)) False)
(= (tstp-test:has-inference-inputs (tptp-rec:inputs-cons $head $tail))
   (case $head
     (((tptp-rec:cnf $_n $_r $_f (tptp-rec:annotation $source $_opt) $_s)
        (case $source
          (((tptp-rec:inference $_rule $_info $_parents) True)
           ($_ (tstp-test:has-inference-inputs $tail)))))
      ((tptp-rec:fof $_n $_r $_f (tptp-rec:annotation $source $_opt) $_s)
        (case $source
          (((tptp-rec:inference $_rule $_info $_parents) True)
           ($_ (tstp-test:has-inference-inputs $tail)))))
      ($_ (tstp-test:has-inference-inputs $tail)))))
(= (tstp-test:row $tag $path)
   (let $records (tptp:read-file $path)
     (let $_ (println! (TptpTstpRecords $tag $records))
       (case $records
         (((tptp-rec:file $inputs $span)
            (TptpTstpRow $tag (tstp-test:kinds $records)
              (tstp-test:names $records)
              (tstp-test:has-inference $records)))
          ($fault (TptpTstpRowFault $tag $fault)))))))
(= (tstp-test:run)
   (TptpOfficialSyntaxRecordsTstpV1Summary
     (tstp-test:row e-cnf (system:arg 0))
     (tstp-test:row e-fof (system:arg 1))
     (tstp-test:row vampire-cnf (system:arg 2))
     (tstp-test:row vampire-fof (system:arg 3))))
!(println! (tstp-test:run))
