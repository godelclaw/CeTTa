; Typed heads run in the prepared machine as HE runs them: a parameter of a
; value class is cast where HE casts it, and a call HE answers with a type
; error is left to the canonical evaluator, which answers it.  A call
; expected to have a type is cast to it, and binds a type variable there.
(: inc (-> Number Number))
(= (inc $x) (+ $x 1))
(= (loop $n $acc) (if (== $n 0) $acc (loop (- $n 1) (inc $acc))))
(: fact (-> Number Number))
(= (fact $n) (if (== $n 0) 1 (* $n (fact (- $n 1)))))
(: same (-> %Undefined% %Undefined%))
(= (same $x) $x)
(: neg (-> Bool Bool))
(= (neg $b) (if $b False True))
(= (flips $n $b) (if (== $n 0) $b (flips (- $n 1) (neg $b))))
(: twice (-> Number Number))
(= (twice $x) (inc (inc $x)))
(: f (-> Number Number))
(= (f $x $y) (+ $x $y))
(= (f $x) (* $x 10))
(= (g $n) (f $n 1))
(: wrong (-> Number String))
(= (wrong $x) (+ $x 1))
(: undef-range (-> Number %Undefined%))
(= (undef-range $x) "text")
(= (via $v) (inc $v))
(= (callundef $n) (inc (undef-range $n)))
(: t-id (-> Number Number))
(= (t-id $x) $x)
(= (u-id $x) $x)
(= (bind-typed) (function (chain (metta (t-id 7) $T &self) $v (return ($v $T)))))
(= (bind-untyped) (function (chain (metta (u-id 7) $T &self) $v (return ($v $T)))))
(= (cast-typed) (function (chain (metta (t-id 7) String &self) $v (return ($v bad)))))
(= (cast-untyped) (function (chain (metta (u-id 7) String &self) $v (return ($v bad)))))
!(loop 300 0)
!(fact 20)
!(same (+ 1 2))
!(flips 101 True)
!(twice 40)
!(let $v (+ 2 3) (inc $v))
!(collapse (inc "s"))
!(collapse (via "s"))
!(collapse (via True))
!(collapse (g 5))
!(collapse (wrong 1))
!(collapse (callundef 3))
!(bind-typed)
!(bind-untyped)
!(collapse (cast-typed))
!(collapse (cast-untyped))
