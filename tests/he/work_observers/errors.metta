(= (mixed) (+ 1 "S"))
(= (mixed) 42)
(= (faults) (+ 1 "S"))
(= (faults) (+ 2 "S"))
!(collapse (mixed))
!(let $h (work-new (mixed)) (work-take $h 10))
!(let $h (work-new (mixed)) (work-count $h))
!(let $h (work-new (mixed)) (let $seen (work-exists $h) ($seen (work-take $h 10))))
!(collapse (faults))
!(let $h (work-new (faults)) (work-take $h 10))
!(let $h (work-new (faults)) (work-count $h))
!(let $h (work-new (faults)) (let $seen (work-exists $h) ($seen (work-take $h 10))))
