(= (native-in-result $value) (K (+ $value 1)))
!(native-in-result 2)
!(K (+ 2 1))
(: Held (-> Atom Expression))
(= (held-result $value) (Held (+ $value 1)))
!(held-result 2)
!(import! &self compatibility_ops)
(= (construct-result $head $value) (K ($head $value 1)))
!(construct-result (make-plus-symbol) 2)
