; Well-typed calls: every mode gives HE's answers.
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(: add (-> Nat Nat Nat))
(= (add Z $m) $m)
(= (add (S $n) $m) (S (add $n $m)))
(: n2p (-> Number Nat))
(= (n2p $k) (if (== $k 0) Z (S (n2p (- $k 1)))))
(: nsize (-> Nat Number))
(= (nsize Z) 0)
(= (nsize (S $n)) (+ 1 (nsize $n)))
!(nsize (add (n2p 3) (n2p 4)))
!(get-type (add Z (S Z)))
(: List (-> Type Type))
(: Nil (List $t))
(: Cons (-> $t (List $t) (List $t)))
(: len (-> (List $t) Number))
(= (len Nil) 0)
(= (len (Cons $h $t)) (+ 1 (len $t)))
!(len (Cons 1 (Cons 2 Nil)))
(: twice (-> Atom Atom))
(= (twice $e) ($e $e))
!(twice (add Z Z))
; Ill-typed calls: each mode reports a type error.
!(collapse (add Z 1))
!(collapse (S "x"))
!(collapse (len (Cons 1 (Cons "b" Nil))))
; An ill-typed argument under a declared result type: HE infers the
; argument and reports its own error first, in every mode.
(: f (-> Number Bool))
(= (f $x) True)
!(collapse (add (f "x") Z))
; The same argument where its declared result type fits the call.
(: g (-> Number Nat))
(= (g $x) Z)
!(collapse (add (g "x") Z))
; Result checks stay in every mode: a declared result type vouches for no
; body.  The exact outer type of (wrongf 1) is Number, yet its value is not.
(: wrongf (-> Number Number))
(= (wrongf $x) "wrong")
(: emptyf (-> Number Number))
(= (emptyf $x) (empty))
(: num (-> Number Number))
(= (num $x) $x)
!(collapse (get-type (wrongf 1)))
!(collapse (wrongf 1))
!(collapse (emptyf 1))
!(collapse (num (wrongf 1)))
!(collapse (num (emptyf 1)))
