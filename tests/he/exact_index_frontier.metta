;; Ground matches over a space whose other rows hold variables: a row with
;; variables under the pattern's head, or a row with no head, can match a
;; ground pattern without being it; a number matches a number of the other
;; kind with the same value, NaN not even itself; duplicates keep their
;; multiplicity.  The pad rows keep the space past the size below which
;; every row is a candidate.
(pad 1)
(pad 2)
(pad 3)
(pad 4)
(pad 5)
(pad 6)
(pad 7)
(pad 8)
(pad 9)
(pad 10)
(pad 11)
(pad 12)
(pad 13)
(pad 14)
(pad 15)
(pad 16)
(pad 17)
(pad 18)
(pad 19)
(pad 20)
(fact a 1)
(fact a 1)
(fact b 2)
(num 1.0)
(num 2)
(rule $x 3)

!(match &self (fact a 1) yes)
!(match &self (fact b 2) yes)
!(match &self (fact c 3) yes)
!(match &self (rule z 3) yes)
!(match &self (num 1) yes-int)
!(match &self (num 2.0) yes-float)
!(let $n (/ 0.0 0.0) (match &self (nan $n) yes-nan))
!(add-atom &self (nan (/ 0.0 0.0)))
!(let $n (/ 0.0 0.0) (match &self (nan $n) yes-nan))
!(add-atom &self (fact $y 9))
!(match &self (fact q 9) yes)
!(match &self (fact a 1) yes)
!(remove-atom &self (fact $y 9))
!(match &self (fact q 9) yes)
!(remove-atom &self (fact a 1))
!(match &self (fact a 1) yes)
!(add-atom &self $anything)
!(match &self (fact b 2) yes)
!(match &self (fact c 3) yes)
!(remove-atom &self $anything)
!(match &self (fact c 3) yes)
