!(import! &self runner_owner)
!(bind! &top-own (module-space-no-deps &self))
!(bind! &owner (mod-space! runner_owner))
!(bind! &owner-own (module-space-no-deps &owner))
!(bridge-context-call)
!(collapse (match &top-own (bridge-owned $x) $x))
!(collapse (match &owner-own (bridge-owned $x) $x))
!(match &self (bridge-owned $x) $x)
!(bridge-context-call)
!(collapse (match &top-own (bridge-owned $x) $x))
!(collapse (match &owner-own (bridge-owned $x) $x))
