!(import! &m name_tree_root:inner:leaf)
!(import! &self self:name_tree_root:inner:leaf)
!(import! &self top:name_tree_root:inner:leaf)
!(collapse (match &self (name-tree-seen $x) $x))
!(mod-space! name_tree_root:inner:leaf)
!(import! &self name_tree_root:pkg)
!(collapse (match &self (name-tree-pkg $x) $x))
!(case (import! &self name_tree_root:loader) (((Error $a $b) caught) ($ok loaded)))
!(case (import! &self name_tree_root:missing:leaf) (((Error $a $b) caught) ($ok loaded)))
!(import! &self name_tree_root:both)
!(match &self (name-tree-both $x) $x)
!(import! &self name_tree_root:bare)
!(mod-space! name_tree_root:bare)
!(import! &self name_tree_root:bare:item)
!(match &self (name-tree-item $x) $x)
!(import! &self name_tree_root:both:beside)
!(match &self (name-tree-beside $x) $x)
!(case (mod-space! name_tree_root:absent) (((Error $a $b) $b) ($ok found)))
