(: foo Other)
(: wrong-argument (-> Number))
(= (wrong-argument) (chain (println! "UNEXPECTED-ARGUMENT-EFFECT") $unit 7))
!(case (module-space-no-deps) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps &self extra) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps 7) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps "x") (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps foo) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps (+ 3 4)) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps (wrong-argument)) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps unknown) (((Error $call $why) $why) ($ok unexpected-success)))
!(case (module-space-no-deps $unknown) (((Error $call $why) $why) ($ok unexpected-success)))
