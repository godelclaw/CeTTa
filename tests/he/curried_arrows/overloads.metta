; Full arity first: a call some type takes exactly is read as declared.
(: A Type)
(: B Type)
(: C Type)
(: D Type)
(: a A)
(: c C)
(: f (-> A B))
(: f (-> A C D))
(= (f $x) one-arg)
(= (f $x $y) two-args)
!(f a)
!(get-type (f a))
!(f a c)
!(collapse ((f a) c))
; A head with a non-function type keeps HE's reading.
(: g (-> A C D))
(: g Symbol)
!(g a)
