; A declared arrow and the arrow it returns read as one curried arrow: the
; declaration of sk returns an arrow, sg's takes both arguments, and each
; reads both ways; sapply takes a unary function, which sg is when curried.
(: SA Type)
(: SB Type)
(: SC Type)
(: sA SA)
(: sB SB)
(: sk (-> SA (-> SB SC)))
(: sg (-> SA SB SC))
(: sapply (-> (-> $a $b) $a $b))
(= ((sk sA) sB) done-k)
(= (sg sA sB) done-g)
(= (sapply $f $x) ($f $x))
!(collapse (get-type (sg sA)))
!(collapse (get-type ((sg sA) sB)))
!(collapse (get-type (sk sA)))
!(collapse (get-type ((sk sA) sB)))
!(collapse (get-type (sk sA sB)))
!(collapse (get-type (sapply (sk sA) sB)))
!(collapse (get-type (sapply sg sA)))
!(collapse (get-type (sapply (sg sA) sB)))
!(collapse ((sg sA) sB))
!(collapse ((sk sA) sB))
!(collapse (sk sA sB))
!(collapse (sapply (sk sA) sB))
!(collapse (sapply (sg sA) sB))
!(collapse (sapply sg sA))
!(collapse ((sapply sg sA) sB))
