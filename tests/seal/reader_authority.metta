; A delegated reader can observe portable rows, but cannot obtain the live
; space or recover an opener/admin capability. Nested references are refused.
!(import! &self seal)
!(let $v (seal:new-service reader-test) (bind! &service (new-state $v)))
(= (OPEN) (let (seal:service $o $a $s) (get-state &service) $o))
(= (ADMIN) (let (seal:service $o $a $s) (get-state &service) $a))
(= (LOCK) (let (seal:service $o $a $s) (get-state &service) $s))
!(let $r (seal:reader (OPEN)) (bind! &reader (new-state $r)))
(= (READ) (get-state &reader))
!(let $k (seal:new-key) (bind! &key (new-state $k)))
(= (KEY) (get-state &key))
!(bind! &facts (new-space))
!(add-atom &facts (fact 1))
!(let $b (seal:lock (LOCK) (KEY) &facts) (bind! &box (new-state $b)))
(= (BOX) (get-state &box))
!(seal:grant (ADMIN) (KEY) always)
!(seal:read-space (READ) (BOX) (KEY))
!(case (seal:try-open (READ) (BOX) (KEY))
   (((Error $call $why) (raw-denied $why)) ($v raw-leaked)))
!(case (seal:try-grant (READ) (KEY) always)
   (((Error $call $why) (admin-denied $why)) ($v admin-leaked)))
!(case (seal:try-unseal (READ) (BOX))
   (((Error $call $why) (unsealer-denied $why)) ($v unsealer-leaked)))
; Repeated attenuation cannot promote the reader to an opener.
!(case (seal:try-open (seal:reader (READ)) (BOX) (KEY))
   (((Error $call $why) (promotion-denied $why)) ($v opener-leaked)))
; The owner's existing alias remains live.
!(add-atom &facts (fact 2))
!(seal:read-space (READ) (BOX) (KEY))
!(seal:revoke (ADMIN) (KEY))
!(case (seal:try-read-space (READ) (BOX) (KEY))
   (((Error $call $why) (revoked $why)) ($v leaked-after-revoke)))
; Copying a nested space does not erase its write authority. Refuse the
; entire observation, and leave the one-shot grant available on failure.
!(let $space (new-space) (bind! &nested-ref (new-state $space)))
!(let $space (get-state &nested-ref) (add-atom &facts (nested $space)))
!(seal:grant (ADMIN) (KEY) once)
!(case (seal:try-read-space (READ) (BOX) (KEY))
   (((Error $call $why) (nested-denied $why)) ($v nested-leaked)))
!(let $space (get-state &nested-ref) (remove-atom &facts (nested $space)))
!(seal:read-space (READ) (BOX) (KEY))
!(case (seal:try-read-space (READ) (BOX) (KEY))
   (((Error $call $why) (consumed $why)) ($v second-use)))
; A seal hidden inside a row is authority too, even with portable data in
; its payload. The general opener remains an explicit, stronger capability.
!(let $c (seal:lock (LOCK) (KEY) safe-data) (add-atom &facts (nested-seal $c)))
!(seal:grant (ADMIN) (KEY) once)
!(case (seal:try-read-space (READ) (BOX) (KEY))
   (((Error $call $why) (capsule-denied $why)) ($v capsule-leaked)))
!(let $live (seal:open (OPEN) (BOX) (KEY)) (add-atom $live owner-added))
!(collapse (match &facts owner-added owner-still-controls-space))
