; HOL and Megalodon use the same opaque runtime value kind, with private
; issuing brands. Ordinary seal clients cannot open or construct theorems.
!(import! &self holkernel)
!(import! &self seal)
!(let $k (hol:kernel) (bind! &kernel (new-state $k)))
(= (K) (get-state &kernel))
!(let $t (hol:refl (K) (v "p" (T "bool"))) (bind! &theorem (new-state $t)))
(= (THM) (get-state &theorem))
!(seal:kind (K))
!(seal:kind (THM))
!(case (THM) (((Sealed $name) leaked) ($opaque opaque)))
!(case (THM) (((NativeHandle $kind $id) leaked) ($opaque opaque)))
!(let $t (THM) (repr $t))
!(== (THM) (THM))
; Equal judgments remain distinct proof capsules.
!(let $other (hol:refl (K) (v "p" (T "bool"))) (== (THM) $other))
!(hol:sequent (Sealed hol))
!(hol:sequent (THM))
!(let (seal:facets $s $u) (seal:new hol)
   (collapse (seal:unseal $u (THM))))
!(let $t (THM)
   (case (seal:try-portable (nested $t))
     (((Error $call $why) (serialization-refused $why)) ($value leaked))))
!(bind! &proofs (new-space))
!(let $t (THM) (add-atom &proofs (checked $t)))
!(hol:sequent (match &proofs (checked $t) $t))
; A different kernel brand cannot be used as a HOL theorem.
!(import! &self megalodon)
!(let $s (mg:new-theory-state custom) (bind! &mg $s))
(= (MG) (mg:use (get-state &mg)))
!(mg:parameter (mg:authority (get-state &mg)) "p" (Tp.prop))
!(let $t (mg:check (MG)
     (Megalodon.context 0 (types) (hypotheses (Tm.named "p"))) (Pf.hyp 0))
   (hol:sequent $t))
