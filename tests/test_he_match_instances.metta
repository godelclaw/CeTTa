; Match rows given as template instances inside called functions.
(edge a b) (edge b c) (edge a c) (edge c d) (edge a b)
(w 1 (pt 10 20)) (w 2 (pt 30 40)) (w 1.0 (pt 50 60)) (w 3 three)
(opn $z open-row)
(= (succs $x) (collapse (match &self (edge $x $y) $y)))
!(succs a)
!(succs d)
(= (two-step $x) (collapse (match &self (, (edge $x $y) (edge $y $z)) (via $y $z))))
!(two-step a)
(= (nested $k) (collapse (match &self (w $k (pt $p $q)) (sum $p $q))))
!(nested 1)
!(nested 2)
!(nested 3)
(= (loops) (collapse (match &self (edge $x $x) $x)))
!(loops)
(= (open-rows) (collapse (match &self ($h open-row) $h)))
!(open-rows)
(= (keep-var $x) (collapse (match &self (edge $x $y) (pair $y $free))))
!(let ((pair $a $b)) (keep-var b) ($a (get-metatype $b)))
(= (count-edges) (size-atom (collapse (match &self (edge $x $y) ($x $y)))))
!(count-edges)
