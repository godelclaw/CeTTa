@@ -159,0 +163,28 @@ class NeuralBellmanFordNetwork(nn.Module, core.Configurable):
+    def symmetric_inverse_feature(self, graph, h_index, t_index, r_index):
+        """Compute the inverse-direction feature for every candidate pair.
+
+        A relational training row has one fixed source and multiple candidate
+        tails.  The inverse source therefore varies across the row, so a
+        single Bellman-Ford query per row cannot represent the symmetric
+        score.  Flatten candidate pairs, evaluate them in bounded chunks, and
+        gather the original head for each inverse query.
+        """
+        if not self.num_relation:
+            raise ValueError("symmetric relational scoring requires a positive relation count")
+        inverse_r_index = (r_index + self.num_relation) % (self.num_relation * 2)
+        flat_h_index = h_index.reshape(-1)
+        flat_t_index = t_index.reshape(-1)
+        flat_r_index = inverse_r_index.reshape(-1)
+        inverse_features = []
+        for start in range(0, flat_h_index.numel(), self.symmetric_query_chunk_size):
+            stop = min(start + self.symmetric_query_chunk_size, flat_h_index.numel())
+            output = self.bellmanford(
+                graph,
+                flat_t_index[start:stop],
+                flat_r_index[start:stop],
+            )
+            node_feature = output["node_feature"]
+            query_index = torch.arange(stop - start, device=flat_h_index.device)
+            inverse_features.append(node_feature[flat_h_index[start:stop], query_index])
+        return torch.cat(inverse_features, dim=0).view(*h_index.shape, -1)
+
