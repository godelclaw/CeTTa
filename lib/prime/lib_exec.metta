(scope:profile lexical-fresh per-call reference)

; Selected finite addition batches, written in ordinary MeTTa.
; Use --profile extended in HE or PeTTa. The caller owns the space and
; serializes its mutations until the step completes. This library has no
; priority scheduler, deletion sinks, or concurrent publication protocol.
; Keys select the first matching directive in the dialect's row order;
; use unique keys when the selection must be independent of that order.
;
; A selected exec is data, including the patterns and templates it contains.
(: exec (-> Atom Atom Atom Atom))
(: exec:emit (-> Atom Atom %Undefined%))
(: exec:publish (-> Atom Atom %Undefined%))
(: exec:fire (-> Atom Atom %Undefined%))
(: exec:step-key (-> Atom Atom %Undefined%))

; Traverse a finite template tuple without interpreting its elements.
(= (exec:emit $pending $items)
   (if-equal $items () ()
      (let ($head $tail) (decons-atom $items)
         (let $_ (add-atom-nodup $pending $head)
            (exec:emit $pending $tail)){$_}){$head $tail}))
(= (exec:publish $facts $pending)
   (collapse (match $pending $row (add-atom-nodup $facts $row))))

; All input matches complete into a private proposal space. The selected exec
; remains visible to its own input query, and is consumed before publication.
(= (exec:fire $facts (exec $key $query $templates))
   (let $pending (new-space)
      (let (, $outputs) (decons-atom $templates)
         (let* (($_planned (collapse
                   (match $facts $query (exec:emit $pending $outputs)){$query}))
                ($_consumed (remove-atom $facts (exec $key $query $templates))))
            (exec:publish $facts $pending)))))
(= (exec:step-key $facts $key)
   (let $selected
      (once (match $facts (exec $key $query $templates)
               (exec $key $query $templates)){$key $query $templates})
      (exec:fire $facts $selected)))

; Saturation fires a finite set of exec directives, given as data, in rounds.
; A round proposes every template instance of every directive over every
; match of its query into a private proposal space, then publishes the
; proposals without duplicates; rounds repeat until one adds nothing.  The
; directives are neither selected nor consumed: each stays a rule of the
; saturation, and the space holds their least common fixed point.  When the
; templates build ever larger terms there is no fixed point and saturation
; does not return.
(: exec:saturate (-> Atom Atom %Undefined%))
(: exec:round (-> Atom Atom %Undefined%))
(: exec:size (-> Atom %Undefined%))
(= (exec:size $facts)
   (let $atoms (collapse (get-atoms $facts)) (size-atom $atoms)))
(= (exec:round $facts $directives)
   (let $pending (new-space)
      (let $_planned
            (collapse
               (let (exec $key $query $templates) (superpose $directives)
                  (let (, $outputs) (decons-atom $templates)
                     (match $facts $query (exec:emit $pending $outputs)){$query})))
         (exec:publish $facts $pending))))
(= (exec:saturate $facts $directives)
   (let* (($before (exec:size $facts))
          ($_round (exec:round $facts $directives)))
      (if (== $before (exec:size $facts))
          ()
          (exec:saturate $facts $directives))))
