; Checked properties of the natural-score selector.
; The proof functions use the same admitted program and its actual comparisons.
!(import! &self natural_top_k)

!(hol:define &self band (-> B B B)
  (= (band tt $b) $b)
  (= (band ff $b) ff))

!(hol:define &self bimp (-> B B B)
  (= (bimp tt $b) $b)
  (= (bimp ff $b) tt))

!(hol:define &self bnot (-> B B)
  (= (bnot tt) ff)
  (= (bnot ff) tt))

!(hol:define &self self-imp (-> (b : B) (id B (bimp b b) tt))
  (= (self-imp tt) (refl tt))
  (= (self-imp ff) (refl tt)))

!(hol:define &self imp-tt (-> (b : B) (id B (bimp b tt) tt))
  (= (imp-tt tt) (refl tt))
  (= (imp-tt ff) (refl tt)))

!(hol:define &self symB (-> (x : B) (y : B) (p : (id B x y)) (id B y x))
  (= (symB $x $y $p) (id:eliminate B $x (lam y2 (lam q (id B y2 $x))) (refl $x) $y $p)))

!(hol:define &self mp (-> (x : B) (y : B) (hx : (id B x tt)) (hxy : (id B (bimp x y) tt)) (id B y tt))
  (= (mp $x $y $hx $hxy) (id:eliminate B $x (lam z (lam q (id B (bimp z $y) tt))) $hxy tt $hx)))

!(hol:define &self band-intro (-> (x : B) (y : B) (hx : (id B x tt)) (hy : (id B y tt)) (id B (band x y) tt))
  (= (band-intro $x $y $hx $hy) (id:eliminate B tt (lam z (lam q (id B (band z $y) tt))) $hy $x (symB $x tt $hx))))

!(hol:define &self band-mono (-> (a : B) (a2 : B) (b : B) (b2 : B) (id B (bimp (band (bimp a a2) (bimp b b2)) (bimp (band a b) (band a2 b2))) tt))
  (= (band-mono tt tt tt tt) (refl tt))
  (= (band-mono tt tt tt ff) (refl tt))
  (= (band-mono tt tt ff tt) (refl tt))
  (= (band-mono tt tt ff ff) (refl tt))
  (= (band-mono tt ff tt tt) (refl tt))
  (= (band-mono tt ff tt ff) (refl tt))
  (= (band-mono tt ff ff tt) (refl tt))
  (= (band-mono tt ff ff ff) (refl tt))
  (= (band-mono ff tt tt tt) (refl tt))
  (= (band-mono ff tt tt ff) (refl tt))
  (= (band-mono ff tt ff tt) (refl tt))
  (= (band-mono ff tt ff ff) (refl tt))
  (= (band-mono ff ff tt tt) (refl tt))
  (= (band-mono ff ff tt ff) (refl tt))
  (= (band-mono ff ff ff tt) (refl tt))
  (= (band-mono ff ff ff ff) (refl tt)))

!(hol:define &self geq-flip (-> (a : Nat) (b : Nat) (id B (bimp (bnot (geq a b)) (geq b a)) tt))
  (= (geq-flip $a Z) (refl tt))
  (= (geq-flip Z (S $n)) (refl tt))
  (= (geq-flip (S $m) (S $n)) (geq-flip $m $n)))

!(hol:define &self head-ge (-> Row Rows B)
  (= (head-ge $r RNil) tt)
  (= (head-ge $r (RCons $s $ss)) (geq (score $r) (score $s))))

!(hol:define &self sorted (-> Rows B)
  (= (sorted RNil) tt)
  (= (sorted (RCons $r $rs)) (band (head-ge $r $rs) (sorted $rs))))

!(hol:define &self hgi-pick (-> (f : Row) (r : Row) (g : Row) (gs : Rows) (b : B) (e2 : (id B (geq (score r) (score g)) b)) (e : (id B (geq (score r) (score f)) ff))
               (id B (bimp (head-ge f (RCons g gs)) (head-ge f (pick b (RCons r (RCons g gs)) (RCons g (insert r gs))))) tt))
  (= (hgi-pick $f $r $g $gs tt $e2 $e)
   (id:eliminate B tt (lam y (lam q (id B (bimp (geq (score $f) (score $g)) y) tt))) (imp-tt (geq (score $f) (score $g)))
      (geq (score $f) (score $r))
      (symB (geq (score $f) (score $r)) tt
        (id:eliminate B (geq (score $r) (score $f)) (lam y (lam q (id B (bimp (bnot y) (geq (score $f) (score $r))) tt))) (geq-flip (score $r) (score $f)) ff $e))))
  (= (hgi-pick $f $r $g $gs ff $e2 $e) (self-imp (geq (score $f) (score $g)))))

!(hol:define &self head-ge-insert (-> (f : Row) (r : Row) (rest : Rows) (e : (id B (geq (score r) (score f)) ff)) (id B (bimp (head-ge f rest) (head-ge f (insert r rest))) tt))
  (= (head-ge-insert $f $r RNil $e)
   (id:eliminate B (geq (score $r) (score $f)) (lam y (lam q (id B (bimp (bnot y) (geq (score $f) (score $r))) tt))) (geq-flip (score $r) (score $f)) ff $e))
  (= (head-ge-insert $f $r (RCons $g $gs) $e) (hgi-pick $f $r $g $gs (geq (score $r) (score $g)) (refl (geq (score $r) (score $g))) $e)))

!(hol:define &self ins-pick (-> (r : Row) (f : Row) (rest : Rows) (b : B) (e : (id B (geq (score r) (score f)) b))
               (ih : (id B (bimp (sorted rest) (sorted (insert r rest))) tt))
               (id B (bimp (sorted (RCons f rest)) (sorted (pick b (RCons r (RCons f rest)) (RCons f (insert r rest))))) tt))
  (= (ins-pick $r $f $rest tt $e $ih)
   (id:eliminate B tt (lam y (lam q (id B (bimp (sorted (RCons $f $rest)) (band y (sorted (RCons $f $rest)))) tt)))
      (self-imp (sorted (RCons $f $rest))) (geq (score $r) (score $f)) (symB (geq (score $r) (score $f)) tt $e)))
  (= (ins-pick $r $f $rest ff $e $ih)
   (mp (band (bimp (head-ge $f $rest) (head-ge $f (insert $r $rest))) (bimp (sorted $rest) (sorted (insert $r $rest))))
       (bimp (band (head-ge $f $rest) (sorted $rest)) (band (head-ge $f (insert $r $rest)) (sorted (insert $r $rest))))
       (band-intro (bimp (head-ge $f $rest) (head-ge $f (insert $r $rest))) (bimp (sorted $rest) (sorted (insert $r $rest)))
                   (head-ge-insert $f $r $rest $e) $ih)
       (band-mono (head-ge $f $rest) (head-ge $f (insert $r $rest)) (sorted $rest) (sorted (insert $r $rest))))))

!(hol:define &self insert-sorted (-> (r : Row) (rs : Rows) (id B (bimp (sorted rs) (sorted (insert r rs))) tt))
  (= (insert-sorted $r RNil) (refl tt))
  (= (insert-sorted $r (RCons $f $rest)) (ins-pick $r $f $rest (geq (score $r) (score $f)) (refl (geq (score $r) (score $f))) (insert-sorted $r $rest))))

!(hol:define &self head-ge-take (-> (r : Row) (k : Nat) (rs : Rows) (id B (bimp (head-ge r rs) (head-ge r (take k rs))) tt))
  (= (head-ge-take $r Z $rs) (imp-tt (head-ge $r $rs)))
  (= (head-ge-take $r (S $k) RNil) (refl tt))
  (= (head-ge-take $r (S $k) (RCons $s $ss)) (self-imp (geq (score $r) (score $s)))))

!(hol:define &self take-sorted (-> (k : Nat) (rs : Rows) (id B (bimp (sorted rs) (sorted (take k rs))) tt))
  (= (take-sorted Z $rs) (imp-tt (sorted $rs)))
  (= (take-sorted (S $k) RNil) (refl tt))
  (= (take-sorted (S $k) (RCons $r $rs))
   (mp (band (bimp (head-ge $r $rs) (head-ge $r (take $k $rs))) (bimp (sorted $rs) (sorted (take $k $rs))))
       (bimp (band (head-ge $r $rs) (sorted $rs)) (band (head-ge $r (take $k $rs)) (sorted (take $k $rs))))
       (band-intro (bimp (head-ge $r $rs) (head-ge $r (take $k $rs))) (bimp (sorted $rs) (sorted (take $k $rs)))
                   (head-ge-take $r $k $rs) (take-sorted $k $rs))
       (band-mono (head-ge $r $rs) (head-ge $r (take $k $rs)) (sorted $rs) (sorted (take $k $rs))))))

!(hol:define &self bounded-sorted (-> (k : Nat) (rs : Rows) (id B (sorted (bounded k rs)) tt))
  (= (bounded-sorted $k RNil) (refl tt))
  (= (bounded-sorted $k (RCons $r $rs))
   (mp (sorted (insert $r (bounded $k $rs))) (sorted (take $k (insert $r (bounded $k $rs))))
       (mp (sorted (bounded $k $rs)) (sorted (insert $r (bounded $k $rs))) (bounded-sorted $k $rs) (insert-sorted $r (bounded $k $rs)))
       (take-sorted $k (insert $r (bounded $k $rs))))))

!(hol:define &self topk-sorted (-> (b : Nat) (k : Nat) (rs : Rows) (id B (sorted (topk b k rs)) tt))
  (= (topk-sorted $b $k $rs) (bounded-sorted $k (eligible $b $rs))))

!(hol:define &self all-lt (-> Nat Rows B)
  (= (all-lt $b RNil) tt)
  (= (all-lt $b (RCons $r $rs)) (band (lt (index $r) $b) (all-lt $b $rs))))

!(hol:define &self taut-bl (-> (l : B) (a : B) (a2 : B) (id B (bimp (bimp a a2) (bimp (band l a) (band l a2))) tt))
  (= (taut-bl tt tt tt) (refl tt))
  (= (taut-bl tt tt ff) (refl tt))
  (= (taut-bl tt ff tt) (refl tt))
  (= (taut-bl tt ff ff) (refl tt))
  (= (taut-bl ff tt tt) (refl tt))
  (= (taut-bl ff tt ff) (refl tt))
  (= (taut-bl ff ff tt) (refl tt))
  (= (taut-bl ff ff ff) (refl tt)))

!(hol:define &self taut-trans (-> (x : B) (y : B) (z : B) (id B (bimp (band (bimp x y) (bimp y z)) (bimp x z)) tt))
  (= (taut-trans tt tt tt) (refl tt))
  (= (taut-trans tt tt ff) (refl tt))
  (= (taut-trans tt ff tt) (refl tt))
  (= (taut-trans tt ff ff) (refl tt))
  (= (taut-trans ff tt tt) (refl tt))
  (= (taut-trans ff tt ff) (refl tt))
  (= (taut-trans ff ff tt) (refl tt))
  (= (taut-trans ff ff ff) (refl tt)))

!(hol:define &self taut-ins (-> (l : B) (a : B) (lf : B) (x : B) (id B (bimp (bimp (band l a) x) (bimp (band l (band lf a)) (band lf x))) tt))
  (= (taut-ins tt tt tt tt) (refl tt))
  (= (taut-ins tt tt tt ff) (refl tt))
  (= (taut-ins tt tt ff tt) (refl tt))
  (= (taut-ins tt tt ff ff) (refl tt))
  (= (taut-ins tt ff tt tt) (refl tt))
  (= (taut-ins tt ff tt ff) (refl tt))
  (= (taut-ins tt ff ff tt) (refl tt))
  (= (taut-ins tt ff ff ff) (refl tt))
  (= (taut-ins ff tt tt tt) (refl tt))
  (= (taut-ins ff tt tt ff) (refl tt))
  (= (taut-ins ff tt ff tt) (refl tt))
  (= (taut-ins ff tt ff ff) (refl tt))
  (= (taut-ins ff ff tt tt) (refl tt))
  (= (taut-ins ff ff tt ff) (refl tt))
  (= (taut-ins ff ff ff tt) (refl tt))
  (= (taut-ins ff ff ff ff) (refl tt)))

!(hol:define &self imp-trans (-> (x : B) (y : B) (z : B) (h1 : (id B (bimp x y) tt)) (h2 : (id B (bimp y z) tt)) (id B (bimp x z) tt))
  (= (imp-trans $x $y $z $h1 $h2) (mp (band (bimp $x $y) (bimp $y $z)) (bimp $x $z) (band-intro (bimp $x $y) (bimp $y $z) $h1 $h2) (taut-trans $x $y $z))))

!(hol:define &self imp-band-l (-> (l : B) (a : B) (a2 : B) (h : (id B (bimp a a2) tt)) (id B (bimp (band l a) (band l a2)) tt))
  (= (imp-band-l $l $a $a2 $h) (mp (bimp $a $a2) (bimp (band $l $a) (band $l $a2)) $h (taut-bl $l $a $a2))))

!(hol:define &self el-pick (-> (b : Nat) (r : Row) (rs : Rows) (c : B) (e : (id B (lt (index r) b) c)) (ih : (id B (all-lt b (eligible b rs)) tt))
               (id B (all-lt b (pick c (RCons r (eligible b rs)) (eligible b rs))) tt))
  (= (el-pick $b $r $rs tt $e $ih) (band-intro (lt (index $r) $b) (all-lt $b (eligible $b $rs)) $e $ih))
  (= (el-pick $b $r $rs ff $e $ih) $ih))

!(hol:define &self eligible-all (-> (b : Nat) (rs : Rows) (id B (all-lt b (eligible b rs)) tt))
  (= (eligible-all $b RNil) (refl tt))
  (= (eligible-all $b (RCons $r $rs)) (el-pick $b $r $rs (lt (index $r) $b) (refl (lt (index $r) $b)) (eligible-all $b $rs))))

!(hol:define &self ia-pick (-> (b : Nat) (r : Row) (f : Row) (rest : Rows) (c : B) (e : (id B (geq (score r) (score f)) c))
               (ih : (id B (bimp (band (lt (index r) b) (all-lt b rest)) (all-lt b (insert r rest))) tt))
               (id B (bimp (band (lt (index r) b) (all-lt b (RCons f rest))) (all-lt b (pick c (RCons r (RCons f rest)) (RCons f (insert r rest))))) tt))
  (= (ia-pick $b $r $f $rest tt $e $ih) (self-imp (band (lt (index $r) $b) (band (lt (index $f) $b) (all-lt $b $rest)))))
  (= (ia-pick $b $r $f $rest ff $e $ih)
   (mp (bimp (band (lt (index $r) $b) (all-lt $b $rest)) (all-lt $b (insert $r $rest)))
       (bimp (band (lt (index $r) $b) (band (lt (index $f) $b) (all-lt $b $rest))) (band (lt (index $f) $b) (all-lt $b (insert $r $rest))))
       $ih
       (taut-ins (lt (index $r) $b) (all-lt $b $rest) (lt (index $f) $b) (all-lt $b (insert $r $rest))))))

!(hol:define &self insert-all (-> (b : Nat) (r : Row) (rs : Rows) (id B (bimp (band (lt (index r) b) (all-lt b rs)) (all-lt b (insert r rs))) tt))
  (= (insert-all $b $r RNil) (self-imp (band (lt (index $r) $b) tt)))
  (= (insert-all $b $r (RCons $f $rest)) (ia-pick $b $r $f $rest (geq (score $r) (score $f)) (refl (geq (score $r) (score $f))) (insert-all $b $r $rest))))

!(hol:define &self take-all (-> (b : Nat) (k : Nat) (rs : Rows) (id B (bimp (all-lt b rs) (all-lt b (take k rs))) tt))
  (= (take-all $b Z $rs) (imp-tt (all-lt $b $rs)))
  (= (take-all $b (S $k) RNil) (refl tt))
  (= (take-all $b (S $k) (RCons $r $rs)) (imp-band-l (lt (index $r) $b) (all-lt $b $rs) (all-lt $b (take $k $rs)) (take-all $b $k $rs))))

!(hol:define &self bounded-all (-> (b : Nat) (k : Nat) (rs : Rows) (id B (bimp (all-lt b rs) (all-lt b (bounded k rs))) tt))
  (= (bounded-all $b $k RNil) (refl tt))
  (= (bounded-all $b $k (RCons $r $rs))
   (imp-trans (band (lt (index $r) $b) (all-lt $b $rs)) (all-lt $b (insert $r (bounded $k $rs))) (all-lt $b (take $k (insert $r (bounded $k $rs))))
     (imp-trans (band (lt (index $r) $b) (all-lt $b $rs)) (band (lt (index $r) $b) (all-lt $b (bounded $k $rs))) (all-lt $b (insert $r (bounded $k $rs)))
       (imp-band-l (lt (index $r) $b) (all-lt $b $rs) (all-lt $b (bounded $k $rs)) (bounded-all $b $k $rs))
       (insert-all $b $r (bounded $k $rs)))
     (take-all $b $k (insert $r (bounded $k $rs))))))

!(hol:define &self topk-eligible (-> (b : Nat) (k : Nat) (rs : Rows) (id B (all-lt b (topk b k rs)) tt))
  (= (topk-eligible $b $k $rs) (mp (all-lt $b (eligible $b $rs)) (all-lt $b (bounded $k (eligible $b $rs))) (eligible-all $b $rs) (bounded-all $b $k (eligible $b $rs)))))

!(hol:define &self proj1 (-> (a : B) (i : B) (id B (bimp (band a i) a) tt))
  (= (proj1 tt tt) (refl tt))
  (= (proj1 tt ff) (refl tt))
  (= (proj1 ff tt) (refl tt))
  (= (proj1 ff ff) (refl tt)))

!(hol:define &self proj2 (-> (a : B) (i : B) (id B (bimp (band a i) i) tt))
  (= (proj2 tt tt) (refl tt))
  (= (proj2 tt ff) (refl tt))
  (= (proj2 ff tt) (refl tt))
  (= (proj2 ff ff) (refl tt)))

!(hol:define &self weaken-imp (-> (g : B) (l : B) (id B (bimp l (bimp g l)) tt))
  (= (weaken-imp tt tt) (refl tt))
  (= (weaken-imp tt ff) (refl tt))
  (= (weaken-imp ff tt) (refl tt))
  (= (weaken-imp ff ff) (refl tt)))

!(hol:define &self taut-and3 (-> (p : B) (x : B) (y : B) (id B (bimp (band (bimp p x) (bimp p y)) (bimp p (band x y))) tt))
  (= (taut-and3 tt tt tt) (refl tt))
  (= (taut-and3 tt tt ff) (refl tt))
  (= (taut-and3 tt ff tt) (refl tt))
  (= (taut-and3 tt ff ff) (refl tt))
  (= (taut-and3 ff tt tt) (refl tt))
  (= (taut-and3 ff tt ff) (refl tt))
  (= (taut-and3 ff ff tt) (refl tt))
  (= (taut-and3 ff ff ff) (refl tt)))

!(hol:define &self proj-L (-> (l : B) (a : B) (t : B) (s : B) (id B (bimp (band (band l a) (band t s)) l) tt))
  (= (proj-L tt tt tt tt) (refl tt))
  (= (proj-L tt tt tt ff) (refl tt))
  (= (proj-L tt tt ff tt) (refl tt))
  (= (proj-L tt tt ff ff) (refl tt))
  (= (proj-L tt ff tt tt) (refl tt))
  (= (proj-L tt ff tt ff) (refl tt))
  (= (proj-L tt ff ff tt) (refl tt))
  (= (proj-L tt ff ff ff) (refl tt))
  (= (proj-L ff tt tt tt) (refl tt))
  (= (proj-L ff tt tt ff) (refl tt))
  (= (proj-L ff tt ff tt) (refl tt))
  (= (proj-L ff tt ff ff) (refl tt))
  (= (proj-L ff ff tt tt) (refl tt))
  (= (proj-L ff ff tt ff) (refl tt))
  (= (proj-L ff ff ff tt) (refl tt))
  (= (proj-L ff ff ff ff) (refl tt)))

!(hol:define &self proj-T (-> (l : B) (a : B) (t : B) (s : B) (id B (bimp (band (band l a) (band t s)) t) tt))
  (= (proj-T tt tt tt tt) (refl tt))
  (= (proj-T tt tt tt ff) (refl tt))
  (= (proj-T tt tt ff tt) (refl tt))
  (= (proj-T tt tt ff ff) (refl tt))
  (= (proj-T tt ff tt tt) (refl tt))
  (= (proj-T tt ff tt ff) (refl tt))
  (= (proj-T tt ff ff tt) (refl tt))
  (= (proj-T tt ff ff ff) (refl tt))
  (= (proj-T ff tt tt tt) (refl tt))
  (= (proj-T ff tt tt ff) (refl tt))
  (= (proj-T ff tt ff tt) (refl tt))
  (= (proj-T ff tt ff ff) (refl tt))
  (= (proj-T ff ff tt tt) (refl tt))
  (= (proj-T ff ff tt ff) (refl tt))
  (= (proj-T ff ff ff tt) (refl tt))
  (= (proj-T ff ff ff ff) (refl tt)))

!(hol:define &self proj-AS (-> (l : B) (a : B) (t : B) (s : B) (id B (bimp (band (band l a) (band t s)) (band a s)) tt))
  (= (proj-AS tt tt tt tt) (refl tt))
  (= (proj-AS tt tt tt ff) (refl tt))
  (= (proj-AS tt tt ff tt) (refl tt))
  (= (proj-AS tt tt ff ff) (refl tt))
  (= (proj-AS tt ff tt tt) (refl tt))
  (= (proj-AS tt ff tt ff) (refl tt))
  (= (proj-AS tt ff ff tt) (refl tt))
  (= (proj-AS tt ff ff ff) (refl tt))
  (= (proj-AS ff tt tt tt) (refl tt))
  (= (proj-AS ff tt tt ff) (refl tt))
  (= (proj-AS ff tt ff tt) (refl tt))
  (= (proj-AS ff tt ff ff) (refl tt))
  (= (proj-AS ff ff tt tt) (refl tt))
  (= (proj-AS ff ff tt ff) (refl tt))
  (= (proj-AS ff ff ff tt) (refl tt))
  (= (proj-AS ff ff ff ff) (refl tt)))

!(hol:define &self proj-TS (-> (l : B) (a : B) (t : B) (s : B) (id B (bimp (band (band l a) (band t s)) (band t s)) tt))
  (= (proj-TS tt tt tt tt) (refl tt))
  (= (proj-TS tt tt tt ff) (refl tt))
  (= (proj-TS tt tt ff tt) (refl tt))
  (= (proj-TS tt tt ff ff) (refl tt))
  (= (proj-TS tt ff tt tt) (refl tt))
  (= (proj-TS tt ff tt ff) (refl tt))
  (= (proj-TS tt ff ff tt) (refl tt))
  (= (proj-TS tt ff ff ff) (refl tt))
  (= (proj-TS ff tt tt tt) (refl tt))
  (= (proj-TS ff tt tt ff) (refl tt))
  (= (proj-TS ff tt ff tt) (refl tt))
  (= (proj-TS ff tt ff ff) (refl tt))
  (= (proj-TS ff ff tt tt) (refl tt))
  (= (proj-TS ff ff tt ff) (refl tt))
  (= (proj-TS ff ff ff tt) (refl tt))
  (= (proj-TS ff ff ff ff) (refl tt)))

!(hol:define &self all-gt (-> Nat Rows B)
  (= (all-gt $i RNil) tt)
  (= (all-gt $i (RCons $r $rs)) (band (lt $i (index $r)) (all-gt $i $rs))))

!(hol:define &self incr (-> Rows B)
  (= (incr RNil) tt)
  (= (incr (RCons $r $rs)) (band (all-gt (index $r) $rs) (incr $rs))))

!(hol:define &self tie-ok (-> Row Rows B)
  (= (tie-ok $r RNil) tt)
  (= (tie-ok $r (RCons $s $ss)) (bimp (geq (score $s) (score $r)) (lt (index $r) (index $s)))))

!(hol:define &self stable (-> Rows B)
  (= (stable RNil) tt)
  (= (stable (RCons $r $rs)) (band (tie-ok $r $rs) (stable $rs))))

!(hol:define &self imp-and (-> (p : B) (x : B) (y : B) (h1 : (id B (bimp p x) tt)) (h2 : (id B (bimp p y) tt)) (id B (bimp p (band x y)) tt))
