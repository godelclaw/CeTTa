; Generated by tools/prime_scope_migration.py from lib/dict.metta; do not edit.
(scope:profile lexical-fresh per-call reference)

; Functional key-value dictionaries backed by spaces: a `hash` space where
; the profile provides one, the default (key-indexed) space elsewhere.
;
; Algebraic domain: a dictionary is a functional relation R subset K x V
; stored as `(dict:entry $key $val)` facts.
;   - `dict:get` enforces the functional invariant (`functional_iff_at_most_one`):
;     0 matches -> `(empty)` (no answer);
;     1 match   -> the unique value;
;     >1 match  -> `(Error dict:get (AmbiguousDictKey $key))`.
;   - An error names its operation by symbol, not by the call: PeTTa evaluates
;     an embedded call again, which would rebuild the same error without end.
;   - Four explicit update policies over keys:
;     `dict:put!`            (replace: overwrites any prior value for $key)
;     `dict:put-keep-first!` (keep-first: preserves existing binding if present)
;     `dict:put-reject!`     (reject: raises `DuplicateDictKey` if $key exists)
;     `dict:put-merge!`      (merge: combines `$old` and `$val` with `$combine`)

; The `hash` engine is a host form of the extended profile. Elsewhere
; `(new-space hash)` does not reduce, and atoms added to it vanish. The
; default space indexes keys too, so a dictionary keeps its semantics and
; keyed access in every profile.
(= (dict:new)
   (dict:space (new-space hash)))

(= (dict:new-with $engine)
   (dict:space (new-space hash $engine)))

(= (dict:space $made)
   (if (== (get-metatype $made) Grounded) $made (new-space)))

(= (dict:remove-list! $d $key $vals)
   (if (== $vals ())
       ()
       (let ($head $tail) (decons-atom $vals)
         (let $_ (remove-atom $d (dict:entry $key $head))
           (dict:remove-list! $d $key $tail)){$_}){$head $tail}))

(= (dict:remove! $d $key)
   (let $vals (collapse (match $d (dict:entry $key $v) $v){$key})
     (dict:remove-list! $d $key $vals)))

(= (dict:get $d $key)
   (let $vals (collapse (match $d (dict:entry $key $v) $v){$key})
     (let $n (size-atom $vals)
       (if (== $n 0)
           (empty)
           (if (== $n 1)
               (car-atom $vals)
               (Error dict:get (AmbiguousDictKey $key)))))))

(= (dict:get-or $d $key $default)
   (let $vals (collapse (match $d (dict:entry $key $v) $v){$key})
     (let $n (size-atom $vals)
       (if (== $n 0)
           $default
           (if (== $n 1)
               (car-atom $vals)
               (Error dict:get-or (AmbiguousDictKey $key)))))))

(= (dict:has-key? $d $key)
   (let $vals (collapse (match $d (dict:entry $key $v) $v){$key})
     (> (size-atom $vals) 0)))

(= (dict:put! $d $key $val)
   (let $_ (dict:remove! $d $key)
     (add-atom $d (dict:entry $key $val))))

(= (dict:put-keep-first! $d $key $val)
   (if (dict:has-key? $d $key)
       ()
       (add-atom $d (dict:entry $key $val))))

(= (dict:put-reject! $d $key $val)
   (if (dict:has-key? $d $key)
       (Error dict:put-reject! (DuplicateDictKey $key))
       (add-atom $d (dict:entry $key $val))))

(= (dict:put-merge! $d $key $val $combine)
   (let $vals (collapse (match $d (dict:entry $key $v) $v){$key})
     (let $n (size-atom $vals)
       (if (== $n 0)
           (add-atom $d (dict:entry $key $val))
           (if (== $n 1)
               (let $old (car-atom $vals)
                 (let $_ (remove-atom $d (dict:entry $key $old))
                   (let $merged ($combine $old $val)
                     (add-atom $d (dict:entry $key $merged))){$merged}){$_}){$old}
               (Error dict:put-merge! (AmbiguousDictKey $key)))))))

; One answer each: `collapse` gathers every match (no dialect defines
; collapse-set or collapse-bag, which left one branch per entry).
(= (dict:keys $d)
   (unique-atom (collapse (match $d (dict:entry $k $v) $k){$k $v})))

(= (dict:entries $d)
   (collapse (match $d (dict:entry $k $v) ($k $v))))

(= (dict:size $d)
   (let $keys (dict:keys $d)
     (size-atom $keys)))
