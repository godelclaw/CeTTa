; First-order declaration inspection and checked contextual rewrite proposals.
; The exported LanguageDef is data. Loading or running it does not grant a
; conversion licence: each proposed endpoint is checked in the chosen theory.
!(import! &self langdef)

(= (math:append LNil $ys) $ys)
(= (math:append (LCons $x $xs) $ys)
   (let $rest (math:append $xs $ys) (LCons $x $rest)))
; Only closed first-order arrows are exported. Higher-order and dependent
; declarations retain their ordinary mathematical interface.
(= (math:domains $type)
   (case (get-metatype $type)
     ((Symbol ())
      (Expression (case $type
        (((-> $domain $rest) (cons-atom $domain (math:domains $rest)))
         ($_ (let ($head $parts) (decons-atom $type)
                (if (== $head ->) (math:all-but-last $parts) Empty)))))))))
(= (math:all-but-last $parts)
   (let ($first $rest) (decons-atom $parts)
     (case $rest ((() ())
       ($_ (cons-atom $first (math:all-but-last $rest)))))))
(= (math:result $type)
   (case (get-metatype $type)
     ((Symbol $type)
      (Expression (let ($head $parts) (decons-atom $type)
        (if (== $head ->) (math:result (math:last $parts)) Empty))))))
(= (math:last $parts)
   (let ($first $rest) (decons-atom $parts)
     (case $rest ((() $first) ($_ (math:last $rest))))))
(= (math:simple-types $types)
   (case $types ((() True)
     ($_ (let ($first $rest) (decons-atom $types)
       (if (== (get-metatype $first) Symbol) (math:simple-types $rest) False))))))
(= (math:signature $space $name)
   (match $space (: $name $type) $type){$name})
(= (math:argument-name $index)
   (format-args "argument:{}" (cons-atom $index ())))
(= (math:arguments $types $index)
   (case $types ((() LNil)
     ($_ (let ($first $rest) (decons-atom $types)
       (let* (($name (math:argument-name $index)) ($type (repr $first))
              ($tail (math:arguments $rest (+ $index 1))))
         (LCons (TermSimple $name (TBase $type)) $tail)))))))
(= (math:grammar $space $head)
   (let* (($type (math:signature $space $head))
          ($domains (math:domains $type)) ($result (math:result $type)))
     (if (math:simple-types (cons-atom $result $domains))
       (let* (($name (repr $head)) ($category (repr $result))
              ($args (math:arguments $domains 0)))
         (GrammarRule $name $category $args LNil EvalNone))
       Empty)))
(= (math:grammars $space $heads)
   (case $heads ((() LNil)
     ($_ (let ($head $rest) (decons-atom $heads)
       (let* (($rule (math:grammar $space $head)) ($tail (math:grammars $space $rest)))
         (LCons $rule $tail)))))))
(= (math:types $types)
   (case $types ((() LNil)
     ($_ (let ($type $rest) (decons-atom $types)
       (let* (($name (repr $type)) ($tail (math:types $rest)))
         (LCons (TypeDecl $name CarrierAst) $tail)))))))

; Kernel patterns have indexed rule variables and explicit application spines.
; Naming an index vN retains sharing without exposing host pattern variables.
(= (math:pattern $term)
   (case (get-metatype $term)
     ((Symbol (let $name (repr $term) (PApp $name LNil)))
      (Expression (case $term
        (((PVar $index) (let $name (format-args "v{}" (cons-atom $index ())) (FVar $name)))
         ((DeclConst $head) (let $name (repr $head) (PApp $name LNil)))
         ((App $fun $arg)
           (let (PApp $name $args) (math:pattern $fun)
             (let* (($value (math:pattern $arg))
                    ($values (math:append $args (LCons $value LNil))))
               (PApp $name $values))))))))))
(= (math:patterns $terms)
   (case $terms ((() LNil)
     ($_ (let ($term $rest) (decons-atom $terms)
       (let* (($value (math:pattern $term)) ($tail (math:patterns $rest)))
         (LCons $value $tail)))))))
(= (math:bindings $space $pattern $type)
   (case $pattern
     (((FVar $name) (let $category (repr $type)
                      (LCons (TypeBinding $name (TBase $category)) LNil)))
      ((PApp $name $args)
        (let* (($head (parse $name)) ($signature (math:signature $space $head))
               ($domains (math:domains $signature)))
          (math:argument-bindings $space $args $domains))))))
(= (math:argument-bindings $space $args $domains)
   (case $args ((LNil LNil)
     ((LCons $arg $rest)
       (let ($type $types) (decons-atom $domains)
         (let* (($here (math:bindings $space $arg $type))
                ($tail (math:argument-bindings $space $rest $types)))
           (math:append $here $tail)))))))
(= (math:rule $space $head $ordinal $patterns $body)
   (let* (($name (repr $head))
          ($key (format-args "{}:{}" (cons-atom $name (cons-atom $ordinal ()))))
          ($left (math:patterns $patterns)) ($right (math:pattern $body))
          ($signature (math:signature $space $head))
          ($domains (math:domains $signature))
          ($bindings (math:argument-bindings $space $left $domains)))
     (RewriteRule $key $bindings LNil (PApp $name $left) $right)))
(= (math:rule-rows $space $head $rows $ordinal)
   (case $rows ((() LNil)
     ($_ (let ((Math:Rule $patterns $body) $rest) (decons-atom $rows)
       (let* (($rule (math:rule $space $head $ordinal $patterns $body))
              ($tail (math:rule-rows $space $head $rest (+ $ordinal 1))))
         (LCons $rule $tail)))))))
(= (math:rules $space $heads)
   (case $heads ((() LNil)
     ($_ (let ($head $rest) (decons-atom $heads)
       (let* (($rows (collapse (match $space (type:rule $head $arity $patterns $body)
                                   (Math:Rule $patterns $body)){$head}))
              ($here (math:rule-rows $space $head $rows 0))
              ($tail (math:rules $space $rest)))
         (math:append $here $tail)))))))

; Computation under an argument is an explicit contextual rule. The runner
; retains its nested trace rather than quietly changing root-step semantics.
(= (math:context-args $types $selected $index $after)
   (case $types ((() LNil)
     ($_ (let ($type $rest) (decons-atom $types)
       (let* (($name (if (and $after (== $selected $index)) "target"
                        (math:argument-name $index)))
              ($tail (math:context-args $rest $selected (+ $index 1) $after)))
         (LCons (FVar $name) $tail)))))))
(= (math:context-bindings $types $index)
   (case $types ((() LNil)
     ($_ (let ($type $rest) (decons-atom $types)
       (let* (($name (math:argument-name $index)) ($category (repr $type))
              ($tail (math:context-bindings $rest (+ $index 1))))
         (LCons (TypeBinding $name (TBase $category)) $tail)))))))
(= (math:contexts $head $types $rest $index)
   (case $rest ((() LNil)
     ($_ (let ($type $tail-types) (decons-atom $rest)
       (let* (($name (repr $head)) ($category (repr $type))
              ($key (format-args "{}:under:{}" (cons-atom $name (cons-atom $index ()))))
              ($from (math:argument-name $index))
              ($bindings (math:context-bindings $types 0))
              ($all-bindings (LCons (TypeBinding "target" (TBase $category)) $bindings))
              ($left (math:context-args $types $index 0 False))
              ($right (math:context-args $types $index 0 True))
              ($rule (RewriteRule $key $all-bindings
                        (LCons (Congruence (FVar $from) (FVar "target")) LNil)
                        (PApp $name $left) (PApp $name $right)))
              ($tail (math:contexts $head $types $tail-types (+ $index 1))))
         (LCons $rule $tail)))))))
(= (math:all-contexts $space $heads)
   (case $heads ((() LNil)
     ($_ (let ($head $rest) (decons-atom $heads)
       (let* (($signature (math:signature $space $head))
              ($types (math:domains $signature))
              ($here (math:contexts $head $types $types 0))
              ($tail (math:all-contexts $space $rest)))
         (math:append $here $tail)))))))

; An explicit list selects the exported carriers and heads. No equations are
; copied into a second authored definition. Missing grammar stays unavailable.
(= (math:presentation $space $types $heads)
   (let* (($carriers (math:types $types)) ($grammar (math:grammars $space $heads))
          ($roots (math:rules $space $heads)) ($contexts (math:all-contexts $space $heads))
          ($rules (math:append $roots $contexts)))
     (GSLTLanguageDefWireV1 "SelectedMathematics" $carriers $grammar LNil $rules)))

; Reports are inspectable data, never sealed theorem values. The supplied
; proof must concern these exact endpoints, in this selected scope.
(= (math:check-conversion $space $type $source $target $proof $budget)
   (let $verdict (try (type:check $space $proof (id $type $source $target) $budget))
     (Math:Conversion $source $target $proof $verdict)))
(= (math:check-steps $space $type $source $steps $budget)
   (case $steps ((() ())
     ($_ (let ((LangDef:ContextualTermResult $target $trace) $rest) (decons-atom $steps)
       (let* (($checked (math:check-conversion $space $type $source $target (refl $source) $budget))
              ($tail (math:check-steps $space $type $source $rest $budget)))
         (cons-atom (Math:Step $checked $trace) $tail)))))))
(= (math:via-results $space $type $source $budget $result)
   (case $result
     (((LangDef:ContextualCodecFault $phase resource_limit $detail)
        (Math:Steps (Incomplete (LangDef:ContextualCodecFault $phase resource_limit $detail)) ()))
      ($_ (let ($head $body) (decons-atom $result)
        (if (== $head LangDef:ContextualTermResults)
          (let ($status $steps) (decons-atom $body)
            (let $checked (math:check-steps $space $type $source $steps $budget)
              (Math:Steps $status $checked)))
          $result))))))
(= (math:via $space $type $language $category $depth $work $budget $source)
   (let $result (langdef:rewrite-term-at-data $language $category $category
                    $depth $work (LangDef:RelationRows) $source)
     (math:via-results $space $type $source $budget $result)))
