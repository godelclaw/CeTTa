; Finite, incremental graph traversals over the same captured KB view.
; A graph is the projection of a relation onto two ground identity fields.
; Equal edges with different fact identities remain different occurrences.
; Non-ground or missing endpoints are outside this projection, not variables
; to instantiate. Other fields may contain arbitrary inert values.
!(import! &self "kb.metta")

(= (kbg:direction? $direction) (or (== $direction out) (== $direction in)))
(= (kbg:spec? $spec)
   (if (knowledge:tagged? $spec KgRelation 4)
     (let (KgRelation $relation $source $target) $spec
       (if (and (knowledge:ground-identity? $relation)
                (and (kb:integer? $source) (kb:integer? $target)))
           (and (>= $source 0) (>= $target 0)) False)) False))
(= (kbg:plan $plan)
   (if (and (knowledge:headed? $plan) (knowledge:ground-identity? $plan))
     (case $plan
       (((KgNeighbours $spec $start $direction)
         (kbg:setup $spec $start $direction KgNeighboursMode))
        ((KgReach $spec $start $direction)
         (kbg:setup $spec $start $direction KgReachMode))
        ((KgTriangles $spec $start $direction)
         (kbg:setup $spec $start $direction (KgTrianglesMode $start)))
        ((KgPaths $spec $start $minimum $maximum $direction)
         (if (and (kb:integer? $minimum) (kb:integer? $maximum))
           (if (and (>= $minimum 0) (>= $maximum $minimum))
             (kbg:setup $spec $start $direction (KgPathsMode $minimum $maximum))
             (KbRefused graph-path-bound)) (KbRefused graph-path-bound)))
        ((KgShortest $spec $start $goal $ties $direction)
         (if (or (== $ties one) (== $ties all))
           (kbg:setup $spec $start $direction (KgShortestMode $goal $ties))
           (KbRefused graph-shortest-mode)))
        ($bad (KbRefused graph-plan)))) (KbRefused graph-plan)))
(= (kbg:setup $spec $start $direction $mode)
   (if (and (kbg:spec? $spec) (kbg:direction? $direction))
       (KgSetup $spec $start $direction $mode) (KbRefused graph-spec)))

; The allowance bounds retained frontier entries plus visited identities.
; It is not a byte or wall-clock limit. Per-edge decoded bytes and page steps
; have independent limits. Continuations are consumed once and own one scan.
(= (kbg:open $view $plan $bytes $states)
   (if (and (kb:integer? $bytes) (kb:integer? $states))
     (if (and (> $bytes 0) (> $states 1))
       (case (kbg:plan $plan)
         (((KgSetup $spec $start $direction $mode)
           (case (store:encode $start)
             (((StoreEncoded $key)
               (let* (($config (KgConfig $spec $direction $bytes $states))
                      ($seed (KgPath (cons-atom $start ()) () 0))
                      ($frontier (KgFrontier (cons-atom $seed ()) () 1 ((KgSeen $key 0 False)) 1 KgNoDistance))
                      ($cursor (KgCursor $view $config $mode $frontier KgIdle (KgWork 0 0 0 1))))
                 (case $mode
                   (((KgPathsMode 0 $maximum)
                     (KgCursor $view $config $mode $frontier (KgSeed $seed) (KgWork 0 0 0 1)))
                    ((KgShortestMode $goal $ties)
                     (if (kb:equal $start $goal)
                       (KgCursor $view $config $mode (KgFrontier () () 0 () 0 0)
                         (KgSeed $seed) (KgWork 0 0 0 1)) $cursor))
                    ($other $cursor)))))
              ($error $error))))
          ($error $error))) (KbRefused graph-budget)) (KbRefused graph-budget)))

(= (kbg:cursor? $cursor)
   (if (knowledge:tagged? $cursor KgCursor 7)
     (let (KgCursor $view $config $mode $frontier $active $work) $cursor
       (and (not (== (get-metatype $view) Variable))
         (and (knowledge:tagged? $config KgConfig 5)
           (and (knowledge:tagged? $frontier KgFrontier 7)
             (and (knowledge:tagged? $work KgWork 5)
               (or (== $active KgIdle) (knowledge:headed? $active))))))) False))
(= (kbg:work $cursor)
   (if (kbg:cursor? $cursor) (index-atom $cursor 6) (KbRefused graph-cursor)))
(= (kbg:observe $cursor)
   (if (kbg:cursor? $cursor)
     (let (KgCursor $view (KgConfig (KgRelation $relation $from $to) $direction $bytes $limit)
            $mode $frontier $active $work) $cursor
       (kb:observe-selector $view (KbRelation $relation))) (KbRefused graph-cursor)))
(= (kbg:close-active $active)
   (case $active
     (((KgScan $scan $path) (let $closed (kb:query-close $scan) KgClosed))
      (KgIdle KgClosed) ((KgSeed $path) KgClosed) ($bad (KbRefused graph-state)))))
(= (kbg:close $cursor)
   (if (kbg:cursor? $cursor) (kbg:close-active (index-atom $cursor 5))
       (KbRefused graph-cursor)))

(= (kbg:path-value (KgPath $nodes $edges $length))
   (KgPath (list:reverse $nodes) (list:reverse $edges) $length))
(= (kbg:seen $key $entries)
   (if (== $entries ()) KgUnseen
     (let (KgSeen $stored $depth $emitted) (car-atom $entries)
       (if (== $key $stored) (KgKnown $depth $emitted)
           (kbg:seen $key (cdr-atom $entries))))))
(= (kbg:mark-emitted $key $entries)
   (if (== $entries ()) ()
     (let* ((($first $rest) (decons-atom $entries)) ((KgSeen $stored $depth $emitted) $first))
       (if (== $key $stored) (cons-atom (KgSeen $stored $depth True) $rest)
           (cons-atom $first (kbg:mark-emitted $key $rest))))))
(= (kbg:at-limit? $mode $length $best)
   (case $mode
     (((KgPathsMode $minimum $maximum) (>= $length $maximum))
      ((KgTrianglesMode $start) (>= $length 3))
      ((KgShortestMode $goal $ties) (if (== $best KgNoDistance) False (>= $length $best)))
      ($other False))))

; Internal transitions carry the complete next frontier and optional answer.
; A queue made of front/back lists preserves breadth-first distance order.
(= (kbg:idle $view (KgConfig (KgRelation $relation $from $to) $direction $bytes $limit)
                    $mode (KgFrontier $front $back $queued $seen $count $best))
   (if (== $front ())
     (if (== $back ()) (KgEnd 0 0)
       (KgSkip (KgFrontier (list:reverse $back) () $queued $seen $count $best) KgIdle 0 0 0))
     (let* ((($path $tail) (decons-atom $front)) ((KgPath $nodes $edges $depth) $path)
            ($pending (KgFrontier $tail $back (- $queued 1) $seen $count $best)))
       (if (kbg:at-limit? $mode $depth $best) (KgSkip $pending KgIdle 0 0 0)
         (let $position (if (== $direction out) $from $to)
           (case (kb:query-open $view (KbArgument $relation $position (car-atom $nodes)) $bytes)
             (((KbCursor $v $scan $p $prefix $budget $rows $keys $decoded)
               (KgSkip $pending
                 (KgScan (KbCursor $v $scan $p $prefix $budget $rows $keys $decoded) $path) 0 0 0))
              ($error (KgFail $error 0 0)))))))))

; The exact argument index is a domain selector. Validate the other endpoint
; before treating a record as a graph edge; never instantiate stored variables.
(= (kbg:edge (KgRelation $relation $from $to) $direction $fact)
   (case $fact
     (((KbFact $identity $stored $fields)
       (if (and (< $from (size-atom $fields)) (< $to (size-atom $fields)))
         (let* (($source (index-atom $fields $from)) ($target (index-atom $fields $to)))
           (if (and (knowledge:ground-identity? $source) (knowledge:ground-identity? $target))
               (KgEdge $identity $source $target) KgNotEdge)) KgNotEdge))
      ($bad (KbRefused graph-row)))))

(= (kbg:admit $limit $frontier $path $key $enqueue $remember $emitted $best)
   (let* (((KgFrontier $front $back $queued $seen $count $old-best) $frontier)
          ((KgPath $nodes $edges $depth) $path)
          ($new-queued (+ $queued (if $enqueue 1 0)))
          ($new-count (+ $count (if $remember 1 0))))
     (if (> (+ $new-queued $new-count) $limit) (KbRefused graph-state-budget)
       (KgFrontier $front (if $enqueue (cons-atom $path $back) $back) $new-queued
         (if $remember (cons-atom (KgSeen $key $depth $emitted) $seen)
             (if $emitted (kbg:mark-emitted $key $seen) $seen)) $new-count $best))))

; Triangles are anchored, directed three-edge cycles with three distinct
; vertices. Rotations and parallel edge occurrences are not silently merged.
(= (kbg:triangle-result $result)
   (case $result
     (((KgVisit (KgSome (KgPath $nodes $edges 3)) $frontier $offered $stop)
       (let* (($a (index-atom $nodes 0)) ($b (index-atom $nodes 1))
              ($c (index-atom $nodes 2)) ($end (index-atom $nodes 3)))
         (KgVisit
           (if (and (kb:equal $a $end)
                    (and (not (kb:equal $a $b))
                         (and (not (kb:equal $a $c)) (not (kb:equal $b $c)))))
               (KgSome (KgPath $nodes $edges 3)) KgNone)
           $frontier $offered $stop)))
      ($other $other))))
(= (kbg:visit $config $mode $frontier $path $edge)
   (let* (((KgConfig $spec $direction $bytes $limit) $config)
          ((KgFrontier $front $back $queued $seen $count $best) $frontier)
          ((KgPath $nodes $edges $depth) $path)
          ((KgEdge $identity $source $target) $edge)
          ($next-node (if (== $direction out) $target $source))
          ($next-depth (+ $depth 1))
          ($next-path (KgPath (cons-atom $next-node $nodes) (cons-atom $identity $edges) $next-depth)))
     (case $mode
       ((KgNeighboursMode (KgVisit (KgSome $edge) $frontier 0 False))
        ((KgTrianglesMode $start)
         (kbg:triangle-result (kbg:visit $config (KgPathsMode 3 3) $frontier $path $edge)))
        ((KgPathsMode $minimum $maximum)
         (let* (($enqueue (< $next-depth $maximum))
                ($updated (kbg:admit $limit $frontier $next-path "" $enqueue False False $best)))
           (if (knowledge:tagged? $updated KgFrontier 7)
             (KgVisit (if (>= $next-depth $minimum) (KgSome (kbg:path-value $next-path)) KgNone)
                      $updated (if $enqueue 1 0) False) $updated)))
        ($other
         (case (store:encode $next-node)
           (((StoreEncoded $key)
             (let $known (kbg:seen $key $seen)
               (case $mode
                 ((KgReachMode
                   (if (== $known KgUnseen)
                     (let $updated (kbg:admit $limit $frontier (KgPath (cons-atom $next-node ()) () $next-depth)
                                             $key True True True $best)
                       (if (knowledge:tagged? $updated KgFrontier 7)
                           (KgVisit (KgSome $next-node) $updated 1 False) $updated))
                     (case $known
                       (((KgKnown $old-depth False)
                         (KgVisit (KgSome $next-node)
                           (kbg:admit $limit $frontier $next-path $key False False True $best) 0 False))
                        ($seen-already (KgVisit KgNone $frontier 0 False))))))
                  ((KgShortestMode $goal $ties)
                   (if (or (== $known KgUnseen)
                           (and (== $ties all) (== $known (KgKnown $next-depth False))))
                     (if (kb:equal $next-node $goal)
                       (KgVisit (KgSome (kbg:path-value $next-path))
                         (KgFrontier $front $back $queued $seen $count $next-depth) 0 (== $ties one))
                       (let* (($enqueue (if (== $best KgNoDistance) True (< $next-depth $best)))
                              ($updated (kbg:admit $limit $frontier $next-path $key $enqueue
                                                  (== $known KgUnseen) False $best)))
                         (if (knowledge:tagged? $updated KgFrontier 7)
                             (KgVisit KgNone $updated (if $enqueue 1 0) False) $updated)))
                     (KgVisit KgNone $frontier 0 False)))
                  ($bad (KbRefused graph-mode))))))
            ($error $error))))))))

(= (kbg:scan $config $mode $frontier $source $path)
   (let* (((KgConfig $spec $direction $budget $limit) $config)
          ((KbCursor $view $handle $position $prefix $b $rows $keys $decoded) $source))
     (case (kb:query-next $source)
       (((KbYield $fact (KbCursor $v $s $p $f $bytes $n $k $d))
         (let* (($next (KbCursor $v $s $p $f $bytes $n $k $d))
                ($edge (kbg:edge $spec $direction $fact)))
           (if (== $edge KgNotEdge) (KgSkip $frontier (KgScan $next $path) (- $k $keys) (- $d $decoded) 0)
             (case (kbg:visit $config $mode $frontier $path $edge)
               (((KgVisit $answer $pending $enqueued $stop)
                 (let $active (if $stop (let $closed (kb:query-close $next) KgIdle) (KgScan $next $path))
                   (KgVisited $answer
                     (if $stop (KgFrontier () () 0 () 0 KgNoDistance) $pending)
                     $active (- $k $keys) (- $d $decoded) $enqueued)))
                ($error (let $closed (kb:query-close $next) (KgFail $error (- $k $keys) (- $d $decoded)))))))))
        ((KbEnd (KbWork $n $k $d))
         (let $closed (kb:query-close $source) (KgSkip $frontier KgIdle (- $k $keys) (- $d $decoded) 0)))
        ($error (let $closed (kb:query-close $source) (KgFail $error 0 0)))))))

(= (kbg:advance $view $config $mode $frontier $active)
   (case $active
     ((KgIdle (kbg:idle $view $config $mode $frontier))
      ((KgSeed $path) (KgVisited (KgSome (kbg:path-value $path)) $frontier KgIdle 0 0 0))
      ((KgScan $source $path) (kbg:scan $config $mode $frontier $source $path))
      ($bad (KgFail (KbRefused graph-state) 0 0)))))
(= (kbg:step $cursor)
   (if (kbg:cursor? $cursor) (kbg:step-ready $cursor) (KbRefused graph-cursor)))
(= (kbg:step-ready (KgCursor $view $config $mode $frontier $active (KgWork $steps $keys $bytes $offered)))
   (case (kbg:advance $view $config $mode $frontier $active)
     (((KgVisited $answer $pending $next $k $d $enqueued)
       (let $continuation (KgCursor $view $config $mode $pending $next
                             (KgWork (+ $steps 1) (+ $keys $k) (+ $bytes $d) (+ $offered $enqueued)))
         (case $answer
           (((KgSome $row) (KgYield $row $continuation))
            (KgNone (KgContinue $continuation))))))
      ((KgSkip $pending $next $k $d $enqueued)
       (KgContinue (KgCursor $view $config $mode $pending $next
         (KgWork (+ $steps 1) (+ $keys $k) (+ $bytes $d) (+ $offered $enqueued)))))
      ((KgEnd $k $d) (KgDone (KgWork (+ $steps 1) (+ $keys $k) (+ $bytes $d) $offered)))
      ((KgFail $error $k $d) (KgFailed $error (KgWork (+ $steps 1) (+ $keys $k) (+ $bytes $d) $offered))))))
(= (kbg:page $cursor $count $fuel)
   (if (kbg:cursor? $cursor)
     (if (and (kb:integer? $count) (kb:integer? $fuel))
       (if (and (> $count 0) (>= $fuel 0)) (kbg:page-walk $cursor $count $fuel ())
           (KbRefused graph-page-budget)) (KbRefused graph-page-budget)) (KbRefused graph-cursor)))
(= (kbg:page-walk $cursor $count $fuel $reversed)
   (if (== $count 0) (KgPage (list:reverse $reversed) (KgMore $cursor))
     (if (== $fuel 0) (KgPage (list:reverse $reversed) (KgPaused $cursor))
       (case (kbg:step-ready $cursor)
         (((KgYield $row $next) (kbg:page-walk $next (- $count 1) (- $fuel 1) (cons-atom $row $reversed)))
          ((KgContinue $next) (kbg:page-walk $next $count (- $fuel 1) $reversed))
          ((KgDone $work) (KgPage (list:reverse $reversed) (KgComplete $work)))
          ((KgFailed $error $work) (KgPage (list:reverse $reversed) (KgFailure $error $work))))))))
(= (kbg:explain $plan)
   (case (kbg:plan $plan)
     (((KgSetup (KgRelation $relation $from $to) $start $direction $mode)
       (KgPlan $mode ground-endpoints breadth-first
         (kb:explain (KbArgument $relation (if (== $direction out) $from $to) $start))
         (dependencies relation-range) (frontier explicit) (visited linear-reference)))
      ($error $error))))
