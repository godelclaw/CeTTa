; Candidate postings for durable ordinary Spaces. The shared matcher owns
; unification. Projection equality is exact only for symbols and strings;
; all other projected values and whole-variable facts use the wildcard range.
!(import! &self "knowledge.metta")
!(import! &self (library list))
!(import! &self "atom_data.metta")

(: durable-index:exact? (-> Atom Bool))
(: durable-index:postings (-> Atom String Atom %Undefined%))
(: durable-index:one (-> Atom String Atom %Undefined%))
(: durable-index:project (-> Atom Number Number %Undefined%))
(: durable-index:bucket (-> String Atom %Undefined%))

(= (durable-index:integer? $value)
  (if (== (get-metatype $value) Grounded)
    (case (store:key-i64 $value) (((StoreKeyBytes $bytes) True) ($other False))) False))
(= (durable-index:spec? $spec)
  (if (knowledge:tagged? $spec SpaceIndexV1 3)
    (let (SpaceIndexV1 $arity $position) $spec
      (if (and (durable-index:integer? $arity) (durable-index:integer? $position))
        (and (and (> $arity 0) (<= $arity 4294967295)) (and (>= $position 0) (< $position $arity))) False))
    False))
(= (durable-index:prefix $collection $arity $position)
  (knowledge:address "space/index/v1/" (SpaceIndexKeyV1 $collection $arity $position)))
(= (durable-index:descriptors $collection $specs)
  (durable-index:describe $collection $specs () ()))
(= (durable-index:describe $collection $specs $seen $reverse)
  (if (== (get-metatype $specs) Expression)
    (if (== $specs ()) (SpaceIndexesV1 (list:reverse $reverse))
      (let $spec (car-atom $specs)
        (if (durable-index:spec? $spec)
          (if (durable-index:member? $spec $seen) (SpaceRefusedV1 repeated-index)
            (let (SpaceIndexV1 $arity $position) $spec
              (case (durable-index:prefix $collection $arity $position)
                (((KnowledgeAddressV1 $prefix)
                  (durable-index:describe $collection (cdr-atom $specs)
                    (cons-atom $spec $seen)
                    (cons-atom (StoreSpaceIndexV1 $arity $position $prefix) $reverse)))
                 ($error $error)))))
          (SpaceRefusedV1 index-format))))
    (SpaceRefusedV1 index-list)))
(= (durable-index:member? $item $items)
  (if (== $items ()) False
    (if (== $item (car-atom $items)) True (durable-index:member? $item (cdr-atom $items)))))
(= (durable-index:valid? $collection $indexes)
  (durable-index:validate $collection $indexes ()))
(= (durable-index:validate $collection $indexes $seen)
  (if (== (get-metatype $indexes) Expression)
    (if (== $indexes ()) True
      (let $index (car-atom $indexes)
        (if (knowledge:tagged? $index StoreSpaceIndexV1 4)
          (let (StoreSpaceIndexV1 $arity $position $prefix) $index
            (let $spec (SpaceIndexV1 $arity $position)
              (if (and (durable-index:spec? $spec) (not (durable-index:member? $spec $seen)))
                (case (durable-index:prefix $collection $arity $position)
                  (((KnowledgeAddressV1 $expected)
                    (if (== $prefix $expected)
                      (durable-index:validate $collection (cdr-atom $indexes) (cons-atom $spec $seen)) False))
                   ($error False))) False)))
          False)))
    False))
(= (durable-index:exact? $value)
  ; A grounded native operator is represented as a Symbol in portable data,
  ; although language reflection calls its metatype Grounded. Use the shared
  ; wire kind, so callable-looking data is classified without invoking it.
  (case (store:encode $value)
    (((StoreEncoded $bytes)
      (let $tag (str:byte-slice $bytes 4 5) (or (== $tag "S") (== $tag "T"))))
     ($failure False))))
(= (durable-index:project $atom $arity $position)
  (case (get-metatype $atom)
    ((Variable SpaceIndexAnyV1)
     (Expression
       (if (== (size-atom $atom) $arity)
         (let (AtomDataV1 $field) (atom-data:item $atom $position) (SpaceIndexFieldV1 $field)) SpaceIndexSkipV1))
     ($other SpaceIndexSkipV1))))
(= (durable-index:bucket $prefix $field)
  (if (durable-index:exact? $field)
    (case (store:encode $field)
      (((StoreEncoded $bytes) (SpaceIndexPrefixV1 (str:concat (str:concat $prefix "/exact/") (str:concat $bytes "/"))))
       ($error $error)))
    (SpaceIndexPrefixV1 (str:concat $prefix "/any/"))))
(= (durable-index:one $index $key $atom)
  (let (StoreSpaceIndexV1 $arity $position $prefix) $index
    (case (durable-index:project $atom $arity $position)
      ((SpaceIndexSkipV1 SpaceIndexSkipV1)
       (SpaceIndexAnyV1 (SpaceIndexPostingV1 (str:concat (str:concat $prefix "/any/") $key)))
       ((SpaceIndexFieldV1 $field)
        (case (durable-index:bucket $prefix $field)
          (((SpaceIndexPrefixV1 $bucket) (SpaceIndexPostingV1 (str:concat $bucket $key)))
           ($error $error))))
       ($error $error)))))
(= (durable-index:postings $indexes $key $atom)
  (if (== $indexes ()) (SpaceIndexPostingsV1 ())
    (let ($index $rest) (decons-atom $indexes)
    (case (durable-index:one $index $key $atom)
      ((SpaceIndexSkipV1 (durable-index:postings $rest $key $atom))
       ((SpaceIndexPostingV1 $posting)
        (case (durable-index:postings $rest $key $atom)
          (((SpaceIndexPostingsV1 $tail) (SpaceIndexPostingsV1 (cons-atom $posting $tail)))
           ($error $error))))
       ($error $error))))))
(= (durable-index:old-postings $view $indexes $key)
  (case (store:get $view $key 1048576)
    (((StoreValue $body)
      (case (store:decode $body)
        (((StoreDecoded $atom) (durable-index:postings $indexes $key $atom))
         ($error $error))))
     ($error $error))))
(= (durable-index:new-postings $indexes $key $operation)
  (case $operation
    (((put $same $body)
      (case (store:decode $body)
        (((StoreDecoded $atom) (durable-index:postings $indexes $key $atom))
         ($error $error))))
     ((remove $same) (SpaceIndexPostingsV1 ()))
     ($other (SpaceRefusedV1 index-operation)))))
(= (durable-index:operations $view $indexes $key $delta $operation)
  (if (== $indexes ()) (SpaceIndexOperationsV1 ())
    (case (if (== $delta 1) (SpaceIndexPostingsV1 ()) (durable-index:old-postings $view $indexes $key))
      (((SpaceIndexPostingsV1 $old)
        (case (durable-index:new-postings $indexes $key $operation)
          (((SpaceIndexPostingsV1 $new)
            (let* (($remove (map-atom $old $posting (remove $posting)))
                   ($put (map-atom $new $posting (put $posting ""))))
              (SpaceIndexOperationsV1 (list:append $remove $put))))
           ($error $error))))
       ($error $error)))))
