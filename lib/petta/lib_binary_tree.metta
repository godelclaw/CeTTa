; Recursive records over the ordinary packed binary library. Payloads and tags
; stay U8 tensors. Encoding and decoding do not interpret tags or execute data.
!(import! &self (library binary))
!(import! &self (library tensor))

(= (binary-tree:bytes? $value)
   (let $size (binary:packed-length ($value))
     (binary:unsigned? $size)))

(= (binary-tree:pack $fields)
   (case (binary:pack-fields $fields)
     (((Binary:Fault $reason) (Binary:TreeFault $reason))
      ($bytes (Binary:TreeBytes $bytes)))))

; Exact encoding lengths, without allocating any encoded payload. These
; algebra operations also serve memoized traversal of a compact record DAG.
(= (binary-tree:leaf-length $payload)
   (if (binary-tree:bytes? $payload)
     (binary:packed-length (Binary:FieldLengths (0 (index-atom (tensor:shape $payload) 0))))
     (Binary:TreeFault InvalidPayload)))
(= (binary-tree:node-length $tag $lengths)
   (if (binary-tree:bytes? $tag)
     (let $packed (binary:packed-length (Binary:FieldLengths $lengths))
       (if (binary:unsigned? $packed)
         (binary:packed-length (Binary:FieldLengths (1 (index-atom (tensor:shape $tag) 0) $packed)))
         $packed))
     (Binary:TreeFault InvalidTag)))
(= (binary-tree:byte-length $tree)
   (case $tree
     (((Binary:Leaf $payload) (binary-tree:leaf-length $payload))
      ((Binary:Node $tag $children)
       (case (binary-tree:lengths $children)
         (((Binary:Lengths $lengths) (binary-tree:node-length $tag $lengths))
          ($other $other))))
      ($other (Binary:TreeFault InvalidTree)))))
(= (binary-tree:lengths $children)
   (if (== $children ()) (Binary:Lengths ())
     (if (== (get-metatype $children) Expression)
       (let ($head $tail) (decons-atom $children)
         (let $length (binary-tree:byte-length $head)
           (if (binary:unsigned? $length)
             (case (binary-tree:lengths $tail)
               (((Binary:Lengths $rest)
                 (let $lengths (cons-atom $length $rest) (Binary:Lengths $lengths)))
                ($other $other)))
             $length)))
       (Binary:TreeFault InvalidChildren))))

(= (binary-tree:encode $tree)
   (case $tree
     (((Binary:Leaf $payload)
       (if (binary-tree:bytes? $payload)
         (let $marker (binary:unsigned 0) (binary-tree:pack ($marker $payload)))
         (Binary:TreeFault InvalidPayload)))
      ((Binary:Node $tag $children)
       (if (binary-tree:bytes? $tag)
         (case (binary-tree:encode-list $children)
           (((Binary:TreeFields $fields)
             (case (binary-tree:pack $fields)
               (((Binary:TreeBytes $packed)
                 (let $marker (binary:unsigned 1) (binary-tree:pack ($marker $tag $packed))))
                ($other $other))))
            ($other $other)))
         (Binary:TreeFault InvalidTag)))
      ($other (Binary:TreeFault InvalidTree)))))

(= (binary-tree:encode-list $children)
   (if (== $children ()) (Binary:TreeFields ())
     (if (== (get-metatype $children) Expression)
       (let ($head $tail) (decons-atom $children)
         (case (binary-tree:encode $head)
           (((Binary:TreeBytes $bytes)
             (case (binary-tree:encode-list $tail)
               (((Binary:TreeFields $rest)
                 (let $fields (cons-atom $bytes $rest) (Binary:TreeFields $fields)))
                ($other $other))))
            ($other $other))))
       (Binary:TreeFault InvalidChildren))))

(= (binary-tree:decode $bytes)
   (if (binary-tree:bytes? $bytes)
     (case (tensor:shape $bytes)
       ((($length) (if (== $length 0) (Binary:TreeFault truncated)
                    (binary-tree:decode-with-budget (* 8 $length) $bytes)))))
     (Binary:TreeFault InvalidPayload)))

; The budget is derived from the input, not a language depth limit. Each
; enclosing record contributes bits beyond every child it contains.
(= (binary-tree:decode-with-budget $fuel $bytes)
   (if (== $fuel 0) (Binary:TreeFault DecodeBudget)
     (case (binary:unpack-fields $bytes)
       (((Binary:Fields $fields)
         (case $fields
           ((($marker $payload)
             (if (== $marker (binary:unsigned 0))
               (Binary:Tree (Binary:Leaf $payload)) (Binary:TreeFault InvalidMarker)))
            (($marker $tag $packed)
             (if (== $marker (binary:unsigned 1))
               (case (binary:unpack-fields $packed)
                 (((Binary:Fields $children)
                   (case (binary-tree:decode-list (- $fuel 1) $children)
                     (((Binary:TreeChildren $values) (Binary:Tree (Binary:Node $tag $values)))
                      ($other $other))))
                  ((Binary:Fault $reason) (Binary:TreeFault $reason))
                  ($other (Binary:TreeFault InvalidChildren))))
               (Binary:TreeFault InvalidMarker)))
            ($other (Binary:TreeFault InvalidRecord)))))
        ((Binary:Fault $reason) (Binary:TreeFault $reason))
        ($other (Binary:TreeFault InvalidRecord))))))

(= (binary-tree:decode-list $fuel $children)
   (if (== $children ()) (Binary:TreeChildren ())
     (let ($head $tail) (decons-atom $children)
       (case (binary-tree:decode-with-budget $fuel $head)
         (((Binary:Tree $value)
           (case (binary-tree:decode-list $fuel $tail)
             (((Binary:TreeChildren $rest)
               (let $values (cons-atom $value $rest) (Binary:TreeChildren $values)))
              ($other $other))))
          ($other $other))))))
