; Schema-directed records over binary trees. A row is
; (Binary:Form positive-integer constructor field-kinds).
; Kinds: Bytes, Text, Symbol, Natural, (Record constructor),
; (Vector kind), (Either constructors). Tag zero belongs to vectors.
!(import! &self (library lib_binary_tree))

(= (binary-schema:natural? $n)
   (binary:unsigned? $n))
(= (binary-schema:text? $value)
   (== (binary:from-utf8 (binary:utf8 $value)) $value))

(= (binary-schema:find-name $schema $name)
   (if (== $schema ()) Binary:None
     (let ($row $tail) (decons-atom $schema)
       (case $row
         (((Binary:Form $tag $constructor $fields)
           (if (== $constructor $name) (Binary:Some $row)
             (binary-schema:find-name $tail $name))))))))
(= (binary-schema:find-tag $schema $wanted)
   (if (== $schema ()) Binary:None
     (let ($row $tail) (decons-atom $schema)
       (case $row
         (((Binary:Form $tag $constructor $fields)
           (if (== $tag $wanted) (Binary:Some $row)
             (binary-schema:find-tag $tail $wanted))))))))
(= (binary-schema:member? $wanted $values)
   (if (== $values ()) False
     (let ($head $tail) (decons-atom $values)
       (or (== $wanted $head) (binary-schema:member? $wanted $tail)))))

; A schema is registered finite trusted data. Duplicate tags/names are refused.
(= (binary-schema:shape? $schema)
   (if (== $schema ()) True
     (if (== (get-metatype $schema) Expression)
       (let ($row $tail) (decons-atom $schema)
         (case $row
           (((Binary:Form $tag $constructor $fields)
             (if (binary-schema:shape? $tail)
              (and (binary-schema:natural? $tag)
               (and (> $tag 0)
                 (and (== (binary:value-kind $constructor) Symbol)
                   (and (== (get-metatype $fields) Expression)
                     (and (== (binary-schema:find-name $tail $constructor) Binary:None)
                       (== (binary-schema:find-tag $tail $tag) Binary:None))))))
              False))
            ($other False))))
       False)))

(= (binary-schema:kind? $schema $kind)
   (case $kind
     ((Bytes True) (Text True) (Symbol True) (Natural True)
      ((Vector $element) (binary-schema:kind? $schema $element))
      ((Record $name)
       (and (== (binary:value-kind $name) Symbol)
            (not (== (binary-schema:find-name $schema $name) Binary:None))))
      ((Either $names)
       (and (not (== $names ())) (binary-schema:constructors? $schema $names)))
      ($other False))))
(= (binary-schema:constructors? $schema $names)
   (if (== $names ()) True
     (if (== (get-metatype $names) Expression)
       (let ($name $tail) (decons-atom $names)
         (and (binary-schema:kind? $schema (Record $name))
              (binary-schema:constructors? $schema $tail))) False)))
(= (binary-schema:kinds? $schema $kinds)
   (if (== $kinds ()) True
     (let ($kind $tail) (decons-atom $kinds)
       (and (binary-schema:kind? $schema $kind) (binary-schema:kinds? $schema $tail)))))
(= (binary-schema:rows? $schema $rows)
   (if (== $rows ()) True
     (let ($row $tail) (decons-atom $rows)
       (case $row
         (((Binary:Form $tag $name $fields)
           (and (binary-schema:kinds? $schema $fields) (binary-schema:rows? $schema $tail))))))))
(= (binary-schema:valid? $schema)
   (if (binary-schema:shape? $schema) (binary-schema:rows? $schema $schema) False))

(= (binary-schema:to-tree $schema $kind $value)
   (case $kind
     ((Bytes (if (binary-tree:bytes? $value) (Binary:Tree (Binary:Leaf $value))
               (Binary:TreeFault InvalidBytes)))
      (Text (if (binary-schema:text? $value)
              (let $bytes (binary:utf8 $value) (Binary:Tree (Binary:Leaf $bytes)))
              (Binary:TreeFault InvalidText)))
      (Symbol (if (== (binary:value-kind $value) Symbol)
                (let $bytes (binary:symbol-utf8 $value) (Binary:Tree (Binary:Leaf $bytes)))
                (Binary:TreeFault InvalidSymbol)))
      (Natural (if (binary-schema:natural? $value)
                 (let $bytes (binary:unsigned $value) (Binary:Tree (Binary:Leaf $bytes)))
                 (Binary:TreeFault InvalidNatural)))
      ((Vector $element)
       (case (binary-schema:encode-vector $schema $element $value)
         (((Binary:TreeChildren $children)
           (let $tag (binary:unsigned 0) (Binary:Tree (Binary:Node $tag $children))))
          ($other $other))))
      ((Record $constructor) (binary-schema:encode-record $schema ($constructor) $value))
      ((Either $constructors) (binary-schema:encode-record $schema $constructors $value))
      ($other (Binary:TreeFault InvalidKind)))))

(= (binary-schema:encode-record $schema $constructors $value)
   (if (and (== (get-metatype $value) Expression) (not (== $value ())))
     (let ($constructor $values) (decons-atom $value)
       (if (binary-schema:member? $constructor $constructors)
         (case (binary-schema:find-name $schema $constructor)
           (((Binary:Some (Binary:Form $tag $name $fields))
             (case (binary-schema:encode-fields $schema $fields $values)
               (((Binary:TreeChildren $children)
                 (let $bytes (binary:unsigned $tag) (Binary:Tree (Binary:Node $bytes $children))))
                ($other $other))))
            ($other (Binary:TreeFault UnknownConstructor))))
         (Binary:TreeFault WrongConstructor)))
     (Binary:TreeFault InvalidRecord)))

(= (binary-schema:encode-vector $schema $kind $values)
   (if (== $values ()) (Binary:TreeChildren ())
     (if (== (get-metatype $values) Expression)
       (let ($head $tail) (decons-atom $values)
         (case (binary-schema:to-tree $schema $kind $head)
           (((Binary:Tree $tree)
             (case (binary-schema:encode-vector $schema $kind $tail)
               (((Binary:TreeChildren $rest)
                 (let $children (cons-atom $tree $rest) (Binary:TreeChildren $children)))
                ($other $other))))
            ($other $other))))
       (Binary:TreeFault InvalidVector))))

(= (binary-schema:encode-fields $schema $kinds $values)
   (if (== $kinds ())
     (if (== $values ()) (Binary:TreeChildren ()) (Binary:TreeFault WrongArity))
     (if (and (== (get-metatype $values) Expression) (not (== $values ())))
       (let* ((($kind $tail) (decons-atom $kinds)) (($value $rest) (decons-atom $values)))
         (case (binary-schema:to-tree $schema $kind $value)
           (((Binary:Tree $tree)
             (case (binary-schema:encode-fields $schema $tail $rest)
               (((Binary:TreeChildren $others)
                 (let $children (cons-atom $tree $others) (Binary:TreeChildren $children)))
                ($other $other))))
            ($other $other))))
       (Binary:TreeFault WrongArity))))

(= (binary-schema:from-tree $schema $kind $tree)
   (case ($kind $tree)
     (((Bytes (Binary:Leaf $bytes)) (Binary:Value $bytes))
      ((Text (Binary:Leaf $bytes))
       (let $value (binary:from-utf8 $bytes)
         (if (binary-schema:text? $value) (Binary:Value $value) (Binary:TreeFault InvalidText))))
      ((Symbol (Binary:Leaf $bytes))
       (let $value (binary:from-symbol-utf8 $bytes)
         (if (== (binary:value-kind $value) Symbol)
           (Binary:Value $value) (Binary:TreeFault InvalidSymbol))))
      ((Natural (Binary:Leaf $bytes))
       (let $value (binary:from-unsigned $bytes)
         (if (binary-schema:natural? $value) (Binary:Value $value) (Binary:TreeFault InvalidNatural))))
      (((Vector $element) (Binary:Node $tag $children))
       (if (== $tag (binary:unsigned 0)) (binary-schema:decode-vector $schema $element $children)
         (Binary:TreeFault WrongConstructor)))
      (((Record $constructor) (Binary:Node $tag $children))
       (binary-schema:decode-record $schema ($constructor) $tag $children))
      (((Either $constructors) (Binary:Node $tag $children))
       (binary-schema:decode-record $schema $constructors $tag $children))
      ($other (Binary:TreeFault WrongKind)))))

(= (binary-schema:decode-record $schema $constructors $tag $children)
   (case (binary-schema:find-tag $schema (binary:from-unsigned $tag))
     (((Binary:Some (Binary:Form $index $name $fields))
       (if (binary-schema:member? $name $constructors)
         (case (binary-schema:decode-fields $schema $fields $children)
           (((Binary:Value $values)
             (let $value (cons-atom $name $values) (Binary:Value $value)))
            ($other $other)))
         (Binary:TreeFault WrongConstructor)))
      ($other (Binary:TreeFault UnknownConstructor)))))

(= (binary-schema:decode-vector $schema $kind $children)
   (if (== $children ()) (Binary:Value ())
     (let ($head $tail) (decons-atom $children)
       (case (binary-schema:from-tree $schema $kind $head)
         (((Binary:Value $value)
           (case (binary-schema:decode-vector $schema $kind $tail)
             (((Binary:Value $rest)
               (let $values (cons-atom $value $rest) (Binary:Value $values)))
              ($other $other))))
          ($other $other))))))

(= (binary-schema:decode-fields $schema $kinds $children)
   (if (== $kinds ())
     (if (== $children ()) (Binary:Value ()) (Binary:TreeFault WrongArity))
     (if (== $children ()) (Binary:TreeFault WrongArity)
       (let* ((($kind $tail) (decons-atom $kinds)) (($child $rest) (decons-atom $children)))
         (case (binary-schema:from-tree $schema $kind $child)
           (((Binary:Value $value)
             (case (binary-schema:decode-fields $schema $tail $rest)
               (((Binary:Value $others)
                 (let $values (cons-atom $value $others) (Binary:Value $values)))
                ($other $other))))
            ($other $other)))))))

(= (binary-schema:encode $schema $kind $value)
   (if (binary-schema:valid? $schema)
     (case (binary-schema:to-tree $schema $kind $value)
       (((Binary:Tree $tree) (binary-tree:encode $tree)) ($other $other)))
     (Binary:TreeFault InvalidSchema)))
(= (binary-schema:decode $schema $kind $bytes)
   (if (binary-schema:valid? $schema)
     (case (binary-tree:decode $bytes)
       (((Binary:Tree $tree) (binary-schema:from-tree $schema $kind $tree)) ($other $other)))
     (Binary:TreeFault InvalidSchema)))
