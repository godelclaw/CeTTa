; Complete scoped-template archives over the common protocol-value codec.
; A raw source carries only its base signature, not an unused proposal grammar.
; Definitions carry their own ordinary context, parameter declarations and
; pattern forest. Calls carry checked partial captures and their source origin.
!(import! &self (library lib_scoped_templates))
!(import! &self (library lib_binary_value))
!(import! &self (library lib_ic_packed))
!(import! &self (library lib_ic_search))

(= (scoped-archive:definition? $sorts $operators $definition)
   (case $definition
     (((Scoped:Definition $name $ordinary $parameters $roots $patterns)
       (let $family (Scoped:Family $sorts $operators $parameters)
         (if (and (binary-schema:text? $name) (scoped:family? $family))
           (if (and (scoped:known? $sorts $ordinary) (scoped:known? $sorts $roots))
             (if (scoped:sequence? $patterns)
               (let* (($arguments (scoped:args $patterns)) ($slots (scoped:dependency-slots $roots)))
                 (and (scoped:data? $arguments)
                      (scoped:valid-args $family $ordinary Schema $slots $arguments))) False) False) False)))
      ($other False))))
(= (scoped-archive:definitions? $sorts $operators $definitions)
   (if (scoped:sequence? $definitions)
     (if (== $definitions ()) True
       (and (scoped-archive:definition? $sorts $operators (car-atom $definitions))
            (scoped-archive:definitions? $sorts $operators (cdr-atom $definitions)))) False))

(= (scoped-archive:restore-item $sorts $operators $definitions $item)
   (case $item
     (((Scoped:Raw $origin $roots $sources)
       (if (and (scoped:known? $sorts $roots) (scoped:sequence? $sources))
         (let* (($family (Scoped:Family $sorts $operators ()))
                ($arguments (scoped:args $sources)) ($slots (scoped:dependency-slots $roots)))
           (if (and (scoped:data? $arguments)
                    (scoped:valid-args $family () Base $slots $arguments))
             (IC:Some (Scoped:Packet $origin $roots $sources)) IC:None)) IC:None))
      ((Scoped:Call $origin $index $captures)
       (case (scoped:at $definitions $index)
         (((IC:Some (Scoped:Definition $name $ordinary $parameters $roots $patterns))
           (case (scoped:expand-many (Scoped:Family $sorts $operators $parameters)
                   $ordinary $roots $captures $patterns)
             (((IC:Some $sources) (IC:Some (Scoped:Packet $origin $roots $sources))) ($other IC:None))))
          ($other IC:None))))
      ($other IC:None))))
(= (scoped-archive:restore-items $sorts $operators $definitions $items)
   (if (scoped:sequence? $items)
     (if (== $items ()) (IC:Some ())
       (let ($item $tail) (decons-atom $items)
         (case ((scoped-archive:restore-item $sorts $operators $definitions $item)
                (scoped-archive:restore-items $sorts $operators $definitions $tail))
           ((((IC:Some $packet) (IC:Some $rest))
             (let $packets (cons-atom $packet $rest) (IC:Some $packets)))
            ($other IC:None))))) IC:None))

(= (scoped-archive:observe $archive)
   (case $archive
     (((Scoped:Archive "SC1" $sorts $operators $definitions $items)
       (if (and (scoped:family? (Scoped:Family $sorts $operators ()))
                (scoped-archive:definitions? $sorts $operators $definitions))
         (case (scoped-archive:restore-items $sorts $operators $definitions $items)
           (((IC:Some $packets) (IC:Some (Scoped:Observation $sorts $operators $packets))) ($other IC:None)))
         IC:None))
      ($other IC:None))))
(= (ic:scoped-pack $archive)
   (case (scoped-archive:observe $archive)
     (((IC:Some $observation) (binary-value:pack $archive))
      ($other (IC:ScopedFault InvalidArchive)))))
(= (ic:scoped-unpack $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value $archive)
       (case (scoped-archive:observe $archive)
         (((IC:Some $observation) (IC:Some $archive)) ($other IC:None))))
      ($other IC:None))))
(= (ic:scoped-restore $bytes)
   (case (ic:scoped-unpack $bytes)
     (((IC:Some $archive) (scoped-archive:observe $archive)) ($other IC:None))))
(= (ic-packed:observe IC:ScopedArchive $bytes) (ic:scoped-restore $bytes))
(= (ic-packed:accepts? IC:ScopedArchive $original $candidate) (== $original $candidate))
(= (ic:scoped-check $original $current $candidate)
   (case (ic-packed:check IC:ScopedArchive $original $current $candidate)
     (((IC:PackedAccepted $next $before $after) (IC:ScopedAccepted $next $before $after))
      ((IC:PackedRejected $reason) (IC:ScopedRejected $reason)))))

; Raw preparation preserves source locations, root order and every repeated
; occurrence. Parameter proposals are not hidden prerequisites for decoding it.
(= (scoped-archive:raw-items $packets)
   (if (scoped:sequence? $packets)
     (if (== $packets ()) (IC:Some ())
       (let ($packet $tail) (decons-atom $packets)
         (case ($packet (scoped-archive:raw-items $tail))
           ((((Scoped:Packet $origin $roots $sources) (IC:Some $rest))
             (let $items (cons-atom (Scoped:Raw $origin $roots $sources) $rest) (IC:Some $items)))
            ($other IC:None))))) IC:None))
(= (ic:prepare-scoped $family $packets)
   (if (scoped:family? $family)
     (case ($family (scoped-archive:raw-items $packets))
       ((((Scoped:Family $sorts $operators $parameters) (IC:Some $items))
         (case (ic:scoped-pack (Scoped:Archive "SC1" $sorts $operators () $items))
           (((Binary:TreeBytes $bytes) (IC:ScopedTask $bytes)) ($other $other))))
        ($other (IC:ScopedFault InvalidSources))))
     (IC:ScopedFault InvalidFamily)))

; Packet roots are disjoint occurrence sites. Each successful forest match
; shares one capture environment across all its rule components.
(= (scoped-archive:replace-one $sorts $operators $definitions $index $definition $item)
   (case $definition
     (((Scoped:Definition $name $ordinary $parameters $roots $patterns)
       (case (scoped-archive:restore-item $sorts $operators $definitions $item)
         (((IC:Some (Scoped:Packet $origin $actual $sources))
           (if (== $roots $actual)
             (case (scoped:match-many (Scoped:Family $sorts $operators $parameters)
                     $ordinary $roots $patterns $sources)
               (((IC:Some $captures) (IC:Replacement (Scoped:Call $origin $index $captures) 1))
                ($other (IC:Replacement $item 0))))
             (IC:Replacement $item 0)))
          ($other IC:None))))
      ($other IC:None))))
(= (scoped-archive:replace $sorts $operators $definitions $index $definition $items)
   (if (== $items ()) (IC:Rewritten () 0)
     (let ($item $tail) (decons-atom $items)
       (case (scoped-archive:replace-one $sorts $operators $definitions $index $definition $item)
         (((IC:Replacement $next $count)
           (case (scoped-archive:replace $sorts $operators $definitions $index $definition $tail)
             (((IC:Rewritten $rest $later)
               (let $rewritten (cons-atom $next $rest) (IC:Rewritten $rewritten (+ $count $later))))
              ($other IC:None))))
          ($other IC:None))))))
(= (ic:scoped-factor $archive $name $ordinary $parameters $roots $patterns)
   (case (scoped-archive:observe $archive)
     (((IC:Some $observation)
       (case $archive
         (((Scoped:Archive $version $sorts $operators $definitions $items)
           (let $definition (Scoped:Definition $name $ordinary $parameters $roots $patterns)
             (if (scoped-archive:definition? $sorts $operators $definition)
               (case (scoped-archive:replace $sorts $operators $definitions (size-atom $definitions) $definition $items)
                 (((IC:Rewritten $residual $support)
                    (let $library (union-atom $definitions (cons-atom $definition ()))
                     (IC:ScopedProposal (Scoped:Archive $version $sorts $operators $library $residual) $support)))
                  ($other IC:None))) IC:None))))))
      ($other IC:None))))

(= (ic-search:observation IC:ScopedArchive $artifact) (ic:scoped-restore $artifact))
(= (ic-search:consider IC:ScopedArchive $original $best $candidate)
   (case (ic:scoped-check $original $best $candidate)
     (((IC:ScopedAccepted $next $before $after) (IC:CandidateAccepted $next))
      ((IC:ScopedRejected $reason) (IC:CandidateRejected $reason)))))
(= (ic-search:materialize IC:ScopedArchive $original $proposal)
   (case $proposal
     (((Scoped:Factor $base $name $ordinary $parameters $roots $patterns)
       (case (ic:scoped-factor $base $name $ordinary $parameters $roots $patterns)
         (((IC:ScopedProposal $candidate $support)
           (if (>= $support 2)
             (case (ic:scoped-pack $candidate)
               (((Binary:TreeBytes $bytes) (IC:Candidate $bytes))
                ($other (IC:ProducerFault InvalidScopedEncoding))))
             (IC:Refused InsufficientSupport)))
          ($other (IC:ProducerFault InvalidScopedTemplate)))))
      ($other (IC:ProducerFault InvalidProposal)))))

(= (scoped-archive:produce $proposals)
   (if (== $proposals ()) (superpose ()) (IC:Proposal (car-atom $proposals))))
(= (scoped-archive:produce $proposals)
   (if (== $proposals ()) (superpose ()) (scoped-archive:produce (cdr-atom $proposals))))
(= (ic:learn-scoped $original (IC:Candidates $proposals) $quantum)
   (if (scoped:sequence? $proposals)
     (case ((ic:scoped-restore $original) (binary-value:pack $proposals))
       ((((IC:Some $source) (Binary:TreeBytes $protocol))
         (let* (($environment (context-space)) ($handle (work-new (scoped-archive:produce $proposals))))
           (case (ic:prepare IC:ScopedArchive $original ($environment) $quantum ((IC:Branch 1 $handle)))
             (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
              ($other (let $released (work-cancel $handle) $other))))))
        ($other (IC:SearchRefused InvalidScopedTask))))
     (IC:SearchRefused InvalidProposals)))
