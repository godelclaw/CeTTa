; Collection policy over a disposable, revision-bound record view.
; Durable mutations are returned as conditional service batch operations.
; A record is (Memory id revision profile vector document metadata).
; Metadata is an expression of (string-key value) entries.
!(import! &self (library lib_retrieval))
!(import! &self (library list))
!(bind! &memory-records (new-space))
!(bind! &memory-index (new-state Missing))
!(bind! &memory-profile (new-state Missing))

(= (memory:member $x $xs)
   (> (size-atom (collapse (case (superpose $xs) (($x True) ($_ (empty)))))) 0))
(= (memory:field $metadata $key)
   (collapse (case (superpose $metadata) ((($key $value) $value) ($_ (empty))))))
(= (memory:filter $metadata All) True)
(= (memory:filter $metadata (Eq $key $value)) (memory:member $value (memory:field $metadata $key)))
(= (memory:filter $metadata (And $filters))
   (== (collapse (if (memory:filter $metadata (superpose $filters)) (empty) False)) ()))
(= (memory:filter $metadata (Or $filters))
   (> (size-atom (collapse (if (memory:filter $metadata (superpose $filters)) True (empty)))) 0))

(= (memory:record $id)
   (match &memory-records (Memory $id $rev $profile $vector $doc $meta)
     (Memory $id $rev $profile $vector $doc $meta)))
(= (memory:matches $filter)
   (match &memory-records (Memory $id $rev $profile $vector $doc $meta)
     (if (memory:filter $meta $filter)
       (Memory $id $rev $profile $vector $doc $meta) (empty))))
(= (memory:brief (Memory $id $rev $profile $vector $doc $meta))
   (MemoryInfo $id $rev $doc $meta))
(= (memory:score $profile $query (Memory $id $rev $rp $vector $doc $meta))
   (if (== $profile $rp)
     (case (tensor:cosine $query $vector)
       (((TensorFailure $reason) (RetrievalFailure $id $reason))
        ($score (if (or (isnan-math $score) (isinf-math $score))
          (RetrievalFailure $id nonfinite-score)
          ($score (MemoryInfo $id $rev $doc $meta))))))
     (RetrievalFailure $id profile-mismatch)))
(= (memory:precedes ($a $av) ($b $bv)) (> $a $b))
(= (memory:query-scored $profile $query $k $filter)
   (case (retrieval:validate (collapse
           (memory:score $profile $query (memory:matches $filter))))
     (((RetrievalFailure $id $reason) (MemoryFailure $id $reason))
      ($scores (list:sort-by memory:precedes (retain-top-k-keyed-atom $scores $k))))))
(= (memory:query $profile $query $k $filter)
   (case (tensor:norm $query)
     (((TensorFailure $reason) (MemoryFailure query $reason))
      ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
        (MemoryFailure query invalid-norm)
        (memory:query-scored $profile $query $k $filter))))))

; The packed index is derived from one immutable worker view. The source store
; and model profile are checked by the adapter before this worker is used.
(= (memory:vector (Memory $id $rev $p $v $doc $meta)) $v)
(= (memory:build-index $width)
   (let $records (collapse (memory:matches All))
     (let $matrix (tensor:stack f64 $width (collapse (memory:vector (superpose $records))))
       (case $matrix
         (((TensorFailure $why) (MemoryFailure index $why))
          ($packed (case (tensor:row-norms $packed)
            (((TensorFailure $why) (MemoryFailure index $why))
             ($norms (let $briefs (collapse (memory:brief (superpose $records)))
               (let $saved (change-state! &memory-index (Packed $briefs $packed $norms))
                 (get-state &memory-index))))))))))))
(= (memory:packed-hit $filter $score (MemoryInfo $id $rev $doc $meta))
   (if (memory:filter $meta $filter) ($score (MemoryInfo $id $rev $doc $meta)) (empty)))
(= (memory:query-packed $query $k $filter (Packed $rows $matrix $norms))
   (case (tensor:cosine-rows $matrix $norms $query)
     (((TensorFailure $why) (MemoryFailure query $why))
      ($tensor (let $scores (tensor:to-expr $tensor)
        (let $indices (range-atom (size-atom $rows))
         (let $candidates (collapse
          (let $i (superpose $indices)
            (let $score (index-atom $scores $i)
              (let $row (index-atom $rows $i)
                (memory:packed-hit $filter $score $row)))))
          (list:sort-by memory:precedes (retain-top-k-keyed-atom $candidates $k)))))))))
(= (memory:query-indexed $query $k $filter)
   (let $index (case (get-state &memory-index)
         ((Missing (memory:build-index (car-atom (tensor:shape $query)))) ($ready $ready)))
     (case $index
       (((MemoryFailure $id $why) (MemoryFailure $id $why))
        ($packed (memory:query-packed $query $k $filter $packed))))))
(= (memory:validate $profile $dimensions (Memory $id $rev $rp $v $doc $meta))
   (if (and (== $profile $rp) (== (tensor:dtype $v) f64))
     (if (== (tensor:shape $v) ($dimensions))
       (case (tensor:norm $v)
         (((TensorFailure $why) (MemoryFailure $id $why))
          ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
            (MemoryFailure $id invalid-norm) Valid))))
       (MemoryFailure $id dimensions))
     (MemoryFailure $id profile-or-dtype)))

(= (memory:patch $old $patch)
   (let $keys (collapse (case (superpose $patch) ((($key $value) $key))))
     (collapse (superpose
       ((case (superpose $old)
          ((($key $value) (if (memory:member $key $keys) (empty) ($key $value)))))
        (case (superpose $patch)
          ((($key MemoryDeleteField) (empty)) ($entry $entry))))))))
(= (memory:update $revision $patch (Memory $id $oldrev $p $v $doc $meta))
   (let $newmeta (memory:patch $meta $patch)
     ((remove (Memory $id $oldrev $p $v $doc $meta))
      (add (Memory $id $revision $p $v $doc $newmeta)))))
(= (memory:apply (add $row)) (add-atom &memory-records $row))
(= (memory:apply (remove $row)) (remove-atom &memory-records $row))
(= (memory:load-error $profile $dimensions $row)
   (case (memory:validate $profile $dimensions $row)
     ((Valid (empty)) ($failure $failure))))

(= (memory:dispatch $request)
   (case $request
     (((load $profile $dimensions $rows)
       (let $errors (collapse (memory:load-error $profile $dimensions (superpose $rows)))
         (if (== $errors ())
           (if (or (== (get-state &memory-profile) Missing)
                   (== (get-state &memory-profile) (Profile $profile $dimensions)))
             (let $configured (change-state! &memory-profile (Profile $profile $dimensions))
               (let $reset (change-state! &memory-index Missing)
                 (let $done (collapse (let $row (superpose $rows) (add-atom &memory-records $row)))
                   (Loaded (size-atom $done)))))
             (MemoryFailure load profile-mismatch))
           (car-atom $errors))))
      ((get $ids) (collapse (memory:brief (memory:record (superpose $ids)))))
      ((records $ids) (collapse (memory:record (superpose $ids))))
      ((ids $filter) (collapse (case (memory:matches $filter)
         (((Memory $id $rev $p $v $doc $meta) $id)))))
      ((query $profile $query $k $filter)
       (case (get-state &memory-profile)
         (((Profile $profile $dimensions)
           (if (== (tensor:shape $query) ($dimensions))
             (memory:query-indexed $query $k $filter)
             (MemoryFailure query dimensions)))
          ($_ (MemoryFailure query profile-mismatch)))))
      ((query-reference $profile $query $k $filter) (memory:query $profile $query $k $filter))
      ((upsert $profile $dimensions $row)
       (case (memory:validate $profile $dimensions $row)
         ((Valid (case $row
           (((Memory $id $rev $p $v $doc $meta)
             (cons-atom (add $row) (collapse (remove (memory:record $id))))))))
          ($failure $failure))))
      ((insert $profile $dimensions $row)
       (case $row
         (((Memory $id $rev $p $v $doc $meta)
           (if (== (collapse (memory:record $id)) ())
             (memory:dispatch (upsert $profile $dimensions $row))
             (MemoryFailure $id exists))))))
      ((delete $ids) (collapse (remove (memory:record (superpose $ids)))))
      ((apply $operations)
       (let $reset (change-state! &memory-index Missing)
         (let $done (collapse (memory:apply (superpose $operations)))
           (Applied (size-atom $done)))))
      ((patch $revision $id $metadata)
       (case (collapse (memory:record $id))
         ((() (MemoryFailure $id missing))
          (($row) (memory:update $revision $metadata $row))
          ($_ (MemoryFailure $id duplicate-id)))))
      ($unknown (MemoryFailure request unsupported)))))
