; Collection policy over a disposable, revision-bound record view.
; Durable mutations are returned as conditional service batch operations.
; A record is (Memory id revision profile vector document metadata).
; Metadata is an expression of (string-key value) entries.
!(import! &self (library lib_retrieval))
!(import! &self (library list))
!(import! &self (library lib_row_index))
!(bind! &memory-records (new-space))
!(bind! &memory-index (new-state Missing))
!(bind! &memory-profile (new-state Missing))
!(bind! &memory-view (new-state 0))
!(bind! &memory-dirty (new-space))
!(bind! &memory-delta-index (new-state Missing))
!(bind! &memory-scan-tier (new-state wide))

(= (memory:invalidate)
   (let $next (+ (get-state &memory-view) 1)
     (let $saved (change-state! &memory-view $next)
       (let $delta (change-state! &memory-delta-index Missing)
         (change-state! &memory-index Missing)))))

(= (memory:member $x $xs)
   (> (size-atom (collapse (case (superpose $xs) (($x True) ($_ (empty)))))) 0))
(= (memory:field $metadata $key)
   (collapse (case (superpose $metadata) ((($key $value) $value) ($_ (empty))))))
(= (memory:filter $metadata All) True)
(= (memory:filter $metadata (Eq $key $value)) (memory:member $value (memory:field $metadata $key)))
(= (memory:filter $metadata (And $filters))
   (== (collapse (if (memory:filter $metadata (superpose $filters)) (empty) False)) ()))
(= (memory:filter $metadata (Or $filters))
   (> (size-atom (collapse (if (memory:filter $metadata (superpose $filters)) True (empty)))) 0))

(= (memory:record $id)
   (match &memory-records (Memory $id $rev $profile $vector $doc $meta)
     (Memory $id $rev $profile $vector $doc $meta)))
(= (memory:matches $filter)
   (match &memory-records (Memory $id $rev $profile $vector $doc $meta)
     (if (memory:filter $meta $filter)
       (Memory $id $rev $profile $vector $doc $meta) (empty))))
(= (memory:brief (Memory $id $rev $profile $vector $doc $meta))
   (MemoryInfo $id $rev $doc $meta))
(= (memory:score $profile $query (Memory $id $rev $rp $vector $doc $meta))
   (if (== $profile $rp)
     (case (tensor:cosine $query $vector)
       (((TensorFailure $reason) (RetrievalFailure $id $reason))
        ($score (if (or (isnan-math $score) (isinf-math $score))
          (RetrievalFailure $id nonfinite-score)
          ($score (MemoryInfo $id $rev $doc $meta))))))
     (RetrievalFailure $id profile-mismatch)))
(= (memory:precedes ($a $av) ($b $bv)) (> $a $b))
(= (memory:query-scored $profile $query $k $filter)
   (case (retrieval:validate (collapse
           (memory:score $profile $query (memory:matches $filter))))
     (((RetrievalFailure $id $reason) (MemoryFailure $id $reason))
      ($scores (list:sort-by memory:precedes (retain-top-k-keyed-atom $scores $k))))))
(= (memory:query $profile $query $k $filter)
   (case (tensor:norm $query)
     (((TensorFailure $reason) (MemoryFailure query $reason))
      ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
        (MemoryFailure query invalid-norm)
        (memory:query-scored $profile $query $k $filter))))))

; The packed index is derived from one immutable worker view. The source store
; and model profile are checked by the adapter before this worker is used.
(= (memory:vector (Memory $id $rev $p $v $doc $meta)) $v)
(= (memory:field-index $index $i (MemoryInfo $id $rev $doc $meta))
   (case (superpose $meta)
     ((($key $value) (index:insert $index $i $key $value)))))
(= (memory:build-packed $width $records)
   (let $matrix (tensor:stack f64 $width (collapse (memory:vector (superpose $records))))
     (case $matrix
       (((TensorFailure $why) (MemoryFailure index $why))
        ($packed (case (tensor:normalize-rows $packed)
          (((TensorFailure $why) (MemoryFailure index $why))
           ($unit (let* (($briefs (collapse (memory:brief (superpose $records))))
                         ($rows (new-space)) ($count (size-atom $briefs))
                         ($stamp (get-state &memory-view))
                         ($projection (index:new $stamp $count 128))
                         ($positions (range-atom $count))
                         ($built (collapse (let $i (superpose $positions)
                           (let $row (index-atom $briefs $i)
                             (let $saved-row (add-atom $rows (Row $i $row))
                               (memory:field-index $projection $i $row)))))))
             (let $screen (if (== (get-state &memory-scan-tier) f32)
                    (case (tensor:cast f32 $unit)
                      (((TensorFailure $why) (MemoryFailure index $why))
                       ($compact (case (tensor:row-error-bounds $unit $compact)
                         (((TensorFailure $why) (MemoryFailure index $why))
                          ($certificate (Screen $compact $certificate))))))) Missing)
               (case $screen
                 (((MemoryFailure $id $why) (MemoryFailure $id $why))
                  ($ready (Packed $stamp $rows $count $unit $projection (tensor:full u8 ($count) 1) $ready))))))))))))))
(= (memory:clear-dirty)
   (collapse (let $row (match &memory-dirty $entry $entry) (remove-atom &memory-dirty $row))))
(= (memory:build-index $width)
   (case (memory:build-packed $width (collapse (memory:matches All)))
     (((MemoryFailure $id $why) (MemoryFailure $id $why))
      ($packed (let* (($cleared (memory:clear-dirty))
                      ($delta (change-state! &memory-delta-index Missing))
                      ($saved (change-state! &memory-index $packed))) $packed)))))
; Writes retire base rows before selection. Latest versions of changed IDs are
; scored in a bounded delta matrix; deleted IDs yield no delta row.
(= (memory:operation-id (add (Memory $id $rev $p $v $doc $meta))) $id)
(= (memory:operation-id (remove (Memory $id $rev $p $v $doc $meta))) $id)
(= (memory:mark-dirty $id)
   (if (== (collapse (match &memory-dirty (Dirty $id) True)) ())
     (add-atom &memory-dirty (Dirty $id)) ()))
(= (memory:touch-index $operations)
   (let* (($next (+ (get-state &memory-view) 1))
          ($version (change-state! &memory-view $next))
          ($delta (change-state! &memory-delta-index Missing)))
     (case (get-state &memory-index)
       ((Missing ())
        ((Packed $stamp $rows $count $matrix $projection $live $screen)
         (let* (($ids (collapse (memory:operation-id (superpose $operations))))
                ($marked (collapse (memory:mark-dirty (superpose $ids))))
                ($retired (tensor:indices (collapse (let $id (superpose $ids)
                  (match $rows (Row $i (MemoryInfo $id $rev $doc $meta)) $i)))))
                ($updated (tensor:mask-and $live (tensor:mask-not (tensor:mask-indices $count $retired)))))
           (case $updated
             (((TensorFailure $why) (change-state! &memory-index Missing))
              ($mask (if (>= (size-atom (collapse (get-atoms &memory-dirty))) 128)
                (change-state! &memory-index Missing)
                (change-state! &memory-index (Packed $stamp $rows $count $matrix $projection $mask $screen))))))))))))
(= (memory:build-delta $width)
   (let $records (collapse (let $id (match &memory-dirty (Dirty $id) $id) (memory:record $id)))
     (let $packed (memory:build-packed $width $records)
       (let $saved (change-state! &memory-delta-index $packed) $packed))))

; An equality posting is a derived selector over one immutable worker view.
; Matching the indexed key/value happens once; Boolean composition uses masks.
(= (memory:selected-hits $rows $indices $scores)
   (let* (($selected (tensor:to-expr $indices)) ($values (tensor:to-expr $scores))
          ($positions (range-atom (size-atom $selected))))
     (collapse (let $i (superpose $positions)
       (let* (($score (index-atom $values $i))
              ($row-id (index-atom $selected $i))
              ($row (match $rows (Row $row-id $brief) $brief)))
         ($score $row))))))
(= (memory:query-selected $rows $matrix $query $k $indices)
   (case (tensor:cosine-unit-rows $matrix $query $indices)
     (((TensorFailure $why) (MemoryFailure query $why))
      ($scores (case (tensor:top-k $scores $k)
        (((TensorFailure $why) (MemoryFailure query $why))
         ($top (memory:selected-hits $rows (tensor:gather $indices $top) (tensor:gather $scores $top)))))))))
(= (memory:query-screened $rows $matrix $compact $certificate $query $k $indices)
   (case (tensor:norm $query)
     (((TensorFailure $why) (MemoryFailure query $why))
      ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
        (MemoryFailure query invalid-value)
        (let $unit-query (tensor:scale $query (/ 1.0 $norm))
          (case (tensor:screen-candidates $compact $certificate $unit-query $indices $k)
            (((TensorFailure $why) (MemoryFailure query $why))
             ($candidates (let $selected (tensor:gather $indices $candidates)
               (case (tensor:matvec-selected $matrix $unit-query $selected)
                 (((TensorFailure $why) (MemoryFailure query $why))
                  ($scores (case (tensor:top-k $scores $k)
                    (((TensorFailure $why) (MemoryFailure query $why))
                     ($top (memory:selected-hits $rows (tensor:gather $selected $top)
                       (tensor:gather $scores $top))))))))))))))))))
(= (memory:query-tier $rows $matrix Missing $query $k $indices)
   (memory:query-selected $rows $matrix $query $k $indices))
(= (memory:query-tier $rows $matrix (Screen $compact $certificate) $query $k $indices)
   (memory:query-screened $rows $matrix $compact $certificate $query $k $indices))
(= (memory:query-packed $query $k $filter (Packed $stamp $rows $count $matrix $projection $live $screen))
   (case (tensor:mask-and $live (index:mask $stamp $projection $filter))
     (((IndexFailure $why) (MemoryFailure filter $why))
      ((TensorFailure $why) (MemoryFailure filter $why))
      ($mask (case (tensor:nonzero $mask)
        (((TensorFailure $why) (MemoryFailure filter $why))
         ($indices (memory:query-tier $rows $matrix $screen $query $k $indices))))))))
(= (memory:query-indexed $query $k $filter)
   (let $index (case (get-state &memory-index)
         ((Missing (memory:build-index (car-atom (tensor:shape $query)))) ($base-ready $base-ready)))
     (case $index
       (((MemoryFailure $id $why) (MemoryFailure $id $why))
        ($packed (let $base (memory:query-packed $query $k $filter $packed)
          (case $base
            (((MemoryFailure $id $why) (MemoryFailure $id $why))
             ($hits (if (== (collapse (get-atoms &memory-dirty)) ()) $hits
               (let $delta (case (get-state &memory-delta-index)
                     ((Missing (memory:build-delta (car-atom (tensor:shape $query)))) ($delta-ready $delta-ready)))
                 (case $delta
                   (((MemoryFailure $id $why) (MemoryFailure $id $why))
                    ($tail (case (memory:query-packed $query $k $filter $tail)
                      (((MemoryFailure $id $why) (MemoryFailure $id $why))
                       ($recent (let $both (list:append $hits $recent)
                         (list:sort-by memory:precedes (retain-top-k-keyed-atom $both $k))))))))))))))))))))
(= (memory:validate $profile $dimensions (Memory $id $rev $rp $v $doc $meta))
   (if (and (== $profile $rp) (== (tensor:dtype $v) f64))
     (if (== (tensor:shape $v) ($dimensions))
       (case (tensor:norm $v)
         (((TensorFailure $why) (MemoryFailure $id $why))
          ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
            (MemoryFailure $id invalid-norm) Valid))))
       (MemoryFailure $id dimensions))
     (MemoryFailure $id profile-or-dtype)))

(= (memory:patch $old $patch)
   (let $keys (collapse (case (superpose $patch) ((($key $value) $key))))
     (collapse (superpose
       ((case (superpose $old)
          ((($key $value) (if (memory:member $key $keys) (empty) ($key $value)))))
        (case (superpose $patch)
          ((($key MemoryDeleteField) (empty)) ($entry $entry))))))))
(= (memory:update $revision $patch (Memory $id $oldrev $p $v $doc $meta))
   (let $newmeta (memory:patch $meta $patch)
     ((remove (Memory $id $oldrev $p $v $doc $meta))
      (add (Memory $id $revision $p $v $doc $newmeta)))))
(= (memory:apply (add $row)) (add-atom &memory-records $row))
(= (memory:apply (remove $row)) (remove-atom &memory-records $row))
(= (memory:load-error $profile $dimensions $row)
   (case (memory:validate $profile $dimensions $row)
     ((Valid (empty)) ($failure $failure))))
(= (memory:index-status)
   (let* (($view (get-state &memory-view))
          ($base (case (get-state &memory-index)
            ((Missing Missing)
             ((Packed $stamp $rows $count $matrix $projection $live $screen) (Base $stamp $count)))))
          ($dirty (size-atom (collapse (get-atoms &memory-dirty))))
          ($delta (case (get-state &memory-delta-index)
            ((Missing Missing)
             ((Packed $ds $dr $dn $dm $dp $dl $dc) (Delta $ds $dn))))))
     (IndexStatus $view $base $dirty $delta)))

(= (memory:dispatch $request)
   (case $request
     (((execution-profile) (let $provider (tensor:matvec-provider) (TensorExecution $provider f64 lane4)))
      ((scan-tier $tier)
       (if (or (== $tier wide) (== $tier f32))
         (let* (($changed (change-state! &memory-scan-tier $tier)) ($reset (memory:invalidate)))
           (ScanTier $tier))
         (MemoryFailure scan-tier unsupported)))
      ((index-status) (memory:index-status))
      ((load $profile $dimensions $rows)
       (let $errors (collapse (memory:load-error $profile $dimensions (superpose $rows)))
         (if (== $errors ())
           (if (or (== (get-state &memory-profile) Missing)
                   (== (get-state &memory-profile) (Profile $profile $dimensions)))
             (let $configured (change-state! &memory-profile (Profile $profile $dimensions))
               (let $reset (memory:invalidate)
                 (let $done (collapse (let $row (superpose $rows) (add-atom &memory-records $row)))
                   (Loaded (size-atom $done)))))
             (MemoryFailure load profile-mismatch))
           (car-atom $errors))))
      ((get $ids) (collapse (memory:brief (memory:record (superpose $ids)))))
      ((records $ids) (collapse (memory:record (superpose $ids))))
      ((ids $filter) (collapse (case (memory:matches $filter)
         (((Memory $id $rev $p $v $doc $meta) $id)))))
      ((query $profile $query $k $filter)
       (case (get-state &memory-profile)
         (((Profile $profile $dimensions)
           (if (== (tensor:shape $query) ($dimensions))
             (memory:query-indexed $query $k $filter)
             (MemoryFailure query dimensions)))
          ($_ (MemoryFailure query profile-mismatch)))))
      ((query-reference $profile $query $k $filter) (memory:query $profile $query $k $filter))
      ((query-many $profile $queries $k $filter)
       (let $positions (range-atom (size-atom $queries))
         (collapse (let $i (superpose $positions)
           (let* (($query (index-atom $queries $i))
                  ($found (memory:dispatch (query $profile $query $k $filter))))
             ($i $found))))))
      ((upsert $profile $dimensions $row)
       (case (memory:validate $profile $dimensions $row)
         ((Valid (case $row
           (((Memory $id $rev $p $v $doc $meta)
             (cons-atom (add $row) (collapse (remove (memory:record $id))))))))
          ($failure $failure))))
      ((insert $profile $dimensions $row)
       (case $row
         (((Memory $id $rev $p $v $doc $meta)
           (if (== (collapse (memory:record $id)) ())
             (memory:dispatch (upsert $profile $dimensions $row))
             (MemoryFailure $id exists))))))
      ((delete $ids) (collapse (remove (memory:record (superpose $ids)))))
      ((apply $operations)
       (let $done (collapse (memory:apply (superpose $operations)))
         (let $updated (memory:touch-index $operations)
           (Applied (size-atom $done)))))
      ((patch $revision $id $metadata)
       (case (collapse (memory:record $id))
         ((() (MemoryFailure $id missing))
          (($row) (memory:update $revision $metadata $row))
          ($_ (MemoryFailure $id duplicate-id)))))
      ($unknown (MemoryFailure request unsupported)))))
