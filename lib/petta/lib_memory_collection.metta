; Collection policy over a disposable, revision-bound record view.
; Durable mutations are returned as conditional service batch operations.
; A record is (Memory id revision profile vector document metadata).
; Metadata is an expression of (string-key value) entries.
!(import! &self (library lib_retrieval))
!(import! &self (library list))
!(import! &self (library lib_row_index))
!(import! &self (library str))
!(bind! &memory-records (new-space))
!(bind! &memory-index (new-state Missing))
!(bind! &memory-profile (new-state Missing))
!(bind! &memory-view (new-state 0))
!(bind! &memory-dirty (new-space))
!(bind! &memory-delta-index (new-state Missing))
!(bind! &memory-scan-tier (new-state wide))
!(bind! &memory-all-rows (new-state Missing))
; A collection loaded from a matrix: (MatrixSource table unit), where the
; table holds its rows' IDs, documents, revisions and metadata as columns.
!(bind! &memory-matrix (new-state Missing))

(= (memory:invalidate)
   (let $next (+ (get-state &memory-view) 1)
     (let $saved (change-state! &memory-view $next)
       (let $delta (change-state! &memory-delta-index Missing)
         (let $rows (change-state! &memory-all-rows Missing)
           (change-state! &memory-index Missing))))))

(= (memory:member $x $xs)
   (> (size-atom (collapse (case (superpose $xs) (($x True) ($_ (empty)))))) 0))
(= (memory:field $metadata $key)
   (collapse (case (superpose $metadata) ((($key $value) $value) ($_ (empty))))))
(= (memory:filter $metadata All) True)
(= (memory:filter $metadata (Eq $key $value)) (memory:member $value (memory:field $metadata $key)))
(= (memory:filter $metadata (And $filters))
   (== (collapse (if (memory:filter $metadata (superpose $filters)) (empty) False)) ()))
(= (memory:filter $metadata (Or $filters))
   (> (size-atom (collapse (if (memory:filter $metadata (superpose $filters)) True (empty)))) 0))

(= (memory:record $id)
   (match &memory-records (Memory $id $rev $profile $vector $doc $meta)
     (Memory $id $rev $profile $vector $doc $meta)))
(= (memory:matches $filter)
   (match &memory-records (Memory $id $rev $profile $vector $doc $meta)
     (if (memory:filter $meta $filter)
       (Memory $id $rev $profile $vector $doc $meta) (empty))))
(= (memory:brief (Memory $id $rev $profile $vector $doc $meta))
   (MemoryInfo $id $rev $doc $meta))
(= (memory:score $profile $query (Memory $id $rev $rp $vector $doc $meta))
   (if (== $profile $rp)
     (case (tensor:cosine $query $vector)
       (((TensorFailure $reason) (RetrievalFailure $id $reason))
        ($score (if (or (isnan-math $score) (isinf-math $score))
          (RetrievalFailure $id nonfinite-score)
          ($score (MemoryInfo $id $rev $doc $meta))))))
     (RetrievalFailure $id profile-mismatch)))
(= (memory:precedes ($a $av) ($b $bv)) (> $a $b))
(= (memory:query-scored $profile $query $k $filter)
   (case (retrieval:validate (collapse
           (memory:score $profile $query (memory:matches $filter))))
     (((RetrievalFailure $id $reason) (MemoryFailure $id $reason))
      ($scores (list:sort-by memory:precedes (retain-top-k-keyed-atom $scores $k))))))
(= (memory:query $profile $query $k $filter)
   (case (tensor:norm $query)
     (((TensorFailure $reason) (MemoryFailure query $reason))
      ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
        (MemoryFailure query invalid-norm)
        (memory:query-scored $profile $query $k $filter))))))

; The packed index is derived from one immutable worker view. The source store
; and model profile are checked by the adapter before this worker is used.
(= (memory:vector (Memory $id $rev $p $v $doc $meta)) $v)
(= (memory:field-index $index $i (MemoryInfo $id $rev $doc $meta))
   (case (superpose $meta)
     ((($key $value) (index:insert $index $i $key $value)))))
(= (memory:build-packed $width $records)
   (let $matrix (tensor:stack f64 $width (collapse (memory:vector (superpose $records))))
     (case $matrix
       (((TensorFailure $why) (MemoryFailure index $why))
        ($packed (case (tensor:normalize-rows $packed)
          (((TensorFailure $why) (MemoryFailure index $why))
           ($unit (let* (($briefs (collapse (memory:brief (superpose $records))))
                         ($rows (new-space)) ($count (size-atom $briefs))
                         ($stamp (get-state &memory-view))
                         ($projection (index:new $stamp $count 128))
                         ($positions (list:range $count))
                         ($built (collapse (let $i (superpose $positions)
                           (let $row (index-atom $briefs $i)
                             (let $saved-row (add-atom $rows (Row $i $row))
                               (memory:field-index $projection $i $row)))))))
             (let $screen (memory:build-screen (get-state &memory-scan-tier) $unit)
               (case $screen
                 (((MemoryFailure $id $why) (MemoryFailure $id $why))
                  ($ready (Packed $stamp $rows $count $unit $projection (tensor:full u8 ($count) 1) $ready))))))))))))))
; A scan tier's screen over the unit rows: none, an f32 copy, or a certified
; 8-bit copy. Each screen only selects rows; scores come from the f64 rows.
(= (memory:build-screen wide $unit) Missing)
(= (memory:build-screen f32 $unit)
   (if (== (tensor:dtype $unit) f32) Missing (case (tensor:cast f32 $unit)
     (((TensorFailure $why) (MemoryFailure index $why))
      ($compact (case (tensor:row-error-bounds $unit $compact)
        (((TensorFailure $why) (MemoryFailure index $why))
         ($certificate (Screen $compact $certificate)))))))))
(= (memory:build-screen int8 $unit)
   (case (tensor:int8-rows $unit)
     (((TensorFailure $why) (MemoryFailure index $why))
      (($codes $record) (Int8Screen $codes $record)))))
(= (memory:clear-dirty)
   (collapse (let $row (match &memory-dirty $entry $entry) (remove-atom &memory-dirty $row))))
(= (memory:build-index $width)
   (case (case (get-state &memory-matrix)
           ((Missing (memory:build-packed $width (collapse (memory:matches All))))
            ($source (memory:build-matrix-packed $source))))
     (((MemoryFailure $id $why) (MemoryFailure $id $why))
      ($packed (let* (($cleared (memory:clear-dirty))
                      ($delta (change-state! &memory-delta-index Missing))
                      ($saved (change-state! &memory-index $packed))) $packed)))))
; Writes retire base rows before selection. Latest versions of changed IDs are
; scored in a bounded delta matrix; deleted IDs yield no delta row.
(= (memory:operation-id (add (Memory $id $rev $p $v $doc $meta))) $id)
(= (memory:operation-id (remove (Memory $id $rev $p $v $doc $meta))) $id)
(= (memory:mark-dirty $id)
   (if (== (collapse (match &memory-dirty (Dirty $id) True)) ())
     (add-atom &memory-dirty (Dirty $id)) ()))
(= (memory:touch-index $operations)
   (let* (($next (+ (get-state &memory-view) 1))
          ($version (change-state! &memory-view $next))
          ($delta (change-state! &memory-delta-index Missing)))
     (case (get-state &memory-index)
       ((Missing ())
        ((Packed $stamp $rows $count $matrix $projection $live $screen)
         (let* (($ids (collapse (memory:operation-id (superpose $operations))))
                ($marked (collapse (memory:mark-dirty (superpose $ids))))
                ($retired (tensor:indices (collapse (let $id (superpose $ids)
                  (match $rows (Row $i (MemoryInfo $id $rev $doc $meta)) $i)))))
                ($updated (tensor:mask-and $live (tensor:mask-not (tensor:mask-indices $count $retired)))))
           (case $updated
             (((TensorFailure $why) (change-state! &memory-index Missing))
              ($mask (if (>= (size-atom (collapse (get-atoms &memory-dirty))) 128)
                (change-state! &memory-index Missing)
                (change-state! &memory-index (Packed $stamp $rows $count $matrix $projection $mask $screen))))))))))))
(= (memory:build-delta $width)
   (let $records (collapse (let $id (match &memory-dirty (Dirty $id) $id) (memory:record $id)))
     (let $packed (memory:build-packed $width $records)
       (let $saved (change-state! &memory-delta-index $packed) $packed))))

; A matrix collection answers queries over its rows and takes no writes. Its
; rows of unit length within 1e-5, as normalized f32 embeddings are, are used
; as stored, so a mapped matrix is not copied, and scores are inner products
; with them. Other rows are normalized into an f64 copy.
(= (memory:largest $vector)
   (index-atom (tensor:to-expr (tensor:gather $vector (tensor:top-k $vector 1))) 0))
(= (memory:unit-rows $matrix $count)
   (if (== $count 0) $matrix
     (case (tensor:row-norms $matrix)
       (((TensorFailure $why) (TensorFailure $why))
        ($norms (let* (($gap (tensor:add $norms (tensor:full f64 ($count) -1.0)))
                       ($above (memory:largest $gap))
                       ($below (memory:largest (tensor:scale $gap -1.0))))
                  (if (and (<= $above 0.00001) (<= $below 0.00001)) $matrix
                    (tensor:div-rows $matrix $norms))))))))

; A matrix collection's rows are columns of named tensors, as a matrix file
; holds them: ids.offsets and ids.bytes, the IDs; documents.offsets and
; documents.bytes; revisions, an integer vector; and for each metadata key,
; metadata.<key>, a vector, or metadata.<key>.offsets and .bytes, strings,
; with metadata.<key>.present marking the rows that have the key. An entry is
; (name tensor), or (name tensor bool) for a vector of booleans, which a file
; stores as BOOL.
;
; The table is (MatrixTable ids index documents revisions columns). ids and
; documents are (Strings offsets bytes); documents and revisions may be
; Missing; index is the IDs' hash table; each column is (Column key kind
; values present), of kind text, integer, real or truth, with present a u8
; mask or Missing.
(= (memory:file-entry $entries $name)
   (case (collapse (case (superpose $entries)
           ((($name $value) $value) (($name $value bool) $value) ($other (empty)))))
     ((($value) $value) ($other Missing))))
; The tensor named "vectors", or a file's only tensor, as a .npy file holds.
(= (memory:file-vectors $entries)
   (case (memory:file-entry $entries "vectors")
     ((Missing (if (== (size-atom $entries) 1) (index-atom (index-atom $entries 0) 1) Missing))
      ($vectors $vectors))))
(= (memory:text $value) (if (== (get-type $value) String) $value (repr $value)))
(= (memory:length $tensor) (case (tensor:shape $tensor) ((($n) $n) ($other -1))))
(= (memory:strings-length (Strings $offsets $bytes))
   (if (and (== (tensor:dtype $offsets) i64) (and (== (tensor:dtype $bytes) u8) (>= (memory:length $bytes) 0)))
     (- (memory:length $offsets) 1) -1))
(= (memory:strings-entry $entries $prefix)
   (let* (($offsets (memory:file-entry $entries (str:concat $prefix ".offsets")))
          ($bytes (memory:file-entry $entries (str:concat $prefix ".bytes"))))
     (if (and (== $offsets Missing) (== $bytes Missing)) Missing
       (if (or (== $offsets Missing) (== $bytes Missing)) (MemoryFailure load-matrix ($prefix incomplete))
         (Strings $offsets $bytes)))))
; Documents are checked as they are read, so a large file opens at once.
(= (memory:documents $entries $count)
   (case (memory:strings-entry $entries "documents")
     ((Missing Missing)
      ((Strings $offsets $bytes)
       (if (== (memory:strings-length (Strings $offsets $bytes)) $count) (Strings $offsets $bytes)
         (MemoryFailure load-matrix documents)))
      ($failure $failure))))
(= (memory:revisions $entries $count)
   (case (memory:file-entry $entries "revisions")
     ((Missing Missing)
      ($revisions (if (and (== (tensor:dtype $revisions) i64) (== (memory:length $revisions) $count)) $revisions
        (MemoryFailure load-matrix revisions))))))
(= (memory:truths $entries)
   (collapse (case (superpose $entries) ((($name $value bool) $name) ($other (empty))))))
(= (memory:column-name $name)
   (if (and (str:starts-with $name "metadata.")
            (not (or (str:ends-with $name ".bytes") (str:ends-with $name ".present"))))
     $name (empty)))
(= (memory:metadata-names $entries)
   (collapse (case (superpose $entries)
     ((($name $value) (memory:column-name $name))
      (($name $value bool) (memory:column-name $name))))))
(= (memory:present $entries $count $key $kind $values)
   (case (memory:file-entry $entries (str:concat (str:concat "metadata." $key) ".present"))
     ((Missing (Column $key $kind $values Missing))
      ($present (if (and (== (tensor:dtype $present) u8) (== (memory:length $present) $count))
        (case (tensor:mask-not $present)
          (((TensorFailure $why) (MemoryFailure load-matrix ($key present)))
           ($valid (Column $key $kind $values $present))))
        (MemoryFailure load-matrix ($key present)))))))
(= (memory:text-column $entries $count $key)
   (case (memory:strings-entry $entries (str:concat "metadata." $key))
     (((Strings $offsets $bytes)
       (case (tensor:string-count $offsets $bytes)
         (((TensorFailure $why) (MemoryFailure load-matrix ($key $why)))
          ($n (if (== $n $count) (memory:present $entries $count $key text (Strings $offsets $bytes))
                (MemoryFailure load-matrix ($key count)))))))
      ($failure $failure))))
(= (memory:value-column $entries $truths $count $name $key)
   (let $values (memory:file-entry $entries $name)
     (if (not (== (memory:length $values) $count)) (MemoryFailure load-matrix ($key count))
       (case (tensor:dtype $values)
         ((i64 (memory:present $entries $count $key integer $values))
          (f64 (memory:present $entries $count $key real $values))
          (f32 (memory:present $entries $count $key real $values))
          (u8 (if (memory:member $name $truths)
                (case (tensor:mask-not $values)
                  (((TensorFailure $why) (MemoryFailure load-matrix ($key truth)))
                   ($valid (memory:present $entries $count $key truth $values))))
                (memory:present $entries $count $key integer $values)))
          ($other (MemoryFailure load-matrix ($key dtype))))))))
(= (memory:column $entries $truths $count $name)
   (let $length (str:byte-length $name)
     (if (str:ends-with $name ".offsets")
       (memory:text-column $entries $count (str:byte-slice $name 9 (- $length 8)))
       (memory:value-column $entries $truths $count $name (str:byte-slice $name 9 $length)))))
(= (memory:columns $entries $count)
   (let* (($truths (memory:truths $entries))
          ($names (memory:metadata-names $entries))
          ($columns (collapse (let $name (superpose $names) (memory:column $entries $truths $count $name))))
          ($failures (collapse (case (superpose $columns)
                       (((MemoryFailure $id $why) (MemoryFailure $id $why)) ($column (empty))))))
          ($keys (collapse (case (superpose $columns) (((Column $key $kind $values $present) $key))))))
     (if (not (== $failures ())) (car-atom $failures)
       (if (== (size-atom (unique-atom $keys)) (size-atom $keys)) (list:sort-by memory:key-precedes $columns)
         (MemoryFailure load-matrix duplicate-key)))))
(= (memory:key-precedes (Column $a $ak $av $ap) (Column $b $bk $bv $bp)) (< (str:compare $a $b) 0))
(= (memory:id-strings $ids)
   (case $ids
     (((IdColumn $offsets $bytes) (Strings $offsets $bytes))
      ((Ids $strings)
       (case (tensor:string-column $strings)
         (((TensorFailure $why) (MemoryFailure load-matrix (ids $why)))
          (($offsets $bytes) (Strings $offsets $bytes)))))
      ($other (MemoryFailure load-matrix ids)))))
; The IDs' hash table checks every ID and refuses two equal IDs.
(= (memory:matrix-table $ids $entries $count)
   (case (memory:id-strings $ids)
     (((Strings $offsets $bytes)
       (if (not (== (memory:strings-length (Strings $offsets $bytes)) $count)) (MemoryFailure load-matrix ids-count)
         (case (tensor:string-index $offsets $bytes)
           (((TensorFailure $why) (MemoryFailure load-matrix (ids $why)))
            ($index (memory:table-columns (Strings $offsets $bytes) $index $entries $count))))))
      ($failure $failure))))
(= (memory:table-columns $ids $index $entries $count)
   (case (memory:documents $entries $count)
     (((MemoryFailure $id $why) (MemoryFailure $id $why))
      ($documents (case (memory:revisions $entries $count)
        (((MemoryFailure $id $why) (MemoryFailure $id $why))
         ($revisions (case (memory:columns $entries $count)
           (((MemoryFailure $id $why) (MemoryFailure $id $why))
            ($columns (MatrixTable $ids $index $documents $revisions $columns)))))))))))
; Replaces the collection with the matrix and its columns, or leaves it as it
; was when either is refused.
(= (memory:load-matrix $profile $dimensions $ids $matrix $entries)
   (if (not (or (== (tensor:dtype $matrix) f64) (== (tensor:dtype $matrix) f32)))
     (MemoryFailure load-matrix dtype)
     (case (tensor:shape $matrix)
       ((($count $width)
         (if (not (== $width $dimensions)) (MemoryFailure load-matrix dimensions)
           (case (memory:matrix-table $ids $entries $count)
             (((MemoryFailure $id $why) (MemoryFailure $id $why))
              ($table
               (case (memory:unit-rows $matrix $count)
                 (((TensorFailure $why) (MemoryFailure load-matrix $why))
                  ($unit (let* (($removed (collapse (let $row (memory:matches All) (remove-atom &memory-records $row))))
                                ($profiled (change-state! &memory-profile (Profile $profile $dimensions)))
                                ($source (change-state! &memory-matrix (MatrixSource $table $unit)))
                                ($reset (memory:invalidate))
                                ($dirty (memory:clear-dirty)))
                           (LoadedMatrix $count))))))))))
        ($other (MemoryFailure load-matrix shape))))))
; Each tensor is shared when CeTTa reads it as stored and copied otherwise;
; the file's BOOL vectors are marked as booleans.
(= (memory:mark-booleans $path $entries)
   (case (tensor:file-info $path)
     (((TensorFileInfo $format $size $infos $metadata)
       (let $truths (collapse (case (superpose $infos)
                      (((TensorFileEntry $name $dtype $shape "BOOL" $sharing) $name) ($other (empty)))))
         (collapse (case (superpose $entries)
           ((($name $tensor) (if (memory:member $name $truths) ($name $tensor bool) ($name $tensor))))))))
      ($other $entries))))
(= (memory:load-matrix-file $profile $dimensions $path)
   (case (tensor:open-all $path)
     (((TensorFailure $why) (MemoryFailure load-matrix-file $why))
      ((TensorFile $format $opened $metadata)
       (let* (($entries (memory:mark-booleans $path $opened))
              ($vectors (memory:file-vectors $entries))
              ($offsets (memory:file-entry $entries "ids.offsets"))
              ($bytes (memory:file-entry $entries "ids.bytes"))
              ($stored (memory:file-entry $metadata "profile")))
         (if (== $vectors Missing) (MemoryFailure load-matrix-file missing-vectors)
           (if (or (== $offsets Missing) (== $bytes Missing)) (MemoryFailure load-matrix-file missing-ids)
             (if (and (not (== $stored Missing)) (not (== $stored (memory:text $profile))))
               (MemoryFailure load-matrix-file profile-mismatch)
               (memory:load-matrix $profile $dimensions (IdColumn $offsets $bytes) $vectors $entries))))))
      ($other (MemoryFailure load-matrix-file unreadable)))))
(= (memory:build-matrix-packed (MatrixSource $table $unit))
   (let* (($count (car-atom (tensor:shape $unit)))
          ($stamp (get-state &memory-view)))
     (case (memory:build-screen (get-state &memory-scan-tier) $unit)
       (((MemoryFailure $id $why) (MemoryFailure $id $why))
        ($ready (Packed $stamp $table $count $unit $table (tensor:full u8 ($count) 1) $ready))))))

; A filter over a table compares columns: (Eq key value) holds in the rows
; whose column for key holds value, of the column's kind (a String for text,
; an integer for integer, a float for real, a boolean for truth).
(= (memory:integer? $value)
   (case (tensor:from i64 (1) ($value)) (((TensorFailure $why) False) ($tensor True))))
(= (memory:real? $value)
   (if (== (get-type $value) Number) (not (memory:integer? $value)) False))
(= (memory:numeric-mask $values $n $value)
   (case (tensor:mask-equal $values $value)
     (((TensorFailure $why) (tensor:full u8 ($n) 0))
      ($mask $mask))))
(= (memory:value-mask $kind $values $n $value)
   (case $kind
     ((text (if (== (get-type $value) String)
              (let (Strings $offsets $bytes) $values (tensor:string-mask $offsets $bytes $value))
              (tensor:full u8 ($n) 0)))
      (truth (if (== (get-type $value) Bool)
               (if $value (tensor:mask-equal $values 1) (tensor:mask-equal $values 0))
               (tensor:full u8 ($n) 0)))
      (integer (if (memory:integer? $value) (memory:numeric-mask $values $n $value) (tensor:full u8 ($n) 0)))
      (real (if (memory:real? $value) (memory:numeric-mask $values $n $value) (tensor:full u8 ($n) 0))))))
(= (memory:eq-mask (MatrixTable $ids $index $documents $revisions $columns) $n $key $value)
   (case (collapse (case (superpose $columns)
           (((Column $key $kind $values $present) (Column $key $kind $values $present)) ($other (empty)))))
     ((() (tensor:full u8 ($n) 0))
      (((Column $key $kind $values $present))
       (let $mask (memory:value-mask $kind $values $n $value)
         (if (== $present Missing) $mask (tensor:mask-and $mask $present)))))))
(= (memory:column-mask $table $n $filter)
   (case $filter
     ((All (tensor:full u8 ($n) 1))
      ((Eq $key $value) (memory:eq-mask $table $n $key $value))
      ((And $filters) (memory:fold-masks $table $n $filters (tensor:full u8 ($n) 1) And))
      ((Or $filters) (memory:fold-masks $table $n $filters (tensor:full u8 ($n) 0) Or))
      ($other (IndexFailure unsupported-filter)))))
(= (memory:fold-masks $table $n $filters $acc $kind)
   (case $filters
     ((() $acc)
      ($nonempty
       (let* (($head (car-atom $nonempty)) ($tail (cdr-atom $nonempty))
              ($next (memory:column-mask $table $n $head)))
         (case $next
           (((IndexFailure $why) $next)
            ((TensorFailure $why) $next)
            ($mask (let $merged (case $kind ((And (tensor:mask-and $acc $mask)) (Or (tensor:mask-or $acc $mask))))
                     (memory:fold-masks $table $n $tail $merged $kind))))))))))

; A table row as a hit: (MemoryInfo id revision document metadata), with
; revision 0 and document "" when the table has none, and the metadata in
; key order.
(= (memory:element $vector $i)
   (let $picked (tensor:gather $vector (tensor:indices ($i)))
     (index-atom (tensor:to-expr $picked) 0)))
(= (memory:row-document Missing $i) "")
(= (memory:row-document (Strings $offsets $bytes) $i) (tensor:string-at $offsets $bytes $i))
(= (memory:row-present $present $i)
   (if (== $present Missing) True (== (memory:element $present $i) 1)))
(= (memory:column-value $kind $values $i)
   (case $kind
     ((text (let (Strings $offsets $bytes) $values (tensor:string-at $offsets $bytes $i)))
      (truth (let $picked (tensor:gather $values (tensor:indices ($i)))
               (car-atom (tensor:to-booleans $picked))))
      ($number (memory:element $values $i)))))
(= (memory:row-metadata $columns $i)
   (collapse (let (Column $key $kind $values $present) (superpose $columns)
     (if (memory:row-present $present $i)
       (let $value (memory:column-value $kind $values $i) ($key $value))
       (empty)))))
(= (memory:table-row (MatrixTable (Strings $offsets $bytes) $index $documents $revisions $columns) $i)
   (let* (($id (tensor:string-at $offsets $bytes $i))
          ($revision (if (== $revisions Missing) 0 (memory:element $revisions $i)))
          ($document (memory:row-document $documents $i))
          ($metadata (memory:row-metadata $columns $i)))
     (case $document
       (((TensorFailure $why) (MemoryFailure document $why))
        ($text (MemoryInfo $id $revision $text $metadata))))))
(= (memory:first-failure $items)
   (case (collapse (case (superpose $items) (((MemoryFailure $id $why) (MemoryFailure $id $why)) ($item (empty)))))
     ((() $items) ($failures (car-atom $failures)))))
; A matrix collection's rows by ID, through the IDs' hash table; IDs it lacks
; are left out, as for records.
(= (memory:matrix-get (MatrixSource (MatrixTable (Strings $offsets $bytes) $index $documents $revisions $columns) $unit) $ids)
   (let $table (MatrixTable (Strings $offsets $bytes) $index $documents $revisions $columns)
     (memory:first-failure (collapse (let $id (superpose $ids)
       (let $row (tensor:string-find $index $offsets $bytes $id)
         (if (== (get-type $row) Number) (if (>= $row 0) (memory:table-row $table $row) (empty)) (empty))))))))
(= (memory:matrix-ids (MatrixSource (MatrixTable (Strings $offsets $bytes) $index $documents $revisions $columns) $unit) $filter)
   (let* (($table (MatrixTable (Strings $offsets $bytes) $index $documents $revisions $columns))
          ($n (car-atom (tensor:shape $unit))))
     (case (memory:column-mask $table $n $filter)
       (((IndexFailure $why) (MemoryFailure filter $why))
        ((TensorFailure $why) (MemoryFailure filter $why))
        ($mask (let $rows (tensor:to-expr (tensor:nonzero $mask))
          (collapse (let $i (superpose $rows) (tensor:string-at $offsets $bytes $i)))))))))

; A matrix file of the collection's live unit rows: vectors [n d], the
; columns above, and the profile in its metadata. A collection of records
; gives each metadata key one column, which needs one value per row and one
; kind per key.
(= (memory:current-index $dimensions)
   (case (get-state &memory-index)
     ((Missing (memory:build-index $dimensions))
      ($packed (if (== (collapse (get-atoms &memory-dirty)) ()) $packed (memory:build-index $dimensions))))))
(= (memory:column-entries $key $kind $values $present)
   (let* (($name (str:concat "metadata." $key))
          ($main (case $kind
                   ((text (let* (((Strings $offsets $bytes) $values)
                                 ($on (str:concat $name ".offsets")) ($bn (str:concat $name ".bytes")))
                            (($on $offsets) ($bn $bytes))))
                    (truth (($name $values bool)))
                    ($number (($name $values))))))
          ($marks (if (== $present Missing) () (let $pn (str:concat $name ".present") (($pn $present bool))))))
     (list:append $main $marks)))
(= (memory:table-entries (MatrixTable (Strings $offsets $bytes) $index $documents $revisions $columns))
   (let* (($id-entries (("ids.offsets" $offsets) ("ids.bytes" $bytes)))
          ($document-entries (case $documents
                               ((Missing ())
                                ((Strings $do $db) (("documents.offsets" $do) ("documents.bytes" $db))))))
          ($revision-entries (if (== $revisions Missing) () (("revisions" $revisions))))
          ($column-entries (collapse (let (Column $key $kind $values $present) (superpose $columns)
                             (let $entries (memory:column-entries $key $kind $values $present) (superpose $entries))))))
     (list:append $id-entries (list:append $document-entries (list:append $revision-entries $column-entries)))))
(= (memory:value-kind $value)
   (if (== (get-type $value) String) text
     (if (== (get-type $value) Bool) truth
       (if (memory:integer? $value) integer
         (if (== (get-type $value) Number) real other)))))
(= (memory:values-kind $values)
   (let* (($kinds (collapse (let $value (superpose $values) (memory:value-kind $value))))
          ($first (car-atom $kinds))
          ($others (collapse (let $kind (superpose $kinds) (if (== $kind $first) (empty) $kind)))))
     (if (memory:member other $kinds) other (if (== $others ()) $first mixed))))
(= (memory:placeholder text) "")
(= (memory:placeholder truth) 0)
(= (memory:placeholder integer) 0)
(= (memory:placeholder real) 0.0)
(= (memory:cell-value truth $value) (if $value 1 0))
(= (memory:cell-value text $value) $value)
(= (memory:cell-value integer $value) $value)
(= (memory:cell-value real $value) $value)
(= (memory:make-column $kind $count $cells)
   (case $kind
     ((text (case (tensor:string-column $cells)
              (((TensorFailure $why) (TensorFailure $why)) (($offsets $bytes) (Strings $offsets $bytes)))))
      (truth (tensor:from u8 ($count) $cells))
      (integer (tensor:from i64 ($count) $cells))
      (real (tensor:from f64 ($count) $cells)))))
(= (memory:suffixed? $key)
   (or (str:ends-with $key ".offsets") (or (str:ends-with $key ".bytes") (str:ends-with $key ".present"))))
(= (memory:export-column $briefs $count $key)
   (let* (($cells (collapse (let (MemoryInfo $id $rev $doc $meta) (superpose $briefs) (memory:field $meta $key))))
          ($multiple (collapse (let $cell (superpose $cells) (if (> (size-atom $cell) 1) True (empty)))))
          ($values (collapse (let $cell (superpose $cells) (if (== $cell ()) (empty) (car-atom $cell)))))
          ($kind (memory:values-kind $values)))
     (if (or (not (== (get-type $key) String)) (memory:suffixed? $key)) (MemoryFailure export-matrix (metadata-key $key))
       (if (not (== $multiple ())) (MemoryFailure export-matrix (multiple-values $key))
         (if (== $kind other) (MemoryFailure export-matrix (metadata-value $key))
         (if (== $kind mixed) (MemoryFailure export-matrix (mixed-kinds $key))
           (let* (($filled (collapse (let $cell (superpose $cells)
                             (if (== $cell ()) (memory:placeholder $kind) (memory:cell-value $kind (car-atom $cell))))))
                  ($marks (collapse (let $cell (superpose $cells) (if (== $cell ()) 0 1))))
                  ($column (memory:make-column $kind $count $filled))
                  ($present (if (== (size-atom $values) $count) Missing (tensor:from u8 ($count) $marks))))
             (case $column
               (((TensorFailure $why) (MemoryFailure export-matrix ($key $why)))
                ($ready (memory:column-entries $key $kind $ready $present)))))))))))
(= (memory:space-entries $space $count)
   (let* (($positions (list:range $count))
          ($briefs (collapse (let $i (superpose $positions) (match $space (Row $i $brief) $brief)))))
     (if (not (== (size-atom $briefs) $count)) (MemoryFailure export-matrix rows-count)
       (let* (($ids (collapse (let (MemoryInfo $id $rev $doc $meta) (superpose $briefs) $id)))
              ($documents (collapse (let (MemoryInfo $id $rev $doc $meta) (superpose $briefs) $doc)))
              ($revisions (collapse (let (MemoryInfo $id $rev $doc $meta) (superpose $briefs) $rev)))
              ($keys (unique-atom (collapse (let (MemoryInfo $id $rev $doc $meta) (superpose $briefs)
                       (let ($key $value) (superpose $meta) $key)))))
              ($columns (collapse (let $key (superpose $keys) (memory:export-column $briefs $count $key)))))
         (case (memory:first-failure $columns)
           (((MemoryFailure $id $why) (MemoryFailure $id $why))
            ($ready
             (case (tensor:string-column $ids)
               (((TensorFailure $why) (MemoryFailure export-matrix (ids $why)))
                (($io $ib)
                 (case (tensor:string-column $documents)
                   (((TensorFailure $why) (MemoryFailure export-matrix (documents $why)))
                    (($do $db)
                     (case (tensor:from i64 ($count) $revisions)
                       (((TensorFailure $why) (MemoryFailure export-matrix (revisions $why)))
                        ($revision-vector
                         (let $metadata (collapse (let $entries (superpose $ready) (superpose $entries)))
                           (list:append (("ids.offsets" $io) ("ids.bytes" $ib) ("documents.offsets" $do)
                                         ("documents.bytes" $db) ("revisions" $revision-vector))
                                        $metadata))))))))))))))))))
(= (memory:export-entries $rows $count)
   (case $rows
     (((MatrixTable $ids $index $documents $revisions $columns) (memory:table-entries $rows))
      ($space (memory:space-entries $space $count)))))
(= (memory:export-matrix $path)
   (case (get-state &memory-profile)
     ((Missing (MemoryFailure export-matrix empty))
      ((Profile $profile $dimensions)
       (case (memory:current-index $dimensions)
         (((MemoryFailure $id $why) (MemoryFailure $id $why))
          ((Packed $stamp $rows $count $unit $projection $live $screen)
           (case (memory:export-entries $rows $count)
             (((MemoryFailure $id $why) (MemoryFailure $id $why))
              ($columns
               (let* (($profile-text (memory:text $profile)) ($width (repr $dimensions))
                      ($tensors (cons-atom ("vectors" $unit) $columns))
                      ($metadata (("format" "cetta-memory-matrix-v1") ("profile" $profile-text)
                                  ("dimensions" $width))))
                 (case (tensor:save-safetensors $path $tensors $metadata)
                   (((TensorFailure $why) (MemoryFailure export-matrix $why))
                    ((TensorSaved $file $size) (Exported $count $size)))))))))))))))

; An equality posting is a derived selector over one immutable worker view.
; Matching the indexed key/value happens once; Boolean composition uses masks.
(= (memory:selected-hits $rows $indices $scores)
   (case $rows
     (((MatrixTable $ids $index $documents $revisions $columns) (memory:table-hits $rows $indices $scores))
      ($space (memory:space-hits $space $indices $scores)))))
(= (memory:table-hits $table $indices $scores)
   (let* (($selected (tensor:to-expr $indices)) ($values (tensor:to-expr $scores))
          ($positions (list:range (size-atom $selected))))
     (memory:first-failure (collapse (let $i (superpose $positions)
       (let* (($score (index-atom $values $i))
              ($row (memory:table-row $table (index-atom $selected $i))))
         (case $row
           (((MemoryFailure $id $why) $row)
            ($info ($score $info))))))))))
(= (memory:space-hits $rows $indices $scores)
   (let* (($selected (tensor:to-expr $indices)) ($values (tensor:to-expr $scores))
          ($positions (list:range (size-atom $selected))))
     (collapse (let $i (superpose $positions)
       (let* (($score (index-atom $values $i))
              ($row-id (index-atom $selected $i))
              ($row (match $rows (Row $row-id $brief) $brief)))
         ($score $row))))))
(= (memory:query-selected $rows $matrix $query $k $indices)
   (case (tensor:cosine-unit-rows $matrix $query $indices)
     (((TensorFailure $why) (MemoryFailure query $why))
      ($scores (case (tensor:top-k $scores $k)
        (((TensorFailure $why) (MemoryFailure query $why))
         ($top (memory:selected-hits $rows (tensor:gather $indices $top) (tensor:gather $scores $top)))))))))
(= (memory:query-screened $rows $matrix $compact $certificate $query $k $indices)
   (case (tensor:norm $query)
     (((TensorFailure $why) (MemoryFailure query $why))
      ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
        (MemoryFailure query invalid-value)
        (let $unit-query (tensor:scale $query (/ 1.0 $norm))
          (case (tensor:screen-candidates $compact $certificate $unit-query $indices $k)
            (((TensorFailure $why) (MemoryFailure query $why))
             ($candidates (let $selected (tensor:gather $indices $candidates)
               (case (tensor:matvec-selected $matrix $unit-query $selected)
                 (((TensorFailure $why) (MemoryFailure query $why))
                  ($scores (case (tensor:top-k $scores $k)
                    (((TensorFailure $why) (MemoryFailure query $why))
                     ($top (memory:selected-hits $rows (tensor:gather $selected $top)
                       (tensor:gather $scores $top))))))))))))))))))
(= (memory:query-int8 $rows $matrix $codes $record $query $k $indices)
   (case (tensor:norm $query)
     (((TensorFailure $why) (MemoryFailure query $why))
      ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
        (MemoryFailure query invalid-value)
        (let $unit-query (tensor:scale $query (/ 1.0 $norm))
          (case (tensor:int8-candidates $codes $record $unit-query $indices $k)
            (((TensorFailure $why) (MemoryFailure query $why))
             ($selected (case (tensor:matvec-selected $matrix $unit-query $selected)
               (((TensorFailure $why) (MemoryFailure query $why))
                ($scores (case (tensor:top-k $scores $k)
                  (((TensorFailure $why) (MemoryFailure query $why))
                   ($top (memory:selected-hits $rows (tensor:gather $selected $top)
                     (tensor:gather $scores $top)))))))))))))))))
(= (memory:query-tier $rows $matrix Missing $query $k $indices)
   (memory:query-selected $rows $matrix $query $k $indices))
(= (memory:query-tier $rows $matrix (Screen $compact $certificate) $query $k $indices)
   (memory:query-screened $rows $matrix $compact $certificate $query $k $indices))
(= (memory:query-tier $rows $matrix (Int8Screen $codes $record) $query $k $indices)
   (memory:query-int8 $rows $matrix $codes $record $query $k $indices))
(= (memory:filter-mask $stamp $projection $live $filter)
   (case $projection
     (((MatrixTable $ids $index $documents $revisions $columns)
       (memory:column-mask $projection (car-atom (tensor:shape $live)) $filter))
      ($index (index:mask $stamp $index $filter)))))
(= (memory:selected-rows $stamp $projection $live $filter)
   (case (memory:filter-mask $stamp $projection $live $filter)
     (((IndexFailure $why) (IndexFailure $why))
      ((TensorFailure $why) (TensorFailure $why))
      ($selected (case (tensor:mask-and $live $selected)
        (((TensorFailure $why) (TensorFailure $why))
         ($mask (tensor:nonzero $mask))))))))
; The rows an All filter selects are a function of the view and its live mask;
; they are kept while both are unchanged.
(= (memory:all-rows $stamp $projection $live)
   (case (get-state &memory-all-rows)
     (((AllRows $stamp $live $indices) $indices)
      ($other (let $selected (memory:selected-rows $stamp $projection $live All)
        (case $selected
          (((IndexFailure $why) $selected)
           ((TensorFailure $why) $selected)
           ($indices (let $saved (change-state! &memory-all-rows (AllRows $stamp $live $indices)) $indices)))))))))
(= (memory:query-packed $query $k $filter (Packed $stamp $rows $count $matrix $projection $live $screen))
   (case (if (== $filter All) (memory:all-rows $stamp $projection $live)
           (memory:selected-rows $stamp $projection $live $filter))
     (((IndexFailure $why) (MemoryFailure filter $why))
      ((TensorFailure $why) (MemoryFailure filter $why))
      ($indices (memory:query-tier $rows $matrix $screen $query $k $indices)))))
(= (memory:query-indexed $query $k $filter)
   (let $index (case (get-state &memory-index)
         ((Missing (memory:build-index (car-atom (tensor:shape $query)))) ($base-ready $base-ready)))
     (case $index
       (((MemoryFailure $id $why) (MemoryFailure $id $why))
        ($packed (let $base (memory:query-packed $query $k $filter $packed)
          (case $base
            (((MemoryFailure $id $why) (MemoryFailure $id $why))
             ($hits (if (== (collapse (get-atoms &memory-dirty)) ()) $hits
               (let $delta (case (get-state &memory-delta-index)
                     ((Missing (memory:build-delta (car-atom (tensor:shape $query)))) ($delta-ready $delta-ready)))
                 (case $delta
                   (((MemoryFailure $id $why) (MemoryFailure $id $why))
                    ($tail (case (memory:query-packed $query $k $filter $tail)
                      (((MemoryFailure $id $why) (MemoryFailure $id $why))
                       ($recent (let $both (list:append $hits $recent)
                         (list:sort-by memory:precedes (retain-top-k-keyed-atom $both $k))))))))))))))))))))
(= (memory:validate $profile $dimensions (Memory $id $rev $rp $v $doc $meta))
   (if (and (== $profile $rp) (== (tensor:dtype $v) f64))
     (if (== (tensor:shape $v) ($dimensions))
       (case (tensor:norm $v)
         (((TensorFailure $why) (MemoryFailure $id $why))
          ($norm (if (or (<= $norm 0) (or (isnan-math $norm) (isinf-math $norm)))
            (MemoryFailure $id invalid-norm) Valid))))
       (MemoryFailure $id dimensions))
     (MemoryFailure $id profile-or-dtype)))

(= (memory:patch $old $patch)
   (let $keys (collapse (case (superpose $patch) ((($key $value) $key))))
     (collapse (superpose
       ((case (superpose $old)
          ((($key $value) (if (memory:member $key $keys) (empty) ($key $value)))))
        (case (superpose $patch)
          ((($key MemoryDeleteField) (empty)) ($entry $entry))))))))
(= (memory:update $revision $patch (Memory $id $oldrev $p $v $doc $meta))
   (let $newmeta (memory:patch $meta $patch)
     ((remove (Memory $id $oldrev $p $v $doc $meta))
      (add (Memory $id $revision $p $v $doc $newmeta)))))
(= (memory:apply (add $row)) (add-atom &memory-records $row))
(= (memory:apply (remove $row)) (remove-atom &memory-records $row))
(= (memory:load-error $profile $dimensions $row)
   (case (memory:validate $profile $dimensions $row)
     ((Valid (empty)) ($failure $failure))))
(= (memory:index-status)
   (let* (($view (get-state &memory-view))
          ($base (case (get-state &memory-index)
            ((Missing Missing)
             ((Packed $stamp $rows $count $matrix $projection $live $screen) (Base $stamp $count)))))
          ($dirty (size-atom (collapse (get-atoms &memory-dirty))))
          ($delta (case (get-state &memory-delta-index)
            ((Missing Missing)
             ((Packed $ds $dr $dn $dm $dp $dl $dc) (Delta $ds $dn))))))
     (IndexStatus $view $base $dirty $delta)))

(= (memory:dispatch $request)
   (case $request
     (((reset)
       (let $removed (collapse (let $row (memory:matches All) (remove-atom &memory-records $row)))
         (let $profile (let $matrix (change-state! &memory-matrix Missing) (change-state! &memory-profile Missing))
           (let $invalidated (memory:invalidate)
             (let $dirty (memory:clear-dirty) (Reset))))))
      ((execution-profile) (let $provider (tensor:matvec-provider) (TensorExecution $provider f64 lane4)))
      ((scan-tier $tier)
       (if (or (== $tier wide) (or (== $tier f32) (== $tier int8)))
         (let* (($changed (change-state! &memory-scan-tier $tier)) ($reset (memory:invalidate)))
           (ScanTier $tier))
         (MemoryFailure scan-tier unsupported)))
      ((index-status) (memory:index-status))
      ((load $profile $dimensions $rows)
       (if (not (== (get-state &memory-matrix) Missing)) (MemoryFailure load matrix-read-only)
       (let $errors (collapse (memory:load-error $profile $dimensions (superpose $rows)))
         (if (== $errors ())
           (if (or (== (get-state &memory-profile) Missing)
                   (== (get-state &memory-profile) (Profile $profile $dimensions)))
             (let $configured (change-state! &memory-profile (Profile $profile $dimensions))
               (let $reset (memory:invalidate)
                 (let $done (collapse (let $row (superpose $rows) (add-atom &memory-records $row)))
                   (Loaded (size-atom $done)))))
             (MemoryFailure load profile-mismatch))
           (car-atom $errors)))))
      ((load-matrix $profile $dimensions $ids $matrix) (memory:load-matrix $profile $dimensions $ids $matrix ()))
      ((load-matrix $profile $dimensions $ids $matrix $entries)
       (memory:load-matrix $profile $dimensions $ids $matrix $entries))
      ((load-matrix-file $profile $dimensions $path) (memory:load-matrix-file $profile $dimensions $path))
      ((export-matrix $path) (memory:export-matrix $path))
      ((get $ids)
       (case (get-state &memory-matrix)
         ((Missing (collapse (memory:brief (memory:record (superpose $ids)))))
          ($source (memory:matrix-get $source $ids)))))
      ((records $ids)
       (if (== (get-state &memory-matrix) Missing) (collapse (memory:record (superpose $ids)))
         (MemoryFailure records matrix-collection)))
      ((ids $filter)
       (case (get-state &memory-matrix)
         ((Missing (collapse (case (memory:matches $filter) (((Memory $id $rev $p $v $doc $meta) $id)))))
          ($source (memory:matrix-ids $source $filter)))))
      ((MemoryQuery $profile $query $k $filter)
       (case (get-state &memory-profile)
         (((Profile $profile $dimensions)
           (if (== (tensor:shape $query) ($dimensions))
             (memory:query-indexed $query $k $filter)
             (MemoryFailure query dimensions)))
          ($_ (MemoryFailure query profile-mismatch)))))
      ((query-reference $profile $query $k $filter)
       (if (== (get-state &memory-matrix) Missing) (memory:query $profile $query $k $filter)
         (MemoryFailure query-reference matrix-collection)))
      ((query-many $profile $queries $k $filter)
       (let $positions (list:range (size-atom $queries))
         (collapse (let $i (superpose $positions)
           (let* (($query (index-atom $queries $i))
                  ($found (memory:dispatch (MemoryQuery $profile $query $k $filter))))
             ($i $found))))))
      ((upsert $profile $dimensions $row)
       (case (memory:validate $profile $dimensions $row)
         ((Valid (case $row
           (((Memory $id $rev $p $v $doc $meta)
             (cons-atom (add $row) (collapse (remove (memory:record $id))))))))
          ($failure $failure))))
      ((insert $profile $dimensions $row)
       (case $row
         (((Memory $id $rev $p $v $doc $meta)
           (if (== (collapse (memory:record $id)) ())
             (memory:dispatch (upsert $profile $dimensions $row))
             (MemoryFailure $id exists))))))
      ((delete $ids) (collapse (remove (memory:record (superpose $ids)))))
      ((apply $operations)
       (if (not (== (get-state &memory-matrix) Missing)) (MemoryFailure apply matrix-read-only)
       (let $done (collapse (memory:apply (superpose $operations)))
         (let $updated (memory:touch-index $operations)
           (Applied (size-atom $done))))))
      ((patch $revision $id $metadata)
       (case (collapse (memory:record $id))
         ((() (MemoryFailure $id missing))
          (($row) (memory:update $revision $metadata $row))
          ($_ (MemoryFailure $id duplicate-id)))))
      ($unknown (memory:legacy-request $unknown)))))

; The legacy wire tag is data even if an embedding application defines its
; own query command. PeTTa prepares function-headed case patterns, so match
; the raw head here rather than evaluating that command as a pattern.
(= (memory:legacy-request $request)
   (if (== (get-metatype $request) Expression)
     (if (== (size-atom $request) 5)
       (let ($head $profile $vector $k $filter) $request
         (if (== $head query)
           (memory:dispatch (MemoryQuery $profile $vector $k $filter))
           (MemoryFailure request unsupported)))
       (MemoryFailure request unsupported))
     (MemoryFailure request unsupported)))
