; Corpus-guided finite templates over the existing scoped binding family.
; Depth bounds retained rigid constructors, not the source under a parameter.
; One partial capture environment is threaded through the whole rule forest.
!(import! &self "lib/petta/lib_ic_scoped_archive.metta")

(= (scoped-grammar:positions $values $index)
   (if (== $values ()) (superpose ()) (Scoped:Position $index (car-atom $values))))
(= (scoped-grammar:positions $values $index)
   (if (== $values ()) (superpose ())
     (scoped-grammar:positions (cdr-atom $values) (+ $index 1))))

; The dependency order is significant. Enumeration covers every distinct,
; correctly sorted bound-variable spine, including subsets and permutations.
(= (scoped-grammar:spines $bound $dependencies $used)
   (if (== $dependencies ()) (Scoped:Spine ())
     (case (scoped-grammar:positions $bound 0)
       (((Scoped:Position $index $sort)
         (if (and (== $sort (car-atom $dependencies))
                  (not (binary-schema:member? $index $used)))
           (let $selected (cons-atom $index $used)
             (case (scoped-grammar:spines $bound (cdr-atom $dependencies) $selected)
               (((Scoped:Spine $rest)
                 (let $arguments (cons-atom (scoped:variable $index) $rest)
                   (Scoped:Spine $arguments))))))
           (superpose ())))))))

; Literal bound variables keep their actual identity. Ordinary parameters may
; only capture closed terms, as established by the shared matcher.
(= (scoped-grammar:term $family $ordinary $bound $sort $depth $captures $source)
   (case $source
     (((Wire:Pair (Wire:Atom 0) (Wire:Atom $index))
       (if (scoped:variable? $bound $sort $index)
         (Scoped:Expansion $source $captures) (superpose ())))
      ($other (superpose ())))))
(= (scoped-grammar:term $family $ordinary $bound $sort $depth $captures $source)
   (case (scoped-grammar:positions $ordinary 0)
     (((Scoped:Position $index $actual)
       (if (== $actual $sort)
         (let $pattern (scoped:variable (+ (size-atom $bound) $index))
           (case (scoped:match-at $family $bound $captures $pattern $source)
             (((IC:Some $next) (Scoped:Expansion $pattern $next))
              ($other (superpose ())))))
         (superpose ()))))))
(= (scoped-grammar:term (Scoped:Family $sorts $operators $parameters) $ordinary $bound $sort $depth $captures $source)
   (case (scoped-grammar:positions $parameters 0)
     (((Scoped:Position $index (Scoped:Parameter $name $role $dependencies $actual))
       (if (== $actual $sort)
         (case (scoped-grammar:spines $bound $dependencies ())
           (((Scoped:Spine $arguments)
             (let* (($family (Scoped:Family $sorts $operators $parameters))
                    ($pattern (scoped:meta $index $arguments)))
               (case (scoped:match-at $family $bound $captures $pattern $source)
                 (((IC:Some $next) (Scoped:Expansion $pattern $next))
                  ($other (superpose ()))))))))
         (superpose ()))))))
(= (scoped-grammar:term $family $ordinary $bound $sort $depth $captures $source)
   (if (> $depth 0)
     (case $source
       (((Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Atom $index) $values))
         (case (scoped:operator $family $index)
           (((IC:Some (Scoped:Operator $name $actual $slots))
             (if (== $actual $sort)
               (case (scoped-grammar:arguments $family $ordinary $bound $slots (- $depth 1) $captures $values)
                 (((Scoped:Arguments $arguments $next)
                   (Scoped:Expansion
                     (Wire:Pair (Wire:Atom 1)
                       (Wire:Pair (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) $arguments)) $next))))
               (superpose ()))))))
        ($other (superpose ()))))
     (superpose ())))

(= (scoped-grammar:arguments $family $ordinary $bound $slots $depth $captures $sources)
   (if (== $slots ()) (Scoped:Arguments (Wire:Atom 0) $captures)
     (case (cons-atom (car-atom $slots) (cons-atom $sources ()))
       ((((Scoped:Slot $binders $sort) (Wire:Pair $head $tail))
         (let $opened (union-atom $binders $bound)
           (case (scoped-grammar:term $family $ordinary $opened $sort $depth $captures $head)
             (((Scoped:Expansion $pattern $middle)
               (case (scoped-grammar:arguments $family $ordinary $bound (cdr-atom $slots) $depth $middle $tail)
                 (((Scoped:Arguments $rest $next)
                   (Scoped:Arguments (Wire:Pair $pattern $rest) $next)))))))))))))

(= (scoped-grammar:forest $family $ordinary $roots $depth $captures $sources)
   (if (== $roots ()) (Scoped:Forest () $captures)
     (case (scoped-grammar:term $family $ordinary () (car-atom $roots) $depth $captures (car-atom $sources))
       (((Scoped:Expansion $pattern $middle)
         (case (scoped-grammar:forest $family $ordinary (cdr-atom $roots) $depth $middle (cdr-atom $sources))
           (((Scoped:Forest $rest $next)
             (let $patterns (cons-atom $pattern $rest) (Scoped:Forest $patterns $next))))))))))

(= (scoped-grammar:admitted? $family $ordinary $roots $sources $depth)
   (if (scoped:family? $family)
     (case $family
       (((Scoped:Family $sorts $operators $parameters)
         (if (and (binary:unsigned? $depth)
                  (and (scoped:known? $sorts $ordinary) (scoped:known? $sorts $roots)))
           (if (scoped:sequence? $sources)
             (let* (($arguments (scoped:args $sources)) ($slots (scoped:dependency-slots $roots)))
               (and (scoped:data? $arguments)
                    (scoped:valid-args $family () Base $slots $arguments))) False) False))))
     False))
(= (scoped-grammar:enumerate $family $ordinary $roots $sources $depth)
   (if (scoped-grammar:admitted? $family $ordinary $roots $sources $depth)
     (case (scoped-grammar:forest $family $ordinary $roots $depth (Scoped:Captures () ()) $sources)
       (((Scoped:Forest $patterns $captures) (Scoped:Template $patterns))))
     (Scoped:GrammarFault InvalidGrammar)))

; Equal guide forests produce the same region; skipping their later copies
; does not remove source occurrences from support counting or the archive.
; Different guides may still yield the same template. No unproved dominance
; or approximate/hash-key equivalence is used to suppress those proposals.
(= (scoped-grammar:guide $roots $packets $seen)
   (if (== $packets ()) (superpose ())
     (case (car-atom $packets)
       (((Scoped:Packet $origin $actual $sources)
         (if (and (== $roots $actual) (not (binary-schema:member? $sources $seen)))
           (Scoped:Guide $sources) (superpose ())))))))
(= (scoped-grammar:guide $roots $packets $seen)
   (if (== $packets ()) (superpose ())
     (case (car-atom $packets)
       (((Scoped:Packet $origin $actual $sources)
         (let $later (if (== $roots $actual) (cons-atom $sources $seen) $seen)
           (scoped-grammar:guide $roots (cdr-atom $packets) $later)))))))

(= (scoped-grammar:produce $archive (Scoped:Family $sorts $operators $parameters) $name $ordinary $roots $depth $packets)
   (case (scoped-grammar:guide $roots $packets ())
     (((Scoped:Guide $sources)
       (case (scoped-grammar:forest (Scoped:Family $sorts $operators $parameters)
               $ordinary $roots $depth (Scoped:Captures () ()) $sources)
         (((Scoped:Forest $patterns $captures)
           (IC:Proposal (Scoped:Factor $archive $name $ordinary $parameters $roots $patterns)))))))))

(= (ic:learn-scoped $original (IC:Grammar $family $name $ordinary $roots $depth) $quantum)
   (case (ic:scoped-unpack $original)
     (((IC:Some $archive)
       (case ($archive $family)
         ((((Scoped:Archive $version $sorts $operators $definitions $items)
            (Scoped:Family $known $declared $parameters))
           (if (and (== $sorts $known) (== $operators $declared))
             (if (and (binary-schema:text? $name)
                      (and (scoped:family? $family)
                        (and (scoped:known? $sorts $ordinary)
                          (and (scoped:known? $sorts $roots) (binary:unsigned? $depth)))))
               (case (scoped-archive:restore-items $sorts $operators $definitions $items)
                 (((IC:Some $packets)
                   (let* (($environment (context-space))
                          ($handle (work-new (scoped-grammar:produce $archive $family $name $ordinary $roots $depth $packets))))
                     (case (ic:prepare IC:ScopedArchive $original ($environment) $quantum ((IC:Branch 1 $handle)))
                       (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
                        ($other (let $released (work-cancel $handle) $other))))))
                  ($other (IC:SearchRefused InvalidScopedTask))))
               (IC:SearchRefused InvalidGrammar))
             (IC:SearchRefused DifferentSignature)))
          ($other (IC:SearchRefused InvalidGrammar)))))
      ($other (IC:SearchRefused InvalidScopedTask)))))
