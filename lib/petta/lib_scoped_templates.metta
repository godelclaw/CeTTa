; Finite declaration-driven projection of the shared Binding.Term/Args codec.
; Wire:Atom and Wire:Pair denote WireCodec.Data, not executable source terms.
; Base operators are table positions. Schema operators use the tagged sum of
; a base position and a contextual-parameter position. Nothing runs an operator.
!(import! &self (library lib_binary_schema))
!(import! &self (library lib_ic_templates))

(= (scoped:variable $index) (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)))
(= (scoped:args $values)
   (if (== $values ()) (Wire:Atom 0)
     (let ($head $tail) (decons-atom $values)
       (let $rest (scoped:args $tail) (Wire:Pair $head $rest)))))
(= (scoped:base $index $values)
   (let $arguments (scoped:args $values)
     (Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Atom $index) $arguments))))
(= (scoped:rigid $index $values)
   (let $arguments (scoped:args $values)
     (Wire:Pair (Wire:Atom 1)
       (Wire:Pair (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) $arguments))))
(= (scoped:meta $index $values)
   (let $arguments (scoped:args $values)
     (Wire:Pair (Wire:Atom 1)
       (Wire:Pair (Wire:Pair (Wire:Atom 1) (Wire:Atom $index)) $arguments))))

(= (scoped:sequence? $value) (== (get-metatype $value) Expression))
(= (scoped:label? $value)
   (or (== (get-metatype $value) Symbol) (binary-schema:text? $value)))
(= (scoped:sorts? $sorts)
   (if (scoped:sequence? $sorts)
     (if (== $sorts ()) True
       (and (scoped:label? (car-atom $sorts)) (scoped:sorts? (cdr-atom $sorts)))) False))
(= (scoped:known? $sorts $wanted)
   (if (scoped:sequence? $wanted)
     (if (== $wanted ()) True
       (and (binary-schema:member? (car-atom $wanted) $sorts)
            (scoped:known? $sorts (cdr-atom $wanted)))) False))
(= (scoped:slots? $sorts $slots)
   (if (scoped:sequence? $slots)
     (if (== $slots ()) True
       (case (car-atom $slots)
         (((Scoped:Slot $binders $sort)
           (and (scoped:known? $sorts $binders)
             (and (binary-schema:member? $sort $sorts) (scoped:slots? $sorts (cdr-atom $slots)))))
          ($other False)))) False))
(= (scoped:operators? $sorts $operators)
   (if (scoped:sequence? $operators)
     (if (== $operators ()) True
       (case (car-atom $operators)
         (((Scoped:Operator $name $sort $slots)
           (and (binary-schema:text? $name)
             (and (binary-schema:member? $sort $sorts)
               (and (scoped:slots? $sorts $slots) (scoped:operators? $sorts (cdr-atom $operators))))))
          ($other False)))) False))
(= (scoped:parameters? $sorts $parameters)
   (if (scoped:sequence? $parameters)
     (if (== $parameters ()) True
       (case (car-atom $parameters)
         (((Scoped:Parameter $name $role $dependencies $sort)
           (and (binary-schema:text? $name)
             (and (ic-template:role? $role)
               (and (scoped:known? $sorts $dependencies)
                 (and (binary-schema:member? $sort $sorts)
                      (scoped:parameters? $sorts (cdr-atom $parameters)))))))
          ($other False)))) False))
(= (scoped:family? $family)
   (case $family
     (((Scoped:Family $sorts $operators $parameters)
       (and (scoped:sorts? $sorts)
         (and (scoped:operators? $sorts $operators) (scoped:parameters? $sorts $parameters))))
      ($other False))))
(= (scoped:at $values $index)
   (if (binary:unsigned? $index) (ic-template:operator $values $index) IC:None))
(= (scoped:operator (Scoped:Family $sorts $operators $parameters) $index) (scoped:at $operators $index))
(= (scoped:parameter (Scoped:Family $sorts $operators $parameters) $index) (scoped:at $parameters $index))
(= (scoped:variable? $context $sort $index)
   (case (scoped:at $context $index)
     (((IC:Some $actual) (== $actual $sort)) ($other False))))
(= (scoped:dependency-slots $dependencies)
   (map-atom $dependencies $sort (Scoped:Slot () $sort)))

; Wire naturals include constructor markers and list terminators, not only
; variable/operator indices. Numeric matching must not admit floating markers.
(= (scoped:data? $wire)
   (case $wire
     (((Wire:Atom $natural) (binary:unsigned? $natural))
      ((Wire:Pair $first $second) (and (scoped:data? $first) (scoped:data? $second)))
      ($other False))))
(= (scoped:valid? $family $context $sort $profile $wire)
   (if (scoped:data? $wire) (scoped:valid $family $context $sort $profile $wire) False))

; The same signature fields govern validation, matching, transport and expansion.
(= (scoped:valid $family $context $sort $profile $wire)
   (case $wire
     (((Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) (scoped:variable? $context $sort $index))
      ((Wire:Pair (Wire:Atom 1) (Wire:Pair $operator $arguments))
       (case (scoped:resolve $family $profile $operator)
         (((IC:Some (Scoped:Resolved $actual $slots))
           (and (== $actual $sort) (scoped:valid-args $family $context $profile $slots $arguments)))
          ($other False))))
      ($other False))))
(= (scoped:resolve $family Base (Wire:Atom $index))
   (case (scoped:operator $family $index)
     (((IC:Some (Scoped:Operator $name $sort $slots)) (IC:Some (Scoped:Resolved $sort $slots)))
      ($other IC:None))))
(= (scoped:resolve $family Schema $operator)
   (case $operator
     (((Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) (scoped:resolve $family Base (Wire:Atom $index)))
      ((Wire:Pair (Wire:Atom 1) (Wire:Atom $index))
       (case (scoped:parameter $family $index)
         (((IC:Some (Scoped:Parameter $name $role $dependencies $sort))
           (let $slots (scoped:dependency-slots $dependencies) (IC:Some (Scoped:Resolved $sort $slots))))
          ($other IC:None))))
      ($other IC:None))))
(= (scoped:valid-args $family $context $profile $slots $arguments)
   (if (== $slots ()) (== $arguments (Wire:Atom 0))
     (case (cons-atom (car-atom $slots) (cons-atom $arguments ()))
       ((((Scoped:Slot $binders $sort) (Wire:Pair $head $tail))
         (let $opened (union-atom $binders $context)
           (and (scoped:valid $family $opened $sort $profile $head)
                (scoped:valid-args $family $context $profile (cdr-atom $slots) $tail))))
        ($other False)))))

; A checked partial variable renaming. New binders introduced within a body
; are fixed; only variables outside that local prefix consult the map.
(= (scoped:map-index $mapping $index)
   (if (== $mapping ()) IC:None
     (let* ((($from $to) (car-atom $mapping)) ($rest (cdr-atom $mapping)))
       (if (== $from $index) (IC:Some $to) (scoped:map-index $rest $index)))))
(= (scoped:transport $family $mapping $local-depth $wire)
   (case $wire
     (((Wire:Pair (Wire:Atom 0) (Wire:Atom $index))
       (if (< $index $local-depth) (IC:Some $wire)
         (case (scoped:map-index $mapping (- $index $local-depth))
           (((IC:Some $image)
             (let $next (+ $local-depth $image)
               (if (binary:unsigned? $next) (IC:Some (scoped:variable $next)) IC:None)))
            ($other IC:None)))))
      ((Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Atom $index) $arguments))
       (case (scoped:operator $family $index)
         (((IC:Some (Scoped:Operator $name $sort $slots))
           (case (scoped:transport-args $family $mapping $local-depth $slots $arguments)
             (((IC:Some $values) (IC:Some (Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Atom $index) $values))))
              ($other IC:None))))
          ($other IC:None))))
      ($other IC:None))))
(= (scoped:transport-args $family $mapping $depth $slots $arguments)
   (if (== $slots ()) (if (== $arguments (Wire:Atom 0)) (IC:Some (Wire:Atom 0)) IC:None)
     (case (cons-atom (car-atom $slots) (cons-atom $arguments ()))
       ((((Scoped:Slot $binders $sort) (Wire:Pair $head $tail))
         (let $opened (+ $depth (size-atom $binders))
           (if (binary:unsigned? $opened)
             (case (cons-atom (scoped:transport $family $mapping $opened $head)
                    (cons-atom (scoped:transport-args $family $mapping $depth (cdr-atom $slots) $tail) ()))
               ((((IC:Some $value) (IC:Some $rest)) (IC:Some (Wire:Pair $value $rest)))
                ($other IC:None))) IC:None)))
        ($other IC:None)))))

; Recognize actual, distinct bound-variable arguments, in their supplied order.
(= (scoped:spine $bound $arguments $seen)
   (case $arguments
     (((Wire:Atom 0) (IC:Some ()))
      ((Wire:Pair (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) $tail)
       (if (and (binary:unsigned? $index)
                (and (< $index (size-atom $bound)) (not (binary-schema:member? $index $seen))))
         (let $next (cons-atom $index $seen)
           (case (scoped:spine $bound $tail $next)
             (((IC:Some $rest) (let $values (cons-atom $index $rest) (IC:Some $values)))
              ($other IC:None)))) IC:None))
      ($other IC:None))))
(= (scoped:spine-map $spine $position $direction)
   (if (== $spine ()) ()
     (let* (($index (car-atom $spine))
            ($entry (if (== $direction Recover)
                      (cons-atom $index (cons-atom $position ()))
                      (cons-atom $position (cons-atom $index ()))))
            ($rest (scoped:spine-map (cdr-atom $spine) (+ $position 1) $direction)))
       (cons-atom $entry $rest))))

(= (scoped:match-at $family $bound $captures $pattern $source)
   (case (cons-atom $captures (cons-atom $pattern ()))
     ((((Scoped:Captures $variables $metas) (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)))
       (if (< $index (size-atom $bound))
         (if (== $pattern $source) (IC:Some $captures) IC:None)
         (case (scoped:transport $family () 0 $source)
           (((IC:Some $closed)
             (case (ic-template:assign $variables Root (- $index (size-atom $bound)) $closed)
               (((IC:Some $next) (IC:Some (Scoped:Captures $next $metas))) ($other IC:None))))
            ($other IC:None)))))
      (((Scoped:Captures $variables $metas)
        (Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Pair (Wire:Atom 1) (Wire:Atom $index)) $arguments)))
       (case (cons-atom (scoped:parameter $family $index)
               (cons-atom (scoped:spine $bound $arguments ()) ()))
         ((((IC:Some (Scoped:Parameter $name $role $dependencies $sort)) (IC:Some $spine))
           (let $mapping (scoped:spine-map $spine 0 Recover)
             (case (scoped:transport $family $mapping 0 $source)
               (((IC:Some $body)
                 (case (ic-template:assign $metas $role $index $body)
                   (((IC:Some $next) (IC:Some (Scoped:Captures $variables $next))) ($other IC:None))))
                ($other IC:None)))))
          ($other IC:None))))
      (($saved (Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) $arguments)))
       (case $source
         (((Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Atom $actual) $values))
           (if (== $index $actual)
             (case (scoped:operator $family $index)
               (((IC:Some (Scoped:Operator $name $sort $slots))
                 (scoped:match-args $family $bound $captures $slots $arguments $values))
                ($other IC:None))) IC:None))
          ($other IC:None))))
      ($other IC:None))))
(= (scoped:match-args $family $bound $captures $slots $patterns $sources)
   (if (== $slots ())
     (if (and (== $patterns (Wire:Atom 0)) (== $sources (Wire:Atom 0))) (IC:Some $captures) IC:None)
     (case (cons-atom (car-atom $slots) (cons-atom $patterns (cons-atom $sources ())))
       ((((Scoped:Slot $binders $sort) (Wire:Pair $head $tail) (Wire:Pair $value $rest))
         (let $opened (union-atom $binders $bound)
           (case (scoped:match-at $family $opened $captures $head $value)
             (((IC:Some $next) (scoped:match-args $family $bound $next (cdr-atom $slots) $tail $rest))
              ($other IC:None)))))
        ($other IC:None)))))

(= (scoped:expand-at $family $bound (Scoped:Captures $variables $metas) $pattern)
   (case $pattern
     (((Wire:Pair (Wire:Atom 0) (Wire:Atom $index))
       (if (< $index (size-atom $bound)) (IC:Some $pattern)
         (ic-template:lookup $variables Root (- $index (size-atom $bound)))))
      ((Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Pair (Wire:Atom 1) (Wire:Atom $index)) $arguments))
       (case ((scoped:parameter $family $index) (scoped:spine $bound $arguments ()))
         ((((IC:Some (Scoped:Parameter $name $role $dependencies $sort)) (IC:Some $spine))
           (case (ic-template:lookup $metas $role $index)
             (((IC:Some $body)
               (scoped:transport $family (scoped:spine-map $spine 0 Apply) 0 $body))
              ($other IC:None))))
          ($other IC:None))))
      ((Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Pair (Wire:Atom 0) (Wire:Atom $index)) $arguments))
       (case (scoped:operator $family $index)
         (((IC:Some (Scoped:Operator $name $sort $slots))
           (case (scoped:expand-args $family $bound (Scoped:Captures $variables $metas) $slots $arguments)
             (((IC:Some $values) (IC:Some (Wire:Pair (Wire:Atom 1) (Wire:Pair (Wire:Atom $index) $values))))
              ($other IC:None))))
          ($other IC:None))))
      ($other IC:None))))
(= (scoped:expand-args $family $bound $captures $slots $arguments)
   (if (== $slots ()) (if (== $arguments (Wire:Atom 0)) (IC:Some (Wire:Atom 0)) IC:None)
     (case (cons-atom (car-atom $slots) (cons-atom $arguments ()))
       ((((Scoped:Slot $binders $sort) (Wire:Pair $head $tail))
         (let $opened (union-atom $binders $bound)
           (case (cons-atom (scoped:expand-at $family $opened $captures $head)
                  (cons-atom (scoped:expand-args $family $bound $captures (cdr-atom $slots) $tail) ()))
             ((((IC:Some $value) (IC:Some $rest)) (IC:Some (Wire:Pair $value $rest)))
              ($other IC:None)))))
        ($other IC:None)))))

(= (scoped:captures? $family $ordinary $namespace $entries $seen)
   (if (scoped:sequence? $entries)
     (if (== $entries ()) True
       (case (car-atom $entries)
         (((IC:Binding $role $index $body)
           (if (and (binary:unsigned? $index) (not (binary-schema:member? $index $seen)))
             (let $expected
               (if (== $namespace Ordinary)
                 (case (scoped:at $ordinary $index)
                   (((IC:Some $sort) (IC:Some (Scoped:Parameter "" Root () $sort))) ($other IC:None)))
                 (scoped:parameter $family $index))
               (case $expected
                 (((IC:Some (Scoped:Parameter $name $actual $dependencies $sort))
                   (and (== $actual $role)
                     (and (scoped:valid? $family $dependencies $sort Base $body)
                       (let $next (cons-atom $index $seen)
                         (scoped:captures? $family $ordinary $namespace (cdr-atom $entries) $next)))))
                  ($other False)))) False))
          ($other False)))) False))

(= (scoped:match $family $ordinary $sort $pattern $source)
   (if (scoped:family? $family)
     (case $family
       (((Scoped:Family $sorts $operators $parameters)
         (if (and (scoped:known? $sorts $ordinary) (binary-schema:member? $sort $sorts))
           (if (scoped:valid? $family $ordinary $sort Schema $pattern)
             (if (scoped:valid? $family () $sort Base $source)
               (scoped:match-at $family () (Scoped:Captures () ()) $pattern $source)
               (IC:Invalid Source)) (IC:Invalid Template))
           (IC:Invalid Context)))))
     (IC:Invalid Signature)))
(= (scoped:expand $family $ordinary $sort $captures $pattern)
   (if (scoped:family? $family)
     (case ($family $captures)
       ((((Scoped:Family $sorts $operators $parameters) (Scoped:Captures $variables $metas))
         (if (and (scoped:known? $sorts $ordinary) (binary-schema:member? $sort $sorts))
           (if (scoped:valid? $family $ordinary $sort Schema $pattern)
             (if (and (scoped:captures? $family $ordinary Ordinary $variables ())
                      (scoped:captures? $family $ordinary Meta $metas ()))
               (scoped:expand-at $family () $captures $pattern) (IC:Invalid Captures))
             (IC:Invalid Template)) (IC:Invalid Context)))
        ($other (IC:Invalid Captures))))
     (IC:Invalid Signature)))

; Rule components share one accumulator. Matching the left and right sides
; independently would discard the equality obligations between their holes.
(= (scoped:match-many $family $ordinary $sorts $patterns $sources)
   (if (scoped:family? $family)
     (case $family
       (((Scoped:Family $known $operators $parameters)
         (if (and (scoped:known? $known $ordinary) (scoped:known? $known $sorts))
           (let $slots (scoped:dependency-slots $sorts)
             (if (scoped:sequence? $patterns)
               (let $p (scoped:args $patterns)
                 (if (and (scoped:data? $p) (scoped:valid-args $family $ordinary Schema $slots $p))
                   (if (scoped:sequence? $sources)
                     (let $s (scoped:args $sources)
                       (if (and (scoped:data? $s) (scoped:valid-args $family () Base $slots $s))
                         (scoped:match-args $family () (Scoped:Captures () ()) $slots $p $s)
                         (IC:Invalid Source))) (IC:Invalid Source))
                   (IC:Invalid Template))) (IC:Invalid Template)))
           (IC:Invalid Context)))))
     (IC:Invalid Signature)))

(= (scoped:unargs $arguments)
   (case $arguments
     (((Wire:Atom 0) ())
      ((Wire:Pair $head $tail) (let $rest (scoped:unargs $tail) (cons-atom $head $rest))))))

(= (scoped:expand-many $family $ordinary $sorts $captures $patterns)
   (if (scoped:family? $family)
     (case ($family $captures)
       ((((Scoped:Family $known $operators $parameters) (Scoped:Captures $variables $metas))
         (if (and (scoped:known? $known $ordinary) (scoped:known? $known $sorts))
           (if (scoped:sequence? $patterns)
             (let* (($slots (scoped:dependency-slots $sorts)) ($p (scoped:args $patterns)))
               (if (and (scoped:data? $p) (scoped:valid-args $family $ordinary Schema $slots $p))
                 (if (and (scoped:captures? $family $ordinary Ordinary $variables ())
                          (scoped:captures? $family $ordinary Meta $metas ()))
                   (case (scoped:expand-args $family () $captures $slots $p)
                     (((IC:Some $values) (let $out (scoped:unargs $values) (IC:Some $out))) ($other $other)))
                   (IC:Invalid Captures))
                 (IC:Invalid Template))) (IC:Invalid Template))
           (IC:Invalid Context)))
        ($other (IC:Invalid Captures))))
     (IC:Invalid Signature)))
