!(import! &self langdef)

(: __cetta_lib_re (-> Atom Atom Atom))
(: re:compile-value (-> Atom Atom))
(: re:compile (-> %Undefined% %Undefined%))
(: re:compile-with (-> %Undefined% Atom Atom))
(: re:prepare (-> Atom %Undefined%))
(: re-internal:prepared (-> %Undefined% %Undefined%))
(: re:find (-> %Undefined% %Undefined% Atom))
(: re:captures (-> %Undefined% %Undefined% Atom))
(: re:full-match (-> %Undefined% %Undefined% Atom))
(: re:is-match (-> %Undefined% %Undefined% Atom))
(: re:find-all (-> %Undefined% %Undefined% Atom))
(: re:split (-> %Undefined% %Undefined% Atom))
(: re:replace-literal (-> %Undefined% %Undefined% %Undefined% Atom))
(: re:replace-template (-> %Undefined% %Undefined% Atom Atom))
(: re:find-bounded (-> %Undefined% %Undefined% %Undefined% Atom))
(: re:store (-> %Undefined% Atom))
(: re:restore (-> %Undefined% Atom))
(: re:close (-> %Undefined% Atom))
(: re:relation-open (-> %Undefined% %Undefined% Atom))
(: re:relation-open-at (-> %Undefined% %Undefined% Atom %Undefined% Atom))
(: re:relation-next (-> %Undefined% Atom))
(: re:relation-next-bounded (-> %Undefined% %Undefined% Atom))
(: re:relation-progress (-> %Undefined% Atom))
(: re:relation-close (-> %Undefined% Atom))
(: re:group-span (-> %Undefined% Atom Atom))
(: re:group-text (-> %Undefined% %Undefined% Atom Atom))
(: re:match-relation (-> %Undefined% %Undefined% %Undefined%))
(: re:symbol-query (-> %Undefined% Atom))
(: re:symbol-query-with (-> %Undefined% Atom Atom))

; Constructed definitions stay inert; compute their fields explicitly first.
(= (re:compile-value $pattern)
   (function (chain (eval (__cetta_lib_re compile-value ($pattern))) $value (return $value))))

; The source grammar is a baked module-derived parser. Reading a new pattern
; never reconstructs that grammar or its recognizer tables.
(= (re:compile $text)
   (re:compile-with $text (re:lookbehind-policy Forward)))
; Definitions remain ordinary re-readable data. Lexical preparation, the baked
; reader, lowering and the authored compiler run as one native composition;
; a parse that is not a single selected tree is read again with its packed
; forest as evidence. Programs are shared by semantic pattern and capture
; layout, and an equal description borrows a preparation that is still live.
(= (re:prepare $definition)
   (case $definition
     (((re:pattern $text) (re:compile $text))
      ((re:pattern $text $policy) (re:compile-with $text $policy))
      ($other (re:failed re:invalid-definition $other)))))
(= (re-internal:prepared $value)
   (case $value
     (((re:pattern $text) (re:prepare (re:pattern $text)))
      ((re:pattern $text $policy) (re:prepare (re:pattern $text $policy)))
      ($already $already))))
(= (re:compile-with $text $policy)
   (function (chain (eval (__cetta_lib_re compile-text ($text $policy))) $value (return $value))))

(= (re:find $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re find ($prepared $text))) $value (return $value)))))
(= (re:captures $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re captures ($prepared $text))) $value (return $value)))))
(= (re:full-match $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re full-match ($prepared $text))) $value (return $value)))))
(= (re:is-match $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re is-match ($prepared $text))) $value (return $value)))))
(= (re:find-all $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re find-all ($prepared $text))) $value (return $value)))))
(= (re:split $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re split ($prepared $text))) $value (return $value)))))
(= (re:replace-literal $pattern $text $replacement)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re replace-literal ($prepared $text $replacement))) $value (return $value)))))
(= (re:replace-template $pattern $text $parts)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re replace-template ($prepared $text $parts))) $value (return $value)))))
(= (re:find-bounded $pattern $text $work)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re find-bounded ($prepared $text $work))) $value (return $value)))))
(= (re:store $pattern)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re store ($prepared))) $value (return $value)))))
(= (re:restore $bytes)
   (function (chain (eval (__cetta_lib_re restore ($bytes))) $value (return $value))))
(= (re:close $pattern)
   (function (chain (eval (__cetta_lib_re close ($pattern))) $value (return $value))))

; Query the interner's finite text-name snapshot, not an Atomspace's facts.
; Results retain interning order. The metadata counts the captured table and
; opaque non-UTF-8 names, which are not silently treated as nonmatches.
(= (re:symbol-query $pattern)
   (re:symbol-query-with $pattern Search))
(= (re:symbol-query-with $pattern $mode)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re symbol-query ($prepared $mode))) $value (return $value)))))

; Tokens identify immutable positions in a retained occurrence stream.
; Re-reading one token repeats its value, not the producer's effects.
(= (re:relation-open $pattern $text)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re relation-open ($prepared $text))) $value (return $value)))))
(= (re:relation-open-at $pattern $text $mode $start)
   (function (let $prepared (re-internal:prepared $pattern)
     (chain (eval (__cetta_lib_re relation-open ($prepared $text $mode $start))) $value (return $value)))))
(= (re:relation-next $token)
   (function (chain (eval (__cetta_lib_re relation-next ($token))) $value (return $value))))
(= (re:relation-next-bounded $token $work)
   (function (chain (eval (__cetta_lib_re relation-next ($token $work))) $value (return $value))))
(= (re:relation-progress $token)
   (function (chain (eval (__cetta_lib_re relation-progress ($token))) $value (return $value))))
(= (re:relation-close $token)
   (function (chain (eval (__cetta_lib_re relation-close ($token))) $value (return $value))))
(= (re:group-span $match $group)
   (function (chain (eval (__cetta_lib_re group-span ($match $group))) $value (return $value))))
(= (re:group-text $match $text $group)
   (function (chain (eval (__cetta_lib_re group-text ($match $text $group))) $value (return $value))))

; This relation retains overlapping and equal-output path occurrences.
; Ordered nonoverlapping iteration remains the separate re:find-all operation.
(= (re:match-relation $pattern $text)
   (let $token (re:relation-open $pattern $text)
     (re-internal:relation-answers $token)))
(= (re-internal:relation-answers $token)
   (case (re:relation-next $token)
     (((re:relation-yield $answer $next)
       (superpose ($answer (re-internal:relation-answers $next))))
      (re:relation-complete (empty))
      ($other $other))))
