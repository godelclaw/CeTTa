!(import! &self "../lib/lib_module.metta")

!(let*
  (($reader (langdef:load-baked-parser "module-core-reader"))
   ($recipes (module:read-file $reader "arithmetic" "tests/module_values/RewriteBundles.module"))
   ($notes-module (module:read-file $reader "notes" "tests/module_values/SourceNotes.module"))
   ($hints-module (module:read-file $reader "hints" "tests/module_values/SearchHints.module"))
   ($reader-closed (langdef:close-parser $reader))
   ($naturals (module:assemble $recipes "Naturals" LNil LNil OriginViewV1 "example:naturals"))
   ($arithmetic (module:assemble $recipes "Arithmetic" (LCons $naturals LNil)
                  LNil OriginViewV1 "example:arithmetic"))
   ($language (module:language $arithmetic "Example" "Nat" (SyntaxLexicalPolicyV1 bnfc-documented)))
   ($core (module:language-core $language))
   ($syntax (module:language-syntax $language))
   ($notes (module:assemble $notes-module "Notes" LNil LNil OriginViewV1 "example:notes"))
   ($note-schema (module:core $notes "NoteSchema"))
   ($hints (module:assemble $hints-module "Hints" LNil LNil OriginViewV1 "example:hints"))
   ($hint-schema (module:core $hints "HintSchema"))
   ($with-notes (module:attach-layer $core (SyntaxOriginV1 "notes" "source")
                  $note-schema "Note" (LCons (SourceNote) LNil)))
   ($with-hints (module:attach-layer $core (SyntaxOriginV1 "hints" "search")
                  $hint-schema "Hint" (LCons (SearchDepth) LNil)))
   ($extended (module:join-layers $with-notes $with-hints))
   ($unchanged-core (module:base-core $extended))
   ($parser (langdef:compile-parser $syntax auto))
   ($authority (langdef:load-language-value $unchanged-core))
   ($parsed (langdef:parser-parse-text $parser "add(z,s(z))"))
   ($projected (langdef:project-parser-result $authority "Nat" $parsed))
   ($term (langdef:projected-term $projected 0))
   ($admitted (langdef:admit-term-data $authority "Nat" $term))
   ($step (langdef:rewrite-term-at-data $authority "Nat" "Nat" 8 100000 (LangDef:RelationRows) $term))
   ($rules (module:rewrite-rules $arithmetic "Example"))
   ($parser-closed (langdef:close-parser $parser))
   ($authority-closed (langdef:close-language $authority)))
  (function (return (ModuleWorkflowExampleV1 $extended $term $admitted $step $rules))))
