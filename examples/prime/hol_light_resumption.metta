; Resume the authored HOL Light receiver with native lexical bindings.
(scope:profile lexical-fresh per-call reference)
!(import! &self ../../lib/prime/hol_light/data.metta)
!(import! &self ../../lib/prime/hol_light/syntax.metta)
!(import! &self ../../lib/prime/hol_light/kernel.metta)
!(import! &self ../../lib/prime/hol_light/definitions.metta)
!(import! &self ../../lib/prime/hol_light/derived.metta)
!(import! &self ../../lib/prime/hol_light/profile.metta)
!(import! &self ../../lib/prime/hol_light/receive.metta)
!(import! &self ../../lib/prime/hol_light/resumption.metta)
(= (resume:inputs) (function (return (HOL:Cons (HOL:CheckedReuse (HOL:Source 0) (DEFINITION "T" (Tyapp "bool" HOL:Nil) (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil))))) "standard-definition:T" HOL:Nil (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Const "T" (Tyapp "bool" HOL:Nil))) (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))))) (HOL:Cons (HOL:CheckedStep (HOL:Source 1) (REFL (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) HOL:Nil (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil))))) HOL:Nil)))))
!(let $events (resume:inputs) (let* (($work (hol-light:work $events)) ($prefix (hol-light:resume 1 $work)) ($finished (hol-light:resume 1 $prefix)) ($whole (hol-light:resume 2 $work))) (ProofResumption (== $finished $whole) (== (hol-light:work-rest $prefix) (HOL:Cons (HOL:CheckedStep (HOL:Source 1) (REFL (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) HOL:Nil (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil))))) HOL:Nil)) (hol-light:work-consumed $prefix) (hol-light:work-consumed $finished) (hol-light:accepted (hol-light:work-result $finished)) (hol-light:receipt-count (hol-light:work-result $finished)))))
!(let $events (resume:inputs) (let* (($work (hol-light:work $events)) ($prefix (hol-light:resume 1 $work))) (IncompletePreserved (== (hol-light:resume 0 $prefix) $prefix) (== (hol-light:work-result $prefix) (hol-light:work-result $work)))))
!(hol-light:resume -1 (HOL:Work None HOL:Nil 0))
!(let $work (HOL:Work None (HOL:Cons (HOL:CheckedReuse (HOL:Source 0) (DEFINITION "T" (Tyapp "bool" HOL:Nil) (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil))))) "standard-definition:T" HOL:Nil (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Const "T" (Tyapp "bool" HOL:Nil))) (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))))) (HOL:Cons (HOL:CheckedStep (HOL:Source 1) (REFL (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) HOL:Nil (Comb (Comb (Const "=" (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "fun" (HOL:Cons (Tyapp "bool" HOL:Nil) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) (HOL:Cons (Tyapp "bool" HOL:Nil) HOL:Nil))) HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil)))) (Abs (Var "p" (Tyapp "bool" HOL:Nil)) (Var "p" (Tyapp "bool" HOL:Nil))))) HOL:Nil)) 0) (let $finished (hol-light:resume 2 $work) (StickyWork (hol-light:work-result $finished) (hol-light:work-rest $finished) (hol-light:work-consumed $finished))))
