!(import! &self "../lib/lib_module.metta")

!(let*
  (($reader (langdef:load-baked-parser "module-core-reader"))
   ($base (module:read-file $reader "base" "tests/module_values/RewriteBundles.module"))
   ($rules-module (module:read-file $reader "rules" "tests/module_values/DerivedSubstitution.module"))
   ($tuple-module (module:read-file $reader "tuples" "tests/module_values/DerivedTuples.module"))
   ($reader-closed (langdef:close-parser $reader))
   ($naturals (module:assemble $base "Naturals" LNil LNil OriginViewV1 "example:naturals"))
   ($rules (module:assemble $rules-module "NamedZero" (LCons $naturals LNil)
              (LCons (ModuleCatalogEntryV1 "RewriteBundles" $base) LNil) OriginViewV1 "example:rules"))
   ($composed (module:assemble $tuple-module "TupleSyntax" (LCons $rules LNil)
                 (LCons (ModuleCatalogEntryV1 "RewriteBundles" $base) LNil) OriginViewV1 "example:tuples"))
   ($core (module:core $composed "Example"))
   ($tuple-language (module:language $composed "Example" "Wrapped" (SyntaxLexicalPolicyV1 bnfc-documented)))
   ($nat-language (module:language $composed "Example" "Nat" (SyntaxLexicalPolicyV1 bnfc-documented)))
   ($tuple-syntax (module:language-syntax $tuple-language))
   ($nat-syntax (module:language-syntax $nat-language))
   ($tuple-parser (langdef:compile-parser $tuple-syntax general))
   ($nat-parser (langdef:compile-parser $nat-syntax auto))
   ($authority (langdef:load-language-value $core))
   ($tuple-result (langdef:parser-parse-text $tuple-parser "wrap(z,s(z))"))
   ($tuple-projection (langdef:project-parser-result $authority "Wrapped" $tuple-result))
   ($tuple-term (langdef:projected-term $tuple-projection 0))
   ($tuple-admitted (langdef:admit-term-data $authority "Wrapped" $tuple-term))
   ($nat-result (langdef:parser-parse-text $nat-parser "add(z,s(z))"))
   ($nat-again (langdef:parser-parse-text $nat-parser "add(z,s(z))"))
   ($nat-projection (langdef:project-parser-result $authority "Nat" $nat-result))
   ($nat-term (langdef:projected-term $nat-projection 0))
   ($nat-admitted (langdef:admit-term-data $authority "Nat" $nat-term))
   ($step (langdef:rewrite-term-at-data $authority "Nat" "Nat" 8 100000 (LangDef:RelationRows) $nat-term))
   ($rule-view (module:rewrite-rules $composed "Example"))
   ($tuple-closed (langdef:close-parser $tuple-parser))
   ($nat-closed (langdef:close-parser $nat-parser))
   ($authority-closed (langdef:close-language $authority)))
  (function (return (ModuleDerivedExampleV1 $core $tuple-term $tuple-admitted
                      $nat-term $nat-admitted $step $rule-view $nat-result $nat-again))))
