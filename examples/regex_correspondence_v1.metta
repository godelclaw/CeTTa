!(import! &self re)

!(let* (($pattern (re:compile "a|ab"))
        ($search (re:find $pattern "ab"))
        ($whole (re:full-match $pattern "ab"))
        ($absent (re:full-match $pattern "ac"))
        ($closed (re:close $pattern)))
   (function (return (RegexPriorityConnectionV1 $search $whole $absent))))

!(let* (($optional (re:compile "(a)?b"))
        ($empty (re:compile "(a*)b"))
        ($discarded (re:compile "(?:(a)c|b)"))
        ($unmatched (re:captures $optional "b"))
        ($participating (re:captures $empty "b"))
        ($isolated (re:captures $discarded "b"))
        ($closed-optional (re:close $optional))
        ($closed-empty (re:close $empty))
        ($closed-discarded (re:close $discarded)))
   (function (return (RegexCaptureConnectionV1 $unmatched $participating $isolated))))

!(let* (($counted (re:compile "(a|){1,}"))
        ($plus (re:compile "(a|)+"))
        ($same (== (re:store $counted) (re:store $plus)))
        ($selected (re:full-match $counted "a"))
        ($absent (re:full-match $counted "b"))
        ($closed-counted (re:close $counted))
        ($closed-plus (re:close $plus)))
   (function (return (RegexRepetitionConnectionV1 $same $selected $absent))))

!(let* (($text (re:compile "(λ)"))
        ($value (re:compile-value (re:capture 1 (re:literal 955))))
        ($from-text (re:captures $text "aλb"))
        ($from-value (re:captures $value "aλb"))
        ($malformed (re:compile "(a"))
        ($closed-text (re:close $text))
        ($closed-value (re:close $value)))
   (function (return (RegexSourceConnectionV1 $from-text $from-value $malformed))))

!(let* (($pattern (re:compile "a+"))
        ($found (re:find $pattern "aaa"))
        ($absent (re:find $pattern "bbb"))
        ($pending (re:find-bounded $pattern "aaa" 1))
        ($closed (re:close $pattern)))
   (function (return (RegexOutcomeConnectionV1 $found $absent $pending))))
