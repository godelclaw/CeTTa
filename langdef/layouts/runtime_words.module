-- Runtime word representations; generated headers compile as ordinary C.
Module CeTTaRuntimeWords {
  Theory Frames() {
    Empty Equations {
      -- A frame identity: a handle and the generation it was issued at.  The
      -- top two bits are zero in every identity; a binding's context word
      -- (below) keeps its value kind there.
      (FrameIdentity) == (Layout "cesta-layout/1"
        (Word 64)
        (Constants
          (Const HandleLast (Minus (Pow2 32) 1))
          (Const GenerationLast (Minus (Pow2 30) 1)))
        (Fields (Field handle "value") (Field generation "value"))
        (Case (Prefix 2 0)
          (Place handle (Bits 0 32) (Range 1 HandleLast))
          (Place generation (Bits 32 30) (Range 1 GenerationLast)))
        (Reserved (Prefix 2 1)
          (Place handle (Bits 0 32) (Offset (Pow2 32)))
          (Place generation (Bits 32 30)))
        (Reserved (Prefix 1 1)
          (Place handle (Bits 0 32) (Offset (Pow2 33)))
          (Place generation (Bits 32 31)))
        (Location "immutable"));
      -- A binding value's context: the frame identity of its lexical
      -- environment (zero when it has none) and the value's kind, in one
      -- word, so a binding value is two words.
      (BindingContext) == (Layout "cesta-layout/1"
        (Word 64)
        (Fields (Field frame "value") (Field kind "value"))
        (Case
          (Place frame (Bits 0 62))
          (Place kind (Bits 62 2) (Range 0 2)))
        (Location "immutable"));
    }
  }
}
