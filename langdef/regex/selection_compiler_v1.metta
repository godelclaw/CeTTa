(gslt-presentation-v1 RegexSelectionCompilerV1
  (signature
    (operator metta-equation 2)
    (operator re:compile 1)
    (operator re:emit 3)
    (operator re:append 2)
    (operator re:zero 0)
    (operator re:epsilon 0)
    (operator re:literal 1)
    (operator re:any 0)
    (operator re:class 1)
    (operator re:assert 1)
    (operator re:seq 2)
    (operator re:alt 2)
    (operator re:optional 2)
    (operator re:star 2)
    (operator re:plus 2)
    (operator re:capture 2)
    (operator re:code 2)
    (operator re:fail 1)
    (operator re:match 1)
    (operator re:char 3)
    (operator re:class-at 3)
    (operator re:any-at 2)
    (operator re:assert-at 3)
    (operator re:jump 2)
    (operator re:split 3)
    (operator re:save 4)
    (operator re:left 1)
    (operator re:right 1)
    (operator re:body 1)
    (operator re:loop 1)
    (operator re:close 1)
    (operator re:root 0)
    (operator re:end 0)
    (operator Greedy 0)
    (operator Lazy 0)
    (operator Start 0)
    (operator End 0)
    (operator LNil 0)
    (operator LCons 2)
    (operator re:range 2)
    (operator re:count-zero 0)
    (operator re:count-succ 1)
    (operator re:repeat-prefix 3)
    (operator re:repeat-options 3)
    (operator re:repeat-exact 2)
    (operator re:repeat-at-least 3)
    (operator re:repeat-bounded 4)
    (operator re:lower 1)
    (operator re:compile-authored 1)
    (operator re:compile-acc 1)
    (operator re:emit-acc 4))
  (equations)
  (rewrites
    (rule compile (head (metta-equation (re:compile ?p) (re:code re:root (LCons (re:match re:end) (re:emit ?p re:end re:root))))) (body))
    (rule append-nil (head (metta-equation (re:append LNil ?tail) ?tail)) (body))
    (rule append-cons (head (metta-equation (re:append (LCons ?h ?t) ?tail) (LCons ?h (re:append ?t ?tail)))) (body))
    (rule zero (head (metta-equation (re:emit re:zero ?k ?at) (LCons (re:fail ?at) LNil))) (body))
    (rule epsilon (head (metta-equation (re:emit re:epsilon ?k ?at) (LCons (re:jump ?at ?k) LNil))) (body))
    (rule literal (head (metta-equation (re:emit (re:literal ?a) ?k ?at) (LCons (re:char ?at ?a ?k) LNil))) (body))
    (rule any (head (metta-equation (re:emit re:any ?k ?at) (LCons (re:any-at ?at ?k) LNil))) (body))
    (rule class (head (metta-equation (re:emit (re:class ?ranges) ?k ?at) (LCons (re:class-at ?at ?ranges ?k) LNil))) (body))
    (rule assertion (head (metta-equation (re:emit (re:assert ?which) ?k ?at) (LCons (re:assert-at ?at ?which ?k) LNil))) (body))
    (rule sequence (head (metta-equation (re:emit (re:seq ?p ?q) ?k ?at) (LCons (re:jump ?at (re:left ?at)) (re:append (re:emit ?p (re:right ?at) (re:left ?at)) (re:emit ?q ?k (re:right ?at)))))) (body))
    (rule alternative (head (metta-equation (re:emit (re:alt ?p ?q) ?k ?at) (LCons (re:split ?at (re:left ?at) (re:right ?at)) (re:append (re:emit ?p ?k (re:left ?at)) (re:emit ?q ?k (re:right ?at)))))) (body))
    (rule optional-greedy (head (metta-equation (re:emit (re:optional ?p Greedy) ?k ?at) (LCons (re:split ?at (re:body ?at) ?k) (re:emit ?p ?k (re:body ?at))))) (body))
    (rule optional-lazy (head (metta-equation (re:emit (re:optional ?p Lazy) ?k ?at) (LCons (re:split ?at ?k (re:body ?at)) (re:emit ?p ?k (re:body ?at))))) (body))
    (rule star-greedy (head (metta-equation (re:emit (re:star ?p Greedy) ?k ?at) (LCons (re:split ?at (re:body ?at) ?k) (LCons (re:split (re:loop ?at) (re:body ?at) ?k) (re:emit ?p (re:loop ?at) (re:body ?at)))))) (body))
    (rule star-lazy (head (metta-equation (re:emit (re:star ?p Lazy) ?k ?at) (LCons (re:split ?at ?k (re:body ?at)) (LCons (re:split (re:loop ?at) ?k (re:body ?at)) (re:emit ?p (re:loop ?at) (re:body ?at)))))) (body))
    (rule plus-greedy (head (metta-equation (re:emit (re:plus ?p Greedy) ?k ?at) (LCons (re:jump ?at (re:body ?at)) (LCons (re:split (re:loop ?at) (re:body ?at) ?k) (re:emit ?p (re:loop ?at) (re:body ?at)))))) (body))
    (rule plus-lazy (head (metta-equation (re:emit (re:plus ?p Lazy) ?k ?at) (LCons (re:jump ?at (re:body ?at)) (LCons (re:split (re:loop ?at) ?k (re:body ?at)) (re:emit ?p (re:loop ?at) (re:body ?at)))))) (body))
    (rule capture (head (metta-equation (re:emit (re:capture ?g ?p) ?k ?at) (LCons (re:save ?at ?g Start (re:body ?at)) (LCons (re:save (re:close ?at) ?g End ?k) (re:emit ?p (re:close ?at) (re:body ?at)))))) (body))
    (rule repeat-prefix-zero (head (metta-equation (re:repeat-prefix ?p re:count-zero ?tail) ?tail)) (body))
    (rule repeat-prefix-succ (head (metta-equation (re:repeat-prefix ?p (re:count-succ ?n) ?tail) (re:seq ?p (re:repeat-prefix ?p ?n ?tail)))) (body))
    (rule repeat-options-zero (head (metta-equation (re:repeat-options ?p re:count-zero ?g) re:epsilon)) (body))
    (rule repeat-options-succ (head (metta-equation (re:repeat-options ?p (re:count-succ ?n) ?g) (re:optional (re:seq ?p (re:repeat-options ?p ?n ?g)) ?g))) (body))
    (rule repeat-exact (head (metta-equation (re:repeat-exact ?p ?n) (re:repeat-prefix ?p ?n re:epsilon))) (body))
    (rule repeat-at-least-zero (head (metta-equation (re:repeat-at-least ?p re:count-zero ?g) (re:star ?p ?g))) (body))
    (rule repeat-at-least-succ (head (metta-equation (re:repeat-at-least ?p (re:count-succ ?n) ?g) (re:repeat-prefix ?p ?n (re:plus ?p ?g)))) (body))
    (rule repeat-bounded (head (metta-equation (re:repeat-bounded ?p ?low ?extra ?g) (re:repeat-prefix ?p ?low (re:repeat-options ?p ?extra ?g)))) (body))
    (rule lower-zero (head (metta-equation (re:lower re:zero) re:zero)) (body))
    (rule lower-epsilon (head (metta-equation (re:lower re:epsilon) re:epsilon)) (body))
    (rule lower-literal (head (metta-equation (re:lower (re:literal ?a)) (re:literal ?a))) (body))
    (rule lower-any (head (metta-equation (re:lower re:any) re:any)) (body))
    (rule lower-class (head (metta-equation (re:lower (re:class ?ranges)) (re:class ?ranges))) (body))
    (rule lower-assertion (head (metta-equation (re:lower (re:assert ?which)) (re:assert ?which))) (body))
    (rule lower-sequence (head (metta-equation (re:lower (re:seq ?p ?q)) (re:seq (re:lower ?p) (re:lower ?q)))) (body))
    (rule lower-alternative (head (metta-equation (re:lower (re:alt ?p ?q)) (re:alt (re:lower ?p) (re:lower ?q)))) (body))
    (rule lower-optional (head (metta-equation (re:lower (re:optional ?p ?g)) (re:optional (re:lower ?p) ?g))) (body))
    (rule lower-star (head (metta-equation (re:lower (re:star ?p ?g)) (re:star (re:lower ?p) ?g))) (body))
    (rule lower-plus (head (metta-equation (re:lower (re:plus ?p ?g)) (re:plus (re:lower ?p) ?g))) (body))
    (rule lower-capture (head (metta-equation (re:lower (re:capture ?g ?p)) (re:capture ?g (re:lower ?p)))) (body))
    (rule lower-exact (head (metta-equation (re:lower (re:repeat-exact ?p ?n)) (re:repeat-exact (re:lower ?p) ?n))) (body))
    (rule lower-at-least (head (metta-equation (re:lower (re:repeat-at-least ?p ?n ?g)) (re:repeat-at-least (re:lower ?p) ?n ?g))) (body))
    (rule lower-bounded (head (metta-equation (re:lower (re:repeat-bounded ?p ?low ?extra ?g)) (re:repeat-bounded (re:lower ?p) ?low ?extra ?g))) (body))
    (rule compile-authored (head (metta-equation (re:compile-authored ?p) (re:compile-acc (re:lower ?p)))) (body))
    (rule compile-acc (head (metta-equation (re:compile-acc ?p) (re:code re:root (LCons (re:match re:end) (re:emit-acc ?p re:end re:root LNil))))) (body))
    (rule emit-acc-zero (head (metta-equation (re:emit-acc re:zero ?k ?at ?tail) (LCons (re:fail ?at) ?tail))) (body))
    (rule emit-acc-epsilon (head (metta-equation (re:emit-acc re:epsilon ?k ?at ?tail) (LCons (re:jump ?at ?k) ?tail))) (body))
    (rule emit-acc-literal (head (metta-equation (re:emit-acc (re:literal ?a) ?k ?at ?tail) (LCons (re:char ?at ?a ?k) ?tail))) (body))
    (rule emit-acc-any (head (metta-equation (re:emit-acc re:any ?k ?at ?tail) (LCons (re:any-at ?at ?k) ?tail))) (body))
    (rule emit-acc-class (head (metta-equation (re:emit-acc (re:class ?ranges) ?k ?at ?tail) (LCons (re:class-at ?at ?ranges ?k) ?tail))) (body))
    (rule emit-acc-assertion (head (metta-equation (re:emit-acc (re:assert ?which) ?k ?at ?tail) (LCons (re:assert-at ?at ?which ?k) ?tail))) (body))
    (rule emit-acc-sequence (head (metta-equation (re:emit-acc (re:seq ?p ?q) ?k ?at ?tail) (LCons (re:jump ?at (re:left ?at)) (re:emit-acc ?p (re:right ?at) (re:left ?at) (re:emit-acc ?q ?k (re:right ?at) ?tail))))) (body))
    (rule emit-acc-alternative (head (metta-equation (re:emit-acc (re:alt ?p ?q) ?k ?at ?tail) (LCons (re:split ?at (re:left ?at) (re:right ?at)) (re:emit-acc ?p ?k (re:left ?at) (re:emit-acc ?q ?k (re:right ?at) ?tail))))) (body))
    (rule emit-acc-optional-greedy (head (metta-equation (re:emit-acc (re:optional ?p Greedy) ?k ?at ?tail) (LCons (re:split ?at (re:body ?at) ?k) (re:emit-acc ?p ?k (re:body ?at) ?tail)))) (body))
    (rule emit-acc-optional-lazy (head (metta-equation (re:emit-acc (re:optional ?p Lazy) ?k ?at ?tail) (LCons (re:split ?at ?k (re:body ?at)) (re:emit-acc ?p ?k (re:body ?at) ?tail)))) (body))
    (rule emit-acc-star-greedy (head (metta-equation (re:emit-acc (re:star ?p Greedy) ?k ?at ?tail) (LCons (re:split ?at (re:body ?at) ?k) (LCons (re:split (re:loop ?at) (re:body ?at) ?k) (re:emit-acc ?p (re:loop ?at) (re:body ?at) ?tail))))) (body))
    (rule emit-acc-star-lazy (head (metta-equation (re:emit-acc (re:star ?p Lazy) ?k ?at ?tail) (LCons (re:split ?at ?k (re:body ?at)) (LCons (re:split (re:loop ?at) ?k (re:body ?at)) (re:emit-acc ?p (re:loop ?at) (re:body ?at) ?tail))))) (body))
    (rule emit-acc-plus-greedy (head (metta-equation (re:emit-acc (re:plus ?p Greedy) ?k ?at ?tail) (LCons (re:jump ?at (re:body ?at)) (LCons (re:split (re:loop ?at) (re:body ?at) ?k) (re:emit-acc ?p (re:loop ?at) (re:body ?at) ?tail))))) (body))
    (rule emit-acc-plus-lazy (head (metta-equation (re:emit-acc (re:plus ?p Lazy) ?k ?at ?tail) (LCons (re:jump ?at (re:body ?at)) (LCons (re:split (re:loop ?at) ?k (re:body ?at)) (re:emit-acc ?p (re:loop ?at) (re:body ?at) ?tail))))) (body))
    (rule emit-acc-capture (head (metta-equation (re:emit-acc (re:capture ?g ?p) ?k ?at ?tail) (LCons (re:save ?at ?g Start (re:body ?at)) (LCons (re:save (re:close ?at) ?g End ?k) (re:emit-acc ?p (re:close ?at) (re:body ?at) ?tail))))) (body))))
