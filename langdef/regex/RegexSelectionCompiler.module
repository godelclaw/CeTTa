Module RegexSelection {
  Theory RegexSelectionCompilerV1() {
    Empty
    Types { ReValue = String; }
    Terms {
      "re:compile". p:ReValue |- "re:compile" p : ReValue;
      "re:emit". p:ReValue, k:ReValue, at:ReValue |- "re:emit" p k at : ReValue;
      "re:append". first:ReValue, second:ReValue |- "re:append" first second : ReValue;
      "re:zero".  |- "re:zero" : ReValue;
      "re:epsilon".  |- "re:epsilon" : ReValue;
      "re:literal". a:ReValue |- "re:literal" a : ReValue;
      "re:any".  |- "re:any" : ReValue;
      "re:class". ranges:ReValue |- "re:class" ranges : ReValue;
      "re:assert". which:ReValue |- "re:assert" which : ReValue;
      "re:seq". p:ReValue, q:ReValue |- "re:seq" p q : ReValue;
      "re:alt". p:ReValue, q:ReValue |- "re:alt" p q : ReValue;
      "re:optional". p:ReValue, preference:ReValue |- "re:optional" p preference : ReValue;
      "re:star". p:ReValue, preference:ReValue |- "re:star" p preference : ReValue;
      "re:plus". p:ReValue, preference:ReValue |- "re:plus" p preference : ReValue;
      "re:capture". group:ReValue, p:ReValue |- "re:capture" group p : ReValue;
      "re:code". entry:ReValue, rows:ReValue |- "re:code" entry rows : ReValue;
      "re:fail". at:ReValue |- "re:fail" at : ReValue;
      "re:match". at:ReValue |- "re:match" at : ReValue;
      "re:char". at:ReValue, a:ReValue, next:ReValue |- "re:char" at a next : ReValue;
      "re:class-at". at:ReValue, ranges:ReValue, next:ReValue |- "re:class-at" at ranges next : ReValue;
      "re:any-at". at:ReValue, next:ReValue |- "re:any-at" at next : ReValue;
      "re:assert-at". at:ReValue, which:ReValue, next:ReValue |- "re:assert-at" at which next : ReValue;
      "re:jump". at:ReValue, next:ReValue |- "re:jump" at next : ReValue;
      "re:split". at:ReValue, first:ReValue, second:ReValue |- "re:split" at first second : ReValue;
      "re:save". at:ReValue, group:ReValue, boundary:ReValue, next:ReValue |- "re:save" at group boundary next : ReValue;
      "re:left". at:ReValue |- "re:left" at : ReValue;
      "re:right". at:ReValue |- "re:right" at : ReValue;
      "re:body". at:ReValue |- "re:body" at : ReValue;
      "re:loop". at:ReValue |- "re:loop" at : ReValue;
      "re:close". at:ReValue |- "re:close" at : ReValue;
      "re:root".  |- "re:root" : ReValue;
      "re:end".  |- "re:end" : ReValue;
      "Greedy".  |- "Greedy" : ReValue;
      "Lazy".  |- "Lazy" : ReValue;
      "Start".  |- "Start" : ReValue;
      "End".  |- "End" : ReValue;
      "LNil".  |- "LNil" : ReValue;
      "LCons". head:ReValue, tail:ReValue |- "LCons" head tail : ReValue;
      "re:range". low:ReValue, high:ReValue |- "re:range" low high : ReValue;
      "re:count-zero".  |- "re:count-zero" : ReValue;
      "re:count-succ". n:ReValue |- "re:count-succ" n : ReValue;
      "re:repeat-prefix". p:ReValue, n:ReValue, tail:ReValue |- "re:repeat-prefix" p n tail : ReValue;
      "re:repeat-options". p:ReValue, n:ReValue, preference:ReValue |- "re:repeat-options" p n preference : ReValue;
      "re:repeat-exact". p:ReValue, n:ReValue |- "re:repeat-exact" p n : ReValue;
      "re:repeat-at-least". p:ReValue, n:ReValue, preference:ReValue |- "re:repeat-at-least" p n preference : ReValue;
      "re:repeat-bounded". p:ReValue, low:ReValue, extra:ReValue, preference:ReValue |- "re:repeat-bounded" p low extra preference : ReValue;
      "re:lower". p:ReValue |- "re:lower" p : ReValue;
      "re:compile-authored". p:ReValue |- "re:compile-authored" p : ReValue;
      "re:compile-acc". p:ReValue |- "re:compile-acc" p : ReValue;
      "re:emit-acc". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc" p k at tail : ReValue;
    }
    Equations {
      "compile". p:ReValue |- "re:compile"(p) = "re:code"("re:root"(), "LCons"("re:match"("re:end"()), "re:emit"(p, "re:end"(), "re:root"())));
      "append-nil". tail:ReValue |- "re:append"("LNil"(), tail) = tail;
      "append-cons". h:ReValue, t:ReValue, tail:ReValue |- "re:append"("LCons"(h, t), tail) = "LCons"(h, "re:append"(t, tail));
      "zero". k:ReValue, at:ReValue |- "re:emit"("re:zero"(), k, at) = "LCons"("re:fail"(at), "LNil"());
      "epsilon". k:ReValue, at:ReValue |- "re:emit"("re:epsilon"(), k, at) = "LCons"("re:jump"(at, k), "LNil"());
      "literal". a:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:literal"(a), k, at) = "LCons"("re:char"(at, a, k), "LNil"());
      "any". k:ReValue, at:ReValue |- "re:emit"("re:any"(), k, at) = "LCons"("re:any-at"(at, k), "LNil"());
      "class". ranges:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:class"(ranges), k, at) = "LCons"("re:class-at"(at, ranges, k), "LNil"());
      "assertion". which:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:assert"(which), k, at) = "LCons"("re:assert-at"(at, which, k), "LNil"());
      "sequence". p:ReValue, q:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:seq"(p, q), k, at) = "LCons"("re:jump"(at, "re:left"(at)), "re:append"("re:emit"(p, "re:right"(at), "re:left"(at)), "re:emit"(q, k, "re:right"(at))));
      "alternative". p:ReValue, q:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:alt"(p, q), k, at) = "LCons"("re:split"(at, "re:left"(at), "re:right"(at)), "re:append"("re:emit"(p, k, "re:left"(at)), "re:emit"(q, k, "re:right"(at))));
      "optional-greedy". p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:optional"(p, "Greedy"()), k, at) = "LCons"("re:split"(at, "re:body"(at), k), "re:emit"(p, k, "re:body"(at)));
      "optional-lazy". p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:optional"(p, "Lazy"()), k, at) = "LCons"("re:split"(at, k, "re:body"(at)), "re:emit"(p, k, "re:body"(at)));
      "star-greedy". p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:star"(p, "Greedy"()), k, at) = "LCons"("re:split"(at, "re:body"(at), k), "LCons"("re:split"("re:loop"(at), "re:body"(at), k), "re:emit"(p, "re:loop"(at), "re:body"(at))));
      "star-lazy". p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:star"(p, "Lazy"()), k, at) = "LCons"("re:split"(at, k, "re:body"(at)), "LCons"("re:split"("re:loop"(at), k, "re:body"(at)), "re:emit"(p, "re:loop"(at), "re:body"(at))));
      "plus-greedy". p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:plus"(p, "Greedy"()), k, at) = "LCons"("re:jump"(at, "re:body"(at)), "LCons"("re:split"("re:loop"(at), "re:body"(at), k), "re:emit"(p, "re:loop"(at), "re:body"(at))));
      "plus-lazy". p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:plus"(p, "Lazy"()), k, at) = "LCons"("re:jump"(at, "re:body"(at)), "LCons"("re:split"("re:loop"(at), k, "re:body"(at)), "re:emit"(p, "re:loop"(at), "re:body"(at))));
      "capture". g:ReValue, p:ReValue, k:ReValue, at:ReValue |- "re:emit"("re:capture"(g, p), k, at) = "LCons"("re:save"(at, g, "Start"(), "re:body"(at)), "LCons"("re:save"("re:close"(at), g, "End"(), k), "re:emit"(p, "re:close"(at), "re:body"(at))));
      "repeat-prefix-zero". p:ReValue, tail:ReValue |- "re:repeat-prefix"(p, "re:count-zero"(), tail) = tail;
      "repeat-prefix-succ". p:ReValue, n:ReValue, tail:ReValue |- "re:repeat-prefix"(p, "re:count-succ"(n), tail) = "re:seq"(p, "re:repeat-prefix"(p, n, tail));
      "repeat-options-zero". p:ReValue, g:ReValue |- "re:repeat-options"(p, "re:count-zero"(), g) = "re:epsilon"();
      "repeat-options-succ". p:ReValue, n:ReValue, g:ReValue |- "re:repeat-options"(p, "re:count-succ"(n), g) = "re:optional"("re:seq"(p, "re:repeat-options"(p, n, g)), g);
      "repeat-exact". p:ReValue, n:ReValue |- "re:repeat-exact"(p, n) = "re:repeat-prefix"(p, n, "re:epsilon"());
      "repeat-at-least-zero". p:ReValue, g:ReValue |- "re:repeat-at-least"(p, "re:count-zero"(), g) = "re:star"(p, g);
      "repeat-at-least-succ". p:ReValue, n:ReValue, g:ReValue |- "re:repeat-at-least"(p, "re:count-succ"(n), g) = "re:repeat-prefix"(p, n, "re:plus"(p, g));
      "repeat-bounded". p:ReValue, low:ReValue, extra:ReValue, g:ReValue |- "re:repeat-bounded"(p, low, extra, g) = "re:repeat-prefix"(p, low, "re:repeat-options"(p, extra, g));
      "lower-zero".  |- "re:lower"("re:zero"()) = "re:zero"();
      "lower-epsilon".  |- "re:lower"("re:epsilon"()) = "re:epsilon"();
      "lower-literal". a:ReValue |- "re:lower"("re:literal"(a)) = "re:literal"(a);
      "lower-any".  |- "re:lower"("re:any"()) = "re:any"();
      "lower-class". ranges:ReValue |- "re:lower"("re:class"(ranges)) = "re:class"(ranges);
      "lower-assertion". which:ReValue |- "re:lower"("re:assert"(which)) = "re:assert"(which);
      "lower-sequence". p:ReValue, q:ReValue |- "re:lower"("re:seq"(p, q)) = "re:seq"("re:lower"(p), "re:lower"(q));
      "lower-alternative". p:ReValue, q:ReValue |- "re:lower"("re:alt"(p, q)) = "re:alt"("re:lower"(p), "re:lower"(q));
      "lower-optional". p:ReValue, g:ReValue |- "re:lower"("re:optional"(p, g)) = "re:optional"("re:lower"(p), g);
      "lower-star". p:ReValue, g:ReValue |- "re:lower"("re:star"(p, g)) = "re:star"("re:lower"(p), g);
      "lower-plus". p:ReValue, g:ReValue |- "re:lower"("re:plus"(p, g)) = "re:plus"("re:lower"(p), g);
      "lower-capture". g:ReValue, p:ReValue |- "re:lower"("re:capture"(g, p)) = "re:capture"(g, "re:lower"(p));
      "lower-exact". p:ReValue, n:ReValue |- "re:lower"("re:repeat-exact"(p, n)) = "re:repeat-exact"("re:lower"(p), n);
      "lower-at-least". p:ReValue, n:ReValue, g:ReValue |- "re:lower"("re:repeat-at-least"(p, n, g)) = "re:repeat-at-least"("re:lower"(p), n, g);
      "lower-bounded". p:ReValue, low:ReValue, extra:ReValue, g:ReValue |- "re:lower"("re:repeat-bounded"(p, low, extra, g)) = "re:repeat-bounded"("re:lower"(p), low, extra, g);
      "compile-authored". p:ReValue |- "re:compile-authored"(p) = "re:compile-acc"("re:lower"(p));
      "compile-acc". p:ReValue |- "re:compile-acc"(p) = "re:code"("re:root"(), "LCons"("re:match"("re:end"()), "re:emit-acc"(p, "re:end"(), "re:root"(), "LNil"())));
      "emit-acc-zero". k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:zero"(), k, at, tail) = "LCons"("re:fail"(at), tail);
      "emit-acc-epsilon". k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:epsilon"(), k, at, tail) = "LCons"("re:jump"(at, k), tail);
      "emit-acc-literal". a:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:literal"(a), k, at, tail) = "LCons"("re:char"(at, a, k), tail);
      "emit-acc-any". k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:any"(), k, at, tail) = "LCons"("re:any-at"(at, k), tail);
      "emit-acc-class". ranges:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:class"(ranges), k, at, tail) = "LCons"("re:class-at"(at, ranges, k), tail);
      "emit-acc-assertion". which:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:assert"(which), k, at, tail) = "LCons"("re:assert-at"(at, which, k), tail);
      "emit-acc-sequence". p:ReValue, q:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:seq"(p, q), k, at, tail) = "LCons"("re:jump"(at, "re:left"(at)), "re:emit-acc"(p, "re:right"(at), "re:left"(at), "re:emit-acc"(q, k, "re:right"(at), tail)));
      "emit-acc-alternative". p:ReValue, q:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:alt"(p, q), k, at, tail) = "LCons"("re:split"(at, "re:left"(at), "re:right"(at)), "re:emit-acc"(p, k, "re:left"(at), "re:emit-acc"(q, k, "re:right"(at), tail)));
      "emit-acc-optional-greedy". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:optional"(p, "Greedy"()), k, at, tail) = "LCons"("re:split"(at, "re:body"(at), k), "re:emit-acc"(p, k, "re:body"(at), tail));
      "emit-acc-optional-lazy". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:optional"(p, "Lazy"()), k, at, tail) = "LCons"("re:split"(at, k, "re:body"(at)), "re:emit-acc"(p, k, "re:body"(at), tail));
      "emit-acc-star-greedy". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:star"(p, "Greedy"()), k, at, tail) = "LCons"("re:split"(at, "re:body"(at), k), "LCons"("re:split"("re:loop"(at), "re:body"(at), k), "re:emit-acc"(p, "re:loop"(at), "re:body"(at), tail)));
      "emit-acc-star-lazy". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:star"(p, "Lazy"()), k, at, tail) = "LCons"("re:split"(at, k, "re:body"(at)), "LCons"("re:split"("re:loop"(at), k, "re:body"(at)), "re:emit-acc"(p, "re:loop"(at), "re:body"(at), tail)));
      "emit-acc-plus-greedy". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:plus"(p, "Greedy"()), k, at, tail) = "LCons"("re:jump"(at, "re:body"(at)), "LCons"("re:split"("re:loop"(at), "re:body"(at), k), "re:emit-acc"(p, "re:loop"(at), "re:body"(at), tail)));
      "emit-acc-plus-lazy". p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:plus"(p, "Lazy"()), k, at, tail) = "LCons"("re:jump"(at, "re:body"(at)), "LCons"("re:split"("re:loop"(at), k, "re:body"(at)), "re:emit-acc"(p, "re:loop"(at), "re:body"(at), tail)));
      "emit-acc-capture". g:ReValue, p:ReValue, k:ReValue, at:ReValue, tail:ReValue |- "re:emit-acc"("re:capture"(g, p), k, at, tail) = "LCons"("re:save"(at, g, "Start"(), "re:body"(at)), "LCons"("re:save"("re:close"(at), g, "End"(), k), "re:emit-acc"(p, "re:close"(at), "re:body"(at), tail)));
    }
  }
}
