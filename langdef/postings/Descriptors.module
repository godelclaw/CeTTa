Module PostingsDescriptors {
  Theory Descriptors() {
    Empty Types { Descriptor; } Terms {
      "Before". |- "Before" : Descriptor;
      "All". |- "All" : Descriptor;
      "TensorBefore". |- "TensorBefore" : Descriptor;
      "TensorAll". |- "TensorAll" : Descriptor;
      "TableBefore". |- "TableBefore" : Descriptor;
      "TableAll". |- "TableAll" : Descriptor;
      "TableTensorBefore". |- "TableTensorBefore" : Descriptor;
      "TableTensorAll". |- "TableTensorAll" : Descriptor;
      "TableFoldBefore". |- "TableFoldBefore" : Descriptor;
      "WireTableFoldBefore". |- "table-fold-before" : Descriptor;
      "TableFoldColumnsBefore". |- "TableFoldColumnsBefore" : Descriptor;
      "WireTableFoldColumnsBefore". |- "table-fold-columns-before" : Descriptor;
      "FoldRows". |- "FoldRows" : Descriptor;
      "FoldColumns". |- "FoldColumns" : Descriptor;
      "FoldTable". |- "FoldTable" : Descriptor;
      "ColumnsLayout". |- "ColumnsLayout" : Descriptor;
      "WireColumns". |- "Postings:Columns" : Descriptor;
      "LabelsColumn". |- "LabelsColumn" : Descriptor;
      "ValueColumns". |- "ValueColumns" : Descriptor;
      "I64". |- "I64" : Descriptor;
      "F64". |- "F64" : Descriptor;
      "WireI64". |- "i64" : Descriptor;
      "WireF64". |- "f64" : Descriptor;
      "IntegerLeaf". |- "IntegerLeaf" : Descriptor;
      "FloatingLeaf". |- "FloatingLeaf" : Descriptor;
      "FirstGroupEncounterOrder". |- "FirstGroupEncounterOrder" : Descriptor;
      "DeclaredLeafDTypes". |- "DeclaredLeafDTypes" : Descriptor;
      "DenseColumns". |- "DenseColumns" : Descriptor;
      "QueryOrder". |- "QueryOrder" : Descriptor;
      "IndependentGroupStates". |- "IndependentGroupStates" : Descriptor;
      "ProjectedGroupIdentity". |- "ProjectedGroupIdentity" : Descriptor;
      "OriginalGroupCallback". |- "OriginalGroupCallback" : Descriptor;
      "MatchingCompatibleKeys". |- "MatchingCompatibleKeys" : Descriptor;
      "SingleAnswerNumericState". |- "SingleAnswerNumericState" : Descriptor;
      "ExpressionState". |- "ExpressionState" : Descriptor;
      "Stats". |- "Stats" : Descriptor;
      "WireBefore". |- "before" : Descriptor;
      "WireAll". |- "all" : Descriptor;
      "WireTensorBefore". |- "tensor-before" : Descriptor;
      "WireTensorAll". |- "tensor-all" : Descriptor;
      "WireTableBefore". |- "table-before" : Descriptor;
      "WireTableAll". |- "table-all" : Descriptor;
      "WireTableTensorBefore". |- "table-tensor-before" : Descriptor;
      "WireTableTensorAll". |- "table-tensor-all" : Descriptor;
      "WireStats". |- "stats" : Descriptor;
      "Index". |- "Index" : Descriptor;
      "Table". |- "Table" : Descriptor;
      "Either". |- "Either" : Descriptor;
      "Prefix". |- "Prefix" : Descriptor;
      "Complete". |- "Complete" : Descriptor;
      "Metadata". |- "Metadata" : Descriptor;
      "Rows". |- "Rows" : Descriptor;
      "Tensor". |- "Tensor" : Descriptor;
      "Statistics". |- "Statistics" : Descriptor;
      "PrepareIndex". |- "PrepareIndex" : Descriptor;
      "PrepareTable". |- "PrepareTable" : Descriptor;
      "PrepareSpaceTableAttempt". |- "PrepareSpaceTableAttempt" : Descriptor;
      "Inspect". |- "Inspect" : Descriptor;
      "Counts". |- "Counts" : Descriptor;
      "SourcesCurrent". |- "SourcesCurrent" : Descriptor;
      "Close". |- "Close" : Descriptor;
      "SourceOccurrenceOrder". |- "SourceOccurrenceOrder" : Descriptor;
      "DuplicateOccurrences". |- "DuplicateOccurrences" : Descriptor;
      "NumericPositionsAscending". |- "NumericPositionsAscending" : Descriptor;
      "FirstOuterKeyOrder". |- "FirstOuterKeyOrder" : Descriptor;
      "NumericGroupOrder". |- "NumericGroupOrder" : Descriptor;
      "CompleteValidation". |- "CompleteValidation" : Descriptor;
      "AtomicPublication". |- "AtomicPublication" : Descriptor;
      "OwnedSnapshot". |- "OwnedSnapshot" : Descriptor;
      "BorrowedSource". |- "BorrowedSource" : Descriptor;
      "DeclaredProjection". |- "DeclaredProjection" : Descriptor;
      "ExactRowWidth". |- "ExactRowWidth" : Descriptor;
      "ProtectedStandaloneSource". |- "ProtectedStandaloneSource" : Descriptor;
      "BlockLayout". |- "BlockLayout" : Descriptor;
      "WireBlockLayout". |- "Postings:BlockLayout" : Descriptor;
      "RowHead". |- "RowHead" : Descriptor;
      "RowWidth". |- "RowWidth" : Descriptor;
      "KeysField". |- "KeysField" : Descriptor;
      "GroupField". |- "GroupField" : Descriptor;
      "PositionField". |- "PositionField" : Descriptor;
      "PrefixKeys". |- "PrefixKeys" : Descriptor;
      "ForbiddenHeads". |- "ForbiddenHeads" : Descriptor;
      "ExactSourceRevision". |- "ExactSourceRevision" : Descriptor;
      "AuthoredFallback". |- "AuthoredFallback" : Descriptor;
      "CloseInvalidatesAliases". |- "CloseInvalidatesAliases" : Descriptor;
    } Equations {
      (PostingsProjection (BlockLayout)) == (Projection (WireBlockLayout) (RowHead) (RowWidth) (KeysField) (GroupField) (PositionField) (PrefixKeys) (ForbiddenHeads));
      (PostingsProjection (ColumnsLayout)) == (Projection (WireColumns) (LabelsColumn) (ValueColumns));
      (PostingsColumnDType (I64)) == (ColumnDType (WireI64) (IntegerLeaf));
      (PostingsColumnDType (F64)) == (ColumnDType (WireF64) (FloatingLeaf));
      (PostingsCountMode (Before)) == (CountMode (WireBefore) (Index) (Prefix) (Rows));
      (PostingsCountMode (All)) == (CountMode (WireAll) (Index) (Complete) (Rows));
      (PostingsCountMode (TensorBefore)) == (CountMode (WireTensorBefore) (Index) (Prefix) (Tensor));
      (PostingsCountMode (TensorAll)) == (CountMode (WireTensorAll) (Index) (Complete) (Tensor));
      (PostingsCountMode (TableBefore)) == (CountMode (WireTableBefore) (Table) (Prefix) (Rows));
      (PostingsCountMode (TableAll)) == (CountMode (WireTableAll) (Table) (Complete) (Rows));
      (PostingsCountMode (TableTensorBefore)) == (CountMode (WireTableTensorBefore) (Table) (Prefix) (Tensor));
      (PostingsCountMode (TableTensorAll)) == (CountMode (WireTableTensorAll) (Table) (Complete) (Tensor));
      (PostingsCountMode (TableFoldBefore)) == (CountMode (WireTableFoldBefore) (Table) (Prefix) (FoldRows));
      (PostingsCountMode (TableFoldColumnsBefore)) == (CountMode (WireTableFoldColumnsBefore) (Table) (Prefix) (FoldColumns));
      (PostingsCountMode (Stats)) == (CountMode (WireStats) (Either) (Metadata) (Statistics));
      (PostingsObservation (PrepareIndex)) == (Observe (SourceOccurrenceOrder) (DuplicateOccurrences) (NumericPositionsAscending) (CompleteValidation) (AtomicPublication) (OwnedSnapshot) (AuthoredFallback));
      (PostingsObservation (PrepareTable)) == (Observe (MatchingCompatibleKeys) (FirstOuterKeyOrder) (DuplicateOccurrences) (NumericGroupOrder) (NumericPositionsAscending) (CompleteValidation) (AtomicPublication) (OwnedSnapshot) (AuthoredFallback));
      (PostingsObservation (PrepareSpaceTableAttempt)) == (Observe (BorrowedSource) (DeclaredProjection) (MatchingCompatibleKeys) (ExactRowWidth) (ProtectedStandaloneSource) (FirstOuterKeyOrder) (DuplicateOccurrences) (NumericGroupOrder) (NumericPositionsAscending) (CompleteValidation) (AtomicPublication) (OwnedSnapshot) (AuthoredFallback));
      (PostingsObservation (Inspect)) == (Observe (SourceOccurrenceOrder) (DuplicateOccurrences) (OwnedSnapshot));
      (PostingsObservation (Counts)) == (Observe (DuplicateOccurrences) (NumericPositionsAscending) (AuthoredFallback));
      (PostingsObservation (FoldTable)) == (Observe (QueryOrder) (NumericGroupOrder) (MatchingCompatibleKeys) (ProjectedGroupIdentity) (OriginalGroupCallback) (IndependentGroupStates) (ExpressionState) (SingleAnswerNumericState) (CompleteValidation) (AtomicPublication) (AuthoredFallback));
      (PostingsObservation (FoldColumns)) == (Observe (QueryOrder) (NumericGroupOrder) (MatchingCompatibleKeys) (ProjectedGroupIdentity) (OriginalGroupCallback) (IndependentGroupStates) (ExpressionState) (SingleAnswerNumericState) (FirstGroupEncounterOrder) (DeclaredLeafDTypes) (DenseColumns) (CompleteValidation) (AtomicPublication) (AuthoredFallback));
      (PostingsObservation (SourcesCurrent)) == (Observe (ExactSourceRevision) (CompleteValidation) (AuthoredFallback));
      (PostingsObservation (Close)) == (Observe (CloseInvalidatesAliases));
    }
  }
  theory Descriptors()
}
