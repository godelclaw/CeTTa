!(import! &self ../../../../Mettapedia/MettaKernel/kernel/generic_open_rule_programs.metta)
(= (sr:a) (PApp "A" LNil))
(= (sr:b) (PApp "B" LNil))
(= (sr:language)
   (GInferenceLanguageV1 1 LNil
     (LCons (JDecl "A" 0) (LCons (JDecl "B" 0) LNil))
     (LCons (GRuleV1 "step" LNil (LCons (sr:a) LNil) (sr:b) LNil) LNil)
     GNoConversion))
(= (sr:source $revision)
   (GSLTSourceV1 (SourceIdentityV1 "open-rule-calibration" $revision "calibration-artifact")
     (AssumptionLedgerV1 LNil)
     (ProfileLedgerV1 (LCons (SourceProfileV1 "proof-calculus" "1" (PApp "ExactPremises" LNil)) LNil))
     (sr:language)))
(= (sr:program) (GProof (GRuleInst "step" LNil) (PrCons (GOpenHyp 0) PrNil)))
