(hol:profile base)
!(import! &self judgments.metta)
!(hol:inductive &self Nat (u 0) (: Z Nat) (: S (-> Nat Nat)))
!(hol:define &self add (-> Nat Nat Nat)
   (= (add $n Z) $n) (= (add $n (S $m)) (S (add $n $m))))
!(hol:define &self At (-> Nat (u 0))
   (= (At $n) (sigma (value : Nat) (id Nat value $n))))
!(hol:define &self pack (-> (n : Nat) (At n))
   (= (pack $n) (pair $n (refl $n))))
!(hol:define &self use (-> (n : Nat) (p : (At (add n Z))) Nat)
   (= (use $n $p) (fst $p)))

(= (identity-goal) (quote (|- ((: A (u 0)) (: x A)) (: x A))))
!(assertEqual (judge (identity-goal)) True)
!(assertEqual (judge (quote (|- ((: A (u 0)) (: B (u 0)) (: x A)) (: x B)))) False)
!(assertEqual (judge (quote (|- ((: n Nat)) (formed (At n) (u 0))))) True)
!(assertEqual (judge (quote (|- ((: n Nat)) (convert (add n Z) n Nat)))) True)
!(assertEqual (judge (quote (|- ((: n Nat)) (convert (add n Z) (S n) Nat)))) False)
!(assertEqual (judge (quote (|- ((: n Nat)) (convert (add Z n) n Nat)))) False)
!(assertEqual (judge (quote (|- ((: n Nat) (: p (At n))) (: p (At (add n Z)))))) True)
!(assertEqual (judge (quote (|- ((: n Nat) (: p (At n))) (: p (At (S n)))))) False)
!(assertEqual (use (S Z) (pack (S Z))) (S Z))
!(assertEqual (type:check (pack Z) (At (add (S Z) Z))) False)
!(assertEqual (car-atom (try (use (S Z) (pack Z)))) Failed)
!(assertEqual (car-atom (judgment-outcome
   (quote (|- ((: A (u 0)) (: bad Mystery) (: x A)) (: x A))))) Undetermined)
!(assertEqual (judge (quote (|- ((: A (u 0)) (: x A) (: x A)) (: x A))))
   (Unsupported duplicate-display-name))
!(assertEqual (judge (quote (|- ((: A (u 0)) (: x A) (: A (u 0))) (: x A))))
   (Unsupported duplicate-display-name))
!(assertEqual (judge (quote (|- ((: A (u 0)) (: x A)) (: x A))))
   (judge (quote (|- ((: B (u 0)) (: y B)) (: y B)))))

; New computation rules are generated from ordinary signatures and equations.
!(assertEqual (admit-definition (increment-signature inc) (increment-equations inc)) inc)
!(assertEqual (inc Z) (S Z))
!(assertEqual (judge (quote (|- ((: n Nat)) (convert (inc n) (S n) Nat)))) True)
!(let $goal (congruence-judgment inc Nat Nat)
   (assertEqual (judge $goal) True))
!(let $goal (congruence-judgment inc Nat Nat)
   (assertEqual (publish-judgment inc-congr $goal) inc-congr))
!(assertEqual (type:check (inc-congr Z Z (refl Z)) (id Nat (inc Z) (inc Z))) True)
!(assertEqual (type:check (inc-congr Z Z (refl Z)) (id Nat (inc Z) Z)) False)
; Inspection preserves the request as syntax, even after it is known true.
!(let (JudgmentView $original (quote $lowered)
        (quote (PrimeKernelQueryV1 (Judgment $request) $route $context $levels $rules
          $subject $subject-type $object $object-type)))
      (inspect-judgment (quote (|- ((: n Nat)) (convert (inc n) (S n) Nat))))
   (assertEqual (=alpha (quote $request){$request} (quote $lowered){$lowered}) True))

; Programs generate a formation/constructor package, and a consumer, at two carriers.
!(hol:inductive &self Bit (u 0) (: Yes Bit) (: No Bit))
!(assertEqual (admit-datatype (box-declaration NumberBox wrap-number Nat)) NumberBox)
!(assertEqual (admit-datatype (box-declaration BitBox wrap-bit Bit)) BitBox)
!(assertEqual (type:formed NumberBox) True)
!(assertEqual (type:check (wrap-number (S Z)) NumberBox) True)
!(assertEqual (type:check (wrap-number Yes) NumberBox) False)
!(assertEqual (admit-definition (projection-signature unbox-number NumberBox Nat)
   (projection-equations unbox-number wrap-number)) unbox-number)
!(assertEqual (admit-definition (projection-signature unbox-bit BitBox Bit)
   (projection-equations unbox-bit wrap-bit)) unbox-bit)
!(assertEqual (unbox-number (wrap-number (S Z))) (S Z))
!(assertEqual (unbox-bit (wrap-bit Yes)) Yes)
!(assertEqual (judge (quote (|- ((: n Nat))
   (convert (unbox-number (wrap-number n)) n Nat)))) True)

; This proposed indexed declaration spelling is outside the frozen native intake.
!(assertEqual (car-atom (try (hol:inductive Vec (-> Nat (u 0))
   (: Nil (Vec Z)) (: Cons (-> Nat (Vec $n) (Vec (S $n))))))) Undetermined)

; A successful data computation is not a successful mathematical judgment.
!(assertEqual (car-atom (try (identity-goal))) Established)
!(assertEqual (car-atom (judgment-outcome
   (quote (|- ((: A (u 0)) (: B (u 0)) (: x A)) (: x B))))) Refuted)
